@*
    Purpose: Current quotes list page.
    Authors: Naseeha27, Sayali-St10458649, ST10068525 (from git history)
*@

@model IEnumerable<FMCGEnterpriseManagementSystem.Models.Quote>

@{
    ViewData["Title"] = "Quotes";

    var quotes = Model?.ToList()
        ?? new List<FMCGEnterpriseManagementSystem.Models.Quote>();

    var totalQuotes = ViewBag.TotalQuotes ?? quotes.Count;
    var pendingQuotes = ViewBag.PendingQuotes ?? 0;
    var invoicedQuotes = ViewBag.InvoicedQuotes ?? 0;
    var totalValue = ViewBag.TotalQuoteValue ?? 0m;
}

<div class="content-card">

    <!-- HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">

        <div>
            <h2 class="fw-bold mb-1" style="color:#1c323d;">
                Quotes
            </h2>

            <p class="text-muted mb-0">
                Manage current customer quotations and convert approved quotations into invoices.
            </p>
        </div>

        <div class="d-flex gap-2 flex-wrap">

            <a asp-controller="Quotes"
               asp-action="History"
               class="btn btn-outline-secondary">

                <i class="bi bi-clock-history me-1"></i>
                Quote History

            </a>

            <a asp-controller="Quotes"
               asp-action="Create"
               class="btn btn-action-primary text-decoration-none">

                <i class="bi bi-plus-lg me-1"></i>
                New Quote

            </a>

        </div>

    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- SUMMARY CARDS -->
    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="border rounded p-3 h-100">

                <small class="text-muted d-block mb-1">
                    Total Quotes
                </small>

                <div class="fs-4 fw-bold" style="color:#1c323d;">
                    @totalQuotes
                </div>

            </div>
        </div>


        <div class="col-md-3">
            <div class="border rounded p-3 h-100">

                <small class="text-muted d-block mb-1">
                    Pending
                </small>

                <div class="fs-4 fw-bold" style="color:#1c323d;">
                    @pendingQuotes
                </div>

            </div>
        </div>


        <div class="col-md-3">
            <div class="border rounded p-3 h-100">

                <small class="text-muted d-block mb-1">
                    Converted to Invoice
                </small>

                <div class="fs-4 fw-bold" style="color:#1c323d;">
                    @invoicedQuotes
                </div>

            </div>
        </div>


        <div class="col-md-3">
            <div class="border rounded p-3 h-100">

                <small class="text-muted d-block mb-1">
                    Total Quote Value
                </small>

                <div class="fs-4 fw-bold" style="color:#1c323d;">
                    R @Convert.ToDecimal(totalValue).ToString("N2")
                </div>

            </div>
        </div>

    </div>


    <!-- SEARCH / FILTERS -->
    <div class="border rounded p-3 mb-4 bg-light">

        <div class="row g-3 align-items-end">

            <div class="col-lg-5">

                <label class="form-label small fw-semibold">
                    Search Quotes
                </label>

                <input type="text"
                       id="quoteSearch"
                       class="form-control"
                       placeholder="Quote number or customer..." />

            </div>


            <div class="col-md-4 col-lg-2">

                <label class="form-label small fw-semibold">
                    Status
                </label>

                <select id="statusFilter"
                        class="form-select">

                    <option value="">
                        All Statuses
                    </option>

                    <option value="Pending">
                        Pending
                    </option>

                    <option value="Cancelled">
                        Cancelled
                    </option>

                </select>

            </div>


            <div class="col-md-4 col-lg-2">

                <label class="form-label small fw-semibold">
                    Start Date
                </label>

                <input type="date"
                       id="startDate"
                       class="form-control" />

            </div>


            <div class="col-md-4 col-lg-2">

                <label class="form-label small fw-semibold">
                    End Date
                </label>

                <input type="date"
                       id="endDate"
                       class="form-control" />

            </div>


            <div class="col-lg-1">

                <button type="button"
                        id="clearFilters"
                        class="btn btn-outline-secondary w-100">
                    Clear
                </button>

            </div>

        </div>

    </div>


    <!-- CURRENT QUOTES TABLE -->
    <div class="table-responsive">

        <table class="table align-middle mb-0"
               id="quotesTable">

            <thead class="table-light">

                <tr>
                    <th>Date</th>
                    <th>Quote No.</th>
                    <th>Customer</th>
                    <th>Sales Rep</th>
                    <th class="text-end">Total</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>

            </thead>

            <tbody>

                @if (quotes.Any())
                {
                    foreach (var quote in quotes)
                    {
                        var statusClass = quote.Status switch
                        {
                            FMCGEnterpriseManagementSystem.Enums.QuoteStatus.Pending
                                => "bg-warning text-dark",

                            FMCGEnterpriseManagementSystem.Enums.QuoteStatus.Cancelled
                                => "bg-danger",

                            _ => "bg-secondary"
                        };

                        var customerName =
                            quote.Customer != null
                                ? $"{quote.Customer.Name} {quote.Customer.Surname}"
                                : "Unknown Customer";

                        var salesRepName =
                            quote.SalesRepresentative?.Employee != null
                                ? $"{quote.SalesRepresentative.Employee.FirstName} {quote.SalesRepresentative.Employee.LastName}"
                                : "Unassigned";

                        <tr class="quote-row"
                            data-status="@quote.Status"
                            data-date="@quote.QuoteDate.ToString("yyyy-MM-dd")">

                            <td>
                                @quote.QuoteDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                <span class="fw-semibold">
                                    @quote.QuoteNumber
                                </span>
                            </td>

                            <td>
                                <div class="fw-semibold">
                                    @customerName
                                </div>
                            </td>

                            <td>
                                @salesRepName
                            </td>

                            <td class="text-end fw-semibold">
                                R @quote.Total.ToString("N2")
                            </td>

                            <td>
                                <span class="badge @statusClass">
                                    @quote.Status
                                </span>
                            </td>

                            <td class="text-end text-nowrap">

                                <a asp-controller="Quotes"
                                   asp-action="Details"
                                   asp-route-id="@quote.QuoteId"
                                   class="btn btn-sm btn-outline-secondary">
                                    View
                                </a>

                                <a asp-controller="Quotes"
                                   asp-action="Edit"
                                   asp-route-id="@quote.QuoteId"
                                   class="btn btn-sm btn-outline-warning">
                                    Edit
                                </a>


                                <div class="dropdown d-inline-block">

                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                            type="button"
                                            data-bs-toggle="dropdown"
                                            data-bs-boundary="viewport">
                                        More
                                    </button>

                                    <ul class="dropdown-menu dropdown-menu-end">

                                        @if (quote.Status != FMCGEnterpriseManagementSystem.Enums.QuoteStatus.Cancelled)
                                        {
                                            <li>

                                                <form asp-controller="Quotes"
                                                      asp-action="ConvertToInvoice"
                                                      asp-route-id="@quote.QuoteId"
                                                      method="post">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="dropdown-item">
                                                        Convert to Invoice
                                                    </button>

                                                </form>

                                            </li>
                                        }


                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Quotes"
                                               asp-action="DownloadPdf"
                                               asp-route-id="@quote.QuoteId">
                                                Download PDF
                                            </a>
                                        </li>


                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Quotes"
                                               asp-action="Details"
                                               asp-route-id="@quote.QuoteId">
                                                Email Quote
                                            </a>
                                        </li>

                                    </ul>

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="7"
                            class="text-center text-muted py-5">

                            <div class="fw-semibold mb-1">
                                No current quotes
                            </div>

                            <div class="small">
                                Converted quotes are available in Quote History.
                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>


@section Scripts {

    <script>

        const searchInput =
            document.getElementById('quoteSearch');

        const statusFilter =
            document.getElementById('statusFilter');

        const startDate =
            document.getElementById('startDate');

        const endDate =
            document.getElementById('endDate');

        const clearButton =
            document.getElementById('clearFilters');


        function filterQuotes() {

            const search =
                searchInput.value.toLowerCase().trim();

            const status =
                statusFilter.value;

            const start =
                startDate.value;

            const end =
                endDate.value;


            document.querySelectorAll('.quote-row')
                .forEach(function (row) {

                    const text =
                        row.innerText.toLowerCase();

                    const rowStatus =
                        row.dataset.status;

                    const rowDate =
                        row.dataset.date;

                    const matchesSearch =
                        !search || text.includes(search);

                    const matchesStatus =
                        !status || rowStatus === status;

                    const matchesStart =
                        !start || rowDate >= start;

                    const matchesEnd =
                        !end || rowDate <= end;

                    row.style.display =
                        matchesSearch &&
                        matchesStatus &&
                        matchesStart &&
                        matchesEnd
                            ? ''
                            : 'none';
                });
        }


        searchInput.addEventListener(
            'input',
            filterQuotes
        );

        statusFilter.addEventListener(
            'change',
            filterQuotes
        );

        startDate.addEventListener(
            'change',
            filterQuotes
        );

        endDate.addEventListener(
            'change',
            filterQuotes
        );


        clearButton.addEventListener(
            'click',
            function () {

                searchInput.value = '';
                statusFilter.value = '';
                startDate.value = '';
                endDate.value = '';

                filterQuotes();
            }
        );

    </script>
}