@*
    Purpose: Current quotes list, filtering, PDF downloads and invoice conversion.
    Original authors: Naseeha27, Sayali-St10458649, ST10068525 (Git history).
    UI integration: Iqra Nazir (2026).
    UI adaptation assistance: OpenAI ChatGPT (2026).

    References:
    Microsoft (n.d.) ASP.NET Core MVC views.
    https://learn.microsoft.com/en-us/aspnet/core/mvc/views/overview
    MDN Web Docs (n.d.) EventTarget.addEventListener().
    https://developer.mozilla.org/en-US/docs/Web/API/EventTarget/addEventListener
*@

@model IEnumerable<FMCGEnterpriseManagementSystem.Models.Quote>

@{
    ViewData["Title"] = "Quotes";

    var quotes = Model?.ToList()
        ?? new List<FMCGEnterpriseManagementSystem.Models.Quote>();

    var totalQuotes = ViewBag.TotalQuotes ?? quotes.Count;
    var pendingQuotes = ViewBag.PendingQuotes ?? 0;
    var invoicedQuotes = ViewBag.InvoicedQuotes ?? 0;
    var totalValue = ViewBag.TotalQuoteValue ?? 0m;
}

<div class="content-card quotes-page">

    <div class="quotes-page-header">
        <div>
            <h2 class="quotes-page-title">Quotes</h2>
            <p class="quotes-page-subtitle">
                Manage customer quotations and convert approved quotations into invoices.
            </p>
        </div>

        <div class="quotes-header-actions">
            <a asp-controller="Quotes"
               asp-action="History"
               class="quotes-btn-outline">
                <i class="bi bi-clock-history"></i>
                Quote History
            </a>

            <a asp-controller="Quotes"
               asp-action="Create"
               class="quotes-btn-primary">
                <i class="bi bi-plus-lg"></i>
                New Quote
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-3 mb-4">

        <div class="col-md-6 col-xl-3">
            <div class="quotes-stat-card">
                <div class="quotes-stat-label">Total Quotes</div>
                <div class="quotes-stat-value">@totalQuotes</div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="quotes-stat-card pending">
                <div class="quotes-stat-label">Pending</div>
                <div class="quotes-stat-value">@pendingQuotes</div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="quotes-stat-card invoiced">
                <div class="quotes-stat-label">Converted to Invoice</div>
                <div class="quotes-stat-value">@invoicedQuotes</div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="quotes-stat-card value">
                <div class="quotes-stat-label">Total Quote Value</div>
                <div class="quotes-stat-value">
                    R @Convert.ToDecimal(totalValue).ToString("N2")
                </div>
            </div>
        </div>

    </div>

    <div class="quotes-filter-panel">
        <div class="row g-3 align-items-end">

            <div class="col-lg-5">
                <label class="quotes-filter-label" for="quoteSearch">
                    Search Quotes
                </label>
                <input type="text"
                       id="quoteSearch"
                       class="form-control"
                       placeholder="Quote number or customer..." />
            </div>

            <div class="col-md-4 col-lg-2">
                <label class="quotes-filter-label" for="statusFilter">
                    Status
                </label>
                <select id="statusFilter" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Pending">Pending</option>
                    <option value="Cancelled">Cancelled</option>
                </select>
            </div>

            <div class="col-md-4 col-lg-2">
                <label class="quotes-filter-label" for="startDate">
                    Start Date
                </label>
                <input type="date" id="startDate" class="form-control" />
            </div>

            <div class="col-md-4 col-lg-2">
                <label class="quotes-filter-label" for="endDate">
                    End Date
                </label>
                <input type="date" id="endDate" class="form-control" />
            </div>

            <div class="col-lg-1">
                <button type="button"
                        id="clearFilters"
                        class="quotes-btn-outline w-100">
                    Clear
                </button>
            </div>

        </div>
    </div>

    <div class="quotes-table-container">
        <table class="quotes-table" id="quotesTable">

            <thead>
                <tr>
                    <th>Date</th>
                    <th>Quote No.</th>
                    <th>Customer</th>
                    <th>Sales Rep</th>
                    <th class="text-end">Total</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (quotes.Any())
                {
                    foreach (var quote in quotes)
                    {
                        var statusClass = quote.Status switch
                        {
                            FMCGEnterpriseManagementSystem.Enums.QuoteStatus.Pending
                                => "pending",

                            FMCGEnterpriseManagementSystem.Enums.QuoteStatus.Cancelled
                                => "cancelled",

                            _ => "invoiced"
                        };

                        var customerName = quote.Customer != null
                            ? $"{quote.Customer.Name} {quote.Customer.Surname}"
                            : "Unknown Customer";

                        var salesRepName = quote.SalesRepresentative?.Employee != null
                            ? $"{quote.SalesRepresentative.Employee.FirstName} {quote.SalesRepresentative.Employee.LastName}"
                            : "Unassigned";

                        <tr class="quote-row"
                            data-status="@quote.Status"
                            data-date="@quote.QuoteDate.ToString("yyyy-MM-dd")">

                            <td>@quote.QuoteDate.ToString("dd MMM yyyy")</td>

                            <td>
                                <span class="quotes-reference">
                                    @quote.QuoteNumber
                                </span>
                            </td>

                            <td class="fw-semibold">@customerName</td>

                            <td>@salesRepName</td>

                            <td class="text-end fw-semibold">
                                R @quote.Total.ToString("N2")
                            </td>

                            <td>
                                <span class="quotes-status @statusClass">
                                    @quote.Status
                                </span>
                            </td>

                            <td>
                                <div class="quotes-actions">

                                    <a asp-controller="Quotes"
                                       asp-action="Details"
                                       asp-route-id="@quote.QuoteId"
                                       class="quotes-action-btn">
                                        <i class="bi bi-eye"></i>
                                        View
                                    </a>

                                    <a asp-controller="Quotes"
                                       asp-action="Edit"
                                       asp-route-id="@quote.QuoteId"
                                       class="quotes-action-btn quotes-action-edit">
                                        <i class="bi bi-pencil-square"></i>
                                        Edit
                                    </a>

                                    <div class="dropdown">
                                        <button type="button"
                                                class="quotes-action-btn dropdown-toggle"
                                                data-bs-toggle="dropdown"
                                                data-bs-boundary="viewport"
                                                aria-expanded="false">
                                            More
                                        </button>

                                        <ul class="dropdown-menu dropdown-menu-end">

                                            @if (quote.Status != FMCGEnterpriseManagementSystem.Enums.QuoteStatus.Cancelled)
                                            {
                                                <li>
                                                    <form asp-controller="Quotes"
                                                          asp-action="ConvertToInvoice"
                                                          asp-route-id="@quote.QuoteId"
                                                          method="post">

                                                        @Html.AntiForgeryToken()

                                                        <button type="submit"
                                                                class="dropdown-item">
                                                            <i class="bi bi-receipt me-2"></i>
                                                            Convert to Invoice
                                                        </button>
                                                    </form>
                                                </li>
                                            }

                                            <li>
                                                <a class="dropdown-item"
                                                   asp-controller="Quotes"
                                                   asp-action="DownloadPdf"
                                                   asp-route-id="@quote.QuoteId">
                                                    <i class="bi bi-file-earmark-pdf me-2"></i>
                                                    Download PDF
                                                </a>
                                            </li>

                                            <li>
                                                <a class="dropdown-item"
                                                   asp-controller="Quotes"
                                                   asp-action="Details"
                                                   asp-route-id="@quote.QuoteId">
                                                    <i class="bi bi-envelope me-2"></i>
                                                    Email Quote
                                                </a>
                                            </li>

                                        </ul>
                                    </div>

                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7">
                            <div class="quotes-empty-state">
                                <i class="bi bi-file-earmark-text"></i>
                                <strong>No current quotes</strong>
                                <span>
                                    Converted quotes are available in Quote History.
                                </span>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>

</div>

@section Scripts {
    <script>
        // Client-side filtering of the currently displayed quotes.
        const searchInput = document.getElementById('quoteSearch');
        const statusFilter = document.getElementById('statusFilter');
        const startDate = document.getElementById('startDate');
        const endDate = document.getElementById('endDate');
        const clearButton = document.getElementById('clearFilters');

        function filterQuotes() {
            const search = searchInput.value.toLowerCase().trim();
            const status = statusFilter.value;
            const start = startDate.value;
            const end = endDate.value;

            document.querySelectorAll('.quote-row').forEach(function (row) {
                const text = row.innerText.toLowerCase();
                const rowStatus = row.dataset.status;
                const rowDate = row.dataset.date;

                const matchesSearch = !search || text.includes(search);
                const matchesStatus = !status || rowStatus === status;
                const matchesStart = !start || rowDate >= start;
                const matchesEnd = !end || rowDate <= end;

                row.style.display =
                    matchesSearch &&
                    matchesStatus &&
                    matchesStart &&
                    matchesEnd ? '' : 'none';
            });
        }

        searchInput.addEventListener('input', filterQuotes);
        statusFilter.addEventListener('change', filterQuotes);
        startDate.addEventListener('change', filterQuotes);
        endDate.addEventListener('change', filterQuotes);

        clearButton.addEventListener('click', function () {
            searchInput.value = '';
            statusFilter.value = '';
            startDate.value = '';
            endDate.value = '';
            filterQuotes();
        });
    </script>
}