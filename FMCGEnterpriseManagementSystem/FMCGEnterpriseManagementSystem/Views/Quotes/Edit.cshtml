@*
    Purpose: Edit quotation details, products, discounts and VAT.
    Original functionality: Existing Quotes module contributors (Git history).
    UI integration: Iqra Nazir (2026).
    UI adaptation assistance: OpenAI ChatGPT (2026).

    References:
    Bootstrap (n.d.) Forms. https://getbootstrap.com/docs/5.3/forms/overview/
    Microsoft (n.d.) ASP.NET Core MVC model binding.
    https://learn.microsoft.com/en-us/aspnet/core/mvc/models/model-binding
    MDN Web Docs (n.d.) Document.createElement().
    https://developer.mozilla.org/en-US/docs/Web/API/Document/createElement
*@

@model FMCGEnterpriseManagementSystem.Models.Quote

@using Microsoft.AspNetCore.Mvc.Rendering
@inject FMCGEnterpriseManagementSystem.Services.Interfaces.ISettingsService SettingsService

@{
    ViewData["Title"] = "Edit Quote";

    var company = await SettingsService.GetAsync();

    var vatRate = (company.VatRatePercent / 100m)
        .ToString(System.Globalization.CultureInfo.InvariantCulture);
}

<div class="content-card quotes-page">

    <div class="quotes-page-header">

        <div>
            <h2 class="quotes-page-title">Edit Quote</h2>
            <p class="quotes-page-subtitle">
                Update quote details, products and pricing.
            </p>
        </div>

        <div class="quotes-details-card" style="height:auto;min-width:180px;">
            <div class="quotes-detail-label">Quote Number</div>
            <div class="quotes-detail-value">@Model.QuoteNumber</div>
        </div>

    </div>

    <form asp-controller="Quotes"
          asp-action="Edit"
          asp-route-id="@Model.QuoteId"
          method="post"
          id="editQuoteForm">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="QuoteId" />
        <input type="hidden" asp-for="QuoteNumber" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="quotes-form-section">

            <h5 class="quotes-section-title">
                <i class="bi bi-file-earmark-text me-2"></i>
                Quote Information
            </h5>

            <p class="quotes-section-subtitle">
                Update the customer and quotation details.
            </p>

            <div class="row g-3">

                <div class="col-lg-4 col-md-6">
                    <label asp-for="QuoteDate" class="form-label">
                        Quote Date
                    </label>

                    <input asp-for="QuoteDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="QuoteDate"
                          class="text-danger small"></span>
                </div>

                <div class="col-lg-8 col-md-6">
                    <label asp-for="CustomerId" class="form-label">
                        Customer
                    </label>

                    <select asp-for="CustomerId"
                            class="form-select"
                            id="customerSelect">

                        <option value="">Select Customer</option>

                        @foreach (var customer in
                            (List<FMCGEnterpriseManagementSystem.Models.Customer>)ViewBag.CustomerList)
                        {
                            <option value="@customer.CustomerId"
                                    data-payment-terms="@customer.PaymentTerms"
                                    data-sales-rep-id="@customer.SalesRepresentativeId"
                                    data-billing-address="@customer.PhysicalAddress">
                                @customer.Name @customer.Surname
                            </option>
                        }

                    </select>

                    <span asp-validation-for="CustomerId"
                          class="text-danger small"></span>
                </div>

                <div class="col-lg-6">
                    <label asp-for="BillingAddress" class="form-label">
                        Billing Address
                    </label>

                    <textarea asp-for="BillingAddress"
                              class="form-control"
                              rows="3"
                              readonly></textarea>

                    <span asp-validation-for="BillingAddress"
                          class="text-danger small"></span>
                </div>

                <div class="col-lg-3 col-md-6">
                    <label asp-for="PaymentTerms" class="form-label">
                        Payment Terms
                    </label>

                    <select asp-for="PaymentTerms"
                            asp-items="ViewBag.PaymentTermsList"
                            class="form-select"
                            id="paymentTermsSelect">
                        <option value="">Select Terms</option>
                    </select>

                    <span asp-validation-for="PaymentTerms"
                          class="text-danger small"></span>
                </div>

                <div class="col-lg-3 col-md-6">
                    <label asp-for="SalesRepresentativeId" class="form-label">
                        Sales Person
                    </label>

                    <select asp-for="SalesRepresentativeId"
                            asp-items="ViewBag.SalesRepList"
                            class="form-select"
                            id="salesRepSelect">
                        <option value="">Unassigned</option>
                    </select>

                    <span asp-validation-for="SalesRepresentativeId"
                          class="text-danger small"></span>
                </div>

            </div>

        </div>

        <div class="mb-3">
            <h5 class="quotes-section-title">
                <i class="bi bi-box-seam me-2"></i>
                Quote Items
            </h5>

            <p class="quotes-section-subtitle mb-0">
                Update products, quantities, discounts and VAT.
            </p>
        </div>

        <div class="quotes-items-container mb-3">

            <table class="quotes-items-table">

                <thead>
                    <tr>
                        <th>Qty</th>
                        <th>Product Code</th>
                        <th>Product</th>
                        <th>Description</th>
                        <th class="text-end">Unit Price</th>
                        <th>Disc %</th>
                        <th>VAT</th>
                        <th class="text-end">Excl. VAT</th>
                        <th class="text-end">Total</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>

                <tbody id="quoteItemsBody">

                    @{
                        int i = 0;
                    }

                    @foreach (var item in Model.QuoteItems)
                    {
                        <tr class="quote-item-row">

                            <td style="width:75px;">
                                <input type="number"
                                       name="QuoteItems[@i].Quantity"
                                       class="form-control form-control-sm text-center quantity-field"
                                       value="@item.Quantity"
                                       min="1" />
                            </td>

                            <td style="width:110px;">
                                <input type="text"
                                       class="form-control form-control-sm product-code-field"
                                       value="@item.Product?.ProductCode"
                                       readonly />
                            </td>

                            <td style="min-width:160px;">
                                <select name="QuoteItems[@i].ProductId"
                                        class="form-select form-select-sm product-select">

                                    <option value="">Select Product</option>

                                    @foreach (var product in
                                        (List<FMCGEnterpriseManagementSystem.Models.Product>)ViewBag.ProductList)
                                    {
                                        <option value="@product.ProductId"
                                                data-code="@product.ProductCode"
                                                data-price="@product.SellingPrice"
                                                data-description="@product.Description"
                                                selected="@(product.ProductId == item.ProductId)">
                                            @product.ProductName
                                        </option>
                                    }

                                </select>
                            </td>

                            <td style="min-width:150px;">
                                <input type="text"
                                       class="form-control form-control-sm description-field"
                                       value="@item.Product?.Description"
                                       readonly />
                            </td>

                            <td style="width:110px;">
                                <input type="text"
                                       class="form-control form-control-sm text-end price-field"
                                       value="R@(item.UnitPrice.ToString("N2"))"
                                       readonly />

                                <input type="hidden"
                                       name="QuoteItems[@i].UnitPrice"
                                       class="price-hidden"
                                       value="@item.UnitPrice" />
                            </td>

                            <td style="width:95px;">
                                <div class="input-group input-group-sm">
                                    <input type="number"
                                           name="QuoteItems[@i].DiscountPercent"
                                           class="form-control text-center discount-field"
                                           value="@item.DiscountPercent.ToString("0.##")"
                                           min="0"
                                           max="100"
                                           step="1" />
                                    <span class="input-group-text">%</span>
                                </div>
                            </td>

                            <td style="width:115px;">
                                <select name="QuoteItems[@i].VatCategory"
                                        class="form-select form-select-sm vat-field">

                                    <option value="[NONE]"
                                            selected="@(item.VatCategory == "[NONE]")">
                                        None
                                    </option>

                                    <option value="STANDARD"
                                            selected="@(item.VatCategory == "STANDARD")">
                                        Standard
                                    </option>

                                </select>
                            </td>

                            <td style="width:110px;">
                                <input type="text"
                                       class="form-control form-control-sm text-end line-total-excl-vat-field"
                                       value="R@(item.LineTotalExclVat.ToString("N2"))"
                                       readonly />
                            </td>

                            <td style="width:110px;">
                                <input type="text"
                                       class="form-control form-control-sm text-end line-total-field"
                                       value="R@(item.LineTotal.ToString("N2"))"
                                       readonly />
                            </td>

                            <td style="width:90px;" class="text-center">
                                <button type="button"
                                        class="quotes-btn-danger remove-item-btn">
                                    <i class="bi bi-trash"></i>
                                    Remove
                                </button>
                            </td>

                        </tr>

                        i++;
                    }

                </tbody>

            </table>
        </div>

        <button type="button"
                id="addItemBtn"
                class="quotes-btn-outline mb-4">
            <i class="bi bi-plus-lg"></i>
            Add Item
        </button>

        <div class="row justify-content-end mb-4">
            <div class="col-md-5 col-lg-4">

                <div class="quotes-totals-card">

                    <div class="quotes-totals-row">
                        <span>Subtotal</span>
                        <strong id="subtotalAmount">
                            R@(Model.Subtotal.ToString("N2"))
                        </strong>
                    </div>

                    <div class="quotes-totals-row">
                        <span>VAT</span>
                        <strong id="vatAmount">
                            R@((Model.Total - Model.Subtotal).ToString("N2"))
                        </strong>
                    </div>

                    <div class="quotes-totals-row quotes-totals-final">
                        <span>Total</span>
                        <strong id="totalAmount">
                            R@(Model.Total.ToString("N2"))
                        </strong>
                    </div>

                </div>

            </div>
        </div>

        <div class="quotes-form-actions">

            <a asp-controller="Quotes"
               asp-action="Index"
               class="quotes-btn-outline">
                Cancel
            </a>

            <button type="submit"
                    class="quotes-btn-primary">
                <i class="bi bi-check-lg"></i>
                Save Changes
            </button>

        </div>

    </form>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        // VAT rate is loaded from the same Settings service as Create Quote.
        const VAT_RATE = @vatRate;

        const quoteItemsBody = document.getElementById('quoteItemsBody');
        const customerSelect = document.getElementById('customerSelect');
        const paymentTermsSelect = document.getElementById('paymentTermsSelect');
        const salesRepSelect = document.getElementById('salesRepSelect');
        const editQuoteForm = document.getElementById('editQuoteForm');

        customerSelect.addEventListener('change', function () {

            const selectedOption = this.options[this.selectedIndex];

            paymentTermsSelect.value =
                selectedOption.getAttribute('data-payment-terms') || '';

            salesRepSelect.value =
                selectedOption.getAttribute('data-sales-rep-id') || '';

            document.getElementById('BillingAddress').value =
                selectedOption.getAttribute('data-billing-address') || '';
        });

        // Create an empty quotation row while retaining available products.
        function createBlankItemRow() {

            const row = document.createElement('tr');
            row.className = 'quote-item-row';

            row.innerHTML = `
                <td style="width:75px;">
                    <input type="number"
                           class="form-control form-control-sm text-center quantity-field"
                           value="1" min="1" />
                </td>

                <td style="width:110px;">
                    <input type="text"
                           class="form-control form-control-sm product-code-field"
                           readonly />
                </td>

                <td style="min-width:160px;">
                    <select class="form-select form-select-sm product-select">
                        <option value="">Select Product</option>

                        @foreach (var product in
                            (List<FMCGEnterpriseManagementSystem.Models.Product>)ViewBag.ProductList)
                        {
                            <option value="@product.ProductId"
                                    data-code="@product.ProductCode"
                                    data-price="@product.SellingPrice"
                                    data-description="@product.Description">
                                @product.ProductName
                            </option>
                        }
                    </select>
                </td>

                <td style="min-width:150px;">
                    <input type="text"
                           class="form-control form-control-sm description-field"
                           readonly />
                </td>

                <td style="width:110px;">
                    <input type="text"
                           class="form-control form-control-sm text-end price-field"
                           value="R0.00" readonly />

                    <input type="hidden"
                           class="price-hidden"
                           value="0.00" />
                </td>

                <td style="width:95px;">
                    <input type="number"
                           class="form-control form-control-sm text-center discount-field"
                           value="0" min="0" max="100" step="1" />
                </td>

                <td style="width:115px;">
                    <select class="form-select form-select-sm vat-field">
                        <option value="[NONE]">None</option>
                        <option value="STANDARD">Standard</option>
                    </select>
                </td>

                <td style="width:110px;">
                    <input type="text"
                           class="form-control form-control-sm text-end line-total-excl-vat-field"
                           value="R0.00" readonly />
                </td>

                <td style="width:110px;">
                    <input type="text"
                           class="form-control form-control-sm text-end line-total-field"
                           value="R0.00" readonly />
                </td>

                <td style="width:90px;" class="text-center">
                    <button type="button"
                            class="quotes-btn-danger remove-item-btn">
                        <i class="bi bi-trash"></i>
                        Remove
                    </button>
                </td>
            `;

            return row;
        }

        // Maintain consecutive indexes required by ASP.NET Core model binding.
        function reindexRows() {

            const rows = quoteItemsBody.querySelectorAll('.quote-item-row');

            rows.forEach(function (row, index) {

                row.querySelector('.quantity-field').name =
                    `QuoteItems[${index}].Quantity`;

                row.querySelector('.product-select').name =
                    `QuoteItems[${index}].ProductId`;

                row.querySelector('.price-hidden').name =
                    `QuoteItems[${index}].UnitPrice`;

                row.querySelector('.discount-field').name =
                    `QuoteItems[${index}].DiscountPercent`;

                row.querySelector('.vat-field').name =
                    `QuoteItems[${index}].VatCategory`;
            });
        }

        document.getElementById('addItemBtn')
            .addEventListener('click', function () {

                const newRow = createBlankItemRow();
                quoteItemsBody.appendChild(newRow);

                reindexRows();
                calculateGrandTotals();
            });

        quoteItemsBody.addEventListener('click', function (e) {

            const removeButton = e.target.closest('.remove-item-btn');

            if (!removeButton) return;

            const rows = quoteItemsBody.querySelectorAll('.quote-item-row');

            if (rows.length <= 1) {
                alert('A quote must contain at least one item.');
                return;
            }

            removeButton.closest('.quote-item-row').remove();

            reindexRows();
            calculateGrandTotals();
        });

        quoteItemsBody.addEventListener('change', function (e) {

            if (!e.target.classList.contains('product-select')) return;

            const row = e.target.closest('.quote-item-row');
            const selectedOption = e.target.options[e.target.selectedIndex];

            const code = selectedOption.getAttribute('data-code') || '';
            const price = selectedOption.getAttribute('data-price') || '0';
            const description =
                selectedOption.getAttribute('data-description') || '';

            const numericPrice = parseFloat(price) || 0;

            row.querySelector('.product-code-field').value = code;
            row.querySelector('.description-field').value = description;
            row.querySelector('.price-field').value =
                'R' + numericPrice.toFixed(2);

            row.querySelector('.price-hidden').value =
                numericPrice.toFixed(2);

            calculateRow(row);
        });

        function calculateRow(row) {

            const quantity =
                parseFloat(row.querySelector('.quantity-field').value) || 0;

            const unitPrice =
                parseFloat(row.querySelector('.price-hidden').value) || 0;

            const discountPercent =
                parseFloat(row.querySelector('.discount-field').value) || 0;

            const vatCategory =
                row.querySelector('.vat-field').value;

            const beforeDiscount = quantity * unitPrice;
            const discountAmount = beforeDiscount * (discountPercent / 100);
            const exclVat = beforeDiscount - discountAmount;

            const vat = vatCategory === 'STANDARD'
                ? exclVat * VAT_RATE
                : 0;

            const total = exclVat + vat;

            row.querySelector('.line-total-excl-vat-field').value =
                'R' + exclVat.toFixed(2);

            row.querySelector('.line-total-field').value =
                'R' + total.toFixed(2);

            calculateGrandTotals();
        }

        function calculateGrandTotals() {

            let subtotal = 0;
            let total = 0;

            quoteItemsBody.querySelectorAll('.quote-item-row')
                .forEach(function (row) {

                    const excl = parseFloat(
                        row.querySelector('.line-total-excl-vat-field')
                            .value.replace('R', '').replace(/,/g, '')
                    ) || 0;

                    const lineTotal = parseFloat(
                        row.querySelector('.line-total-field')
                            .value.replace('R', '').replace(/,/g, '')
                    ) || 0;

                    subtotal += excl;
                    total += lineTotal;
                });

            const vat = total - subtotal;

            document.getElementById('subtotalAmount').textContent =
                'R' + subtotal.toFixed(2);

            document.getElementById('vatAmount').textContent =
                'R' + vat.toFixed(2);

            document.getElementById('totalAmount').textContent =
                'R' + total.toFixed(2);
        }

        quoteItemsBody.addEventListener('input', function (e) {

            if (
                e.target.classList.contains('quantity-field') ||
                e.target.classList.contains('discount-field')
            ) {
                calculateRow(e.target.closest('.quote-item-row'));
            }
        });

        quoteItemsBody.addEventListener('change', function (e) {

            if (e.target.classList.contains('vat-field')) {
                calculateRow(e.target.closest('.quote-item-row'));
            }
        });

        editQuoteForm.addEventListener('submit', function () {
            reindexRows();
        });

        // Ensure existing quotation items have correct model-binding indexes.
        reindexRows();
    </script>
}