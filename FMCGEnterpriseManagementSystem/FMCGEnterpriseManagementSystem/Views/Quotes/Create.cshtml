@*
    Purpose: Form to add a new quote.
    Authors: Naseeha27, Sayali-St10458649, ST10068525 (from git history)
*@
@model FMCGEnterpriseManagementSystem.ViewModels.QuoteViewModel
@inject FMCGEnterpriseManagementSystem.Services.Interfaces.ISettingsService SettingsService
@{
    ViewData["Title"] = "New Quote";
    var company = await SettingsService.GetAsync();
    var vatRate = (company.VatRatePercent / 100m).ToString(System.Globalization.CultureInfo.InvariantCulture);
}

<div class="content-card">
    <form asp-controller="Quotes" asp-action="Create" method="post" data-line-items-form data-vat-rate="@vatRate" data-default-terms="@company.DefaultPaymentTerms" novalidate>

        <div class="row align-items-center mb-4 g-3">
            <div class="col-12 col-sm-6 text-center text-sm-start">
                <partial name="_CompanyHeader" model="company" />
            </div>
            <div class="col-12 col-sm-6 text-center text-sm-end">
                <div class="d-inline-block text-start w-100" style="max-width: 280px;">
                    <div class="d-flex align-items-center justify-content-between gap-2 mb-1">
                        <label asp-for="QuoteDate" class="small text-secondary fw-bold text-nowrap m-0">Date:</label>
                        <input asp-for="QuoteDate" type="date" class="form-control form-control-sm" style="width:160px;">
                    </div>
                    <span asp-validation-for="QuoteDate" class="text-danger small d-block mb-1"></span>
                    <div class="d-flex align-items-center justify-content-between gap-2">
                        <label class="small text-secondary fw-bold text-nowrap m-0">Quote Number:</label>
                        <input type="text" class="form-control form-control-sm text-center fw-bold" value="Auto-generated" readonly style="width:160px;">
                    </div>
                </div>
            </div>
        </div>

        <h2 class="fw-bold mb-4 text-center text-sm-start" style="color: #1c323d;">New Quote</h2>

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="row align-items-start mb-3 g-2">
                    <label asp-for="CustomerId" class="col-12 col-sm-3 col-form-label fw-bold text-secondary">Customer</label>
                    <div class="col-12 col-sm-9">
                        <select asp-for="CustomerId" id="customerSelect" class="form-select">
                            <option value="">-- Select Customer --</option>
                            @foreach (var customer in Model.AvailableCustomers)
                            {
                                <option value="@customer.CustomerId"
                                        selected="@(customer.CustomerId == Model.CustomerId)"
                                        data-address="@customer.DeliveryAddress"
                                        data-terms="@customer.PaymentTerms"
                                        data-salesrep="@customer.SalesRepresentativeId"
                                        data-salesrepname="@(customer.SalesRepresentative?.Employee != null ? $"{customer.SalesRepresentative.Employee.FirstName} {customer.SalesRepresentative.Employee.LastName}" : "")">
                                    @customer.Name @customer.Surname
                                </option>
                            }
                        </select>
                        <span asp-validation-for="CustomerId" class="text-danger small"></span>
                    </div>
                </div>
                <div class="row align-items-start g-2">
                    <label asp-for="BillingAddress" class="col-12 col-sm-3 col-form-label fw-bold text-secondary">Billing Address:</label>
                    <div class="col-12 col-sm-9">
                        <textarea asp-for="BillingAddress" id="billingAddress" class="form-control bg-white shadow-sm" rows="3" readonly></textarea>
                        <span asp-validation-for="BillingAddress" class="text-danger small"></span>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row align-items-start mb-3 g-2">
                    <label asp-for="PaymentTerms" class="col-12 col-sm-4 col-form-label fw-bold text-secondary text-sm-end">Payment Terms:</label>
                    <div class="col-12 col-sm-8">
                        <input asp-for="PaymentTerms" id="paymentTerms" class="form-control" readonly />
                        <span asp-validation-for="PaymentTerms" class="text-danger small"></span>
                    </div>
                </div>
                <div class="row align-items-start g-2">
                    <label class="col-12 col-sm-4 col-form-label fw-bold text-secondary text-sm-end">Sales Person:</label>
                    <div class="col-12 col-sm-8">
                        <input asp-for="SalesRepresentativeName" id="salesRepName" class="form-control" readonly />
                        <input type="hidden" asp-for="SalesRepresentativeId" id="salesRepId" />
                    </div>
                </div>
            </div>
        </div>

        <partial name="_LineItemsEditor"
                 model="@(new FMCGEnterpriseManagementSystem.ViewModels.LineItemsEditorViewModel { Products = Model.AvailableProducts, Items = Model.Items })" />

        <div class="row justify-content-between g-3 mb-4">
            <div class="col-12 col-md-6 small text-muted">
                <i class="bi bi-clock me-1"></i>
                This quote is valid for <strong>@company.QuoteValidityDays days</strong>
                (until @Model.QuoteDate.AddDays(company.QuoteValidityDays).ToString("dd MMM yyyy")).
            </div>
            <div class="col-12 col-md-4 border-top pt-2 text-end fw-bold text-secondary">
                <div class="d-flex justify-content-between py-1"><span>Subtotal (excl. VAT)</span><span id="subtotalDisplay">R0.00</span></div>
                <div class="d-flex justify-content-between py-1"><span>VAT (@company.VatRatePercent.ToString("0.##")%)</span><span id="vatDisplay">R0.00</span></div>
                <div class="d-flex justify-content-between py-1 border-top border-dark mt-2 text-dark fs-5"><span>Total</span><span id="totalDisplay">R0.00</span></div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 gap-sm-3">
            <a asp-controller="Quotes" asp-action="Index" class="btn btn-link text-decoration-none text-secondary align-self-center">Cancel</a>
            <button type="submit" class="btn btn-custom-save">Create Quote</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/line-items.js" asp-append-version="true"></script>
}
