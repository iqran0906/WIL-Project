@model FMCGEnterpriseManagementSystem.Models.Quote

@using Microsoft.AspNetCore.Mvc.Rendering
@inject FMCGEnterpriseManagementSystem.Services.Interfaces.ISettingsService SettingsService

@{
    ViewData["Title"] = "New Quote";

    var company = await SettingsService.GetAsync();

    var vatRate =
        (company.VatRatePercent / 100m)
        .ToString(System.Globalization.CultureInfo.InvariantCulture);
}


<div class="content-card">

    <!-- =========================================
         PAGE HEADER
         ========================================= -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">

        <div>

            <h2 class="fw-bold mb-1"
                style="color:#1c323d;">
                New Quote
            </h2>

            <p class="text-muted mb-0">
                Create a customer quotation with products, pricing and payment details.
            </p>

        </div>


        <div class="text-md-end">

            <span class="text-muted small d-block">
                Quote Number
            </span>

            <span class="fw-semibold">
                Generated on save
            </span>

        </div>

    </div>


    <!-- =========================================
         FORM
         ========================================= -->
    <form asp-controller="Quotes"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()


        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger mb-4"
             role="alert">
        </div>


        <!-- =====================================
             QUOTE INFORMATION
             ===================================== -->
        <div class="border rounded-3 p-3 p-md-4 mb-4">

            <h5 class="fw-bold mb-3"
                style="color:#1c323d;">
                Quote Information
            </h5>


            <div class="row g-3">

                <!-- DATE -->
                <div class="col-lg-4 col-md-6">

                    <label asp-for="QuoteDate"
                           class="form-label fw-semibold">
                        Quote Date
                    </label>

                    <input asp-for="QuoteDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="QuoteDate"
                          class="text-danger small">
                    </span>

                </div>


                <!-- CUSTOMER -->
                <div class="col-lg-8 col-md-6">

                    <label asp-for="CustomerId"
                           class="form-label fw-semibold">
                        Customer
                    </label>

                    <select asp-for="CustomerId"
                            class="form-select"
                            id="customerSelect">

                        <option value="">
                            Select Customer
                        </option>

                        @foreach (var customer in
                            (List<FMCGEnterpriseManagementSystem.Models.Customer>)ViewBag.CustomerList)
                        {
                            <option value="@customer.CustomerId"
                                    data-payment-terms="@customer.PaymentTerms"
                                    data-sales-rep-id="@customer.SalesRepresentativeId"
                                    data-billing-address="@customer.PhysicalAddress">

                                @customer.Name @customer.Surname

                            </option>
                        }

                    </select>

                    <span asp-validation-for="CustomerId"
                          class="text-danger small">
                    </span>

                </div>


                <!-- BILLING ADDRESS -->
                <div class="col-lg-6">

                    <label asp-for="BillingAddress"
                           class="form-label fw-semibold">
                        Billing Address
                    </label>

                    <textarea asp-for="BillingAddress"
                              class="form-control"
                              rows="3"
                              readonly>
                    </textarea>

                    <span asp-validation-for="BillingAddress"
                          class="text-danger small">
                    </span>

                </div>


                <!-- PAYMENT TERMS -->
                <div class="col-lg-3 col-md-6">

                    <label asp-for="PaymentTerms"
                           class="form-label fw-semibold">
                        Payment Terms
                    </label>

                    <select asp-for="PaymentTerms"
                            asp-items="ViewBag.PaymentTermsList"
                            class="form-select"
                            id="paymentTermsSelect">

                        <option value="">
                            Select Terms
                        </option>

                    </select>

                    <span asp-validation-for="PaymentTerms"
                          class="text-danger small">
                    </span>

                </div>


                <!-- SALES PERSON -->
                <div class="col-lg-3 col-md-6">

                    <label asp-for="SalesRepresentativeId"
                           class="form-label fw-semibold">
                        Sales Person
                    </label>

                    <select asp-for="SalesRepresentativeId"
                            asp-items="ViewBag.SalesRepList"
                            class="form-select"
                            id="salesRepSelect">

                        <option value="">
                            Unassigned
                        </option>

                    </select>

                    <span asp-validation-for="SalesRepresentativeId"
                          class="text-danger small">
                    </span>

                </div>

            </div>

        </div>


        <!-- =====================================
             QUOTE ITEMS
             ===================================== -->
        <div class="mb-3">

            <h5 class="fw-bold mb-1"
                style="color:#1c323d;">
                Quote Items
            </h5>

            <p class="text-muted small mb-0">
                Add products, quantities, discounts and VAT.
            </p>

        </div>


        <!-- =====================================
             ITEMS TABLE
             ===================================== -->
        <div class="table-responsive border rounded-3 mb-3">

            <table class="table align-middle mb-0"
                   style="min-width:1100px;">

                <thead class="table-light">

                    <tr>
                        <th>Qty</th>
                        <th>Product Code</th>
                        <th>Product</th>
                        <th>Description</th>
                        <th class="text-end">Unit Price</th>
                        <th>Disc %</th>
                        <th>VAT</th>
                        <th class="text-end">Excl. VAT</th>
                        <th class="text-end">Total</th>
                    </tr>

                </thead>


                <tbody id="quoteItemsBody">

                    <tr class="quote-item-row">

                        <!-- QUANTITY -->
                        <td style="width:80px;">

                            <input type="number"
                                   name="QuoteItems[0].Quantity"
                                   class="form-control form-control-sm text-center"
                                   value="1"
                                   min="1" />

                        </td>


                        <!-- PRODUCT CODE -->
                        <td style="width:120px;">

                            <input type="text"
                                   class="form-control form-control-sm product-code-field"
                                   readonly />

                        </td>


                        <!-- PRODUCT -->
                        <td style="min-width:180px;">

                            <select name="QuoteItems[0].ProductId"
                                    class="form-select form-select-sm product-select">

                                <option value="">
                                    Select Product
                                </option>

                                @foreach (var product in
                                    (List<FMCGEnterpriseManagementSystem.Models.Product>)ViewBag.ProductList)
                                {
                                    <option value="@product.ProductId"
                                            data-code="@product.ProductCode"
                                            data-price="@product.SellingPrice"
                                            data-description="@product.Description">

                                        @product.ProductName

                                    </option>
                                }

                            </select>

                        </td>


                        <!-- DESCRIPTION -->
                        <td style="min-width:180px;">

                            <input type="text"
                                   class="form-control form-control-sm description-field"
                                   readonly />

                        </td>


                        <!-- UNIT PRICE -->
                        <td style="width:120px;">

                            <input type="text"
                                   class="form-control form-control-sm text-end price-field"
                                   value="R0.00"
                                   readonly />

                            <input type="hidden"
                                   name="QuoteItems[0].UnitPrice"
                                   class="price-hidden"
                                   value="0.00" />

                        </td>


                        <!-- DISCOUNT -->
                        <td style="width:90px;">

                            <input type="number"
                                   name="QuoteItems[0].DiscountPercent"
                                   class="form-control form-control-sm text-center"
                                   value="0"
                                   min="0"
                                   max="100"
                                   step="1" />

                        </td>


                        <!-- VAT -->
                        <td style="width:120px;">

                            <select name="QuoteItems[0].VatCategory"
                                    class="form-select form-select-sm">

                                <option value="[NONE]">
                                    None
                                </option>

                                <option value="STANDARD">
                                    Standard
                                </option>

                            </select>

                        </td>


                        <!-- EX VAT -->
                        <td style="width:120px;">

                            <input type="text"
                                   class="form-control form-control-sm text-end line-total-excl-vat-field"
                                   value="R0.00"
                                   readonly />

                        </td>


                        <!-- TOTAL -->
                        <td style="width:120px;">

                            <input type="text"
                                   class="form-control form-control-sm text-end line-total-field"
                                   value="R0.00"
                                   readonly />

                        </td>

                    </tr>

                </tbody>

            </table>

        </div>


        <!-- ADD ITEM -->
        <div class="mb-4">

            <button type="button"
                    id="addItemBtn"
                    class="btn btn-outline-secondary btn-sm">

                <i class="bi bi-plus-lg me-1"></i>
                Add Item

            </button>

        </div>


        <!-- =====================================
             TOTALS
             ===================================== -->
        <div class="row justify-content-end mb-4">

            <div class="col-lg-4 col-md-5">

                <div class="border rounded-3 p-3 bg-light">

                    <div class="d-flex justify-content-between mb-2">

                        <span class="text-muted">
                            Subtotal
                        </span>

                        <strong id="subtotalAmount">
                            R0.00
                        </strong>

                    </div>


                    <div class="d-flex justify-content-between mb-2">

                        <span class="text-muted">
                            VAT
                        </span>

                        <strong id="vatAmount">
                            R0.00
                        </strong>

                    </div>


                    <hr />


                    <div class="d-flex justify-content-between fs-5">

                        <strong>
                            Total
                        </strong>

                        <strong id="totalAmount">
                            R0.00
                        </strong>

                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================
             ACTION BUTTONS
             ===================================== -->
        <div class="d-flex justify-content-end align-items-center gap-3">

            <a asp-controller="Quotes"
               asp-action="Index"
               class="btn btn-link text-decoration-none text-secondary">

                Cancel

            </a>


            <button type="submit"
                    class="btn btn-custom-save">

                <i class="bi bi-check-lg me-1"></i>
                Create Quote

            </button>

        </div>

    </form>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        let quoteItemIndex = 1;

        // Uses the VAT percentage configured in Settings.
        const VAT_RATE = @vatRate;


        const customerSelect =
            document.getElementById('customerSelect');

        const paymentTermsSelect =
            document.getElementById('paymentTermsSelect');

        const salesRepSelect =
            document.getElementById('salesRepSelect');

        const quoteItemsBody =
            document.getElementById('quoteItemsBody');


        // ==================================================
        // CUSTOMER CHANGE
        // ==================================================

        customerSelect.addEventListener(
            'change',
            function () {

                const selectedOption =
                    this.options[this.selectedIndex];


                const paymentTerms =
                    selectedOption.getAttribute(
                        'data-payment-terms'
                    ) || '';


                const salesRepId =
                    selectedOption.getAttribute(
                        'data-sales-rep-id'
                    ) || '';


                const billingAddress =
                    selectedOption.getAttribute(
                        'data-billing-address'
                    ) || '';


                paymentTermsSelect.value =
                    paymentTerms;

                salesRepSelect.value =
                    salesRepId;

                document.getElementById(
                    'BillingAddress'
                ).value =
                    billingAddress;
            }
        );


        // ==================================================
        // ADD ITEM
        // ==================================================

        document.getElementById('addItemBtn')
            .addEventListener(
                'click',
                function () {

                    const sourceRow =
                        quoteItemsBody.querySelector(
                            '.quote-item-row'
                        );


                    if (!sourceRow) {
                        return;
                    }


                    const newRow =
                        sourceRow.cloneNode(true);


                    newRow
                        .querySelectorAll('input, select')
                        .forEach(function (field) {

                            if (field.name) {

                                field.name =
                                    field.name.replace(
                                        /QuoteItems\[\d+\]/,
                                        `QuoteItems[${quoteItemIndex}]`
                                    );
                            }


                            if (
                                field.classList.contains(
                                    'product-select'
                                )
                            ) {
                                field.selectedIndex = 0;
                            }

                            else if (
                                field.classList.contains(
                                    'product-code-field'
                                )
                            ) {
                                field.value = '';
                            }

                            else if (
                                field.classList.contains(
                                    'description-field'
                                )
                            ) {
                                field.value = '';
                            }

                            else if (
                                field.classList.contains(
                                    'price-field'
                                )
                            ) {
                                field.value = 'R0.00';
                            }

                            else if (
                                field.classList.contains(
                                    'price-hidden'
                                )
                            ) {
                                field.value = '0.00';
                            }

                            else if (
                                field.classList.contains(
                                    'line-total-excl-vat-field'
                                )
                            ) {
                                field.value = 'R0.00';
                            }

                            else if (
                                field.classList.contains(
                                    'line-total-field'
                                )
                            ) {
                                field.value = 'R0.00';
                            }

                            else if (
                                field.name?.endsWith(
                                    '.Quantity'
                                )
                            ) {
                                field.value = '1';
                            }

                            else if (
                                field.name?.endsWith(
                                    '.DiscountPercent'
                                )
                            ) {
                                field.value = '0';
                            }

                            else if (
                                field.name?.endsWith(
                                    '.VatCategory'
                                )
                            ) {
                                field.value = '[NONE]';
                            }

                        });


                    quoteItemsBody.appendChild(
                        newRow
                    );

                    quoteItemIndex++;
                }
            );


        // ==================================================
        // PRODUCT CHANGE
        // ==================================================

        quoteItemsBody.addEventListener(
            'change',
            function (e) {

                if (
                    e.target.classList.contains(
                        'product-select'
                    )
                ) {

                    const row =
                        e.target.closest('tr');


                    const selectedOption =
                        e.target.options[
                            e.target.selectedIndex
                        ];


                    const code =
                        selectedOption.getAttribute(
                            'data-code'
                        ) || '';


                    const price =
                        selectedOption.getAttribute(
                            'data-price'
                        ) || '0';


                    const description =
                        selectedOption.getAttribute(
                            'data-description'
                        ) || '';


                    row.querySelector(
                        '.product-code-field'
                    ).value =
                        code;


                    row.querySelector(
                        '.description-field'
                    ).value =
                        description;


                    row.querySelector(
                        '.price-field'
                    ).value =
                        'R' +
                        parseFloat(price).toFixed(2);


                    row.querySelector(
                        '.price-hidden'
                    ).value =
                        parseFloat(price).toFixed(2);


                    calculateRow(row);
                }

            }
        );


        // ==================================================
        // CALCULATE ONE ROW
        // ==================================================

        function calculateRow(row) {

            const quantity =
                parseFloat(
                    row.querySelector(
                        'input[name$=".Quantity"]'
                    ).value
                ) || 0;


            const priceText =
                row.querySelector(
                    '.price-field'
                )
                .value
                .replace('R', '')
                .replace(/,/g, '');


            const unitPrice =
                parseFloat(priceText) || 0;


            const discountPercent =
                parseFloat(
                    row.querySelector(
                        'input[name$=".DiscountPercent"]'
                    ).value
                ) || 0;


            const vatCategory =
                row.querySelector(
                    'select[name$=".VatCategory"]'
                ).value;


            const beforeDiscount =
                quantity * unitPrice;


            const discountAmount =
                beforeDiscount *
                (discountPercent / 100);


            const exclVat =
                beforeDiscount -
                discountAmount;


            const vat =
                vatCategory === 'STANDARD'
                    ? exclVat * VAT_RATE
                    : 0;


            const total =
                exclVat + vat;


            row.querySelector(
                '.line-total-excl-vat-field'
            ).value =
                'R' + exclVat.toFixed(2);


            row.querySelector(
                '.line-total-field'
            ).value =
                'R' + total.toFixed(2);


            calculateGrandTotals();
        }


        // ==================================================
        // CALCULATE GRAND TOTALS
        // ==================================================

        function calculateGrandTotals() {

            let subtotal = 0;
            let total = 0;


            document
                .querySelectorAll(
                    '.quote-item-row'
                )
                .forEach(function (row) {

                    const excl =
                        parseFloat(
                            row.querySelector(
                                '.line-total-excl-vat-field'
                            )
                            .value
                            .replace('R', '')
                            .replace(/,/g, '')
                        ) || 0;


                    const lineTotal =
                        parseFloat(
                            row.querySelector(
                                '.line-total-field'
                            )
                            .value
                            .replace('R', '')
                            .replace(/,/g, '')
                        ) || 0;


                    subtotal += excl;
                    total += lineTotal;
                });


            const vat =
                total - subtotal;


            document.getElementById(
                'subtotalAmount'
            ).textContent =
                'R' + subtotal.toFixed(2);


            document.getElementById(
                'vatAmount'
            ).textContent =
                'R' + vat.toFixed(2);


            document.getElementById(
                'totalAmount'
            ).textContent =
                'R' + total.toFixed(2);
        }


        // ==================================================
        // QUANTITY / DISCOUNT CHANGE
        // ==================================================

        quoteItemsBody.addEventListener(
            'input',
            function (e) {

                if (
                    e.target.matches(
                        'input[name$=".Quantity"], input[name$=".DiscountPercent"]'
                    )
                ) {

                    calculateRow(
                        e.target.closest('tr')
                    );
                }

            }
        );


        // ==================================================
        // VAT CHANGE
        // ==================================================

        quoteItemsBody.addEventListener(
            'change',
            function (e) {

                if (
                    e.target.matches(
                        'select[name$=".VatCategory"]'
                    )
                ) {

                    calculateRow(
                        e.target.closest('tr')
                    );
                }

            }
        );

    </script>
}