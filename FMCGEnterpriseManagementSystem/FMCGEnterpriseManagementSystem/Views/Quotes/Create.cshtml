@*
    Purpose: Create customer quotations with dynamic products and VAT calculations.
    Original functionality: Existing Quotes module contributors (Git history).
    UI integration: Iqra Nazir (2026).


    References:
    Bootstrap (n.d.) Forms. https://getbootstrap.com/docs/5.3/forms/overview/
    Microsoft (n.d.) ASP.NET Core MVC model binding.
    https://learn.microsoft.com/en-us/aspnet/core/mvc/models/model-binding
    MDN Web Docs (n.d.) EventTarget.addEventListener().
    https://developer.mozilla.org/en-US/docs/Web/API/EventTarget/addEventListener
*@

@model FMCGEnterpriseManagementSystem.Models.Quote

@using Microsoft.AspNetCore.Mvc.Rendering
@inject FMCGEnterpriseManagementSystem.Services.Interfaces.ISettingsService SettingsService

@{
    ViewData["Title"] = "New Quote";

    var company = await SettingsService.GetAsync();

    var vatRate = (company.VatRatePercent / 100m)
        .ToString(System.Globalization.CultureInfo.InvariantCulture);
}

<div class="content-card quotes-page">

    <div class="quotes-page-header">

        <div>
            <h2 class="quotes-page-title">New Quote</h2>
            <p class="quotes-page-subtitle">
                Create a customer quotation with products, pricing and payment details.
            </p>
        </div>

        <div class="quotes-details-card" style="height:auto;min-width:180px;">
            <div class="quotes-detail-label">Quote Number</div>
            <div class="quotes-detail-value">Generated on save</div>
        </div>

    </div>

    <form asp-controller="Quotes"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <!-- QUOTE INFORMATION -->
        <div class="quotes-form-section">

            <h5 class="quotes-section-title">
                <i class="bi bi-file-earmark-text me-2"></i>
                Quote Information
            </h5>

            <p class="quotes-section-subtitle">
                Select the customer and confirm quotation details.
            </p>

            <div class="row g-3">

                <div class="col-lg-4 col-md-6">
                    <label asp-for="QuoteDate" class="form-label">
                        Quote Date
                    </label>

                    <input asp-for="QuoteDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="QuoteDate"
                          class="text-danger small"></span>
                </div>

                <div class="col-lg-8 col-md-6">
                    <label asp-for="CustomerId" class="form-label">
                        Customer
                    </label>

                    <select asp-for="CustomerId"
                            class="form-select"
                            id="customerSelect">

                        <option value="">Select Customer</option>

                        @foreach (var customer in
                            (List<FMCGEnterpriseManagementSystem.Models.Customer>)ViewBag.CustomerList)
                        {
                            <option value="@customer.CustomerId"
                                    data-payment-terms="@customer.PaymentTerms"
                                    data-sales-rep-id="@customer.SalesRepresentativeId"
                                    data-billing-address="@customer.PhysicalAddress">
                                @customer.Name @customer.Surname
                            </option>
                        }

                    </select>

                    <span asp-validation-for="CustomerId"
                          class="text-danger small"></span>
                </div>

                <div class="col-lg-6">
                    <label asp-for="BillingAddress" class="form-label">
                        Billing Address
                    </label>

                    <textarea asp-for="BillingAddress"
                              class="form-control"
                              rows="3"
                              readonly></textarea>

                    <span asp-validation-for="BillingAddress"
                          class="text-danger small"></span>
                </div>

                <div class="col-lg-3 col-md-6">
                    <label asp-for="PaymentTerms" class="form-label">
                        Payment Terms
                    </label>

                    <select asp-for="PaymentTerms"
                            asp-items="ViewBag.PaymentTermsList"
                            class="form-select"
                            id="paymentTermsSelect">

                        <option value="">Select Terms</option>
                    </select>

                    <span asp-validation-for="PaymentTerms"
                          class="text-danger small"></span>
                </div>

                <div class="col-lg-3 col-md-6">
                    <label asp-for="SalesRepresentativeId" class="form-label">
                        Sales Person
                    </label>

                    <select asp-for="SalesRepresentativeId"
                            asp-items="ViewBag.SalesRepList"
                            class="form-select"
                            id="salesRepSelect">

                        <option value="">Unassigned</option>
                    </select>

                    <span asp-validation-for="SalesRepresentativeId"
                          class="text-danger small"></span>
                </div>

            </div>

        </div>

        <!-- QUOTE ITEMS -->
        <div class="mb-3">
            <h5 class="quotes-section-title">
                <i class="bi bi-box-seam me-2"></i>
                Quote Items
            </h5>

            <p class="quotes-section-subtitle mb-0">
                Add products, quantities, discounts and VAT.
            </p>
        </div>

        <div class="quotes-items-container mb-3">

            <table class="quotes-items-table">

                <thead>
                    <tr>
                        <th>Qty</th>
                        <th>Product Code</th>
                        <th>Product</th>
                        <th>Description</th>
                        <th class="text-end">Unit Price</th>
                        <th>Disc %</th>
                        <th>VAT</th>
                        <th class="text-end">Excl. VAT</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>

                <tbody id="quoteItemsBody">

                    <tr class="quote-item-row">

                        <td style="width:80px;">
                            <input type="number"
                                   name="QuoteItems[0].Quantity"
                                   class="form-control form-control-sm text-center"
                                   value="1"
                                   min="1" />
                        </td>

                        <td style="width:120px;">
                            <input type="text"
                                   class="form-control form-control-sm product-code-field"
                                   readonly />
                        </td>

                        <td style="min-width:180px;">
                            <select name="QuoteItems[0].ProductId"
                                    class="form-select form-select-sm product-select">

                                <option value="">Select Product</option>

                                @foreach (var product in
                                    (List<FMCGEnterpriseManagementSystem.Models.Product>)ViewBag.ProductList)
                                {
                                    <option value="@product.ProductId"
                                            data-code="@product.ProductCode"
                                            data-price="@product.SellingPrice"
                                            data-description="@product.Description">
                                        @product.ProductName
                                    </option>
                                }
                            </select>
                        </td>

                        <td style="min-width:180px;">
                            <input type="text"
                                   class="form-control form-control-sm description-field"
                                   readonly />
                        </td>

                        <td style="width:120px;">
                            <input type="text"
                                   class="form-control form-control-sm text-end price-field"
                                   value="R0.00"
                                   readonly />

                            <input type="hidden"
                                   name="QuoteItems[0].UnitPrice"
                                   class="price-hidden"
                                   value="0.00" />
                        </td>

                        <td style="width:90px;">
                            <input type="number"
                                   name="QuoteItems[0].DiscountPercent"
                                   class="form-control form-control-sm text-center"
                                   value="0"
                                   min="0"
                                   max="100"
                                   step="1" />
                        </td>

                        <td style="width:120px;">
                            <select name="QuoteItems[0].VatCategory"
                                    class="form-select form-select-sm">
                                <option value="[NONE]">None</option>
                                <option value="STANDARD">Standard</option>
                            </select>
                        </td>

                        <td style="width:120px;">
                            <input type="text"
                                   class="form-control form-control-sm text-end line-total-excl-vat-field"
                                   value="R0.00"
                                   readonly />
                        </td>

                        <td style="width:120px;">
                            <input type="text"
                                   class="form-control form-control-sm text-end line-total-field"
                                   value="R0.00"
                                   readonly />
                        </td>

                    </tr>

                </tbody>
            </table>

        </div>

        <button type="button"
                id="addItemBtn"
                class="quotes-btn-outline mb-4">
            <i class="bi bi-plus-lg"></i>
            Add Item
        </button>

        <!-- TOTALS -->
        <div class="row justify-content-end mb-4">
            <div class="col-lg-4 col-md-5">

                <div class="quotes-totals-card">

                    <div class="quotes-totals-row">
                        <span>Subtotal</span>
                        <strong id="subtotalAmount">R0.00</strong>
                    </div>

                    <div class="quotes-totals-row">
                        <span>VAT</span>
                        <strong id="vatAmount">R0.00</strong>
                    </div>

                    <div class="quotes-totals-row quotes-totals-final">
                        <span>Total</span>
                        <strong id="totalAmount">R0.00</strong>
                    </div>

                </div>

            </div>
        </div>

        <div class="quotes-form-actions">

            <a asp-controller="Quotes"
               asp-action="Index"
               class="quotes-btn-outline">
                Cancel
            </a>

            <button type="submit"
                    class="quotes-btn-primary">
                <i class="bi bi-check-lg"></i>
                Create Quote
            </button>

        </div>

    </form>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        // Quote calculations use the VAT percentage configured in Settings
        const VAT_RATE = @vatRate;

        let quoteItemIndex = 1;

        const customerSelect = document.getElementById('customerSelect');
        const paymentTermsSelect = document.getElementById('paymentTermsSelect');
        const salesRepSelect = document.getElementById('salesRepSelect');
        const quoteItemsBody = document.getElementById('quoteItemsBody');

        // Automatically populate customer-related fields
        customerSelect.addEventListener('change', function () {
            const selectedOption = this.options[this.selectedIndex];

            paymentTermsSelect.value =
                selectedOption.getAttribute('data-payment-terms') || '';

            salesRepSelect.value =
                selectedOption.getAttribute('data-sales-rep-id') || '';

            document.getElementById('BillingAddress').value =
                selectedOption.getAttribute('data-billing-address') || '';
        });

        // Add another quotation item using the existing first row.
        document.getElementById('addItemBtn')
            .addEventListener('click', function () {

                const sourceRow =
                    quoteItemsBody.querySelector('.quote-item-row');

                if (!sourceRow) return;

                const newRow = sourceRow.cloneNode(true);

                newRow.querySelectorAll('input, select').forEach(function (field) {

                    if (field.name) {
                        field.name = field.name.replace(
                            /QuoteItems\[\d+\]/,
                            `QuoteItems[${quoteItemIndex}]`
                        );
                    }

                    if (field.classList.contains('product-select')) {
                        field.selectedIndex = 0;
                    }
                    else if (
                        field.classList.contains('product-code-field') ||
                        field.classList.contains('description-field')
                    ) {
                        field.value = '';
                    }
                    else if (
                        field.classList.contains('price-field') ||
                        field.classList.contains('line-total-excl-vat-field') ||
                        field.classList.contains('line-total-field')
                    ) {
                        field.value = 'R0.00';
                    }
                    else if (field.classList.contains('price-hidden')) {
                        field.value = '0.00';
                    }
                    else if (field.name?.endsWith('.Quantity')) {
                        field.value = '1';
                    }
                    else if (field.name?.endsWith('.DiscountPercent')) {
                        field.value = '0';
                    }
                    else if (field.name?.endsWith('.VatCategory')) {
                        field.value = '[NONE]';
                    }
                });

                quoteItemsBody.appendChild(newRow);
                quoteItemIndex++;

                calculateGrandTotals();
            });

        // Populate product information when a product is selected
        quoteItemsBody.addEventListener('change', function (e) {

            if (!e.target.classList.contains('product-select')) return;

            const row = e.target.closest('tr');
            const selectedOption = e.target.options[e.target.selectedIndex];

            const code = selectedOption.getAttribute('data-code') || '';
            const price = selectedOption.getAttribute('data-price') || '0';
            const description =
                selectedOption.getAttribute('data-description') || '';

            const numericPrice = parseFloat(price) || 0;

            row.querySelector('.product-code-field').value = code;
            row.querySelector('.description-field').value = description;
            row.querySelector('.price-field').value =
                'R' + numericPrice.toFixed(2);

            row.querySelector('.price-hidden').value =
                numericPrice.toFixed(2);

            calculateRow(row);
        });

        function calculateRow(row) {

            const quantity = parseFloat(
                row.querySelector('input[name$=".Quantity"]').value
            ) || 0;

            const unitPrice = parseFloat(
                row.querySelector('.price-hidden').value
            ) || 0;

            const discountPercent = parseFloat(
                row.querySelector('input[name$=".DiscountPercent"]').value
            ) || 0;

            const vatCategory =
                row.querySelector('select[name$=".VatCategory"]').value;

            const beforeDiscount = quantity * unitPrice;
            const discountAmount = beforeDiscount * (discountPercent / 100);
            const exclVat = beforeDiscount - discountAmount;

            const vat = vatCategory === 'STANDARD'
                ? exclVat * VAT_RATE
                : 0;

            const total = exclVat + vat;

            row.querySelector('.line-total-excl-vat-field').value =
                'R' + exclVat.toFixed(2);

            row.querySelector('.line-total-field').value =
                'R' + total.toFixed(2);

            calculateGrandTotals();
        }

        function calculateGrandTotals() {

            let subtotal = 0;
            let total = 0;

            quoteItemsBody.querySelectorAll('.quote-item-row')
                .forEach(function (row) {

                    const excl = parseFloat(
                        row.querySelector('.line-total-excl-vat-field')
                            .value.replace('R', '').replace(/,/g, '')
                    ) || 0;

                    const lineTotal = parseFloat(
                        row.querySelector('.line-total-field')
                            .value.replace('R', '').replace(/,/g, '')
                    ) || 0;

                    subtotal += excl;
                    total += lineTotal;
                });

            const vat = total - subtotal;

            document.getElementById('subtotalAmount').textContent =
                'R' + subtotal.toFixed(2);

            document.getElementById('vatAmount').textContent =
                'R' + vat.toFixed(2);

            document.getElementById('totalAmount').textContent =
                'R' + total.toFixed(2);
        }

        quoteItemsBody.addEventListener('input', function (e) {

            if (e.target.matches(
                'input[name$=".Quantity"], input[name$=".DiscountPercent"]'
            )) {
                calculateRow(e.target.closest('tr'));
            }
        });

        quoteItemsBody.addEventListener('change', function (e) {

            if (e.target.matches('select[name$=".VatCategory"]')) {
                calculateRow(e.target.closest('tr'));
            }
        });
    </script>
}