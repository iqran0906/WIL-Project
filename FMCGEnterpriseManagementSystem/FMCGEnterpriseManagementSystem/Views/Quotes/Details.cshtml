@model FMCGEnterpriseManagementSystem.Models.Quote
@{
    ViewData["Title"] = "Quote Details";
}

<div class="content-card">
    <div class="row align-items-center mb-4 g-3">
        <div class="col-12 col-sm-6 text-center text-sm-start">
            <h5 class="fw-bold m-0" style="color: #1c323d;">Exclusive Distributors (pty) LTD</h5>
            <small class="text-muted d-block">Durban</small>
        </div>
        <div class="col-12 col-sm-6 text-center text-sm-end">
            <div class="d-inline-block text-start w-100" style="max-width: 280px;">
                <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                    <span class="small text-secondary fw-bold">Date:</span>
<span>@(Model.QuoteDate.ToShortDateString())</span>                </div>
                <div class="d-flex align-items-center justify-content-between gap-2">
                    <span class="small text-secondary fw-bold">Quote Number:</span>
                    <span class="fw-bold">@Model.QuoteNumber</span>
                </div>
            </div>
        </div>
    </div>

    <h2 class="fw-bold mb-4 text-center text-sm-start" style="color: #1c323d;">Quote #@Model.QuoteNumber</h2>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <p><strong>Customer:</strong> @Model.Customer?.Name @Model.Customer?.Surname</p>
            <p><strong>Billing Address:</strong><br />@Model.BillingAddress</p>
        </div>
        <div class="col-md-6">
            <p><strong>Payment Terms:</strong> @Model.PaymentTerms</p>
            <p><strong>Sales Person:</strong> @Model.SalesRepresentative?.Employee?.FirstName @Model.SalesRepresentative?.Employee?.LastName</p>
            <p><strong>Status:</strong> @Model.Status</p>
        </div>
    </div>

<div class="table-responsive border rounded bg-light p-2 mb-3" style="max-height: 350px; overflow-y: auto;">        <table class="table align-middle m-0 bg-white shadow-sm rounded">
<thead class="table-secondary text-secondary small" style="position: sticky; top: 0; z-index: 1;">                <tr>
                    <th>Qty</th>
                    <th>Product Code</th>
                    <th>Product</th>
                    <th>Description</th>
                    <th>Unit Price</th>
                    <th>Disc</th>
                    <th>VAT</th>
                    <th>Total Excl. VAT</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.QuoteItems)
                {
                    <tr>
                        <td>@item.Quantity</td>
                        <td>@item.Product?.ProductCode</td>
                        <td>@item.Product?.ProductName</td>
                        <td>@item.Product?.Description</td>
<td>R@(item.UnitPrice.ToString("N2"))</td>
<td>@item.DiscountPercent%</td>
                        <td>@item.VatCategory</td>
<td>R@(item.LineTotalExclVat.ToString("N2"))</td>
<td>R@(item.LineTotal.ToString("N2"))</td>                    </tr>
                }
            </tbody>
        </table>
    </div>

 <div class="row justify-content-between g-0 mb-4">
    <div class="col-12 col-md-6 text-start">
        <h6 class="fw-bold text-secondary">Banking Details</h6>
        <p class="small mb-0">
            Bank: FNB<br />
            Branch Code: 250655<br />
            Account Name: Exclusive Distributors (Pty) Ltd<br />
            Account Number: 63191446202<br />
            Reference: @Model.QuoteNumber<br />
            Proof of Payment: exclusivedistributors2@@gmail.com
        </p>
        <p class="small mb-0 mt-2">Thanking you for your business!</p>
    </div>
    <div class="col-12 col-md-4 border-top pt-2 text-end fw-bold text-secondary">
        <div class="d-flex justify-content-between py-1"><span>Subtotal</span><span>R@(Model.Subtotal.ToString("N2"))</span></div>
        <div class="d-flex justify-content-between py-1"><span>VAT</span><span>R@((Model.Total - Model.Subtotal).ToString("N2"))</span></div>
        <div class="d-flex justify-content-between py-1 border-top border-dark mt-2 text-dark fs-5"><span>Total</span><span>R@(Model.Total.ToString("N2"))</span></div>
    </div>
</div>

    <div class="d-flex justify-content-end gap-2 gap-sm-3 mt-4">
        <button type="button" class="btn btn-primary px-4" data-bs-toggle="modal" data-bs-target="#emailQuoteModal">
            Email Quote
        </button>
        <a asp-controller="Quotes" asp-action="Index" class="btn btn-link text-decoration-none text-secondary">Back to Quotes</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success mt-3">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger mt-3">@TempData["ErrorMessage"]</div>
    }

    <div class="modal fade" id="emailQuoteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-controller="Quotes" asp-action="EmailQuote" method="post">
                    <input type="hidden" name="id" value="@Model.QuoteId" />
                    <div class="modal-header">
                        <h5 class="modal-title">Email Quote @Model.QuoteNumber</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <label class="fw-bold text-secondary mb-1">Recipient Email</label>
                        <input type="email" name="recipientEmail" class="form-control" required placeholder="customer@example.com" />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
<button type="submit" class="btn btn-primary" onclick="this.disabled=true; this.form.submit();">Send</button>                    </div>
                </form>
            </div>
        </div>
    </div>
</div>