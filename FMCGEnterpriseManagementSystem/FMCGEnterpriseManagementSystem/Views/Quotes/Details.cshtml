@*
    Purpose: Display quotation details and email the quotation.
    Original functionality: Existing Quotes module contributors (Git history).
    UI integration: Iqra Nazir (2026).
    UI adaptation assistance: OpenAI ChatGPT (2026).

    References:
    Bootstrap (n.d.) Modal. https://getbootstrap.com/docs/5.3/components/modal/
    Microsoft (n.d.) ASP.NET Core Tag Helpers.
    https://learn.microsoft.com/en-us/aspnet/core/mvc/views/tag-helpers/intro
*@

@model FMCGEnterpriseManagementSystem.Models.Quote

@{
    ViewData["Title"] = "Quote Details";
}

<div class="content-card quotes-page">

    <div class="quotes-page-header">
        <div>
            <h2 class="quotes-page-title">
                Quote #@Model.QuoteNumber
            </h2>

            <p class="quotes-page-subtitle">
                Review customer details, quotation items and totals.
            </p>
        </div>

        <div class="quotes-header-actions">
            <a asp-controller="Quotes"
               asp-action="Index"
               class="quotes-btn-outline">
                <i class="bi bi-arrow-left"></i>
                Back to Quotes
            </a>

            <button type="button"
                    class="quotes-btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#emailQuoteModal">
                <i class="bi bi-envelope"></i>
                Email Quote
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success mb-4" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger mb-4" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="quotes-form-section">

        <div class="row align-items-center g-3">

            <div class="col-md-6">
                <div class="quotes-company-heading">
                    Exclusive Distributors (Pty) Ltd
                </div>
                <div class="quotes-page-subtitle">Durban</div>
            </div>

            <div class="col-md-6 text-md-end">
                <div class="quotes-detail-label">Quote Number</div>
                <div class="quotes-detail-value">
                    @Model.QuoteNumber
                </div>

                <div class="quotes-detail-label mt-2">Quote Date</div>
                <div class="quotes-detail-value">
                    @Model.QuoteDate.ToString("dd MMMM yyyy")
                </div>
            </div>

        </div>

    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-6">
            <div class="quotes-details-card">

                <h5 class="quotes-section-title mb-3">
                    <i class="bi bi-person me-2"></i>
                    Customer Information
                </h5>

                <div class="mb-3">
                    <div class="quotes-detail-label">Customer</div>
                    <div class="quotes-detail-value">
                        @Model.Customer?.Name @Model.Customer?.Surname
                    </div>
                </div>

                <div>
                    <div class="quotes-detail-label">Billing Address</div>
                    <div class="quotes-detail-value"
                         style="white-space:pre-line;">@Model.BillingAddress</div>
                </div>

            </div>
        </div>

        <div class="col-md-6">
            <div class="quotes-details-card">

                <h5 class="quotes-section-title mb-3">
                    <i class="bi bi-file-text me-2"></i>
                    Quote Information
                </h5>

                <div class="mb-3">
                    <div class="quotes-detail-label">Payment Terms</div>
                    <div class="quotes-detail-value">
                        @Model.PaymentTerms
                    </div>
                </div>

                <div class="mb-3">
                    <div class="quotes-detail-label">Sales Person</div>
                    <div class="quotes-detail-value">
                        @Model.SalesRepresentative?.Employee?.FirstName
                        @Model.SalesRepresentative?.Employee?.LastName
                    </div>
                </div>

                <div>
                    <div class="quotes-detail-label">Status</div>
                    <div class="quotes-detail-value">
                        @Model.Status
                    </div>
                </div>

            </div>
        </div>

    </div>

    <div class="mb-3">
        <h5 class="quotes-section-title">Quote Items</h5>
        <p class="quotes-section-subtitle mb-0">
            Products, quantities, discounts and applicable VAT.
        </p>
    </div>

    <div class="quotes-items-container mb-4"
         style="max-height:400px;overflow-y:auto;">

        <table class="quotes-items-table">

            <thead>
                <tr>
                    <th>Qty</th>
                    <th>Product Code</th>
                    <th>Product</th>
                    <th>Description</th>
                    <th>Unit Price</th>
                    <th>Disc</th>
                    <th>VAT</th>
                    <th>Total Excl. VAT</th>
                    <th>Total</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.QuoteItems)
                {
                    <tr>
                        <td>@item.Quantity</td>
                        <td>@item.Product?.ProductCode</td>
                        <td class="fw-semibold">@item.Product?.ProductName</td>
                        <td>@item.Product?.Description</td>
                        <td>R@(item.UnitPrice.ToString("N2"))</td>
                        <td>@item.DiscountPercent%</td>
                        <td>@item.VatCategory</td>
                        <td>R@(item.LineTotalExclVat.ToString("N2"))</td>
                        <td class="fw-semibold">
                            R@(item.LineTotal.ToString("N2"))
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>

    <div class="row g-4">

        <div class="col-lg-7">
            <div class="quotes-banking-card h-100">

                <h5 class="quotes-section-title mb-3">
                    <i class="bi bi-bank me-2"></i>
                    Banking Details
                </h5>

                <div class="small" style="line-height:1.9;">
                    <strong>Bank:</strong> FNB<br />
                    <strong>Branch Code:</strong> 250655<br />
                    <strong>Account Name:</strong> Exclusive Distributors (Pty) Ltd<br />
                    <strong>Account Number:</strong> 63191446202<br />
                    <strong>Reference:</strong> @Model.QuoteNumber<br />
                    <strong>Proof of Payment:</strong>
                    exclusivedistributors2@@gmail.com
                </div>

                <p class="small mt-3 mb-0">
                    Thanking you for your business!
                </p>

            </div>
        </div>

        <div class="col-lg-5">
            <div class="quotes-totals-card h-100">

                <h5 class="quotes-section-title mb-3">
                    Quote Summary
                </h5>

                <div class="quotes-totals-row">
                    <span>Subtotal</span>
                    <strong>R@(Model.Subtotal.ToString("N2"))</strong>
                </div>

                <div class="quotes-totals-row">
                    <span>VAT</span>
                    <strong>
                        R@((Model.Total - Model.Subtotal).ToString("N2"))
                    </strong>
                </div>

                <div class="quotes-totals-row quotes-totals-final">
                    <span>Total</span>
                    <strong>R@(Model.Total.ToString("N2"))</strong>
                </div>

            </div>
        </div>

    </div>

    <!-- EMAIL QUOTE MODAL -->
    <div class="modal fade"
         id="emailQuoteModal"
         tabindex="-1"
         aria-labelledby="emailQuoteModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <form asp-controller="Quotes"
                      asp-action="EmailQuote"
                      method="post"
                      id="emailQuoteForm">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.QuoteId" />

                    <div class="modal-header">
                        <h5 class="modal-title" id="emailQuoteModalLabel">
                            Email Quote @Model.QuoteNumber
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close"></button>
                    </div>

                    <div class="modal-body">

                        <label for="recipientEmail"
                               class="form-label">
                            Recipient Email
                        </label>

                        <input type="email"
                               id="recipientEmail"
                               name="recipientEmail"
                               class="form-control"
                               required
                               placeholder="customer@example.com" />

                        <p class="quotes-page-subtitle mt-2">
                            The quotation will be emailed to this address.
                        </p>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="quotes-btn-outline"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit"
                                id="sendQuoteButton"
                                class="quotes-btn-primary">
                            <i class="bi bi-send"></i>
                            Send Quote
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        // Prevent accidental repeated email submissions
        document.getElementById('emailQuoteForm')
            .addEventListener('submit', function () {

                const button = document.getElementById('sendQuoteButton');

                button.disabled = true;
                button.innerText = 'Sending...';
            });
    </script>
}