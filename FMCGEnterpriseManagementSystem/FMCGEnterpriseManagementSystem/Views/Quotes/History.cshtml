@*
    Purpose: Display converted quotation history with filtering and PDF downloads.
    Original functionality: Existing Quotes module contributors (Git history).
    UI integration: Iqra Nazir (2026).
    UI adaptation assistance: OpenAI ChatGPT (2026).

    References:
    Bootstrap (n.d.) Tables. https://getbootstrap.com/docs/5.3/content/tables/
    MDN Web Docs (n.d.) HTMLElement.dataset.
    https://developer.mozilla.org/en-US/docs/Web/API/HTMLElement/dataset
*@

@model IEnumerable<FMCGEnterpriseManagementSystem.Models.Quote>

@{
    ViewData["Title"] = "Quote History";

    var quotes = Model?.ToList()
        ?? new List<FMCGEnterpriseManagementSystem.Models.Quote>();

    var totalValue = quotes.Sum(q => q.Total);
}

<div class="content-card quotes-page">

    <div class="quotes-page-header">
        <div>
            <h2 class="quotes-page-title">Quote History</h2>
            <p class="quotes-page-subtitle">
                Quotations that have already been converted into invoices.
            </p>
        </div>

        <a asp-controller="Quotes"
           asp-action="Index"
           class="quotes-btn-outline">
            <i class="bi bi-arrow-left"></i>
            Back to Quotes
        </a>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-6">
            <div class="quotes-stat-card invoiced">
                <div class="quotes-stat-label">Converted Quotes</div>
                <div class="quotes-stat-value">@quotes.Count</div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="quotes-stat-card value">
                <div class="quotes-stat-label">Historical Quote Value</div>
                <div class="quotes-stat-value">
                    R @totalValue.ToString("N2")
                </div>
            </div>
        </div>

    </div>

    <div class="quotes-filter-panel">
        <div class="row g-3 align-items-end">

            <div class="col-md-6">
                <label for="historySearch" class="quotes-filter-label">
                    Search History
                </label>
                <input type="text"
                       id="historySearch"
                       class="form-control"
                       placeholder="Quote number or customer..." />
            </div>

            <div class="col-md-2">
                <label for="startDate" class="quotes-filter-label">
                    Start Date
                </label>
                <input type="date" id="startDate" class="form-control" />
            </div>

            <div class="col-md-2">
                <label for="endDate" class="quotes-filter-label">
                    End Date
                </label>
                <input type="date" id="endDate" class="form-control" />
            </div>

            <div class="col-md-2">
                <button type="button"
                        id="clearFilters"
                        class="quotes-btn-outline w-100">
                    Clear
                </button>
            </div>

        </div>
    </div>

    <div class="quotes-table-container">

        <table class="quotes-table">

            <thead>
                <tr>
                    <th>Date</th>
                    <th>Quote No.</th>
                    <th>Customer</th>
                    <th>Sales Rep</th>
                    <th class="text-end">Total</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (quotes.Any())
                {
                    foreach (var quote in quotes)
                    {
                        var customerName = quote.Customer != null
                            ? $"{quote.Customer.Name} {quote.Customer.Surname}"
                            : "Unknown Customer";

                        var salesRepName = quote.SalesRepresentative?.Employee != null
                            ? $"{quote.SalesRepresentative.Employee.FirstName} {quote.SalesRepresentative.Employee.LastName}"
                            : "Unassigned";

                        <tr class="history-row"
                            data-date="@quote.QuoteDate.ToString("yyyy-MM-dd")">

                            <td>@quote.QuoteDate.ToString("dd MMM yyyy")</td>

                            <td>
                                <span class="quotes-reference">
                                    @quote.QuoteNumber
                                </span>
                            </td>

                            <td class="fw-semibold">@customerName</td>

                            <td>@salesRepName</td>

                            <td class="text-end fw-semibold">
                                R @quote.Total.ToString("N2")
                            </td>

                            <td>
                                <span class="quotes-status invoiced">
                                    Invoiced
                                </span>
                            </td>

                            <td>
                                <div class="quotes-actions">

                                    <a asp-controller="Quotes"
                                       asp-action="Details"
                                       asp-route-id="@quote.QuoteId"
                                       class="quotes-action-btn">
                                        <i class="bi bi-eye"></i>
                                        View
                                    </a>

                                    <a asp-controller="Quotes"
                                       asp-action="DownloadPdf"
                                       asp-route-id="@quote.QuoteId"
                                       class="quotes-action-btn">
                                        <i class="bi bi-file-earmark-pdf"></i>
                                        PDF
                                    </a>

                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7">
                            <div class="quotes-empty-state">
                                <i class="bi bi-clock-history"></i>
                                <strong>No quote history yet</strong>
                                <span>
                                    Quotes will appear here after conversion into invoices.
                                </span>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>

</div>

@section Scripts {
    <script>
        // Filter quote history without changing server-side data
        const searchInput = document.getElementById('historySearch');
        const startDate = document.getElementById('startDate');
        const endDate = document.getElementById('endDate');
        const clearButton = document.getElementById('clearFilters');

        function filterHistory() {
            const search = searchInput.value.toLowerCase().trim();
            const start = startDate.value;
            const end = endDate.value;

            document.querySelectorAll('.history-row').forEach(function (row) {
                const text = row.innerText.toLowerCase();
                const rowDate = row.dataset.date;

                const matchesSearch = !search || text.includes(search);
                const matchesStart = !start || rowDate >= start;
                const matchesEnd = !end || rowDate <= end;

                row.style.display =
                    matchesSearch &&
                    matchesStart &&
                    matchesEnd ? '' : 'none';
            });
        }

        searchInput.addEventListener('input', filterHistory);
        startDate.addEventListener('change', filterHistory);
        endDate.addEventListener('change', filterHistory);

        clearButton.addEventListener('click', function () {
            searchInput.value = '';
            startDate.value = '';
            endDate.value = '';
            filterHistory();
        });
    </script>
}