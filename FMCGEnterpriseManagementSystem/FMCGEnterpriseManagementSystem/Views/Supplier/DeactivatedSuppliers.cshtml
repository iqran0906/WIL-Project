@model IEnumerable<FMCGEnterpriseManagementSystem.ViewModels.SupplierViewModel>

@{
    ViewData["Title"] = "Deactivated Suppliers";
}

<div class="supplier-page">

    <div class="supplier-page-header">
        <div>
            <h2 class="supplier-page-title">Deactivated Suppliers</h2>
            <p class="supplier-page-subtitle">
                View and reactivate suppliers that are no longer active.
            </p>
        </div>

        <a asp-controller="Supplier"
           asp-action="SupplierList"
           class="supplier-btn-outline">
            <i class="bi bi-arrow-left"></i>
            Back to Suppliers
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    <div class="supplier-table-container">

        <table class="supplier-table">

            <thead>
                <tr>
                    <th>Supplier</th>
                    <th>Contact</th>
                    <th>Credit</th>
                    <th>VAT Number</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var supplier in Model)
                    {
                        <tr>
                            <td>
                                <div class="supplier-name">
                                    @supplier.CompanyName
                                </div>

                                @if (!string.IsNullOrWhiteSpace(supplier.PhysicalAddress))
                                {
                                    <div class="supplier-secondary-text">
                                        @supplier.PhysicalAddress
                                    </div>
                                }
                            </td>

                            <td>
                                <div class="fw-semibold">
                                    @supplier.ContactPerson
                                </div>

                                <div class="supplier-secondary-text">
                                    @supplier.Email
                                </div>

                                <div class="supplier-secondary-text">
                                    @supplier.ContactNumber
                                </div>
                            </td>

                            <td>
                                <div class="fw-semibold">
                                    R @supplier.CreditLimit.ToString("N2")
                                </div>

                                <div class="supplier-secondary-text">
                                    @supplier.CreditTerms
                                </div>
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(supplier.VATNumber)
                                    ? "Not provided"
                                    : supplier.VATNumber)
                            </td>

                            <td>
                                <span class="supplier-badge supplier-badge-inactive">
                                    Deactivated
                                </span>
                            </td>

                            <td>
                                <div class="supplier-actions">

                                    <form asp-controller="Supplier"
                                          asp-action="ActivateSupplier"
                                          asp-route-id="@supplier.SupplierId"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="supplier-action-btn supplier-action-activate">
                                            <i class="bi bi-arrow-counterclockwise"></i>
                                            Activate
                                        </button>

                                    </form>

                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">
                            <div class="supplier-empty-state">
                                <i class="bi bi-archive fs-2 d-block mb-2"></i>
                                <strong>No Deactivated Suppliers</strong>
                                <p class="mb-0 mt-2">
                                    Deactivated suppliers will appear here.
                                </p>
                            </div>
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>