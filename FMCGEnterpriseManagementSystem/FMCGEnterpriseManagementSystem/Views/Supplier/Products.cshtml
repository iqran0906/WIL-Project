@*
    Purpose: Products supplied by one supplier.
    Authors: iqran0906 (from git history)
*@
@model IEnumerable<FMCGEnterpriseManagementSystem.ViewModels.ProductViewModel>

@{
    ViewData["Title"] = "Supplier Products";
}

<div class="content-card">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1" style="color:#1c323d;">
                @ViewBag.SupplierName
            </h2>

            <p class="text-muted mb-0">
                Products supplied by this supplier.
            </p>
        </div>

        <a asp-controller="Supplier"
           asp-action="SupplierList"
           class="btn btn-outline-secondary">
            ← Back to Suppliers
        </a>

    </div>

    <!-- Summary -->
    <div class="row g-3 mb-4">

        <div class="col-lg-3 col-md-6">
            <div class="border rounded-3 p-3 bg-white h-100">

                <div class="text-muted small mb-1">
                    Products Supplied
                </div>

                <div class="fs-3 fw-bold"
                     style="color:#1c323d;">
                    @Model.Count()
                </div>

            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="border rounded-3 p-3 bg-white h-100">

                <div class="text-muted small mb-1">
                    Active Products
                </div>

                <div class="fs-3 fw-bold"
                     style="color:#1c323d;">
                    @Model.Count(p => p.IsActive)
                </div>

            </div>
        </div>

    </div>

    <!-- Products -->
    <div class="table-responsive">

        <table class="custom-data-table align-middle">

            <thead>
                <tr>
                    <th>Code</th>
                    <th>Product</th>
                    <th>Category</th>
                    <th>Cost Price</th>
                    <th>Selling Price</th>
                    <th>Status</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Any())
                {
                    foreach (var product in Model)
                    {
                        <tr>

                            <td>
                                <strong>@product.ProductCode</strong>
                            </td>

                            <td>
                                <div class="fw-semibold">
                                    @product.ProductName
                                </div>

                                @if (!string.IsNullOrWhiteSpace(product.Description))
                                {
                                    <div class="small text-muted">
                                        @product.Description
                                    </div>
                                }
                            </td>

                            <td>
                                @product.Category
                            </td>

                            <td>
                                <div class="fw-semibold">
                                    R @product.CostExVat.ToString("N2")
                                </div>

                                <div class="small text-muted">
                                    R @product.CostIncVat.ToString("N2") incl. VAT
                                </div>
                            </td>

                            <td>
                                <strong>
                                    R @product.SellingPrice.ToString("N2")
                                </strong>
                            </td>

                            <td>
                                @if (product.IsActive)
                                {
                                    <span class="badge bg-success px-3 py-2">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger px-3 py-2">
                                        Inactive
                                    </span>
                                }
                            </td>

                            <td class="text-center">

                                <a asp-controller="Products"
                                   asp-action="Edit"
                                   asp-route-id="@product.ProductId"
                                   class="btn btn-warning btn-sm">
                                    ✎ Edit
                                </a>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7"
                            class="text-center py-5">

                            <div class="fw-semibold mb-1">
                                No products linked to this supplier
                            </div>

                            <div class="small text-muted">
                                Products assigned to @ViewBag.SupplierName will appear here.
                            </div>

                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>