@*
    Purpose: Display products supplied by one supplier.
    Original author: iqran0906 (from git history).
    UI styling updated to match the final-fixes design.
*@
@model IEnumerable<FMCGEnterpriseManagementSystem.ViewModels.ProductViewModel>

@{
    ViewData["Title"] = "Supplier Products";

    var products = Model?.ToList()
        ?? new List<FMCGEnterpriseManagementSystem.ViewModels.ProductViewModel>();
}

<div class="supplier-page">

    <div class="supplier-page-header">
        <div>
            <h2 class="supplier-page-title">@ViewBag.SupplierName</h2>
            <p class="supplier-page-subtitle">
                Products supplied by this supplier.
            </p>
        </div>

        <a asp-controller="Supplier"
           asp-action="SupplierList"
           class="supplier-btn-outline">
            <i class="bi bi-arrow-left"></i>
            Back to Suppliers
        </a>
    </div>

    <!-- PRODUCT SUMMARY -->
    <div class="row g-3 mb-4">

        <div class="col-6 col-xl-3">
            <div class="supplier-stat-card">
                <div class="supplier-stat-label">Products Supplied</div>
                <div class="supplier-stat-value">@products.Count</div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="supplier-stat-card active">
                <div class="supplier-stat-label">Active Products</div>
                <div class="supplier-stat-value">
                    @products.Count(p => p.IsActive)
                </div>
            </div>
        </div>

    </div>

    <!-- PRODUCT TABLE -->
    <div class="supplier-table-container">

        <table class="supplier-table">

            <thead>
                <tr>
                    <th>Code</th>
                    <th>Product</th>
                    <th>Category</th>
                    <th>Cost Price</th>
                    <th>Selling Price</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                @if (products.Any())
                {
                    foreach (var product in products)
                    {
                        <tr>
                            <td>
                                <span class="supplier-name">
                                    @product.ProductCode
                                </span>
                            </td>

                            <td>
                                <div class="supplier-name">
                                    @product.ProductName
                                </div>

                                @if (!string.IsNullOrWhiteSpace(product.Description))
                                {
                                    <div class="supplier-secondary-text">
                                        @product.Description
                                    </div>
                                }
                            </td>

                            <td>@product.Category</td>

                            <td>
                                <div class="fw-semibold">
                                    R @product.CostExVat.ToString("N2")
                                </div>

                                <div class="supplier-secondary-text">
                                    R @product.CostIncVat.ToString("N2") incl. VAT
                                </div>
                            </td>

                            <td>
                                <strong>
                                    R @product.SellingPrice.ToString("N2")
                                </strong>
                            </td>

                            <td>
                                @if (product.IsActive)
                                {
                                    <span class="supplier-badge supplier-badge-active">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="supplier-badge supplier-badge-inactive">
                                        Inactive
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="supplier-actions">
                                    <a asp-controller="Products"
                                       asp-action="Edit"
                                       asp-route-id="@product.ProductId"
                                       class="supplier-action-btn supplier-action-edit">
                                        <i class="bi bi-pencil-square"></i>
                                        Edit
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7">
                            <div class="supplier-empty-state">
                                <i class="bi bi-box-seam fs-2 d-block mb-2"></i>
                                <strong>No products linked to this supplier</strong>
                                <p class="mb-0 mt-2">
                                    Products assigned to @ViewBag.SupplierName will appear here.
                                </p>
                            </div>
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>