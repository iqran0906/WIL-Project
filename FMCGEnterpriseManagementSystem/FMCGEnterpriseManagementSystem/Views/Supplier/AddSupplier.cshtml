@*
    Purpose: Form to add a new supplier.
    Authors: Maseeha17 (from git history)
*@
@model FMCGEnterpriseManagementSystem.ViewModels.SupplierViewModel

@{
    ViewData["Title"] = "New Supplier";
}

<div class="content-card">
    <h2 class="fw-bold mb-4" style="color: #1c323d;">New Supplier</h2>

    <form asp-controller="Supplier" asp-action="AddSupplier" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="CompanyName" class="form-label">Company Name</label>
                    <input asp-for="CompanyName" class="form-control" placeholder="Enter Company Name" required>
                    <span asp-validation-for="CompanyName" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ContactPerson" class="form-label">Contact Person</label>
                    <input asp-for="ContactPerson" class="form-control" placeholder="Enter Contact Person">
                    <span asp-validation-for="ContactPerson" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ContactNumber" class="form-label">Telephone / Cell Number</label>
                    <input asp-for="ContactNumber" class="form-control" placeholder="Enter Telephone Number">
                    <span asp-validation-for="ContactNumber" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" type="email" placeholder="Enter Email Address">
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="PhysicalAddress" class="form-label">Address</label>
                    <textarea asp-for="PhysicalAddress" class="form-control" rows="2" placeholder="Enter Address"></textarea>
                    <span asp-validation-for="PhysicalAddress" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="CreditLimit" class="form-label">Credit Limit</label>
                    <input asp-for="CreditLimit" class="form-control" type="number" step="0.01" placeholder="Enter Credit Limit, e.g., 500">
                    <span asp-validation-for="CreditLimit" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="CreditTerms" class="form-label">Credit Terms</label>
                    <select asp-for="CreditTerms" class="form-select">
                        <option selected disabled>Select Terms</option>
                        <option value="Cash">Cash</option>
                        <option value="7 Days">7 Days</option>
                        <option value="14 Days">14 Days</option>
                        <option value="21 Days">21 Days</option>
                        <option value="28 Days">28 Days</option>
                        <option value="30 Days">30 Days</option>
                        <option value="60 Days">60 Days</option>
                    </select>
                    <span asp-validation-for="CreditTerms" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="VATNumber" class="form-label">VAT Number</label>
                    <input asp-for="VATNumber" class="form-control" placeholder="Enter VAT Number">
                    <span asp-validation-for="VATNumber" class="text-danger small"></span>
                </div>
            </div>

            <div class="col-12">
                <div class="mb-4">
                    <label asp-for="Notes" class="form-label">Notes</label>
                    <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Optional"></textarea>
                    <span asp-validation-for="Notes" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-3 mt-2">
            <a asp-controller="Supplier" asp-action="SupplierList" class="btn btn-link text-decoration-none text-secondary align-self-center">Cancel</a>
            <button type="submit" class="btn btn-custom-save">Save Supplier</button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}