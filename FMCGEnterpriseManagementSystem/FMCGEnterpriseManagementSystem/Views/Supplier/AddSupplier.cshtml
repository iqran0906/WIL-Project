@*
    Purpose: Form to add a new supplier.
    
    UI styling updated to match the final-fixes design.
*@
@model FMCGEnterpriseManagementSystem.ViewModels.SupplierViewModel

@{
    ViewData["Title"] = "New Supplier";
}

<div class="supplier-page">

    <div class="supplier-page-header">
        <div>
            <h2 class="supplier-page-title">New Supplier</h2>
            <p class="supplier-page-subtitle">
                Register a supplier and configure contact and credit information.
            </p>
        </div>

        <a asp-controller="Supplier"
           asp-action="SupplierList"
           class="supplier-btn-outline">
            <i class="bi bi-arrow-left"></i>
            Back to Suppliers
        </a>
    </div>

    <form asp-controller="Supplier"
          asp-action="AddSupplier"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="row g-4">

            <!-- CONTACT INFORMATION -->
            <div class="col-lg-6">
                <div class="supplier-form-section">

                    <h5 class="supplier-section-title">
                        <i class="bi bi-building me-2"></i>
                        Supplier Information
                    </h5>

                    <p class="supplier-section-subtitle">
                        Company and contact details.
                    </p>

                    <div class="mb-3">
                        <label asp-for="CompanyName" class="form-label">
                            Company Name
                        </label>

                        <input asp-for="CompanyName"
                               class="form-control"
                               placeholder="Enter company name"
                               required />

                        <span asp-validation-for="CompanyName"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ContactPerson" class="form-label">
                            Contact Person
                        </label>

                        <input asp-for="ContactPerson"
                               class="form-control"
                               placeholder="Enter contact person" />

                        <span asp-validation-for="ContactPerson"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ContactNumber" class="form-label">
                            Telephone / Cell Number
                        </label>

                        <input asp-for="ContactNumber"
                               class="form-control"
                               placeholder="Enter contact number" />

                        <span asp-validation-for="ContactNumber"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">
                            Email (Optional)
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               placeholder="Enter email address" />

                        <span asp-validation-for="Email"
                              class="text-danger small"></span>
                    </div>

                </div>
            </div>

            <!-- CREDIT INFORMATION -->
            <div class="col-lg-6">
                <div class="supplier-form-section">

                    <h5 class="supplier-section-title">
                        <i class="bi bi-credit-card me-2"></i>
                        Business & Credit Information
                    </h5>

                    <p class="supplier-section-subtitle">
                        Address, credit arrangements and tax details.
                    </p>

                    <div class="mb-3">
                        <label asp-for="PhysicalAddress" class="form-label">
                            Physical Address
                        </label>

                        <textarea asp-for="PhysicalAddress"
                                  class="form-control"
                                  rows="2"
                                  placeholder="Enter supplier address"></textarea>

                        <span asp-validation-for="PhysicalAddress"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CreditLimit" class="form-label">
                            Credit Limit
                        </label>

                        <input asp-for="CreditLimit"
                               type="number"
                               step="0.01"
                               class="form-control"
                               placeholder="Enter credit limit" />

                        <span asp-validation-for="CreditLimit"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CreditTerms" class="form-label">
                            Credit Terms
                        </label>

                        <select asp-for="CreditTerms" class="form-select">
                            <option value="">Select Terms</option>
                            <option value="Cash">Cash</option>
                            <option value="7 Days">7 Days</option>
                            <option value="14 Days">14 Days</option>
                            <option value="21 Days">21 Days</option>
                            <option value="28 Days">28 Days</option>
                            <option value="30 Days">30 Days</option>
                            <option value="60 Days">60 Days</option>
                        </select>

                        <span asp-validation-for="CreditTerms"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="VATNumber" class="form-label">
                            VAT Number
                        </label>

                        <input asp-for="VATNumber"
                               class="form-control"
                               placeholder="Enter VAT number" />

                        <span asp-validation-for="VATNumber"
                              class="text-danger small"></span>
                    </div>

                </div>
            </div>

            <!-- NOTES -->
            <div class="col-12">
                <div class="supplier-form-section">

                    <h5 class="supplier-section-title">
                        <i class="bi bi-journal-text me-2"></i>
                        Additional Information
                    </h5>

                    <p class="supplier-section-subtitle">
                        Optional notes about this supplier.
                    </p>

                    <label asp-for="Notes" class="form-label">
                        Notes
                    </label>

                    <textarea asp-for="Notes"
                              class="form-control"
                              rows="3"
                              placeholder="Enter additional notes"></textarea>

                    <span asp-validation-for="Notes"
                          class="text-danger small"></span>

                </div>
            </div>

        </div>

        <div class="supplier-form-actions">
            <a asp-controller="Supplier"
               asp-action="SupplierList"
               class="supplier-btn-outline">
                Cancel
            </a>

            <button type="submit" class="supplier-btn-primary">
                <i class="bi bi-check-lg"></i>
                Save Supplier
            </button>
        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}