@*
    Purpose: Confirmation page before removing a supplier.
    Original author: Maseeha17 (from git history).
    UI styling updated to match the final-fixes design.
*@
@model FMCGEnterpriseManagementSystem.ViewModels.SupplierViewModel

@{
    ViewData["Title"] = "Delete Supplier";
}

<div class="supplier-page">

    <div class="supplier-page-header">
        <div>
            <h2 class="supplier-page-title">Delete Supplier</h2>
            <p class="supplier-page-subtitle">
                Review the supplier details before confirming deletion.
            </p>
        </div>

        <a asp-controller="Supplier"
           asp-action="SupplierList"
           class="supplier-btn-outline">
            <i class="bi bi-arrow-left"></i>
            Back to Suppliers
        </a>
    </div>

    <div class="supplier-delete-card">

        <div class="d-flex align-items-start gap-3 mb-4">

            <i class="bi bi-exclamation-triangle-fill fs-2 text-danger"></i>

            <div>
                <h5 class="fw-bold mb-2" style="color:#183244;">
                    Confirm Supplier Deletion
                </h5>

                <p class="text-muted mb-0">
                    Are you sure you want to delete this supplier?
                    This action cannot be undone.
                </p>
            </div>

        </div>

        <div class="row g-4 mb-4">

            <div class="col-md-6">
                <div class="supplier-stat-label">Company Name</div>
                <div class="supplier-name">@Model.CompanyName</div>
            </div>

            <div class="col-md-6">
                <div class="supplier-stat-label">Supplier ID</div>
                <div class="fw-semibold">#@Model.SupplierId</div>
            </div>

            <div class="col-md-6">
                <div class="supplier-stat-label">Contact Person</div>
                <div>@Model.ContactPerson</div>
            </div>

            <div class="col-md-6">
                <div class="supplier-stat-label">Telephone / Cell</div>
                <div>@Model.ContactNumber</div>
            </div>

            <div class="col-md-6">
                <div class="supplier-stat-label">Email Address</div>
                <div>@Model.Email</div>
            </div>

            <div class="col-md-6">
                <div class="supplier-stat-label">Credit Terms</div>
                <div>@Model.CreditTerms</div>
            </div>

        </div>

        <hr class="my-4" />

        <form asp-controller="Supplier"
              asp-action="DeleteSupplierConfirmed"
              asp-route-supplierId="@Model.SupplierId"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="SupplierId" />

            <div class="supplier-form-actions">

                <a asp-controller="Supplier"
                   asp-action="SupplierList"
                   class="supplier-btn-outline">
                    Cancel
                </a>

                <button type="submit" class="supplier-btn-danger">
                    <i class="bi bi-trash3"></i>
                    Delete Supplier
                </button>

            </div>

        </form>

    </div>

</div>