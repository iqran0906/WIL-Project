@model IEnumerable<FMCGEnterpriseManagementSystem.ViewModels.SupplierViewModel>

@{
    ViewData["Title"] = "Suppliers";
}

<div class="px-2 py-3">
    <h2 class="text-white fw-bold mb-3">Suppliers</h2>

    <div class="mb-4">
        <a asp-controller="Supplier" asp-action="AddSupplier" class="btn btn-action-primary text-decoration-none">
            New Supplier
        </a>
    </div>

    <div class="d-flex align-items-center gap-2 mb-4">
        <span class="text-white fw-bold">Keyword:</span>
        <div class="position-relative">
            <input type="text" class="form-control form-control-sm search-field" placeholder="Supplier Code, Name, Area, etc">
            <i class="bi bi-search position-absolute end-0 top-50 translate-middle-y me-2 text-white-50 small"></i>
        </div>
    </div>

    <div class="table-responsive">
        <table class="custom-data-table">
            <thead>
                <tr>
                    <th>Supplier Name</th>
                    <th>Credit Limit</th>
                    <th>Credit Terms</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var supplier in Model)
                    {
                        <tr>
                            <td>@supplier.CompanyName</td>
                            <td>R @supplier.CreditLimit.ToString("N2")</td>
                            <td>@supplier.CreditTerms</td>
                            <td class="text-end">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-secondary dropdown-toggle" type="button" id="actionMenuButton@supplier.SupplierId" data-bs-toggle="dropdown" aria-expanded="false">
                                        Actions
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="actionMenuButton@supplier.SupplierId">
                                        <li>
                                            <a class="dropdown-item" asp-controller="Supplier" asp-action="EditSupplier" asp-route-id="@supplier.SupplierId">
                                                <i class="bi bi-pencil me-2"></i> Edit
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item text-danger" asp-controller="Supplier" asp-action="DeleteSupplier" asp-route-id="@supplier.SupplierId">
                                                <i class="bi bi-trash me-2"></i> Delete
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-white py-3">No suppliers found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>