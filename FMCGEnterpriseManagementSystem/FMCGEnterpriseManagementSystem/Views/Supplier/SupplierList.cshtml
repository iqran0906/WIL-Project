@model IEnumerable<FMCGEnterpriseManagementSystem.ViewModels.SupplierViewModel>

@{
    ViewData["Title"] = "Suppliers";
}

<div class="supplier-page">

    <div class="supplier-page-header">
        <div>
            <h2 class="supplier-page-title">Supplier Management</h2>
            <p class="supplier-page-subtitle">
                Manage active supplier relationships, contact information and credit terms.
            </p>
        </div>

        <div class="supplier-header-actions">
            <a asp-controller="Supplier"
               asp-action="DeactivatedSuppliers"
               class="supplier-btn-outline">
                <i class="bi bi-archive"></i>
                Deactivated Suppliers
            </a>

            <a asp-controller="Supplier"
               asp-action="AddSupplier"
               class="supplier-btn-primary">
                <i class="bi bi-plus-lg"></i>
                New Supplier
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    <!-- SUMMARY CARDS -->
    <div class="row g-3 mb-4">

        <div class="col-6 col-xl-3">
            <div class="supplier-stat-card">
                <div class="supplier-stat-label">Total Suppliers</div>
                <div class="supplier-stat-value">@ViewBag.TotalSuppliers</div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="supplier-stat-card active">
                <div class="supplier-stat-label">Active Suppliers</div>
                <div class="supplier-stat-value">@ViewBag.ActiveSuppliers</div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="supplier-stat-card inactive">
                <div class="supplier-stat-label">Deactivated Suppliers</div>
                <div class="supplier-stat-value">@ViewBag.InactiveSuppliers</div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="supplier-stat-card credit">
                <div class="supplier-stat-label">Active Credit Limit</div>
                <div class="supplier-stat-value fs-4">
                    R @(((decimal)ViewBag.TotalCreditLimit).ToString("N2"))
                </div>
            </div>
        </div>

    </div>

    <!-- SEARCH -->
    <div class="supplier-filter-panel">

        <form asp-controller="Supplier"
              asp-action="SupplierList"
              method="get">

            <div class="row g-3 align-items-end">

                <div class="col-lg-8">
                    <label class="supplier-filter-label">
                        Search Active Suppliers
                    </label>

                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="form-control"
                           placeholder="Company, contact, email or VAT number..." />
                </div>

                <div class="col-lg-4">
                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="supplier-btn-primary flex-fill">
                            <i class="bi bi-search"></i>
                            Search
                        </button>

                        <a asp-controller="Supplier"
                           asp-action="SupplierList"
                           class="supplier-btn-outline">
                            Clear
                        </a>

                    </div>
                </div>

            </div>
        </form>

    </div>

    <!-- SUPPLIER TABLE -->
    <div class="supplier-table-container">

        <table class="supplier-table">

            <thead>
                <tr>
                    <th>Supplier</th>
                    <th>Contact</th>
                    <th>Credit</th>
                    <th>VAT Number</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var supplier in Model)
                    {
                        <tr>
                            <td>
                                <div class="supplier-name">
                                    @supplier.CompanyName
                                </div>

                                @if (!string.IsNullOrWhiteSpace(supplier.PhysicalAddress))
                                {
                                    <div class="supplier-secondary-text">
                                        @supplier.PhysicalAddress
                                    </div>
                                }
                            </td>

                            <td>
                                <div class="fw-semibold">
                                    @supplier.ContactPerson
                                </div>

                                <div class="supplier-secondary-text">
                                    @supplier.Email
                                </div>

                                <div class="supplier-secondary-text">
                                    @supplier.ContactNumber
                                </div>
                            </td>

                            <td>
                                <div class="fw-semibold">
                                    R @supplier.CreditLimit.ToString("N2")
                                </div>

                                <div class="supplier-secondary-text">
                                    @supplier.CreditTerms
                                </div>
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(supplier.VATNumber)
                                    ? "Not provided"
                                    : supplier.VATNumber)
                            </td>

                            <td>
                                <span class="supplier-badge supplier-badge-active">
                                    Active
                                </span>
                            </td>

                            <td>
                                <div class="supplier-actions">

                                    <a asp-controller="Supplier"
                                       asp-action="Products"
                                       asp-route-id="@supplier.SupplierId"
                                       class="supplier-action-btn supplier-action-view">
                                        <i class="bi bi-box-seam"></i>
                                        View Products
                                    </a>

                                    <a asp-controller="Supplier"
                                       asp-action="EditSupplier"
                                       asp-route-id="@supplier.SupplierId"
                                       class="supplier-action-btn supplier-action-edit">
                                        <i class="bi bi-pencil-square"></i>
                                        Edit
                                    </a>

                                    <form asp-controller="Supplier"
                                          asp-action="DeactivateSupplier"
                                          asp-route-id="@supplier.SupplierId"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="supplier-action-btn supplier-action-danger">
                                            <i class="bi bi-slash-circle"></i>
                                            Deactivate
                                        </button>

                                    </form>

                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">
                            <div class="supplier-empty-state">
                                <i class="bi bi-truck fs-2 d-block mb-2"></i>
                                <strong>No active suppliers found</strong>
                                <p class="mb-0 mt-2">
                                    Try changing your search or add a new supplier.
                                </p>
                            </div>
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>