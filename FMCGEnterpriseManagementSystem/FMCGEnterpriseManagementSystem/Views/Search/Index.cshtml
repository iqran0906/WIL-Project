@*
    File: Views/Search/Index.cshtml

    Purpose:
    Displays global search results grouped by record category.
    Allows users to search for records and navigate to the
    corresponding system pages.

   
    References:
    Microsoft (n.d.) Razor syntax reference for ASP.NET Core.
    Available at: https://learn.microsoft.com/en-us/aspnet/core/mvc/views/razor

    Bootstrap (n.d.) Forms.
    Available at: https://getbootstrap.com/docs/5.3/forms/overview/

    MDN Web Docs (n.d.) HTML search input.
    Available at: https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input/search
*@

@model FMCGEnterpriseManagementSystem.ViewModels.GlobalSearchViewModel

@{
    ViewData["Title"] = "Search Results";
}

<style>
    /* ==========================================
       GLOBAL SEARCH PAGE
       ========================================== */

    .global-search-page {
        background: #e6edf1;
        border: 1px solid rgba(53, 127, 145, 0.18);
        border-radius: 15px;
        padding: 30px;
        min-height: 75vh;
        color: #183244;
        font-size: 16px;
    }

    /* PAGE HEADER */

    .global-search-header {
        display: flex;
        align-items: center;
        gap: 17px;
        margin-bottom: 28px;
    }

    .global-search-header-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 58px;
        height: 58px;
        flex-shrink: 0;
        background: #dce9ee;
        border: 1px solid #c9d9df;
        border-radius: 12px;
        color: #357f91;
        font-size: 26px;
    }

    .global-search-title {
        color: #183244;
        font-size: 30px;
        font-weight: 800;
        margin: 0 0 6px;
    }

    .global-search-description {
        color: #667988;
        font-size: 16px;
        line-height: 1.5;
        margin: 0;
    }

    /* SEARCH PANEL */

    .global-search-panel {
        background: #f8fafb;
        border: 1px solid #c9d9df;
        border-top: 3px solid #357f91;
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 28px;
    }

    .global-search-panel-title {
        color: #183244;
        font-size: 20px;
        font-weight: 800;
        margin: 0 0 8px;
    }

    .global-search-panel-description {
        color: #667988;
        font-size: 15px;
        margin-bottom: 18px;
        line-height: 1.5;
    }

    .global-search-form {
        display: flex;
        align-items: stretch;
        gap: 12px;
        max-width: 850px;
    }

    .global-search-input-wrapper {
        display: flex;
        align-items: center;
        flex: 1;
        min-width: 0;
        background: #fff;
        border: 1px solid #c9d9df;
        border-radius: 9px;
        overflow: hidden;
    }

    .global-search-input-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 15px;
        color: #357f91;
        font-size: 21px;
    }

    .global-search-input {
        flex: 1;
        min-width: 0;
        width: 100%;
        border: none;
        outline: none;
        background: transparent;
        color: #183244;
        font-size: 16px;
        padding: 13px 12px 13px 0;
    }

    .global-search-input::placeholder {
        color: #8496a0;
    }

    .global-search-input-wrapper:focus-within {
        border-color: #357f91;
        box-shadow: 0 0 0 3px rgba(53, 127, 145, 0.12);
    }

    .global-search-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        background: #357f91;
        border: 1px solid #357f91;
        border-radius: 9px;
        padding: 12px 25px;
        color: #fff;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        white-space: nowrap;
        transition: 0.2s ease;
    }

    .global-search-button:hover {
        background: #286675;
        border-color: #286675;
    }

    /* RESULTS SUMMARY */

    .global-search-summary {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        background: #edf3f5;
        border: 1px solid #c9d9df;
        border-radius: 10px;
        padding: 16px 20px;
        margin-bottom: 26px;
        color: #536b78;
        font-size: 16px;
    }

    .global-search-summary i {
        color: #357f91;
        font-size: 20px;
    }

    .global-search-summary strong {
        color: #183244;
        font-weight: 800;
        overflow-wrap: anywhere;
    }

    /* RESULT GROUPS */

    .global-search-group {
        margin-bottom: 28px;
    }

    .global-search-group-header {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 13px;
    }

    .global-search-group-title {
        color: #183244;
        font-size: 20px;
        font-weight: 800;
        margin: 0;
    }

    .global-search-group-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 30px;
        padding: 5px 11px;
        background: #dce9ee;
        border-radius: 7px;
        color: #286675;
        font-size: 14px;
        font-weight: 800;
    }

    /* RESULT CARD */

    .global-search-results-card {
        background: #f8fafb;
        border: 1px solid #c9d9df;
        border-top: 3px solid #357f91;
        border-radius: 12px;
        padding: 5px 23px;
    }

    /* RESULT ROW */

    .global-search-result-row {
        display: flex;
        align-items: flex-start;
        gap: 17px;
        padding: 22px 0;
    }

    .global-search-result-row + .global-search-result-row {
        border-top: 1px solid #d9e4e9;
    }

    .global-search-result-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        flex-shrink: 0;
        background: #dce9ee;
        border-radius: 10px;
        color: #357f91;
        font-size: 22px;
    }

    .global-search-result-content {
        flex: 1;
        min-width: 0;
    }

    .global-search-result-heading {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 7px;
    }

    .global-search-result-title {
        color: #183244;
        font-size: 17px;
        font-weight: 800;
        line-height: 1.5;
        overflow-wrap: anywhere;
    }

    .global-search-exact-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: #dce9ee;
        color: #286675;
        border-radius: 6px;
        padding: 6px 10px;
        font-size: 14px;
        font-weight: 700;
    }

    .global-search-result-subtitle {
        color: #667988;
        font-size: 15px;
        line-height: 1.5;
        margin-bottom: 9px;
        overflow-wrap: anywhere;
    }

    /* RESULT DETAILS */

    .global-search-result-details {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px 20px;
        margin-top: 13px;
    }

    .global-search-detail {
        font-size: 15px;
        line-height: 1.5;
        overflow-wrap: anywhere;
    }

    .global-search-detail-label {
        color: #667988;
        font-weight: 600;
    }

    .global-search-detail-value {
        color: #183244;
        font-weight: 600;
    }

    /* OPEN RECORD BUTTON */

    .global-search-open-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        flex-shrink: 0;
        align-self: center;
        background: #357f91;
        border: 1px solid #357f91;
        border-radius: 8px;
        color: #fff;
        font-size: 15px;
        font-weight: 700;
        padding: 11px 17px;
        text-decoration: none;
        white-space: nowrap;
        transition: 0.2s ease;
    }

    .global-search-open-button:hover {
        background: #286675;
        border-color: #286675;
        color: #fff;
    }

    /* EMPTY STATE */

    .global-search-empty-card {
        background: #f8fafb;
        border: 1px solid #c9d9df;
        border-top: 3px solid #357f91;
        border-radius: 12px;
        padding: 48px 25px;
        text-align: center;
    }

    .global-search-empty-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 75px;
        height: 75px;
        margin: 0 auto 20px;
        background: #dce9ee;
        border-radius: 50%;
        color: #357f91;
        font-size: 32px;
    }

    .global-search-empty-title {
        color: #183244;
        font-size: 21px;
        font-weight: 800;
        margin-bottom: 12px;
        overflow-wrap: anywhere;
    }

    .global-search-empty-description {
        color: #667988;
        font-size: 16px;
        line-height: 1.6;
        max-width: 580px;
        margin: 0 auto;
    }

    /* RESPONSIVE */

    @@media (max-width: 992px) {
        .global-search-result-details {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .global-search-page {
            padding: 18px;
        }

        .global-search-title {
            font-size: 26px;
        }

        .global-search-panel {
            padding: 18px;
        }

        .global-search-form {
            flex-direction: column;
        }

        .global-search-button {
            width: 100%;
        }

        .global-search-results-card {
            padding: 5px 16px;
        }

        .global-search-result-row {
            flex-wrap: wrap;
            gap: 13px;
        }

        .global-search-result-content {
            flex-basis: calc(100% - 65px);
        }

        .global-search-open-button {
            width: 100%;
            margin-top: 6px;
        }

        .global-search-result-details {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="global-search-page">

    @* ==========================================
       PAGE HEADER
       ========================================== *@

    <div class="global-search-header">

        <div class="global-search-header-icon">
            <i class="bi bi-search"></i>
        </div>

        <div>
            <h1 class="global-search-title">
                Search Results
            </h1>

            <p class="global-search-description">
                Search and locate records across the
                Exclusive Distributors Management System.
            </p>
        </div>

    </div>


    @* ==========================================
       SEARCH AGAIN
       ========================================== *@

    <div class="global-search-panel">

        <h2 class="global-search-panel-title">
            Global Search
        </h2>

        <p class="global-search-panel-description">
            Enter a record number, item code, name
            or other identifying information.
        </p>

        <form asp-controller="Search"
              asp-action="Index"
              method="get"
              class="global-search-form"
              role="search">

            <div class="global-search-input-wrapper">

                <span class="global-search-input-icon"
                      aria-hidden="true">
                    <i class="bi bi-search"></i>
                </span>

                <input type="search"
                       name="q"
                       value="@Model.Query"
                       class="global-search-input"
                       placeholder="Customer no., item code, invoice no., name..."
                       aria-label="Search records" />

            </div>

            <button type="submit"
                    class="global-search-button">

                <i class="bi bi-search"></i>
                Search

            </button>

        </form>

    </div>


    @* ==========================================
       SEARCH RESULTS
       ========================================== *@

    @if (Model.TotalResults == 0)
    {
        <div class="global-search-empty-card">

            <div class="global-search-empty-icon">
                <i class="bi bi-search"></i>
            </div>

            <h2 class="global-search-empty-title">
                No results found for "@Model.Query"
            </h2>

            <p class="global-search-empty-description">
                Try searching with a customer number,
                item code, invoice number, quote number,
                or part of a name, email address
                or phone number.
            </p>

        </div>
    }
    else
    {
        @* Display the total number of matching records. *@

        <div class="global-search-summary">

            <i class="bi bi-check-circle"></i>

            <span>
                <strong>
                    @Model.TotalResults
                    result@(Model.TotalResults == 1 ? "" : "s")
                </strong>

                found for

                <strong>"@Model.Query"</strong>
            </span>

        </div>


        @* Group results by record category. *@

        @foreach (var group in Model.Results.GroupBy(r => r.Category))
        {
            <section class="global-search-group">

                <div class="global-search-group-header">

                    <h2 class="global-search-group-title">
                        @group.Key
                    </h2>

                    <span class="global-search-group-count">
                        @group.Count()
                    </span>

                </div>


                <div class="global-search-results-card">

                    @* Exact matches appear first, as in the original view. *@

                    @foreach (var result in group.OrderByDescending(r => r.IsExactMatch))
                    {
                        <div class="global-search-result-row">

                            <div class="global-search-result-icon"
                                 aria-hidden="true">

                                <i class="bi @result.Icon"></i>

                            </div>


                            <div class="global-search-result-content">

                                <div class="global-search-result-heading">

                                    <div class="global-search-result-title">
                                        @result.Title
                                    </div>

                                    @if (result.IsExactMatch)
                                    {
                                        <span class="global-search-exact-badge">

                                            <i class="bi bi-check-circle-fill"></i>
                                            Exact Match

                                        </span>
                                    }

                                </div>


                                @if (!string.IsNullOrWhiteSpace(result.Subtitle))
                                {
                                    <div class="global-search-result-subtitle">
                                        @result.Subtitle
                                    </div>
                                }


                                @if (result.Details.Any())
                                {
                                    <div class="global-search-result-details">

                                        @foreach (var detail in result.Details)
                                        {
                                            <div class="global-search-detail">

                                                <span class="global-search-detail-label">
                                                    @detail.Key:
                                                </span>

                                                <span class="global-search-detail-value">
                                                    @detail.Value
                                                </span>

                                            </div>
                                        }

                                    </div>
                                }

                            </div>


                            @* Preserve controller, action and route values. *@

                            <a asp-controller="@result.Controller"
                               asp-action="@result.Action"
                               asp-all-route-data="@result.RouteValues"
                               class="global-search-open-button">

                                @result.LinkText

                                <i class="bi bi-arrow-right"></i>

                            </a>

                        </div>
                    }

                </div>

            </section>
        }
    }

</div>