</style>


@* =====================================================
   SUCCESS AND ERROR MESSAGES
   ===================================================== *@

@if (!isPdfMode && TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        <i class="bi bi-check-circle me-2"></i>

        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>

    </div>
}

@if (!isPdfMode && TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"
         role="alert">

        <i class="bi bi-exclamation-triangle me-2"></i>

        @TempData["ErrorMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>

    </div>
}


@* =====================================================
   INVOICE APPROVAL AND PAYMENT STATUS
   ===================================================== *@

<div class="invoice-details-page">

    <div class="invoice-section-card">

        <div class="row g-3 align-items-center">

            <div class="col-md-6">

                <div class="invoice-detail-label mb-2">
                    Invoice Status
                </div>

                @if (isPending)
                {
                    <span class="invoice-status-badge invoice-status-pending">
                        <i class="bi bi-clock me-1"></i>
                        Pending Approval
                    </span>
                }
                else if (isApproved)
                {
                    <span class="invoice-status-badge invoice-status-approved">
                        <i class="bi bi-check-circle me-1"></i>
                        Approved
                    </span>
                }
                else
                {
                    <span class="invoice-status-badge invoice-status-other">
                        @Model.Status
                    </span>
                }

            </div>

            <div class="col-md-6">

                <div class="invoice-detail-label mb-2">
                    Payment Status
                </div>

                @if (isFullyPaid)
                {
                    <span class="invoice-status-badge invoice-status-approved">
                        <i class="bi bi-check-circle me-1"></i>
                        Paid in Full
                    </span>
                }
                else if (isPartiallyPaid)
                {
                    <span class="invoice-status-badge invoice-status-partial">
                        <i class="bi bi-hourglass-split me-1"></i>
                        Partially Paid
                    </span>
                }
                else if (isUnpaid)
                {
                    <span class="invoice-status-badge invoice-status-unpaid">
                        <i class="bi bi-clock-history me-1"></i>
                        Unpaid
                    </span>
                }
                else
                {
                    <span class="invoice-status-badge invoice-status-other">
                        Not Yet Approved
                    </span>
                }

            </div>

        </div>

    </div>


    @* =====================================================
       COMPANY AND INVOICE HEADER
       ===================================================== *@

    <div class="row align-items-center mb-4 g-3">

        <div class="col-md-6">

            <div class="invoice-company-name">
                Exclusive Distributors (Pty) Ltd
            </div>

            <div class="invoice-muted">
                Durban
            </div>

        </div>

        <div class="col-md-6 text-md-end">

            <div class="invoice-detail-label">
                Invoice Date
            </div>

            <div class="invoice-detail-value mb-2">
                @Model.InvoiceDate.ToString("dd MMMM yyyy")
            </div>

            <div class="invoice-detail-label">
                Invoice Number
            </div>

            <div class="invoice-detail-value">
                @Model.InvoiceNumber
            </div>

        </div>

    </div>


    <h2 class="mb-4">
        Invoice Preview
    </h2>


    @* =====================================================
       CUSTOMER AND PAYMENT TERMS
       ===================================================== *@

    <div class="invoice-section-card">

        <h5 class="invoice-section-heading">
            <i class="bi bi-person me-2"></i>
            Customer Information
        </h5>

        <div class="row g-3">

            <div class="col-md-6">

                <div class="invoice-detail-label">
                    Customer
                </div>

                <div class="invoice-detail-value">
                    @Model.CustomerName
                </div>

            </div>

            <div class="col-md-6">

                <div class="invoice-detail-label">
                    Payment Terms
                </div>

                <div class="invoice-detail-value">
                    @Model.PaymentTerms
                </div>

            </div>

        </div>

    </div>


    @* =====================================================
       INVOICE ITEMS
       ===================================================== *@

    <div class="invoice-section-card">

        <h5 class="invoice-section-heading">
            <i class="bi bi-box-seam me-2"></i>
            Invoice Items
        </h5>

        <div class="invoice-table-wrapper">

            <table class="invoice-items-table">

                <thead>

                    <tr>
                        <th>Quantity</th>
                        <th>Product Code</th>
                        <th>Description</th>
                        <th class="text-end">Unit Price</th>
                        <th class="text-end">Disc %</th>
                        <th class="text-end">Total (excl. VAT)</th>
                        <th class="text-end">VAT</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model.Items)
                    {
                        // Preserve the existing invoice line calculation.
                        var lineExVat =
                            item.VatCategory == "[NONE]"
                                ? item.LineTotal
                                : item.LineTotal / 1.15m;

                        var lineVatAmount =
                            item.LineTotal - lineExVat;

                        <tr>

                            <td>
                                @item.Quantity
                            </td>

                            <td>
                                @item.ItemCode
                            </td>

                            <td>
                                @item.Description
                            </td>

                            <td class="text-end">
                                @($"R{item.UnitPrice:0.00}")
                            </td>

                            <td class="text-end">
                                @($"{item.DiscountPercent:0.00}%")
                            </td>

                            <td class="text-end">
                                @($"R{lineExVat:0.00}")
                            </td>

                            <td class="text-end">
                                @($"R{lineVatAmount:0.00}")
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>


    @* =====================================================
       BANKING DETAILS AND PAYMENT SUMMARY
       ===================================================== *@

    <div class="row g-4">

        <div class="col-lg-6">

            <div class="invoice-section-card h-100">

                <h5 class="invoice-section-heading">
                    <i class="bi bi-bank me-2"></i>
                    Banking Details
                </h5>

                <div class="invoice-bank-details">

                    <div>
                        <strong>Bank:</strong>
                        FNB
                    </div>

                    <div>
                        <strong>Branch Code:</strong>
                        250655
                    </div>

                    <div>
                        <strong>Account Name:</strong>
                        Exclusive Distributors (Pty) Ltd
                    </div>

                    <div>
                        <strong>Account Number:</strong>
                        63191446202
                    </div>

                    <div>
                        <strong>Reference:</strong>
                        Invoice @Model.InvoiceNumber
                    </div>

                    <div>
                        <strong>Proof of Payment:</strong>
                        exclusivedistributors2@gmail.com
                    </div>

                    <div class="mt-3 fst-italic">
                        Thanking you for your business!
                    </div>

                </div>

            </div>

        </div>


        <div class="col-lg-6">

            <div class="invoice-payment-summary">

                <h5 class="invoice-section-heading">
                    <i class="bi bi-calculator me-2"></i>
                    Payment Summary
                </h5>


                <div class="invoice-summary-row">

                    <span>
                        Subtotal (excl. VAT)
                    </span>

                    <strong>
                        @($"R{Model.Subtotal:0.00}")
                    </strong>

                </div>


                <div class="invoice-summary-row">

                    <span>
                        VAT
                    </span>

                    <strong>
                        @($"R{Model.VatTotal:0.00}")
                    </strong>

                </div>


                <div class="invoice-summary-row invoice-summary-total">

                    <span>
                        Invoice Total
                    </span>

                    <strong>
                        @($"R{Model.Total:0.00}")
                    </strong>

                </div>


                @if (isApproved)
                {
                    <div class="invoice-summary-row">

                        <span>
                            Amount Paid
                        </span>

                        <strong>
                            @($"R{amountPaid:0.00}")
                        </strong>

                    </div>


                    <div class="invoice-summary-row invoice-outstanding">

                        <span>
                            Outstanding Balance
                        </span>

                        <strong>
                            @($"R{Model.AmountDue:0.00}")
                        </strong>

                    </div>


                    @if (isFullyPaid)
                    {
                        <div class="invoice-paid-full">

                            <i class="bi bi-check-circle me-2"></i>

                            PAID IN FULL

                        </div>
                    }
                    else if (isPartiallyPaid)
                    {
                        <div class="mt-3">

                            <span class="invoice-status-badge invoice-status-partial">
                                <i class="bi bi-hourglass-split me-1"></i>
                                PARTIALLY PAID
                            </span>

                        </div>
                    }
                    else
                    {
                        <div class="mt-3">

                            <span class="invoice-status-badge invoice-status-unpaid">
                                PAYMENT OUTSTANDING
                            </span>

                        </div>
                    }
                }

            </div>

        </div>

    </div>


    @* =====================================================
       EMAIL AND NAVIGATION BUTTONS
       ===================================================== *@

    @if (!isPdfMode)
    {
        <div class="invoice-actions invoice-no-print">

            @if (User.IsInRole("Administrator") && isPending)
{
    <button type="button"
            class="invoice-btn-primary"
            data-bs-toggle="modal"
            data-bs-target="#approveInvoiceModal">

        <i class="bi bi-check-circle"></i>
        Approve Invoice

    </button>
}
            <button type="button"
                    class="invoice-btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#emailInvoiceModal">

                <i class="bi bi-envelope"></i>
                Email Invoice
            </button>

            <a asp-controller="Invoices"
               asp-action="Index"
               class="invoice-btn-outline">

                <i class="bi bi-arrow-left"></i>
                Back to Invoices
            </a>

        </div>
    }

</div>


@* =====================================================
   EMAIL INVOICE MODAL
   ===================================================== *@

@if (!isPdfMode)
{
    <div class="modal fade"
         id="emailInvoiceModal"
         tabindex="-1"
         aria-labelledby="emailInvoiceModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <form asp-controller="Invoices"
                      asp-action="EmailInvoice"
                      method="post"
                      id="emailInvoiceForm">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.InvoiceId" />

                    <div class="modal-header">

                        <h5 class="modal-title"
                            id="emailInvoiceModalLabel">

                            Email Invoice @Model.InvoiceNumber

                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>

                    </div>

                    <div class="modal-body">

                        <label for="recipientEmail"
                               class="form-label fw-semibold">

                            Recipient Email

                        </label>

                        <input type="email"
                               id="recipientEmail"
                               name="recipientEmail"
                               class="form-control"
                               value="@ViewBag.CustomerEmail"
                               required
                               placeholder="customer@example.com" />

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-outline-secondary"
                                data-bs-dismiss="modal">

                            Cancel

                        </button>

                        <button type="submit"
                                id="sendInvoiceButton"
                                class="btn btn-primary">

                            <i class="bi bi-send me-1"></i>
                            Send Invoice

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>
}


@* =====================================================
   APPROVE INVOICE CONFIRMATION MODAL
   Only administrators can approve pending invoices.
   ===================================================== *@

@if (!isPdfMode && User.IsInRole("Administrator") && isPending)
{
    <div class="modal fade"
         id="approveInvoiceModal"
         tabindex="-1"
         aria-labelledby="approveInvoiceModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content shadow">

                <div class="modal-header">

                    <h5 class="modal-title fw-bold"
                        id="approveInvoiceModalLabel">

                        <i class="bi bi-check-circle me-2"></i>
                        Approve Invoice

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>


                <div class="modal-body">

                    <p class="mb-3">

                        Are you sure you want to approve
                        <strong>@Model.InvoiceNumber</strong>?

                    </p>

                    <div class="alert alert-warning mb-0">

                        <div class="d-flex">

                            <i class="bi bi-exclamation-triangle-fill me-2 mt-1"></i>

                            <div>

                                <strong>
                                    This action finalises the invoice.
                                </strong>

                                <div class="small mt-1">

                                    Once approved, the invoice will be locked
                                    and the related inventory stock will be deducted.

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>


                    <form asp-controller="Invoices"
                          asp-action="UpdateStatus"
                          asp-route-id="@Model.InvoiceId"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="status"
                               value="Approved" />

                        <button type="submit"
                                class="btn btn-success">

                            <i class="bi bi-check-circle me-1"></i>
                            Yes, Approve Invoice

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>
}


@* =====================================================
   PAGE SCRIPTS
   ===================================================== *@

@if (!isPdfMode)
{
    <script>
        /*
         * Prevent duplicate email submissions.
         *
         * Reference:
         * MDN Web Docs (n.d.) HTMLFormElement submit event.
         */

        const emailInvoiceForm =
            document.getElementById('emailInvoiceForm');

        if (emailInvoiceForm) {
            emailInvoiceForm.addEventListener('submit', function () {

                const sendButton =
                    document.getElementById('sendInvoiceButton');

                if (sendButton) {
                    sendButton.disabled = true;
                    sendButton.innerHTML = 'Sending...';
                }
            });
        }
    </script>
}