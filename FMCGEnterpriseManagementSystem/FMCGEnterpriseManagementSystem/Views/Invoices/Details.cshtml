@*
    File: Views/Invoices/Details.cshtml

    Purpose:
    Display invoice details, invoice approval status,
    payment status, payment summary, banking details,
    and invoice email functionality.

    Original Authors:
    Sayali-St10458649, iqran0906 (Git history).

    UI Improvements and Integration:
    Iqra Nazir (2026).

    

    References:
    Bootstrap (n.d.) Components and utilities.
    https://getbootstrap.com/docs/5.3/

    Microsoft (n.d.) ASP.NET Core MVC Razor views.
    https://learn.microsoft.com/en-us/aspnet/core/mvc/views/razor

    MDN Web Docs (n.d.) HTML forms.
    https://developer.mozilla.org/en-US/docs/Learn_web_development/Extensions/Forms
*@

@model FMCGEnterpriseManagementSystem.ViewModels.InvoiceViewModel

@{
    ViewData["Title"] = "Invoice Preview";

    // Preserve the existing PDF layout selection
    Layout = Context.Request.Query.ContainsKey("pdfmode")
        ? "_PdfLayout"
        : "_Layout";

    // The invoice's payment balance is supplied by the existing ViewModel.
   
    var isApproved = Model.Status == "Approved";
    var isPending = Model.Status == "Pending";

    var amountPaid = Model.Total - Model.AmountDue;

   
    if (amountPaid < 0)
    {
        amountPaid = 0;
    }

    var isFullyPaid = isApproved && Model.AmountDue <= 0;
    var isPartiallyPaid = isApproved
        && Model.AmountDue > 0
        && Model.AmountDue < Model.Total;

    var isUnpaid = isApproved
        && Model.AmountDue >= Model.Total;

    var isPdfMode = Context.Request.Query.ContainsKey("pdfmode");
}

<style>
    /*
