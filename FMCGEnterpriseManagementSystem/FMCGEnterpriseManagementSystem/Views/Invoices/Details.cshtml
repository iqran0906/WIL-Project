@*
    Purpose: Details of a single invoice.
    Authors: Sayali-St10458649, iqran0906 (from git history)
*@
@model FMCGEnterpriseManagementSystem.ViewModels.InvoiceViewModel

@{
    ViewData["Title"] = "Invoice Preview";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i>
        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>
        @TempData["ErrorMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <span class="fw-bold text-secondary me-2">
            Invoice Status:
        </span>

        @if (Model.Status == "Pending")
        {
            <span class="badge bg-warning text-dark fs-6">
                <i class="bi bi-clock me-1"></i>
                Pending Approval
            </span>
        }
        else if (Model.Status == "Approved" && Model.AmountDue <= 0)
        {
            <span class="badge bg-success fs-6">
                <i class="bi bi-check-circle me-1"></i>
                Paid
            </span>
        }
        else if (Model.Status == "Approved" &&
                 Model.AmountDue < Model.Total)
        {
            <span class="badge bg-info text-dark fs-6">
                <i class="bi bi-hourglass-split me-1"></i>
                Partially Paid
            </span>
        }
        else if (Model.Status == "Approved")
        {
            <span class="badge bg-success fs-6">
                <i class="bi bi-check-circle me-1"></i>
                Approved
            </span>
        }
        else
        {
            <span class="badge bg-secondary fs-6">
                @Model.Status
            </span>
        }
    </div>

    @if (User.IsInRole("Administrator") && Model.Status == "Pending")
    {
        <button type="button"
                class="btn btn-success"
                data-bs-toggle="modal"
                data-bs-target="#approveInvoiceModal">

            <i class="bi bi-check-circle me-1"></i>
            Approve Invoice

        </button>
    }

</div>


<div class="content-card">

    <div class="row align-items-center mb-4">

        <div class="col-sm-6">

            <h5 class="fw-bold m-0"
                style="color: #1c323d;">
                Exclusive Distributors (pty) LTD
            </h5>

            <small class="text-muted d-block">
                Durban
            </small>

        </div>

        <div class="col-sm-6 text-sm-end">

            <div class="d-inline-block text-start">

                <div class="d-flex align-items-center gap-2 mb-2">

                    <label class="small text-secondary fw-bold text-nowrap m-0">
                        Date:
                    </label>

                    <span>
                        @Model.InvoiceDate.ToString("yyyy-MM-dd")
                    </span>

                </div>

                <div class="d-flex align-items-center gap-2">

                    <label class="small text-secondary fw-bold text-nowrap m-0">
                        Invoice Number:
                    </label>

                    <span class="fw-bold">
                        @Model.InvoiceNumber
                    </span>

                </div>

            </div>

        </div>

    </div>


    <h2 class="fw-bold mb-4"
        style="color: #1c323d;">
        Invoice Preview
    </h2>


    <div class="row g-3 mb-4">

        <div class="col-md-6">

            <label class="fw-bold text-secondary">
                Customer
            </label>

            <p>
                @Model.CustomerName
            </p>

        </div>

        <div class="col-md-6 text-md-end">

            <label class="fw-bold text-secondary">
                Payment Terms
            </label>

            <p>
                @Model.PaymentTerms
            </p>

        </div>

    </div>


    <div class="table-responsive border rounded bg-light p-2 mb-3">

        <table class="table align-middle m-0 bg-white shadow-sm rounded">

            <thead class="table-secondary text-secondary small">

                <tr>
                    <th>Quantity</th>
                    <th>Product Code</th>
                    <th>Description</th>
                    <th>Unit Price</th>
                    <th>Disc %</th>
                    <th>Total (excl. VAT)</th>
                    <th>VAT</th>
                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model.Items)
                {
                    var lineExVat =
                        item.VatCategory == "[NONE]"
                            ? item.LineTotal
                            : item.LineTotal / 1.15m;

                    var lineVatAmount =
                        item.LineTotal - lineExVat;

                    <tr>

                        <td>
                            @item.Quantity
                        </td>

                        <td>
                            @item.ItemCode
                        </td>

                        <td>
                            @item.Description
                        </td>

                        <td>
                            @($"R{item.UnitPrice:0.00}")
                        </td>

                        <td>
                            @($"{item.DiscountPercent:0.00}%")
                        </td>

                        <td>
                            @($"R{lineExVat:0.00}")
                        </td>

                        <td>
                            @($"R{lineVatAmount:0.00}")
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>


    <div class="row mb-4">

        <div class="col-md-6">

            <div class="border rounded p-3 bg-light">

                <h6 class="fw-bold text-secondary mb-2">
                    Banking Details
                </h6>

                <p class="small mb-1">
                    <strong>Bank:</strong> FNB
                </p>

                <p class="small mb-1">
                    <strong>Branch Code:</strong> 250655
                </p>

                <p class="small mb-1">
                    <strong>Account Name:</strong>
                    Exclusive Distributors (Pty) Ltd
                </p>

                <p class="small mb-1">
                    <strong>Account Number:</strong>
                    63191446202
                </p>

                <p class="small mb-1">
                    <strong>Reference:</strong>
                    Invoice @Model.InvoiceNumber
                </p>

                <p class="small mb-1">
                    <strong>Proof of Payment:</strong>
                    exclusivedistributors2@gmail.com
                </p>

                <p class="small fst-italic mt-2 mb-0">
                    Thanking you for your business!
                </p>

            </div>

        </div>


        <div class="col-md-6 text-end fw-bold text-secondary">

            <div class="d-inline-block text-start"
                 style="min-width: 280px;">

                <div class="d-flex justify-content-between py-1">

                    <span>
                        Subtotal (excl. VAT)
                    </span>

                    <span>
                        @($"R{Model.Subtotal:0.00}")
                    </span>

                </div>

                <div class="d-flex justify-content-between py-1">

                    <span>
                        VAT
                    </span>

                    <span>
                        @($"R{Model.VatTotal:0.00}")
                    </span>

                </div>

                <div class="d-flex justify-content-between py-1 border-top border-dark mt-2 text-dark fs-5">

                    <span>
                        Grand Total
                    </span>

                    <span>
                        @($"R{Model.Total:0.00}")
                    </span>

                </div>


                @if (Model.Status == "Approved" &&
                     Model.AmountDue < Model.Total)
                {
                    <div class="d-flex justify-content-between py-1 mt-2">

                        <span>
                            Amount Paid
                        </span>

                        <span>
                            @($"R{(Model.Total - Model.AmountDue):0.00}")
                        </span>

                    </div>

                    <div class="d-flex justify-content-between py-1 fw-bold">

                        <span>
                            Amount Due
                        </span>

                        <span>
                            @($"R{Model.AmountDue:0.00}")
                        </span>

                    </div>
                }

            </div>

        </div>

    </div>


    <div class="d-flex justify-content-end gap-3">

        <a asp-action="Index"
           class="btn btn-outline-secondary px-4">

            Back to Invoices

        </a>

    </div>

</div>


@* ============================================
   APPROVE INVOICE CONFIRMATION MODAL
   Only administrators can see this modal.
   ============================================ *@

@if (User.IsInRole("Administrator") && Model.Status == "Pending")
{
    <div class="modal fade"
         id="approveInvoiceModal"
         tabindex="-1"
         aria-labelledby="approveInvoiceModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content shadow">

                <div class="modal-header">

                    <h5 class="modal-title fw-bold"
                        id="approveInvoiceModalLabel">

                        <i class="bi bi-check-circle me-2"></i>
                        Approve Invoice

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>


                <div class="modal-body">

                    <p class="mb-3">

                        Are you sure you want to approve
                        <strong>@Model.InvoiceNumber</strong>?

                    </p>

                    <div class="alert alert-warning mb-0">

                        <div class="d-flex">

                            <i class="bi bi-exclamation-triangle-fill me-2 mt-1"></i>

                            <div>

                                <strong>
                                    This action finalises the invoice.
                                </strong>

                                <div class="small mt-1">

                                    Once approved, the invoice will be locked
                                    and the related inventory stock will be
                                    deducted.

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>


                    <form asp-controller="Invoices"
                          asp-action="UpdateStatus"
                          asp-route-id="@Model.InvoiceId"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="status"
                               value="Approved" />

                        <button type="submit"
                                class="btn btn-success">

                            <i class="bi bi-check-circle me-1"></i>
                            Yes, Approve Invoice

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>
}