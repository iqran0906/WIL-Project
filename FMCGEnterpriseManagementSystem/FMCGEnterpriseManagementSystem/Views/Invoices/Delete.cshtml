@model FMCGEnterpriseManagementSystem.ViewModels.InvoiceViewModel

@{
    ViewData["Title"] = "Delete Invoice";
}

<div class="content-card">
    <h2 class="fw-bold mb-4" style="color: #1c323d;">Delete Invoice</h2>
    <h5>Are you sure you want to delete this invoice?</h5>

    <dl class="row mt-4">
        <dt class="col-sm-2">Invoice Number</dt>
        <dd class="col-sm-10">@Model.InvoiceNumber</dd>

        <dt class="col-sm-2">Date</dt>
        <dd class="col-sm-10">@Model.InvoiceDate.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-2">Customer</dt>
        <dd class="col-sm-10">@Model.CustomerName</dd>

        <dt class="col-sm-2">Total</dt>
        <dd class="col-sm-10">R@Model.Total.ToString("0.00")</dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.Status</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="InvoiceId" />
        <div class="d-flex gap-3">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-link text-decoration-none text-secondary">Cancel</a>
        </div>
    </form>
</div>