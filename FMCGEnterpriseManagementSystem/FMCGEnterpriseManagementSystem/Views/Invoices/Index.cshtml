@*
    Purpose: Invoices list page (table with search / filters and actions).
    Authors: Sayali-St10458649 (from git history)*@
@model IEnumerable<FMCGEnterpriseManagementSystem.ViewModels.InvoiceViewModel>

@{
    ViewData["Title"] = "Invoice";
}

<div class="content-card">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-1"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1" style="color:#1c323d;">
                Invoice
            </h2>

            <p class="text-muted mb-0">
                Manage customer invoices, track amounts due, and view statuses.
            </p>
        </div>

        <a asp-controller="Invoices"
           asp-action="Create"
           class="btn btn-action-primary px-4">
            + New Invoice
        </a>

    </div>

    <!-- Search & Filter Form -->
    <form asp-action="Index"
          method="get"
          class="border rounded-3 p-3 mb-4 bg-white">

        <div class="row g-3 align-items-end">

            <div class="col-lg-3">
                <label class="form-label fw-semibold small">Customer</label>
                <select name="customerId"
                        asp-items="ViewBag.CustomerFilter"
                        class="form-select">
                    <option value="">All</option>
                </select>
            </div>

            <div class="col-lg-2">
                <label class="form-label fw-semibold small">Start Date</label>
                <input type="date"
                       name="startDate"
                       value="@ViewBag.StartDate"
                       class="form-control" />
            </div>

            <div class="col-lg-2">
                <label class="form-label fw-semibold small">End Date</label>
                <input type="date"
                       name="endDate"
                       value="@ViewBag.EndDate"
                       class="form-control" />
            </div>

            <div class="col-lg-3">
                <label class="form-label fw-semibold small">Keyword</label>
                <input type="text"
                       name="keyword"
                       value="@ViewBag.Keyword"
                       class="form-control"
                       placeholder="Invoice no. or customer..." />
            </div>

            <div class="col-lg-2">
                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-action-primary flex-fill">
                        Filter
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Clear
                    </a>
                </div>
            </div>

        </div>

    </form>

    @if (ViewBag.DateError != null)
    {
        <div class="alert alert-danger mb-4"><i class="bi bi-exclamation-triangle me-1"></i>@ViewBag.DateError</div>
    }

    <!-- Invoices Table -->
    <div class="table-responsive">

        <table class="custom-data-table align-middle">

            <thead>
                <tr>
                    <th>Date</th>
                    <th>Invoice No.</th>
                    <th>Customer</th>
                    <th>Amount Due</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var invoice in Model)
                    {
                        <tr>

                            <!-- Date -->
                            <td>
                                <div class="fw-semibold">
                                    @invoice.InvoiceDate.ToString("yyyy-MM-dd")
                                </div>
                            </td>

                            <!-- Invoice No. -->
                            <td>
                                <div class="fw-semibold">
                                    @invoice.InvoiceNumber
                                </div>
                            </td>

                            <!-- Customer -->
                            <td>
                                <div class="fw-semibold">
                                    @invoice.CustomerName
                                </div>
                            </td>

                            <!-- Amount Due -->
                            <td>
                                <div class="fw-semibold">
                                    R @invoice.AmountDue.ToString("N2")
                                </div>
                            </td>

                            <!-- Total -->
                            <td>
                                <div class="fw-bold">
                                    R @invoice.Total.ToString("N2")
                                </div>
                            </td>

                            <!-- Status -->
                            <td>
                                @if (invoice.Status == "Approved")
                                {
                                    <span class="badge bg-success px-3 py-2">
                                        Approved
                                    </span>
                                }
                                else if (invoice.Status == "Paid")
                                {
                                    <span class="badge bg-success px-3 py-2">
                                        Paid
                                    </span>
                                }
                                else if (invoice.Status == "Cancelled")
                                {
                                    <span class="badge bg-danger px-3 py-2">
                                        Cancelled
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2">
                                        Pending
                                    </span>
                                }
                            </td>

                            <!-- Actions -->
                            <td>
                                <div class="d-flex justify-content-center gap-2">

                                    <a asp-action="Details"
                                       asp-route-id="@invoice.InvoiceId"
                                       class="btn btn-primary btn-sm">
                                        View
                                    </a>

                                    <a asp-action="Download"
                                       asp-route-id="@invoice.InvoiceId"
                                       class="btn btn-secondary btn-sm">
                                        Download
                                    </a>

                                    <button type="button"
                                            class="btn btn-outline-primary btn-sm email-invoice-btn"
                                            data-invoice-id="@invoice.InvoiceId"
                                            data-invoice-number="@invoice.InvoiceNumber">
                                        Email
                                    </button>

                                    @if (invoice.Status == "Pending")
                                    {
                                        <a asp-action="Delete"
                                           asp-route-id="@invoice.InvoiceId"
                                           class="btn btn-danger btn-sm">
                                            Delete
                                        </a>
                                    }

                                </div>
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7"
                            class="text-center py-5">

                            <div class="fw-semibold mb-1">
                                No invoices match your filters.
                            </div>

                            <div class="text-muted small">
                                Try changing your search or date criteria.
                            </div>

                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

    <div class="modal fade" id="emailInvoiceModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="EmailInvoice" method="post" id="emailInvoiceForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="emailInvoiceId" />
                    <div class="modal-header">
                        <h5 class="modal-title">Email Invoice <span id="emailInvoiceNumberLabel"></span></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label fw-semibold small">Recipient Email</label>
                        <input type="email" name="recipientEmail" class="form-control" required placeholder="customer@example.com" />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-action-primary">Send Email</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        document.querySelectorAll('.email-invoice-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                document.getElementById('emailInvoiceId').value = this.getAttribute('data-invoice-id');
                document.getElementById('emailInvoiceNumberLabel').textContent = this.getAttribute('data-invoice-number');
                new bootstrap.Modal(document.getElementById('emailInvoiceModal')).show();
            });
        });
    </script>
}