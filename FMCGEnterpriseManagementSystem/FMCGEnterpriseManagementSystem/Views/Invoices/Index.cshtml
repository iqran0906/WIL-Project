@*
    Purpose: Invoice listing, filtering, status display and document actions.
    Original authors: Sayali-St10458649, iqran0906 (from Git history).

    References:
    Bootstrap (n.d.) Tables, Forms and Modals.
    https://getbootstrap.com/docs/5.3/
*@

@model IEnumerable<FMCGEnterpriseManagementSystem.ViewModels.InvoiceViewModel>

@{
    ViewData["Title"] = "Invoices";

    var invoices = Model?.ToList()
        ?? new List<FMCGEnterpriseManagementSystem.ViewModels.InvoiceViewModel>();

    var pendingCount = invoices.Count(i => i.Status == "Pending");

    var outstandingAmount = invoices
        .Where(i => i.Status == "Approved" && i.AmountDue > 0)
        .Sum(i => i.AmountDue);

    var keyword = ViewBag.Keyword?.ToString() ?? "";
}

<link rel="stylesheet"
      href="~/css/invoices.css"
      asp-append-version="true" />

<div class="invoice-page">

    <!-- SUCCESS AND ERROR MESSAGES -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    <!-- HEADER -->

    <div class="invoice-page-header">

        <div>

            <h2 class="invoice-page-title">
                Invoices
            </h2>

            <p class="invoice-page-subtitle">
                Manage pending, approved and outstanding invoices.
            </p>

        </div>

        <div class="invoice-header-actions">

            <a asp-controller="Invoices"
               asp-action="History"
               class="invoice-btn-outline">

                <i class="bi bi-clock-history me-2"></i>
                Invoice History

            </a>

            <a asp-controller="Invoices"
               asp-action="Create"
               class="invoice-btn-primary">

                <i class="bi bi-plus-lg me-2"></i>
                New Invoice

            </a>

        </div>

    </div>

    <!-- SUMMARY CARDS -->

    <div class="row g-3">

        <div class="col-12 col-md-4">

            <div class="invoice-stat-card">

                <div class="invoice-stat-label">
                    Invoices Displayed
                </div>

                <div class="invoice-stat-value">
                    @invoices.Count
                </div>

            </div>

        </div>

        <div class="col-12 col-md-4">

            <div class="invoice-stat-card pending">

                <div class="invoice-stat-label">
                    Pending Approval
                </div>

                <div class="invoice-stat-value">
                    @pendingCount
                </div>

            </div>

        </div>

        <div class="col-12 col-md-4">

            <div class="invoice-stat-card outstanding">

                <div class="invoice-stat-label">
                    Outstanding Amount
                </div>

                <div class="invoice-stat-value">
                    R @outstandingAmount.ToString("N2")
                </div>

            </div>

        </div>

    </div>

    <!-- FILTERS -->

    <div class="invoice-filter-panel">

        <form asp-controller="Invoices"
              asp-action="Index"
              method="get">

            <div class="row g-3 align-items-end">

                <!-- CUSTOMER -->

                <div class="col-12 col-md-6 col-xl-3">

                    <label for="invoiceCustomerFilter"
                           class="invoice-filter-label">
                        Customer
                    </label>

                    <select id="invoiceCustomerFilter"
                            name="customerId"
                            asp-items="ViewBag.CustomerFilter"
                            class="form-select">

                        <option value="">
                            All Customers
                        </option>

                    </select>

                </div>

                <!-- START DATE -->

                <div class="col-12 col-md-6 col-xl-2">

                    <label for="invoiceStartDate"
                           class="invoice-filter-label">
                        Start Date
                    </label>

                    <input id="invoiceStartDate"
                           type="date"
                           name="startDate"
                           value="@ViewBag.StartDate"
                           class="form-control" />

                </div>

                <!-- END DATE -->

                <div class="col-12 col-md-6 col-xl-2">

                    <label for="invoiceEndDate"
                           class="invoice-filter-label">
                        End Date
                    </label>

                    <input id="invoiceEndDate"
                           type="date"
                           name="endDate"
                           value="@ViewBag.EndDate"
                           class="form-control" />

                </div>

                <!-- KEYWORD -->

                <div class="col-12 col-md-6 col-xl-3">

                    <label for="invoiceKeyword"
                           class="invoice-filter-label">
                        Search
                    </label>

                    <input id="invoiceKeyword"
                           type="search"
                           name="keyword"
                           value="@keyword"
                           class="form-control"
                           placeholder="Invoice no. or customer..." />

                </div>

                <!-- ACTIONS -->

                <div class="col-12 col-xl-2">

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn invoice-btn-primary flex-fill">

                            <i class="bi bi-funnel me-1"></i>
                            Filter

                        </button>

                        <a asp-controller="Invoices"
                           asp-action="Index"
                           class="btn invoice-btn-outline">

                            Clear

                        </a>

                    </div>

                </div>

            </div>

        </form>

    </div>

    <!-- DATE VALIDATION -->

    @if (ViewBag.DateError != null)
    {
        <div class="alert alert-danger" role="alert">

            <i class="bi bi-exclamation-triangle me-2"></i>
            @ViewBag.DateError

        </div>
    }

    <!-- INVOICE TABLE -->

    <div class="invoice-table-container">

        <table class="invoice-table">

            <thead>

                <tr>
                    <th>Date</th>
                    <th>Invoice No.</th>
                    <th>Customer</th>
                    <th>Amount Due</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>

            </thead>

            <tbody>

                @foreach (var invoice in invoices)
                {
                    <tr>

                        <!-- DATE -->

                        <td>
                            @invoice.InvoiceDate.ToString("yyyy-MM-dd")
                        </td>

                        <!-- INVOICE NUMBER -->

                        <td>
                            <span class="invoice-number">
                                @invoice.InvoiceNumber
                            </span>
                        </td>

                        <!-- CUSTOMER -->

                        <td>
                            <span class="invoice-customer">
                                @(string.IsNullOrWhiteSpace(invoice.CustomerName)
                                    ? "Unknown Customer"
                                    : invoice.CustomerName)
                            </span>
                        </td>

                        <!-- AMOUNT DUE -->

                        <td>
                            <span class="invoice-amount">
                                R @invoice.AmountDue.ToString("N2")
                            </span>
                        </td>

                        <!-- TOTAL -->

                        <td>
                            <span class="invoice-amount">
                                R @invoice.Total.ToString("N2")
                            </span>
                        </td>

                        <!-- STATUS -->

                        <td>

                            @if (invoice.Status == "Pending")
                            {
                                <span class="invoice-status pending">

                                    <i class="bi bi-clock"></i>
                                    Pending Approval

                                </span>
                            }
                            else if (invoice.Status == "Approved" &&
                                     invoice.AmountDue <= 0)
                            {
                                <span class="invoice-status paid">

                                    <i class="bi bi-check-circle"></i>
                                    Paid

                                </span>
                            }
                            else if (invoice.Status == "Approved" &&
                                     invoice.AmountDue < invoice.Total)
                            {
                                <span class="invoice-status partial">

                                    <i class="bi bi-hourglass-split"></i>
                                    Partially Paid

                                </span>
                            }
                            else if (invoice.Status == "Approved")
                            {
                                <span class="invoice-status approved">

                                    <i class="bi bi-check-circle"></i>
                                    Approved

                                </span>
                            }
                            else
                            {
                                <span class="invoice-status other">
                                    @invoice.Status
                                </span>
                            }

                        </td>

                        <!-- ACTIONS -->

                        <td>

                            <div class="invoice-actions">

                                <a asp-controller="Invoices"
                                   asp-action="Details"
                                   asp-route-id="@invoice.InvoiceId"
                                   class="invoice-action-btn invoice-action-view">

                                    <i class="bi bi-eye"></i>
                                    View

                                </a>

                                <a asp-controller="Invoices"
                                   asp-action="Download"
                                   asp-route-id="@invoice.InvoiceId"
                                   class="invoice-action-btn invoice-action-download">

                                    <i class="bi bi-download"></i>
                                    Download

                                </a>

                                <button type="button"
                                        class="invoice-action-btn invoice-action-email"
                                        data-bs-toggle="modal"
                                        data-bs-target="#emailInvoiceModal"
                                        data-invoice-id="@invoice.InvoiceId"
                                        data-invoice-number="@invoice.InvoiceNumber">

                                    <i class="bi bi-envelope"></i>
                                    Email

                                </button>

                                @*
                                    Only pending invoices may be deleted.
                                    Approved invoices are finalised and may
                                    already have affected inventory.
                                *@

                                @if (invoice.Status == "Pending")
                                {
                                    <a asp-controller="Invoices"
                                       asp-action="Delete"
                                       asp-route-id="@invoice.InvoiceId"
                                       class="invoice-action-btn invoice-action-delete">

                                        <i class="bi bi-trash"></i>
                                        Delete

                                    </a>
                                }

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

    <!-- EMPTY STATE -->

    @if (!invoices.Any())
    {
        <div class="invoice-empty-state">

            <i class="bi bi-receipt fs-1 d-block mb-3"></i>

            <h5 class="fw-bold">
                No invoices found
            </h5>

            <p class="mb-0">
                Try changing your search criteria or create a new invoice.
            </p>

        </div>
    }

</div>

<!-- EMAIL INVOICE MODAL -->

<div class="modal fade invoice-modal"
     id="emailInvoiceModal"
     tabindex="-1"
     aria-labelledby="emailInvoiceModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <form asp-controller="Invoices"
                  asp-action="EmailInvoice"
                  method="post"
                  id="emailInvoiceForm">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       id="emailInvoiceId" />

                <!-- MODAL HEADER -->

                <div class="modal-header">

                    <h5 class="modal-title fw-bold"
                        id="emailInvoiceModalLabel">

                        <i class="bi bi-envelope me-2"></i>
                        Email Invoice
                        <span id="emailInvoiceNumberLabel"></span>

                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>

                <!-- MODAL BODY -->

                <div class="modal-body">

                    <label for="invoiceRecipientEmail"
                           class="form-label fw-semibold">
                        Recipient Email
                    </label>

                    <input id="invoiceRecipientEmail"
                           type="email"
                           name="recipientEmail"
                           class="form-control"
                           required
                           placeholder="customer@example.com" />

                    <div class="form-text mt-2">
                        The selected invoice will be sent to this email address.
                    </div>

                </div>

                <!-- MODAL FOOTER -->

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="invoice-btn-primary">

                        <i class="bi bi-send me-1"></i>
                        Send Invoice

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <script>
        /*
         * Purpose: Populate the invoice email modal with
         * the selected invoice's ID and number.
         *
         * Reference: Bootstrap (n.d.) Modal events.
         */

        document.addEventListener("DOMContentLoaded", function () {

            const modalElement =
                document.getElementById("emailInvoiceModal");

            if (!modalElement) {
                return;
            }

            modalElement.addEventListener("show.bs.modal", function (event) {

                const button = event.relatedTarget;

                if (!button) {
                    return;
                }

                const invoiceId =
                    button.getAttribute("data-invoice-id");

                const invoiceNumber =
                    button.getAttribute("data-invoice-number");

                document.getElementById("emailInvoiceId").value =
                    invoiceId || "";

                document.getElementById("emailInvoiceNumberLabel").textContent =
                    invoiceNumber || "";

            });

        });
    </script>

}