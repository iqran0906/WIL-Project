@*
    Purpose: Invoices list page (table with search / filters and actions).
    Authors: Sayali-St10458649, iqran0906 (from git history)
*@
@model IEnumerable<FMCGEnterpriseManagementSystem.ViewModels.InvoiceViewModel>

@{
    ViewData["Title"] = "Invoice";
}

<div class="px-2 py-3">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-1"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row align-items-start mb-3">

        <div class="col-md-4">

            <h2 class="text-white fw-bold mb-1">
                Invoices
            </h2>

            <p class="text-white-50 small mb-3">
                Manage pending, approved and outstanding invoices.
            </p>

            <div class="d-flex gap-2 flex-wrap">

                <a asp-controller="Invoices"
                   asp-action="Create"
                   class="btn btn-action-primary text-decoration-none">

                    <i class="bi bi-plus-lg me-1"></i>
                    New Invoice

                </a>

                <a asp-controller="Invoices"
                   asp-action="History"
                   class="btn btn-outline-light text-decoration-none">

                    <i class="bi bi-clock-history me-1"></i>
                    Invoice History

                </a>

            </div>

        </div>

        <div class="col-md-8">

            <form asp-action="Index"
                  method="get">

                <div class="row g-2 justify-content-md-end text-white">

                    <div class="col-6 col-sm-3">

                        <label class="small fw-bold">
                            Customer:
                        </label>

                        <select name="customerId"
                                asp-items="ViewBag.CustomerFilter"
                                class="form-select form-select-sm">

                            <option value="">
                                All
                            </option>

                        </select>

                    </div>

                    <div class="col-6 col-sm-3">

                        <label class="small fw-bold">
                            Start:
                        </label>

                        <input type="date"
                               name="startDate"
                               value="@ViewBag.StartDate"
                               class="form-control form-control-sm" />

                    </div>

                    <div class="col-6 col-sm-3">

                        <label class="small fw-bold">
                            End:
                        </label>

                        <input type="date"
                               name="endDate"
                               value="@ViewBag.EndDate"
                               class="form-control form-control-sm" />

                    </div>

                    <div class="col-6 col-sm-3">

                        <label class="small fw-bold">
                            &nbsp;
                        </label>

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-sm btn-light flex-fill">
                                Filter
                            </button>

                            <a asp-action="Index"
                               class="btn btn-sm btn-outline-light">
                                Clear
                            </a>

                        </div>

                    </div>

                </div>

                <div class="d-flex justify-content-md-end align-items-center gap-2 mt-3">

                    <span class="text-white fw-bold small">
                        Keyword:
                    </span>

                    <div class="position-relative">

                        <input type="text"
                               name="keyword"
                               value="@ViewBag.Keyword"
                               class="form-control form-control-sm search-field"
                               placeholder="Invoice no. or customer" />

                        <i class="bi bi-search position-absolute end-0 top-50 translate-middle-y me-2 text-white-50 small"></i>

                    </div>

                </div>

            </form>

        </div>

    </div>


    @if (ViewBag.DateError != null)
    {
        <div class="alert alert-danger">

            <i class="bi bi-exclamation-triangle me-1"></i>
            @ViewBag.DateError

        </div>
    }


    <div class="table-responsive">

        <table class="custom-data-table">

            <thead>

                <tr>
                    <th>Date</th>
                    <th>Invoice No.</th>
                    <th>Customer</th>
                    <th>Amount Due</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th class="text-center">Actions</th>
                </tr>

            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var invoice in Model)
                    {
                        <tr>

                            <td>
                                @invoice.InvoiceDate.ToString("yyyy-MM-dd")
                            </td>

                            <td>
                                @invoice.InvoiceNumber
                            </td>

                            <td>
                                @invoice.CustomerName
                            </td>

                            <td>
                                @($"R{invoice.AmountDue:0.00}")
                            </td>

                            <td>
                                @($"R{invoice.Total:0.00}")
                            </td>


                            @* ===========================
                               INVOICE / PAYMENT STATUS
                               =========================== *@

                            <td>

                                @if (invoice.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">

                                        <i class="bi bi-clock me-1"></i>
                                        Pending Approval

                                    </span>
                                }
                                else if (invoice.Status == "Approved" &&
                                         invoice.AmountDue <= 0)
                                {
                                    <span class="badge bg-success">

                                        <i class="bi bi-check-circle me-1"></i>
                                        Paid

                                    </span>
                                }
                                else if (invoice.Status == "Approved" &&
                                         invoice.AmountDue < invoice.Total)
                                {
                                    <span class="badge bg-info text-dark">

                                        <i class="bi bi-hourglass-split me-1"></i>
                                        Partially Paid

                                    </span>
                                }
                                else if (invoice.Status == "Approved")
                                {
                                    <span class="badge bg-success">

                                        <i class="bi bi-check-circle me-1"></i>
                                        Approved

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @invoice.Status
                                    </span>
                                }

                            </td>


                            @* ===========================
                               ACTIONS
                               =========================== *@

                            <td>

                                <div class="d-flex gap-2 flex-wrap">

                                    <a asp-action="Details"
                                       asp-route-id="@invoice.InvoiceId"
                                       class="btn btn-sm btn-outline-secondary">

                                        View

                                    </a>

                                    <a asp-action="Download"
                                       asp-route-id="@invoice.InvoiceId"
                                       class="btn btn-sm btn-outline-primary">

                                        Download

                                    </a>


                                    @*
                                        Only pending invoices may be deleted.

                                        Once approved, the invoice has been
                                        finalised and stock has been deducted,
                                        so it should no longer be removable.
                                    *@
                                    <button type="button"
                                            class="btn btn-outline-primary btn-sm email-invoice-btn"
                                            data-invoice-id="@invoice.InvoiceId"
                                            data-invoice-number="@invoice.InvoiceNumber">
                                        Email
                                    </button>

                                    @if (invoice.Status == "Pending")
                                    {
                                        <a asp-action="Delete"
                                           asp-route-id="@invoice.InvoiceId"
                                           class="btn btn-sm btn-outline-danger">

                                            Delete

                                        </a>
                                    }

                                </div>
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7"
                            class="text-center py-5">

                            <div class="fw-semibold mb-1">
                                No invoices match your filters.
                            </div>

                            <div class="text-muted small">
                                Try changing your search or date criteria.
                            </div>

                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

    <div class="modal fade" id="emailInvoiceModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="EmailInvoice" method="post" id="emailInvoiceForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="emailInvoiceId" />
                    <div class="modal-header">
                        <h5 class="modal-title">Email Invoice <span id="emailInvoiceNumberLabel"></span></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label fw-semibold small">Recipient Email</label>
                        <input type="email" name="recipientEmail" class="form-control" required placeholder="customer@example.com" />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-action-primary">Send Email</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        document.querySelectorAll('.email-invoice-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                document.getElementById('emailInvoiceId').value = this.getAttribute('data-invoice-id');
                document.getElementById('emailInvoiceNumberLabel').textContent = this.getAttribute('data-invoice-number');
                new bootstrap.Modal(document.getElementById('emailInvoiceModal')).show();
            });
        });
    </script>
}