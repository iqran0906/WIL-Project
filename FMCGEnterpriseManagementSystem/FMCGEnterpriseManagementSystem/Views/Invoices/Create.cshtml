@model FMCGEnterpriseManagementSystem.ViewModels.InvoiceViewModel

@{
    ViewData["Title"] = "New Invoice";
}

<div class="content-card">
    <div class="row align-items-center mb-4">
        <div class="col-sm-6">
            <h5 class="fw-bold m-0" style="color: #1c323d;">Exclusive Distributors (pty) LTD</h5>
            <small class="text-muted d-block">Durban</small>
        </div>
        <div class="col-sm-6 text-sm-end">
            <div class="d-inline-block text-start">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <label class="small text-secondary fw-bold text-nowrap m-0">Date:</label>
                    <input asp-for="InvoiceDate" type="date" class="form-control form-control-sm" style="width:160px;">
                </div>
                <div class="d-flex align-items-center gap-2">
                    <label class="small text-secondary fw-bold text-nowrap m-0">Invoice Number:</label>
                    <input type="text" class="form-control form-control-sm text-center fw-bold" value="Auto-generated" readonly style="width:160px;">
                </div>
            </div>
        </div>
    </div>

    <h2 class="fw-bold mb-4" style="color: #1c323d;">New Invoice</h2>

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <form asp-action="Create" method="post" id="invoiceForm">
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="row align-items-center mb-3">
                    <label class="col-sm-3 fw-bold text-secondary">Customer</label>
                    <div class="col-sm-9">
                        <select asp-for="CustomerId" id="customerSelect" class="form-select">
                            <option value="">-- Select Customer --</option>
                            @foreach (var customer in Model.AvailableCustomers)
                            {
                                <option value="@customer.CustomerId"
                                        data-address="@customer.DeliveryAddress"
                                        data-terms="@customer.PaymentTerms"
                                        data-salesrep="@customer.SalesRepresentativeId"
                                        data-salesrepname="@(customer.SalesRepresentative?.Employee != null ? $"{customer.SalesRepresentative.Employee.FirstName} {customer.SalesRepresentative.Employee.LastName}" : "")">
                                    @customer.Name @customer.Surname
                                </option>
                            }
                        </select>
                    </div>
                </div>
                <div class="row align-items-start">
                    <label class="col-sm-3 fw-bold text-secondary">Billing Address:</label>
                    <div class="col-sm-9">
                        <textarea asp-for="BillingAddress" id="billingAddress" class="form-control" rows="3" readonly></textarea>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row align-items-center mb-3">
                    <label class="col-sm-4 fw-bold text-secondary text-sm-end">Payment Terms:</label>
                    <div class="col-sm-8">
                        <input asp-for="PaymentTerms" id="paymentTerms" class="form-control" readonly />
                    </div>
                </div>
                <div class="row align-items-center">
                    <label class="col-sm-4 fw-bold text-secondary text-sm-end">Sales Person:</label>
                    <div class="col-sm-8">
                        <input asp-for="SalesRepresentativeName" id="salesRepName" class="form-control" readonly />
                        <input type="hidden" asp-for="SalesRepresentativeId" id="salesRepId" />
                    </div>
                </div>
            </div>actaul n
        </div>

        <div class="table-responsive border rounded bg-light p-2 mb-3">
            <table class="table align-middle m-0 bg-white shadow-sm rounded" id="itemsTable">
                <thead class="table-secondary text-secondary small">
                    <tr>
                        <th style="width: 8%;">Qty</th>
                        <th style="width: 12%;">Product ID</th>
                        <th style="width: 12%;">Unit Price</th>
                        <th style="width: 12%;">Disc %</th>
                        <th style="width: 15%;">VAT Category</th>
                        <th style="width: 12%;">Total</th>
                        <th style="width: 8%;"></th>
                    </tr>
                </thead>
                <tbody id="itemsBody">
                    <!-- rows added by JS -->
                </tbody>
            </table>
            <div class="p-2">
                <button type="button" class="btn btn-sm btn-link text-decoration-none text-dark fw-bold p-0" id="addItemBtn">
                    <i class="bi bi-plus-lg me-1"></i>Add Item
                </button>
            </div>
        </div>

        <div class="row justify-content-end text-end g-0 mb-4 fw-bold text-secondary">
            <div class="col-md-4 border-top pt-2">
                <div class="d-flex justify-content-between py-1"><span>Subtotal (excl. VAT)</span><span id="subtotalDisplay">R0.00</span></div>
                <div class="d-flex justify-content-between py-1"><span>VAT</span><span id="vatDisplay">R0.00</span></div>
                <div class="d-flex justify-content-between py-1 border-top border-dark mt-2 text-dark fs-5"><span>Grand Total</span><span id="totalDisplay">R0.00</span></div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-3">
            <a asp-action="Index" class="btn btn-link text-decoration-none text-secondary align-self-center">Cancel</a>
            <button type="submit" class="btn btn-custom-save">Save Invoice</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const VAT_RATE = 0.15;
        let itemIndex = 0;

        function addItemRow() {
            const tbody = document.getElementById('itemsBody');
            const row = document.createElement('tr');
            row.innerHTML = `
                        <td><input type="number" name="Items[${itemIndex}].Quantity" class="form-control form-control-sm text-center item-qty" value="1" min="1"></td>
                        <td><input type="number" name="Items[${itemIndex}].ProductId" class="form-control form-control-sm item-product" placeholder="e.g. 1"></td>
                        <td><input type="number" step="0.01" name="Items[${itemIndex}].UnitPrice" class="form-control form-control-sm text-end item-price" value="0.00"></td>
                        <td><input type="number" step="0.01" name="Items[${itemIndex}].DiscountPercent" class="form-control form-control-sm text-center item-disc" value="0"></td>
                        <td>
                            <select name="Items[${itemIndex}].VatCategory" class="form-select form-select-sm item-vat">
                                <option value="STANDARD">Standard</option>
                                <option value="[NONE]">None</option>
                            </select>
                        </td>
                        <td><span class="line-total">R0.00</span></td>
                        <td><button type="button" class="btn btn-sm btn-link text-danger remove-row">&times;</button></td>
                    `;
            tbody.appendChild(row);
            itemIndex++;
            attachRowEvents(row);
        }

        function attachRowEvents(row) {
            const inputs = row.querySelectorAll('.item-qty, .item-price, .item-disc, .item-vat');
            inputs.forEach(input => input.addEventListener('input', () => {
                calculateRow(row);
                calculateTotals();
            }));
            row.querySelector('.remove-row').addEventListener('click', () => {
                row.remove();
                calculateTotals();
            });
        }

        function calculateRow(row) {
            const qty = parseFloat(row.querySelector('.item-qty').value) || 0;
            const price = parseFloat(row.querySelector('.item-price').value) || 0;
            const disc = parseFloat(row.querySelector('.item-disc').value) || 0;
            const vatCategory = row.querySelector('.item-vat').value;

            const lineSubtotal = qty * price;
            const afterDiscount = lineSubtotal - (lineSubtotal * disc / 100);
            const vatAmount = vatCategory === '[NONE]' ? 0 : afterDiscount * VAT_RATE;
            const lineTotal = afterDiscount + vatAmount;

            row.querySelector('.line-total').textContent = 'R' + lineTotal.toFixed(2);
            return lineTotal;
        }

        function calculateTotals() {
            let subtotal = 0;
            let vatTotal = 0;
            let total = 0;
            document.querySelectorAll('#itemsBody tr').forEach(row => {
                const qty = parseFloat(row.querySelector('.item-qty').value) || 0;
                const price = parseFloat(row.querySelector('.item-price').value) || 0;
                const disc = parseFloat(row.querySelector('.item-disc').value) || 0;
                const vatCategory = row.querySelector('.item-vat').value;

                const lineSubtotal = qty * price;
                const afterDiscount = lineSubtotal - (lineSubtotal * disc / 100);
                const vatAmount = vatCategory === '[NONE]' ? 0 : afterDiscount * VAT_RATE;

                subtotal += afterDiscount;
                vatTotal += vatAmount;
                total += afterDiscount + vatAmount;
            });
            document.getElementById('subtotalDisplay').textContent = 'R' + subtotal.toFixed(2);
            document.getElementById('vatDisplay').textContent = 'R' + vatTotal.toFixed(2);
            document.getElementById('totalDisplay').textContent = 'R' + total.toFixed(2);
        }

        document.getElementById('addItemBtn').addEventListener('click', addItemRow);

        // start with one row
        addItemRow();
       
        document.getElementById('customerSelect').addEventListener('change', function() {
            const selected = this.options[this.selectedIndex];
            document.getElementById('billingAddress').value = selected.getAttribute('data-address') || '';
            document.getElementById('paymentTerms').value = selected.getAttribute('data-terms') || '';
            document.getElementById('salesRepId').value = selected.getAttribute('data-salesrep') || '';
            document.getElementById('salesRepName').value = selected.getAttribute('data-salesrepname') || '';
        });
    </script>
}