@model IEnumerable<FMCGEnterpriseManagementSystem.ViewModels.InvoiceViewModel>

@{
    ViewData["Title"] = "Invoice History";

    var invoices = Model?.ToList()
        ?? new List<FMCGEnterpriseManagementSystem.ViewModels.InvoiceViewModel>();

    var historicalValue = invoices.Sum(i => i.Total);
}

<div class="px-2 py-3">

    <!-- HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">

        <div>

            <h2 class="text-white fw-bold mb-1">
                Invoice History
            </h2>

            <p class="text-white-50 mb-0">
                Fully paid invoices retained as financial records.
            </p>

        </div>

        <a asp-controller="Invoices"
           asp-action="Index"
           class="btn btn-outline-light">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Invoices

        </a>

    </div>


    <!-- SUMMARY CARDS -->
    <div class="row g-3 mb-4">

        <div class="col-md-6">

            <div class="bg-white border rounded-3 p-3 h-100">

                <div class="text-muted small mb-1">
                    Paid Invoices
                </div>

                <div class="fs-3 fw-bold"
                     style="color:#1c323d;">

                    @invoices.Count

                </div>

            </div>

        </div>


        <div class="col-md-6">

            <div class="bg-white border rounded-3 p-3 h-100">

                <div class="text-muted small mb-1">
                    Paid Invoice Value
                </div>

                <div class="fs-3 fw-bold"
                     style="color:#1c323d;">

                    R @historicalValue.ToString("N2")

                </div>

            </div>

        </div>

    </div>


    <!-- FILTERS -->
    <div class="bg-white border rounded-3 p-3 mb-4">

        <form asp-controller="Invoices"
              asp-action="History"
              method="get">

            <div class="row g-3 align-items-end">

                <div class="col-lg-3 col-md-6">

                    <label class="form-label small fw-semibold">
                        Customer
                    </label>

                    <select name="customerId"
                            asp-items="ViewBag.CustomerFilter"
                            class="form-select">

                        <option value="">
                            All Customers
                        </option>

                    </select>

                </div>


                <div class="col-lg-2 col-md-6">

                    <label class="form-label small fw-semibold">
                        Start Date
                    </label>

                    <input type="date"
                           name="startDate"
                           value="@ViewBag.StartDate"
                           class="form-control" />

                </div>


                <div class="col-lg-2 col-md-6">

                    <label class="form-label small fw-semibold">
                        End Date
                    </label>

                    <input type="date"
                           name="endDate"
                           value="@ViewBag.EndDate"
                           class="form-control" />

                </div>


                <div class="col-lg-3 col-md-6">

                    <label class="form-label small fw-semibold">
                        Search
                    </label>

                    <input type="text"
                           name="keyword"
                           value="@ViewBag.Keyword"
                           class="form-control"
                           placeholder="Invoice no. or customer..." />

                </div>


                <div class="col-lg-2">

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-action-primary flex-fill">
                            Filter
                        </button>

                        <a asp-controller="Invoices"
                           asp-action="History"
                           class="btn btn-outline-secondary">
                            Clear
                        </a>

                    </div>

                </div>

            </div>

        </form>

    </div>


    @if (ViewBag.DateError != null)
    {
        <div class="alert alert-danger">

            <i class="bi bi-exclamation-triangle me-1"></i>
            @ViewBag.DateError

        </div>
    }


    <!-- HISTORY TABLE -->
    <div class="table-responsive">

        <table class="custom-data-table">

            <thead>

                <tr>
                    <th>Date</th>
                    <th>Invoice No.</th>
                    <th>Customer</th>
                    <th>Amount Paid</th>
                    <th>Amount Due</th>
                    <th>Status</th>
                    <th class="text-center">Actions</th>
                </tr>

            </thead>


            <tbody>

                @if (invoices.Any())
                {
                    foreach (var invoice in invoices)
                    {
                        <tr>

                            <td>
                                @invoice.InvoiceDate.ToString("yyyy-MM-dd")
                            </td>


                            <td>
                                <span class="fw-semibold">
                                    @invoice.InvoiceNumber
                                </span>
                            </td>


                            <td>
                                @(string.IsNullOrWhiteSpace(invoice.CustomerName)
                                    ? "Unknown Customer"
                                    : invoice.CustomerName)
                            </td>


                            <td class="fw-semibold">
                                @($"R{invoice.Total:0.00}")
                            </td>


                            <td>
                                @($"R{invoice.AmountDue:0.00}")
                            </td>


                            <td>

                                <span class="badge bg-success">

                                    <i class="bi bi-check-circle me-1"></i>
                                    Paid

                                </span>

                            </td>


                            <td>

                                <div class="d-flex justify-content-center gap-2 flex-wrap">

                                    <a asp-controller="Invoices"
                                       asp-action="Details"
                                       asp-route-id="@invoice.InvoiceId"
                                       class="btn btn-sm btn-outline-secondary">

                                        View

                                    </a>


                                    <a asp-controller="Invoices"
                                       asp-action="Download"
                                       asp-route-id="@invoice.InvoiceId"
                                       class="btn btn-sm btn-outline-primary">

                                        Download

                                    </a>


                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary email-invoice-btn"
                                            data-invoice-id="@invoice.InvoiceId"
                                            data-invoice-number="@invoice.InvoiceNumber">

                                        Email

                                    </button>

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="7"
                            class="text-center py-5">

                            <i class="bi bi-receipt fs-2 d-block mb-2 text-muted"></i>

                            <div class="fw-semibold mb-1">
                                No paid invoices found
                            </div>

                            <div class="text-muted small">
                                Fully paid invoices will automatically appear here.
                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>


    <!-- EMAIL MODAL -->
    <div class="modal fade"
         id="emailInvoiceModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog">

            <div class="modal-content">

                <form asp-controller="Invoices"
                      asp-action="EmailInvoice"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           id="emailInvoiceId" />


                    <div class="modal-header">

                        <h5 class="modal-title">

                            Email Invoice

                            <span id="emailInvoiceNumberLabel">
                            </span>

                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal">
                        </button>

                    </div>


                    <div class="modal-body">

                        <label class="form-label fw-semibold small">
                            Recipient Email
                        </label>

                        <input type="email"
                               name="recipientEmail"
                               class="form-control"
                               required
                               placeholder="customer@example.com" />

                    </div>


                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-outline-secondary"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit"
                                class="btn btn-action-primary">
                            Send Email
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        document.querySelectorAll('.email-invoice-btn')
            .forEach(btn => {

                btn.addEventListener(
                    'click',
                    function () {

                        document.getElementById(
                            'emailInvoiceId'
                        ).value =
                            this.getAttribute(
                                'data-invoice-id'
                            );

                        document.getElementById(
                            'emailInvoiceNumberLabel'
                        ).textContent =
                            this.getAttribute(
                                'data-invoice-number'
                            );

                        new bootstrap.Modal(
                            document.getElementById(
                                'emailInvoiceModal'
                            )
                        ).show();
                    }
                );

            });

    </script>
}