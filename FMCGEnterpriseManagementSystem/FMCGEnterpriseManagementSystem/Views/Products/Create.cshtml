@*
    Purpose: Create a new product.

    Original authors:
    iqran0906 and Maseeha17 (Git history).


    Mozilla Developer Network (n.d.) EventTarget.addEventListener().
    https://developer.mozilla.org/en-US/docs/Web/API/EventTarget/addEventListener
*@

@model FMCGEnterpriseManagementSystem.ViewModels.ProductViewModel

@{
    ViewData["Title"] = "Create Product";
}

<div class="product-page">

    <div class="product-page-header">

        <div>
            <h2 class="product-page-title">Create New Product</h2>

            <p class="product-page-subtitle">
                Add a new product to the catalogue and configure its pricing.
            </p>
        </div>

        <a asp-action="Index"
           class="product-btn-outline">
            <i class="bi bi-arrow-left"></i>
            Back to Products
        </a>

    </div>

    <form asp-action="Create" method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="row g-4">

            <!-- PRODUCT INFORMATION -->
            <div class="col-lg-6">

                <div class="product-form-section">

                    <h5 class="product-section-title">
                        <i class="bi bi-box-seam me-2"></i>
                        Product Information
                    </h5>

                    <p class="product-section-subtitle">
                        Enter the product's supplier, name and category.
                    </p>

                    <div class="mb-3">

                        <label asp-for="SupplierId" class="form-label">
                            Supplier
                        </label>

                        <select asp-for="SupplierId"
                                asp-items="ViewBag.Suppliers"
                                class="form-select">

                            <option value="">-- Select Supplier --</option>

                        </select>

                        <span asp-validation-for="SupplierId"
                              class="text-danger small"></span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="ProductName" class="form-label">
                            Product Name
                        </label>

                        <input asp-for="ProductName"
                               class="form-control"
                               placeholder="E.g. Chocolate Bar" />

                        <span asp-validation-for="ProductName"
                              class="text-danger small"></span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Description" class="form-label">
                            Description
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Optional product description"></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger small"></span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Category" class="form-label">
                            Category
                        </label>

                        <select asp-for="Category" class="form-select">

                            <option value="">-- Select Category --</option>
                            <option value="Beverages">Beverages</option>
                            <option value="Confectionery">Confectionery</option>
                            <option value="Dairy">Dairy</option>
                            <option value="Frozen Foods">Frozen Foods</option>
                            <option value="Groceries">Groceries</option>
                            <option value="Household">Household</option>
                            <option value="Personal Care">Personal Care</option>
                            <option value="Snacks">Snacks</option>
                            <option value="Other">Other</option>

                        </select>

                        <span asp-validation-for="Category"
                              class="text-danger small"></span>

                    </div>

                </div>

            </div>

            <!-- PRICING INFORMATION -->
            <div class="col-lg-6">

                <div class="product-form-section">

                    <h5 class="product-section-title">
                        <i class="bi bi-currency-exchange me-2"></i>
                        Pricing Information
                    </h5>

                    <p class="product-section-subtitle">
                        Configure cost and selling prices.
                    </p>

                    <div class="mb-3">

                        <label asp-for="CostExVat" class="form-label">
                            Cost Excl. VAT (R)
                        </label>

                        <input asp-for="CostExVat"
                               id="CostExVat"
                               class="form-control"
                               type="number"
                               step="0.01"
                               min="0" />

                        <span asp-validation-for="CostExVat"
                              class="text-danger small"></span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="SellingPrice" class="form-label">
                            Selling Price (R)
                        </label>

                        <input asp-for="SellingPrice"
                               id="SellingPrice"
                               class="form-control"
                               type="number"
                               step="0.01"
                               min="0.01" />

                        <span asp-validation-for="SellingPrice"
                              class="text-danger small"></span>

                    </div>

                    <!-- SELLING BELOW COST WARNING -->
                    <div id="sellingPriceWarning"
                         class="product-price-warning d-none mb-3"
                         role="alert">

                        <div class="d-flex align-items-start">

                            <i class="bi bi-exclamation-triangle-fill me-2 mt-1"></i>

                            <div>

                                <strong>
                                    Selling price is below cost price.
                                </strong>

                                <div class="small mt-1">
                                    This product will be sold at a loss.
                                    Please check the pricing before saving.
                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="alert alert-info small mt-4 mb-0">

                        <i class="bi bi-info-circle me-2"></i>

                        The product code will be generated automatically
                        when the product is saved.

                    </div>

                </div>

            </div>

        </div>

        <div class="product-form-actions">

            <a asp-action="Index"
               class="product-btn-outline">
                Cancel
            </a>

            <button type="submit" class="product-btn-primary">
                <i class="bi bi-check-lg"></i>
                Save Product
            </button>

        </div>

    </form>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        // Warn when the selling price is lower than the cost price.
        document.addEventListener("DOMContentLoaded", function () {

            const costInput = document.getElementById("CostExVat");
            const sellingPriceInput = document.getElementById("SellingPrice");
            const warning = document.getElementById("sellingPriceWarning");

            if (!costInput || !sellingPriceInput || !warning) {
                return;
            }

            function checkSellingPrice() {

                const cost = parseFloat(costInput.value);
                const sellingPrice = parseFloat(sellingPriceInput.value);

                if (!isNaN(cost) &&
                    !isNaN(sellingPrice) &&
                    sellingPrice < cost) {

                    warning.classList.remove("d-none");
                    sellingPriceInput.classList.add("border-warning");

                } else {

                    warning.classList.add("d-none");
                    sellingPriceInput.classList.remove("border-warning");

                }
            }

            costInput.addEventListener("input", checkSellingPrice);
            sellingPriceInput.addEventListener("input", checkSellingPrice);

            checkSellingPrice();
        });
    </script>
}