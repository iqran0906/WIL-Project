@*
    Purpose: Display discontinued products and allow reactivation.

    Original authors:
    iqran0906 and Maseeha17 (Git history).

    UI update:
    Adapted with assistance from OpenAI ChatGPT (2026).

    References:
    Bootstrap (n.d.) Tables and alerts.
    https://getbootstrap.com/docs/5.3/content/tables/

    Microsoft (n.d.) ASP.NET Core MVC views.
    https://learn.microsoft.com/en-us/aspnet/core/mvc/views/overview
*@

@model IEnumerable<FMCGEnterpriseManagementSystem.ViewModels.ProductViewModel>

@{
    ViewData["Title"] = "Discontinued Products";
}

<div class="product-page">

    <div class="product-page-header">

        <div>
            <h2 class="product-page-title">
                Discontinued Products
            </h2>

            <p class="product-page-subtitle">
                Products that are no longer part of the active product catalogue.
            </p>
        </div>

        <a asp-action="Index"
           class="product-btn-outline">
            <i class="bi bi-arrow-left"></i>
            Back to Products
        </a>

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>

        </div>
    }

    <!-- DISCONTINUED PRODUCTS TABLE -->
    <div class="product-table-container">

        <table class="product-table">

            <thead>
                <tr>
                    <th>Code</th>
                    <th>Product</th>
                    <th>Category</th>
                    <th>Supplier</th>
                    <th>Cost Price</th>
                    <th>Selling Price</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                <span class="product-name">
                                    @item.ProductCode
                                </span>
                            </td>

                            <td>
                                <div class="product-name">
                                    @item.ProductName
                                </div>

                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <div class="product-secondary-text">
                                        @item.Description
                                    </div>
                                }
                            </td>

                            <td>@item.Category</td>

                            <td>
                                @(string.IsNullOrWhiteSpace(item.SupplierName)
                                    ? "Not Available"
                                    : item.SupplierName)
                            </td>

                            <td>
                                <div class="fw-semibold">
                                    R @item.CostExVat.ToString("N2")
                                </div>

                                <div class="product-secondary-text">
                                    R @item.CostIncVat.ToString("N2") incl. VAT
                                </div>
                            </td>

                            <td>
                                <strong>
                                    R @item.SellingPrice.ToString("N2")
                                </strong>
                            </td>

                            <td>
                                <span class="product-badge product-badge-inactive">
                                    Discontinued
                                </span>
                            </td>

                            <td>
                                <div class="product-actions">

                                    <form asp-action="Activate"
                                          asp-route-id="@item.ProductId"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="product-action-btn product-action-activate">

                                            <i class="bi bi-arrow-counterclockwise"></i>
                                            Reactivate

                                        </button>

                                    </form>

                                </div>
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8">

                            <div class="product-empty-state">

                                <i class="bi bi-archive fs-2 d-block mb-2"></i>

                                <strong>No Discontinued Products</strong>

                                <p class="mb-0 mt-2">
                                    Products you discontinue will appear here.
                                </p>

                            </div>

                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>