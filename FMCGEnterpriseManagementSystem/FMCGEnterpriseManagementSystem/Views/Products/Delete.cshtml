@*
    Purpose: Confirmation page before discontinuing a product.

    Original authors:
    iqran0906 and Maseeha17 (Git history).

    UI update:
    Adapted with assistance from OpenAI ChatGPT (2026).

    References:
    Microsoft (n.d.) ASP.NET Core Tag Helpers.
    https://learn.microsoft.com/en-us/aspnet/core/mvc/views/tag-helpers/intro

    Bootstrap (n.d.) Documentation.
    https://getbootstrap.com/docs/5.3/
*@

@model FMCGEnterpriseManagementSystem.ViewModels.ProductViewModel

@{
    ViewData["Title"] = "Discontinue Product";
}

<div class="product-page">

    <div class="product-page-header">

        <div>
            <h2 class="product-page-title">Discontinue Product</h2>

            <p class="product-page-subtitle">
                Review the product details before discontinuing it.
            </p>
        </div>

        <a asp-action="Index"
           class="product-btn-outline">
            <i class="bi bi-arrow-left"></i>
            Back to Products
        </a>

    </div>

    <div class="product-delete-card">

        <div class="d-flex align-items-start gap-3 mb-4">

            <i class="bi bi-exclamation-triangle-fill fs-2 text-danger"></i>

            <div>

                <h5 class="fw-bold mb-2" style="color:#183244;">
                    Confirm Product Discontinuation
                </h5>

                <p class="text-muted mb-0">
                    Are you sure you want to discontinue this product?
                    It will be removed from the active product catalogue.
                </p>

            </div>

        </div>

        <div class="row g-4 mb-4">

            <div class="col-md-6">
                <div class="product-stat-label">Product Name</div>
                <div class="product-name">@Model.ProductName</div>
            </div>

            <div class="col-md-6">
                <div class="product-stat-label">Product Code</div>
                <div class="fw-semibold">@Model.ProductCode</div>
            </div>

            <div class="col-md-6">
                <div class="product-stat-label">Category</div>
                <div>@Model.Category</div>
            </div>

            <div class="col-md-6">
                <div class="product-stat-label">Supplier</div>
                <div>
                    @(string.IsNullOrWhiteSpace(Model.SupplierName)
                        ? "Not Available"
                        : Model.SupplierName)
                </div>
            </div>

        </div>

        <hr class="my-4" />

        <form asp-action="Delete"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="ProductId" />

            <div class="product-form-actions">

                <a asp-action="Index"
                   class="product-btn-outline">
                    Cancel
                </a>

                <button type="submit" class="product-btn-danger">
                    <i class="bi bi-slash-circle"></i>
                    Confirm Discontinue
                </button>

            </div>

        </form>

    </div>

</div>