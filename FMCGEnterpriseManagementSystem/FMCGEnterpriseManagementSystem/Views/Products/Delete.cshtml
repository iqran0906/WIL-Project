@model FMCGEnterpriseManagementSystem.ViewModels.ProductViewModel

@{
    ViewData["Title"] = "Delete Product";
}

<div class="content-card">
    <h2>Delete Product</h2>
    <h3 class="text-danger">Are you sure you want to delete this?</h3>
    <hr />

    <div>
        <dl class="row">
            <dt class="col-sm-2">Product Name</dt>
            <dd class="col-sm-10">@Model.ProductName</dd>

            <dt class="col-sm-2">Product Code</dt>
            <dd class="col-sm-10">@Model.ProductCode</dd>

            <dt class="col-sm-2">Category</dt>
            <dd class="col-sm-10">@Model.Category</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="ProductId" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>