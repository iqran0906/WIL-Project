@*
    Purpose: Display active products, summary statistics and filters.

    Original authors:
    iqran0906 and Maseeha17 (Git history).

    Microsoft (n.d.) ASP.NET Core MVC views.
    https://learn.microsoft.com/en-us/aspnet/core/mvc/views/overview
*@

@model IEnumerable<FMCGEnterpriseManagementSystem.ViewModels.ProductViewModel>

@{
    ViewData["Title"] = "Products Management";
}

<div class="product-page">

    <!-- PAGE HEADER -->
    <div class="product-page-header">

        <div>
            <h2 class="product-page-title">Product Management</h2>

            <p class="product-page-subtitle">
                Manage your active product catalogue, suppliers and pricing.
            </p>
        </div>

        <div class="product-header-actions">

            <a asp-action="DiscontinuedProducts"
               class="product-btn-outline">
                <i class="bi bi-archive"></i>
                Discontinued Products
            </a>

            <a asp-action="Create"
               class="product-btn-primary">
                <i class="bi bi-plus-lg"></i>
                New Product
            </a>

        </div>

    </div>

    <!-- SUCCESS MESSAGE -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>

        </div>
    }

    <!-- SUMMARY CARDS -->
    <div class="row g-3 mb-4">

        <div class="col-6 col-xl-3">
            <div class="product-stat-card">
                <div class="product-stat-label">
                    Total Products
                </div>

                <div class="product-stat-value">
                    @ViewBag.TotalProducts
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="product-stat-card active">
                <div class="product-stat-label">
                    Active Products
                </div>

                <div class="product-stat-value">
                    @ViewBag.ActiveProducts
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="product-stat-card inactive">
                <div class="product-stat-label">
                    Discontinued Products
                </div>

                <div class="product-stat-value">
                    @ViewBag.InactiveProducts
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="product-stat-card suppliers">
                <div class="product-stat-label">
                    Active Suppliers
                </div>

                <div class="product-stat-value">
                    @ViewBag.TotalSuppliers
                </div>
            </div>
        </div>

    </div>

    <!-- SEARCH AND FILTERS -->
    <div class="product-filter-panel">

        <form method="get"
              asp-action="Index">

            <div class="row g-3 align-items-end">

                <div class="col-lg-4 col-md-6">

                    <label class="product-filter-label">
                        Search
                    </label>

                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="form-control"
                           placeholder="Code, product, supplier..." />

                </div>

                <div class="col-lg-3 col-md-6">

                    <label class="product-filter-label">
                        Category
                    </label>

                    <select name="category" class="form-select">

                        <option value="">All Categories</option>

                        @foreach (var category in ViewBag.Categories)
                        {
                            if (ViewBag.SelectedCategory == category)
                            {
                                <option value="@category" selected>
                                    @category
                                </option>
                            }
                            else
                            {
                                <option value="@category">
                                    @category
                                </option>
                            }
                        }

                    </select>

                </div>

                <div class="col-lg-3 col-md-6">

                    <label class="product-filter-label">
                        Supplier
                    </label>

                    <select name="supplierId"
                            asp-items="ViewBag.SupplierFilter"
                            class="form-select">

                        <option value="">All Suppliers</option>

                    </select>

                </div>

                <div class="col-lg-2 col-md-6">

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="product-btn-primary flex-fill">
                            Filter
                        </button>

                        <a asp-action="Index"
                           class="product-btn-outline">
                            Clear
                        </a>

                    </div>

                </div>

            </div>

        </form>

    </div>

    <!-- PRODUCT TABLE -->
    <div class="product-table-container">

        <table class="product-table">

            <thead>
                <tr>
                    <th>Code</th>
                    <th>Product</th>
                    <th>Category</th>
                    <th>Supplier</th>
                    <th>Cost Price</th>
                    <th>Selling Price</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                <span class="product-name">
                                    @item.ProductCode
                                </span>
                            </td>

                            <td>
                                <div class="product-name">
                                    @item.ProductName
                                </div>

                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <div class="product-secondary-text">
                                        @item.Description
                                    </div>
                                }
                            </td>

                            <td>@item.Category</td>

                            <td>
                                @(string.IsNullOrWhiteSpace(item.SupplierName)
                                    ? "Not Available"
                                    : item.SupplierName)
                            </td>

                            <td>
                                <div class="fw-semibold">
                                    R @item.CostExVat.ToString("N2")
                                </div>

                                <div class="product-secondary-text">
                                    R @item.CostIncVat.ToString("N2") incl. VAT
                                </div>
                            </td>

                            <td>
                                <strong>
                                    R @item.SellingPrice.ToString("N2")
                                </strong>
                            </td>

                            <td>
                                <span class="product-badge product-badge-active">
                                    Active
                                </span>
                            </td>

                            <td>
                                <div class="product-actions">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.ProductId"
                                       class="product-action-btn product-action-edit">
                                        <i class="bi bi-pencil-square"></i>
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.ProductId"
                                       class="product-action-btn product-action-danger">
                                        <i class="bi bi-slash-circle"></i>
                                        Discontinue
                                    </a>

                                </div>
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8">
                            <div class="product-empty-state">

                                <i class="bi bi-box-seam fs-2 d-block mb-2"></i>

                                <strong>No active products found</strong>

                                <p class="mb-0 mt-2">
                                    Try changing your search or filters.
                                </p>

                            </div>
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>