@model IEnumerable<FMCGEnterpriseManagementSystem.ViewModels.ProductViewModel>

@{
    ViewData["Title"] = "Products";
}

<div class="content-card">
    <h2>Products Management</h2>
    <hr />

    <p>
        <a asp-action="Create" class="btn btn-action-primary">Create New Product</a>
    </p>

    <table class="custom-data-table">
        <thead>
            <tr>
                <th>Product Code</th>
                <th>Product Name</th>
                <th>Category</th>
                <th>Selling Price</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ProductCode</td>
                        <td>@item.ProductName</td>
                        <td>@item.Category</td>
                        <td>@item.SellingPrice.ToString("C")</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-sm btn-primary">Edit</a> |
                            <a asp-action="Delete" asp-route-id="@item.ProductId" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center">No products found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>