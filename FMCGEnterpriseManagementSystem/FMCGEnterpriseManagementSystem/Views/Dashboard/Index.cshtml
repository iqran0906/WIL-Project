@model FMCGEnterpriseManagementSystem.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard & Analytics";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">FMCG Operations Dashboard</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item active">Real-time Inventory & Analytics Overview</li>
    </ol>

    <!-- KPI Metric Cards -->
    <div class="row">
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-white mb-4">
                <div class="card-body">
                    <h5 class="card-title">Total Products</h5>
                    <h3>@Model.TotalProducts</h3>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-warning text-dark mb-4">
                <div class="card-body">
                    <h5 class="card-title">Low Stock Items</h5>
                    <h3>@Model.LowStockItems</h3>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-danger text-white mb-4">
                <div class="card-body">
                    <h5 class="card-title">Out of Stock</h5>
                    <h3>@Model.OutOfStockItems</h3>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-success text-white mb-4">
                <div class="card-body">
                    <h5 class="card-title">Inventory Value</h5>
                    <h3>@Model.TotalInventoryValue.ToString("C")</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Financial / Restock Overview Row -->
    <div class="row">
        <div class="col-xl-6">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-wallet me-1"></i>
                    Projected Restock Budget
                </div>
                <div class="card-body">
                    <h4>@Model.ProjectedRestockBudget.ToString("C")</h4>
                    <p class="text-muted">Estimated budget required to bring low and out-of-stock items up to operational thresholds.</p>
                </div>
            </div>
        </div>
        <div class="col-xl-6">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-chart-bar me-1"></i>
                    Stock Count by Category
                </div>
                <div class="card-body">
                    <ul class="list-group">
                        @for (int i = 0; i < Model.CategoryNames.Length; i++)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                @Model.CategoryNames[i]
                                <span class="badge bg-secondary rounded-pill">@Model.CategoryQuantities[i] units</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Critical Stock Watchlist Table -->
    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-exclamation-triangle me-1"></i>
            Critical Stock Watchlist (Top 10 Items)
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped" id="datatablesSimple">
                    <thead>
                        <tr>
                            <th>Product Code</th>
                            <th>Product Name</th>
                            <th>Current Stock</th>
                            <th>Reorder Level</th>
                            <th>Health Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var alert in Model.CriticalStockAlerts)
                        {
                            <tr>
                                <td>@alert.ProductCode</td>
                                <td>@alert.ProductName</td>
                                <td>@alert.CurrentStock</td>
                                <td>@alert.ReorderLevel</td>
                                <td>
                                    @if (alert.HealthStatus == "Critical")
                                    {
                                        <span class="badge bg-danger">Critical</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Low</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>