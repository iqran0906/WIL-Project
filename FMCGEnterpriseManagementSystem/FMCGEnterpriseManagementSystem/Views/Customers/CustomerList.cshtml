@model IEnumerable<FMCGEnterpriseManagementSystem.ViewModels.CustomerViewModel>

@{
    ViewData["Title"] = "Customers";

    var customers = Model?.ToList() ?? new List<FMCGEnterpriseManagementSystem.ViewModels.CustomerViewModel>();
    var totalCustomers = customers.Count;

    var assignedCustomers = customers.Count(c =>
        !string.IsNullOrWhiteSpace(c.SalesRep) &&
        !c.SalesRep.Equals("Unassigned", StringComparison.OrdinalIgnoreCase));

    var unassignedCustomers = totalCustomers - assignedCustomers;

    var customerGroups = customers
        .Where(c => !string.IsNullOrWhiteSpace(c.CustomerGroup))
        .Select(c => c.CustomerGroup)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();

    var isAdministrator = User.IsInRole("Administrator");
}

<div class="customer-page">

    <!-- PAGE HEADER -->
    <div class="customer-page-header">
        <div>
            <h2 class="customer-page-title">Customer Management</h2>
            <p class="customer-page-subtitle">
                Manage customer accounts, contact information and sales assignments.
            </p>
        </div>

        <div class="customer-header-actions">
            @if (isAdministrator)
            {
                <a asp-controller="Customers"
                   asp-action="RecentlyDeleted"
                   class="customer-btn-outline">
                    <i class="bi bi-trash3"></i>
                    Recently Deleted
                </a>
            }

            <a asp-controller="Customers"
               asp-action="AddCustomer"
               class="customer-btn-primary">
                <i class="bi bi-plus-lg"></i>
                New Customer
            </a>
        </div>
    </div>

    <!-- SUMMARY CARDS -->
    <div class="row g-3 mb-4">

        <div class="col-6 col-xl-3">
            <div class="customer-stat-card">
                <div class="customer-stat-label">Total Customers</div>
                <div class="customer-stat-value">@totalCustomers</div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="customer-stat-card assigned">
                <div class="customer-stat-label">Assigned to Sales Rep</div>
                <div class="customer-stat-value">@assignedCustomers</div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="customer-stat-card unassigned">
                <div class="customer-stat-label">Unassigned Customers</div>
                <div class="customer-stat-value">@unassignedCustomers</div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="customer-stat-card groups">
                <div class="customer-stat-label">Customer Groups</div>
                <div class="customer-stat-value">@customerGroups</div>
            </div>
        </div>

    </div>

    <!-- SEARCH -->
    <div class="customer-filter-panel">
        <form method="get"
              asp-controller="Customers"
              asp-action="CustomerList">

            <div class="row g-3 align-items-end">
                <div class="col-md-8">
                    <label class="customer-filter-label">
                        Search Customers
                    </label>

                    <input type="text"
                           name="searchKeyword"
                           value="@Context.Request.Query["searchKeyword"]"
                           class="form-control"
                           placeholder="Search customer name, email or contact number..." />
                </div>

                <div class="col-md-2">
                    <button type="submit"
                            class="customer-btn-primary w-100">
                        <i class="bi bi-search"></i>
                        Search
                    </button>
                </div>

                <div class="col-md-2">
                    <a asp-controller="Customers"
                       asp-action="CustomerList"
                       class="customer-btn-outline w-100">
                        Clear
                    </a>
                </div>
            </div>
        </form>
    </div>

    <!-- CUSTOMER TABLE -->
    <div class="customer-table-container">
        <table class="customer-table">

            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Contact</th>
                    <th>Address</th>
                    <th>Group</th>
                    <th>Payment Terms</th>
                    <th>Sales Rep</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (customers.Any())
                {
                    foreach (var customer in customers)
                    {
                        <tr>
                            <td>
                                <div class="customer-name">
                                    @customer.Name @customer.Surname
                                </div>

                                <div class="customer-secondary-text">
                                    @customer.Email
                                </div>

                                @if (!string.IsNullOrWhiteSpace(customer.VATNumber))
                                {
                                    <div class="customer-secondary-text">
                                        VAT: @customer.VATNumber
                                    </div>
                                }
                            </td>

                            <td>
                                <div>@customer.CellNumber</div>

                                @if (!string.IsNullOrWhiteSpace(customer.TelephoneNumber))
                                {
                                    <div class="customer-secondary-text">
                                        @customer.TelephoneNumber
                                    </div>
                                }
                            </td>

                            <td style="max-width: 220px;">
                                @customer.PhysicalAddress

                                @if (!string.IsNullOrWhiteSpace(customer.DeliveryAddress) &&
                                     customer.DeliveryAddress != customer.PhysicalAddress)
                                {
                                    <div class="customer-secondary-text">
                                        Delivery: @customer.DeliveryAddress
                                    </div>
                                }
                            </td>

                            <td>
                                <span class="customer-badge customer-badge-group">
                                    @customer.CustomerGroup
                                </span>
                            </td>

                            <td>@customer.PaymentTerms</td>

                            <td>
                                @if (string.IsNullOrWhiteSpace(customer.SalesRep) ||
                                     customer.SalesRep.Equals("Unassigned", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="customer-badge customer-badge-unassigned">
                                        Unassigned
                                    </span>
                                }
                                else
                                {
                                    <span class="customer-badge customer-badge-assigned">
                                        @customer.SalesRep
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="customer-actions">
                                    <a asp-controller="Customers"
                                       asp-action="Edit"
                                       asp-route-id="@customer.CustomerId"
                                       class="customer-action-btn customer-action-edit">
                                        <i class="bi bi-pencil-square"></i>
                                        Edit
                                    </a>

                                    @if (isAdministrator)
                                    {
                                        <a asp-controller="Customers"
                                           asp-action="Delete"
                                           asp-route-id="@customer.CustomerId"
                                           class="customer-action-btn customer-action-delete">
                                            <i class="bi bi-trash"></i>
                                            Delete
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7">
                            <div class="customer-empty-state">
                                <i class="bi bi-people fs-2 d-block mb-2"></i>
                                <strong>No customers found.</strong>
                                <p class="mb-0 mt-2">
                                    Try a different search or add a new customer.
                                </p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>

</div>