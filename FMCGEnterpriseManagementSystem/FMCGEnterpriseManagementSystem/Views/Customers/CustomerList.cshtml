@model IEnumerable<FMCGEnterpriseManagementSystem.ViewModels.CustomerViewModel>

@{
    ViewData["Title"] = "Customers";
}

<div class="p-3">
    <!-- Header Row -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold mb-0 text-white" style="font-size: 2.2rem;">Customers</h1>
    </div>

    <!-- New Customer Button -->
    <div class="mb-4">
        <a asp-controller="Customers" asp-action="AddCustomer" class="btn fw-bold px-4 py-2 text-white" style="background-color: #316573; border: none; border-radius: 4px;">New Customer</a>
    </div>

    <!-- Search & Filter Bar -->
    <form method="get" class="d-flex align-items-center gap-2 mb-4">
        <label class="fw-bold mb-0 text-white">Keyword:</label>
        <div class="input-group" style="width: 300px;">
            <input type="text" name="searchKeyword" class="form-control rounded-0" placeholder="Customer Name, Email..." style="border: 1px solid #ccc;">
            <button type="submit" class="btn btn-light rounded-0 border" style="background-color: #f4f4f4; border-color: #ccc !important;">
                <i class="bi bi-search"></i>
            </button>
        </div>
    </form>

    <!-- Table styled with a clean white background and dark text -->
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 bg-white text-dark shadow-sm" style="border: 1px solid #dee2e6; font-size: 0.9rem;">
            <thead>
                <tr class="bg-light border-bottom">
                    <th class="fw-semibold py-3 px-2 text-dark">Customer Name</th>
                    <th class="fw-semibold py-3 px-2 text-dark">Contact Number</th>
                    <th class="fw-semibold py-3 px-2 text-dark">Physical Address</th>
                    <th class="fw-semibold py-3 px-2 text-dark">Delivery Address</th>
                    <th class="fw-semibold py-3 px-2 text-dark">Email</th>
                    <th class="fw-semibold py-3 px-2 text-dark">VAT Number</th>
                    <th class="fw-semibold py-3 px-2 text-dark">Group</th>
                    <th class="fw-semibold py-3 px-2 text-dark">Payment Terms</th>
                    <th class="fw-semibold py-3 px-2 text-dark">Sales Rep</th>
                    <th class="fw-semibold py-3 px-2 text-center text-dark" style="width: 140px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var customer in Model)
                    {
                        <tr class="border-bottom bg-white text-dark">
                            <td class="py-3 px-2 fw-medium">@customer.Name @customer.Surname</td>
                            <td class="py-3 px-2">
                                <div>C: @customer.CellNumber</div>
                                @if (!string.IsNullOrWhiteSpace(customer.TelephoneNumber))
                                {
                                    <div class="small text-muted">T: @customer.TelephoneNumber</div>
                                }
                            </td>
                            <td class="py-3 px-2">@customer.PhysicalAddress</td>
                            <td class="py-3 px-2">@(string.IsNullOrWhiteSpace(customer.DeliveryAddress) ? customer.PhysicalAddress : customer.DeliveryAddress)</td>
                            <td class="py-3 px-2">@customer.Email</td>
                            <td class="py-3 px-2">@(string.IsNullOrWhiteSpace(customer.VATNumber) ? "-" : customer.VATNumber)</td>
                            <td class="py-3 px-2">@customer.CustomerGroup</td>
                            <td class="py-3 px-2">@customer.PaymentTerms</td>
                            <td class="py-3 px-2">@customer.SalesRep</td>
                            <td class="py-3 px-2 text-center">
                                <div class="d-flex justify-content-center gap-1">
                                    <a class="btn btn-sm btn-outline-secondary py-0 px-2" asp-controller="Customers" asp-action="Edit" asp-route-id="@customer.CustomerId" title="Edit">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <a class="btn btn-sm btn-outline-danger py-0 px-2" asp-controller="Customers" asp-action="Delete" asp-route-id="@customer.CustomerId" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr class="bg-white">
                        <td colspan="10" class="text-center py-4 text-muted">
                            No customers found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>