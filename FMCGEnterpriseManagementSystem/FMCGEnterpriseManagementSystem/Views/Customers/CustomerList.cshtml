@model IEnumerable<FMCGEnterpriseManagementSystem.ViewModels.CustomerViewModel>

@{
    ViewData["Title"] = "Customers";

    var customers = Model?.ToList() ?? new List<FMCGEnterpriseManagementSystem.ViewModels.CustomerViewModel>();
    var totalCustomers = customers.Count;
    var assignedCustomers = customers.Count(c =>
        !string.IsNullOrWhiteSpace(c.SalesRep) &&
        !c.SalesRep.Equals("Unassigned", StringComparison.OrdinalIgnoreCase));
    var unassignedCustomers = totalCustomers - assignedCustomers;
    var customerGroups = customers
        .Where(c => !string.IsNullOrWhiteSpace(c.CustomerGroup))
        .Select(c => c.CustomerGroup)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();
}

<div class="content-card">

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Customers</h2>
            <p class="text-muted mb-0">
                Manage customer accounts, contact information and sales assignments.
            </p>
        </div>

        <a asp-controller="Customers"
           asp-action="AddCustomer"
           class="btn btn-action-primary">
            <i class="bi bi-plus-lg me-1"></i>
            New Customer
        </a>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">

        <div class="col-6 col-xl-3">
            <div class="border rounded-3 p-3 h-100 bg-light">
                <div class="text-muted small mb-1">Total Customers</div>
                <div class="fs-3 fw-bold">@totalCustomers</div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="border rounded-3 p-3 h-100 bg-light">
                <div class="text-muted small mb-1">Assigned to Sales Rep</div>
                <div class="fs-3 fw-bold">@assignedCustomers</div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="border rounded-3 p-3 h-100 bg-light">
                <div class="text-muted small mb-1">Unassigned</div>
                <div class="fs-3 fw-bold">@unassignedCustomers</div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="border rounded-3 p-3 h-100 bg-light">
                <div class="text-muted small mb-1">Customer Groups</div>
                <div class="fs-3 fw-bold">@customerGroups</div>
            </div>
        </div>

    </div>

    <!-- Search -->
    <form method="get"
          asp-controller="Customers"
          asp-action="CustomerList"
          class="mb-4">

        <div class="row g-2 align-items-end">

            <div class="col-md-7 col-lg-5">
                <label class="form-label fw-semibold">Search Customers</label>

                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <i class="bi bi-search"></i>
                    </span>

                    <input type="text"
                           name="searchKeyword"
                           value="@Context.Request.Query["searchKeyword"]"
                           class="form-control"
                           placeholder="Search name, email or contact number..." />
                </div>
            </div>

            <div class="col-auto">
                <button type="submit"
                        class="btn btn-action-primary px-4">
                    Search
                </button>
            </div>

            <div class="col-auto">
                <a asp-controller="Customers"
                   asp-action="CustomerList"
                   class="btn btn-outline-secondary px-4">
                    Clear
                </a>
            </div>

        </div>
    </form>

    <!-- Customer Table -->
    <div class="table-responsive">

        <table class="table table-hover align-middle border mb-0">

            <thead class="table-light">
                <tr>
                    <th class="py-3">Customer</th>
                    <th class="py-3">Contact</th>
                    <th class="py-3">Address</th>
                    <th class="py-3">Group</th>
                    <th class="py-3">Payment Terms</th>
                    <th class="py-3">Sales Rep</th>
                    <th class="py-3 text-center">Actions</th>
                </tr>
            </thead>

            <tbody>

                @if (customers.Any())
                {
                    foreach (var customer in customers)
                    {
                        <tr>

                            <!-- Customer -->
                            <td class="py-3">
                                <div class="fw-bold">
                                    @customer.Name @customer.Surname
                                </div>

                                <div class="small text-muted">
                                    @customer.Email
                                </div>

                                @if (!string.IsNullOrWhiteSpace(customer.VATNumber))
                                {
                                    <div class="small text-muted">
                                        VAT: @customer.VATNumber
                                    </div>
                                }
                            </td>

                            <!-- Contact -->
                            <td class="py-3">
                                <div>
                                    <i class="bi bi-phone me-1 text-muted"></i>
                                    @customer.CellNumber
                                </div>

                                @if (!string.IsNullOrWhiteSpace(customer.TelephoneNumber))
                                {
                                    <div class="small text-muted mt-1">
                                        <i class="bi bi-telephone me-1"></i>
                                        @customer.TelephoneNumber
                                    </div>
                                }
                            </td>

                            <!-- Address -->
                            <td class="py-3" style="max-width: 220px;">
                                <div>
                                    @customer.PhysicalAddress
                                </div>

                                @if (!string.IsNullOrWhiteSpace(customer.DeliveryAddress) &&
                                     customer.DeliveryAddress != customer.PhysicalAddress)
                                {
                                    <div class="small text-muted mt-1">
                                        Delivery: @customer.DeliveryAddress
                                    </div>
                                }
                            </td>

                            <!-- Group -->
                            <td class="py-3">
                                <span class="badge bg-secondary">
                                    @customer.CustomerGroup
                                </span>
                            </td>

                            <!-- Payment Terms -->
                            <td class="py-3">
                                @customer.PaymentTerms
                            </td>

                            <!-- Sales Rep -->
                            <td class="py-3">

                                @if (string.IsNullOrWhiteSpace(customer.SalesRep) ||
                                     customer.SalesRep.Equals("Unassigned", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-warning text-dark">
                                        Unassigned
                                    </span>
                                }
                                else
                                {
                                    <span class="fw-semibold">
                                        @customer.SalesRep
                                    </span>
                                }

                            </td>

                            <!-- Actions -->
                            <td class="py-3 text-center">

                                <div class="d-flex justify-content-center gap-2">

                                    <a asp-controller="Customers"
                                       asp-action="Edit"
                                       asp-route-id="@customer.CustomerId"
                                       class="btn btn-sm btn-warning">
                                        <i class="bi bi-pencil-square me-1"></i>
                                        Edit
                                    </a>

                                    <a asp-controller="Customers"
                                       asp-action="Delete"
                                       asp-route-id="@customer.CustomerId"
                                       class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash me-1"></i>
                                        Delete
                                    </a>

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7"
                            class="text-center text-muted py-5">

                            <i class="bi bi-people fs-2 d-block mb-2"></i>

                            No customers found.

                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>