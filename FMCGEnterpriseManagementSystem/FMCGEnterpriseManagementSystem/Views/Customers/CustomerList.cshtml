@model IEnumerable<FMCGEnterpriseManagementSystem.ViewModels.CustomerViewModel>

@{
    ViewData["Title"] = "Customers";
}

<div class="p-3">
    <!-- Header Row -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold mb-0 text-white" style="font-size: 2.2rem;">Customers</h1>
    </div>

    <!-- New Customer Button -->
    <div class="mb-4">
        <a asp-controller="Customers" asp-action="AddCustomer" class="btn fw-bold px-4 py-2 text-white" style="background-color: #316573; border: none; border-radius: 4px;">New Customer</a>
    </div>

    <!-- Search & Filter Bar -->
    <form method="get" class="d-flex align-items-center gap-2 mb-4">
        <label class="fw-bold mb-0 text-white">Keyword:</label>
        <div class="input-group" style="width: 300px;">
            <input type="text" name="searchKeyword" class="form-control rounded-0" placeholder="Customer Name, Email..." style="border: 1px solid #ccc;">
            <button type="submit" class="btn btn-light rounded-0 border" style="background-color: #f4f4f4; border-color: #ccc !important;">
                <i class="bi bi-search"></i>
            </button>
        </div>
    </form>

    <!-- Table matching Supplier style -->
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" style="border: 1px solid #44596e; font-size: 0.95rem;">
            <thead>
                <tr style="background-color: #ffffff; border-bottom: 1px solid #c0c0c0;">
                    <th class="fw-semibold py-3 px-3" style="color: #000;">Customer Name</th>
                    <th class="fw-semibold py-3 px-3" style="color: #000;">Contact Number</th>
                    <th class="fw-semibold py-3 px-3" style="color: #000;">Address</th>
                    <th class="fw-semibold py-3 px-3" style="color: #000;">Salesperson</th>
                    <th class="fw-semibold py-3 px-3 text-center" style="color: #000; width: 60px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                @*[cite: 2] *@
                {
                    @foreach (var customer in Model)
                    @*[cite: 2] *@
                    {
                        <tr class="text-white" style="border-bottom: 1px solid #2d4052; background-color: #1a2a38;">
                            <td class="py-3 px-3 text-white">@customer.Name @customer.Surname</td>
                            <td class="py-3 px-3 text-white">@customer.CellNumber</td>
                            <td class="py-3 px-3 text-white">@customer.PhysicalAddress</td>
                            <td class="py-3 px-3 text-white">@customer.SalesRep</td>
                            <td class="py-3 px-3 text-center">
                                <div class="dropdown">
                                    <button class="btn btn-sm p-0 border-0 text-white" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        ▼
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow rounded-0">
                                        <li>
                                            <a class="dropdown-item small" asp-controller="Customers" asp-action="Edit" asp-route-id="@customer.CustomerId">
                                                <i class="bi bi-pencil me-2"></i>Edit
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item small" asp-controller="Customers" asp-action="DownloadCustomerPdf" asp-route-id="@customer.CustomerId">
                                                <i class="bi bi-file-earmark-arrow-down me-2"></i>Download PDF
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item small" asp-controller="Customers" asp-action="ViewCustomerPdf" asp-route-id="@customer.CustomerId" target="_blank">
                                                <i class="bi bi-file-earmark-pdf me-2"></i>View PDF
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item small text-danger" asp-controller="Customers" asp-action="Delete" asp-route-id="@customer.CustomerId">
                                                <i class="bi bi-trash me-2"></i>Delete
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr style="background-color: #ffffff;">
                        <td colspan="5" class="text-center py-4 text-muted">
                            <!-- Empty row matching the clean look -->
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>