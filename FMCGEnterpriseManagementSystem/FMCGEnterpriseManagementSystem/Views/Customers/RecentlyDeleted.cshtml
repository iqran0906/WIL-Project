@model IEnumerable<FMCGEnterpriseManagementSystem.ViewModels.CustomerViewModel>

@{
    ViewData["Title"] = "Recently Deleted Customers";
}

<div class="container-fluid px-4 py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Recently Deleted Customers</h2>
            <p class="text-muted mb-0">
                View and restore customer records that have been deleted.
            </p>
        </div>

        <a asp-controller="Customers"
           asp-action="CustomerList"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Customers
        </a>
    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle me-2"></i>

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }


    <!-- Recently Deleted Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="px-4 py-3">
                                    Customer
                                </th>

                                <th class="py-3">
                                    Email
                                </th>

                                <th class="py-3">
                                    Cell Number
                                </th>

                                <th class="py-3">
                                    Customer Group
                                </th>

                                <th class="py-3">
                                    Sales Representative
                                </th>

                                <th class="text-end px-4 py-3">
                                    Action
                                </th>
                            </tr>
                        </thead>


                        <tbody>

                            @foreach (var customer in Model)
                            {
                                <tr>

                                    <td class="px-4">
                                        <div class="fw-semibold">
                                            @customer.Name @customer.Surname
                                        </div>

                                        <small class="text-muted">
                                            Customer #@customer.CustomerId
                                        </small>
                                    </td>


                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(customer.Email))
                                        {
                                            @customer.Email
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not provided
                                            </span>
                                        }
                                    </td>


                                    <td>
                                        @customer.CellNumber
                                    </td>


                                    <td>
                                        @customer.CustomerGroup
                                    </td>


                                    <td>
                                        @customer.SalesRep
                                    </td>


                                    <td class="text-end px-4">

                                        <form asp-controller="Customers"
                                              asp-action="Restore"
                                              asp-route-id="@customer.CustomerId"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success">

                                                <i class="bi bi-arrow-counterclockwise me-1"></i>
                                                Restore

                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-trash3 fs-1 text-muted"></i>

                    <h5 class="mt-3 mb-1">
                        No Recently Deleted Customers
                    </h5>

                    <p class="text-muted mb-3">
                        Deleted customer records will appear here.
                    </p>

                    <a asp-controller="Customers"
                       asp-action="CustomerList"
                       class="btn btn-outline-secondary">

                        Back to Customers

                    </a>

                </div>
            }

        </div>
    </div>

</div>