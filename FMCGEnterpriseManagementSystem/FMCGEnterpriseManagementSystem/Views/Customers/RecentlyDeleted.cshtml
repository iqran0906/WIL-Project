@model IEnumerable<FMCGEnterpriseManagementSystem.ViewModels.CustomerViewModel>

@{
    ViewData["Title"] = "Recently Deleted Customers";

    var deletedCustomers = Model?.ToList()
        ?? new List<FMCGEnterpriseManagementSystem.ViewModels.CustomerViewModel>();
}

<div class="customer-page">

    <!-- PAGE HEADER -->
    <div class="customer-page-header">

        <div>

            <h2 class="customer-page-title">
                Recently Deleted Customers
            </h2>

            <p class="customer-page-subtitle">
                Review and restore previously deleted customer records.
            </p>

        </div>

        <a asp-controller="Customers"
           asp-action="CustomerList"
           class="customer-btn-outline">

            <i class="bi bi-arrow-left"></i>
            Back to Customers

        </a>

    </div>

    <!-- SUCCESS MESSAGE -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle me-2"></i>

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    <!-- SUMMARY -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">

            <div class="customer-stat-card">

                <div class="customer-stat-label">
                    Recently Deleted
                </div>

                <div class="customer-stat-value">
                    @deletedCustomers.Count
                </div>

            </div>

        </div>

    </div>

    <!-- DELETED CUSTOMERS TABLE -->
    @if (deletedCustomers.Any())
    {
        <div class="customer-table-container">

            <table class="customer-table">

                <thead>

                    <tr>
                        <th>Customer</th>
                        <th>Email</th>
                        <th>Cell Number</th>
                        <th>Customer Group</th>
                        <th>Sales Representative</th>
                        <th>Actions</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var customer in deletedCustomers)
                    {
                        <tr>

                            <!-- CUSTOMER -->
                            <td>

                                <div class="customer-name">
                                    @customer.Name @customer.Surname
                                </div>

                                <div class="customer-secondary-text">
                                    Customer #@customer.CustomerId
                                </div>

                            </td>

                            <!-- EMAIL -->
                            <td>

                                @if (!string.IsNullOrWhiteSpace(customer.Email))
                                {
                                    @customer.Email
                                }
                                else
                                {
                                    <span class="customer-secondary-text">
                                        Not provided
                                    </span>
                                }

                            </td>

                            <!-- CONTACT -->
                            <td>
                                @customer.CellNumber
                            </td>

                            <!-- GROUP -->
                            <td>

                                <span class="customer-badge customer-badge-group">
                                    @customer.CustomerGroup
                                </span>

                            </td>

                            <!-- SALES REP -->
                            <td>

                                @if (string.IsNullOrWhiteSpace(customer.SalesRep) ||
                                     customer.SalesRep.Equals(
                                         "Unassigned",
                                         StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="customer-badge customer-badge-unassigned">
                                        Unassigned
                                    </span>
                                }
                                else
                                {
                                    <span class="customer-badge customer-badge-assigned">
                                        @customer.SalesRep
                                    </span>
                                }

                            </td>

                            <!-- RESTORE -->
                            <td>

                                <div class="customer-actions">

                                    <form asp-controller="Customers"
                                          asp-action="Restore"
                                          asp-route-id="@customer.CustomerId"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="customer-action-btn customer-action-restore">

                                            <i class="bi bi-arrow-counterclockwise"></i>
                                            Restore

                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <!-- EMPTY STATE -->
        <div class="customer-empty-state">

            <i class="bi bi-trash3 fs-1 d-block mb-3"></i>

            <h5 class="fw-bold mb-2">
                No Recently Deleted Customers
            </h5>

            <p class="mb-4">
                Deleted customer records will appear here.
            </p>

            <a asp-controller="Customers"
               asp-action="CustomerList"
               class="customer-btn-outline">

                <i class="bi bi-arrow-left"></i>
                Back to Customers

            </a>

        </div>
    }

</div>