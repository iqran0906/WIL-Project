@model FMCGEnterpriseManagementSystem.ViewModels.CustomerViewModel

@{
    ViewData["Title"] = "Delete Customer";
}

<div class="content-card">
    <h2 class="fw-bold mb-3 text-danger">Delete Customer</h2>
    <p class="text-muted mb-4">Are you sure you want to delete this customer? This action cannot be undone.</p>

    <div class="card border-danger mb-4">
        <div class="card-body">
            <h5 class="card-title fw-bold">@Model.Name @Model.Surname</h5>
            <p class="card-text mb-1"><strong>Email:</strong> @Model.Email</p>
            <p class="card-text mb-1"><strong>Cell:</strong> @Model.CellNumber</p>
            <p class="card-text mb-0"><strong>Group:</strong> @Model.CustomerGroup</p>
        </div>
    </div>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CustomerId" />

        <div class="d-flex justify-content-end gap-3">
            <a asp-action="CustomerList" class="btn btn-secondary align-self-center">Cancel</a>
            <button type="submit" class="btn btn-danger">Confirm Delete</button>
        </div>
    </form>
</div>