@model FMCGEnterpriseManagementSystem.ViewModels.TriggerReorderViewModel

@{
    ViewData["Title"] = "Trigger Automated Reorder";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold mb-0">Reorder Stock</h3>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Forecasting</a>
        </div>

        <form asp-action="Reorder" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ProductId" />
            <input type="hidden" asp-for="ProductCode" />
            <input type="hidden" asp-for="ProductName" />

            <div class="mb-3">
                <label class="form-label">Product</label>
                <input class="form-control" value="[@Model.ProductCode] @Model.ProductName" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="SupplierId" class="form-label"></label>
                <select asp-for="SupplierId" asp-items="ViewBag.Suppliers" class="form-select">
                    <option value="">-- Select Supplier --</option>
                </select>
                <span asp-validation-for="SupplierId" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ReorderQuantity" class="form-label"></label>
                <input asp-for="ReorderQuantity" class="form-control" type="number" />
                <span asp-validation-for="ReorderQuantity" class="text-danger small"></span>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-custom-save">Confirm & Order Stock</button>
            </div>
        </form>
    </div>
</div>