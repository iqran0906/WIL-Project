@{
    string userEmail = User.Identity?.IsAuthenticated == true ? User.Identity.Name ?? "User" : "Guest";
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";

    string autoMessage = (currentController, currentAction) switch
    {
        ("Home", "Dashboard") => "Welcome back to your central command dashboard. Monitor system metrics and shortcuts below.",
        ("Home", "CustomerList") => "Manage, view, and organize your client database records from this active customer register.",
        ("Home", "AddCustomer") => "Fill out the required information below to register a new customer into the enterprise system.",
        ("Home", "SupplierList") => "Review and maintain your supplier and vendor network directory.",
        ("Employees", "Index") => "View and manage all active company employee records and personnel details.",
        ("SalesRepresentatives", "Index") => "Access and track sales representative profiles, regions, and performance logs.",
        ("Home", "InventoryList") => "Manage and track inventory levels, stock availability, and warehouse storage items.",
        ("Home", "InvoiceList") => "Review, track, and generate customer billing invoices and payment histories.",
        ("Payments", "Index") => "Monitor incoming financial transactions, payment statuses, and settlement logs.",
        ("Home", "QuoteList") => "Review and manage pending and approved customer price quotations.",
        ("Reports", "Index") => "Analyze operational performance data, sales reports, and summary metrics.",
        ("Home", "Settings") => "Manage system user registrations, administrative access, and account settings.",
        ("Home", "UserProfile") => "View and update your personal account credentials and profile details.",
        _ => $"You are currently viewing the {currentAction} management portal for Exclusive Distributors."
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Exclusive Distributors</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        :root {
            --sidebar-bg: #357383;
            --main-bg: #1c323d;
            --card-bg: rgba(255, 255, 255, 0.95);
            --text-dark: #212529;
        }

        body {
            background-color: var(--main-bg);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow-x: hidden;
        }

        .sidebar {
            background-color: var(--sidebar-bg);
            min-height: auto;
            color: white;
            padding-top: 20px;
            transition: margin-left 0.3s ease-in-out;
        }

            .sidebar.collapsed-sidebar {
                display: none !important;
            }

        @@media (min-width: 768px) {
            .sidebar {
                min-height: 100vh;
            }
        }

        .sidebar .nav-link, .mobile-dropdown .nav-link {
            color: rgba(255, 255, 255, 0.85);
            font-weight: 600;
            font-size: 1.1rem;
            padding: 12px 20px;
            border-left: 4px solid transparent;
            transition: all 0.2s ease;
        }

            .sidebar .nav-link:hover, .sidebar .nav-link.active,
            .mobile-dropdown .nav-link:hover, .mobile-dropdown .nav-link.active {
                color: #ffffff;
                background-color: rgba(255, 255, 255, 0.1);
                border-left: 4px solid #ffffff;
                text-shadow: 1px 1px 2px rgba(0,0,0,0.3);
            }

        .brand-logo-container {
            width: 80px;
            height: 80px;
            background: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
            padding: 5px;
        }

            .brand-logo-container img {
                width: 100%;
                height: 100%;
                object-fit: contain;
                border-radius: 50%;
            }

        .sidebar-bottom-wrapper {
            padding-bottom: 25px;
            padding-top: 20px;
            margin-top: auto;
        }

        .btn-sidebar-logout {
            background-color: rgba(255, 255, 255, 0.15);
            color: #ffffff;
            font-weight: 600;
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 6px;
            padding: 8px 16px;
            transition: all 0.2s ease;
            width: 100%;
        }

            .btn-sidebar-logout:hover {
                background-color: #dc3545;
                color: white;
                border-color: #dc3545;
            }

        .top-navbar {
            background-color: transparent !important;
            padding: 15px 15px;
        }

        @@media (min-width: 768px) {
            .top-navbar {
                padding: 15px 30px;
            }
        }

        .top-navbar .navbar-brand {
            color: white !important;
            font-weight: bold;
            font-size: 1.2rem;
        }

        @@media (min-width: 768px) {
            .top-navbar .navbar-brand {
                font-size: 1.5rem;
            }
        }

        .content-card {
            background: var(--card-bg);
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.2);
            min-height: 80vh;
            margin-bottom: 30px;
        }

        @@media (min-width: 768px) {
            .content-card {
                padding: 30px;
            }
        }

        .form-label {
            font-weight: 500;
            color: #495057;
            font-size: 0.9rem;
            margin-bottom: 4px;
        }

        .form-control, .form-select {
            border-radius: 6px;
            border: 1px solid #ced4da;
            padding: 8px 12px;
            background-color: #f8f9fa;
        }

            .form-control:focus, .form-select:focus {
                background-color: #fff;
                border-color: #357383;
                box-shadow: 0 0 0 0.25rem rgba(53, 115, 131, 0.25);
            }

        .btn-custom-save {
            background-color: #212529;
            color: white;
            border: none;
            padding: 10px 24px;
            border-radius: 6px;
            font-weight: 500;
        }

            .btn-custom-save:hover {
                background-color: #000000;
                color: white;
            }

        .btn-action-primary {
            background-color: #357383;
            color: white;
            font-weight: 600;
            padding: 8px 24px;
            border-radius: 4px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.15);
        }

            .btn-action-primary:hover {
                background-color: #2b5e6b;
                color: white;
            }

        .custom-data-table {
            border-collapse: separate;
            border-spacing: 0 8px;
            width: 100%;
        }

            .custom-data-table th, .custom-data-table td {
                background: white;
                padding: 10px 15px;
                text-align: center;
                border: 1px solid #c8d6e5;
                color: #212529;
                font-weight: 500;
            }

            .custom-data-table th {
                font-weight: 600;
                background: #ffffff;
            }
    </style>
</head>
<body>

    <div class="d-md-none text-white" style="background-color: var(--sidebar-bg);">
        <div class="d-flex justify-content-between align-items-center px-3 py-2">
            <div class="d-flex align-items-center gap-2">
                <img src="~/images/logo.png" alt="Logo" style="width: 32px; height: 32px; border-radius: 50%; object-fit: contain; background: white; padding: 2px;" />
                <span class="fw-bold fs-5">Menu</span>
            </div>

            <button class="btn text-white p-1 border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mobileMenu">
                <i class="bi bi-list fs-1"></i>
            </button>
        </div>

        <div class="collapse mobile-dropdown" id="mobileMenu">
            <ul class="nav flex-column text-center pb-3">
                <li class="nav-item"><a class="nav-link py-2" asp-controller="Home" asp-action="Dashboard">Dashboard</a></li>
                <li class="nav-item"><a class="nav-link py-2" asp-controller="Home" asp-action="CustomerList">Customers</a></li>
                <li class="nav-item"><a class="nav-link py-2" asp-controller="Home" asp-action="SupplierList">Suppliers</a></li>
                <li class="nav-item"><a class="nav-link py-2" asp-controller="Employees" asp-action="Index">Employees</a></li>
                <li class="nav-item"><a class="nav-link py-2" asp-controller="SalesRepresentatives" asp-action="Index">Sales Representatives</a></li>
                <li class="nav-item"><a class="nav-link py-2" asp-controller="Home" asp-action="InventoryList">Inventory</a></li>
                <li class="nav-item"><a class="nav-link py-2" asp-controller="Home" asp-action="InvoiceList">Invoices</a></li>
                <li class="nav-item"><a class="nav-link py-2" asp-controller="Payments" asp-action="Index">Payments</a></li>
                <li class="nav-item"><a class="nav-link py-2" asp-controller="Home" asp-action="QuoteList">Quotes</a></li>
                <li class="nav-item"><a class="nav-link py-2" asp-controller="Reports" asp-action="Index">Reports</a></li>
                <li class="nav-item"><a class="nav-link py-2" asp-controller="Home" asp-action="Settings">Settings</a></li>
            </ul>
        </div>
    </div>

    <div class="container-fluid p-0">
        <div class="row g-0">

            <div id="sidebarCol" class="col-md-3 col-lg-2 sidebar d-none d-md-flex flex-column justify-content-between">
                <div>
                    <div class="px-3 mb-4">
                        <h4 class="text-center font-weight-bold tracking-wide py-2 m-0">Exclusive Distributors</h4>
                    </div>

                    <ul class="nav flex-column justify-content-start">
                        <li class="nav-item"><a class="nav-link px-3 py-2" asp-controller="Home" asp-action="Dashboard">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link px-3 py-2" asp-controller="Home" asp-action="CustomerList">Customers</a></li>
                        <li class="nav-item"><a class="nav-link px-3 py-2" asp-controller="Home" asp-action="SupplierList">Suppliers</a></li>
                        <li class="nav-item"><a class="nav-link px-3 py-2" asp-controller="Employees" asp-action="Index">Employees</a></li>
                        <li class="nav-item"><a class="nav-link px-3 py-2" asp-controller="SalesRepresentatives" asp-action="Index">Sales Representatives</a></li>
                        <li class="nav-item"><a class="nav-link px-3 py-2" asp-controller="Home" asp-action="InventoryList">Inventory</a></li>
                        <li class="nav-item"><a class="nav-link px-3 py-2" asp-controller="Home" asp-action="InvoiceList">Invoices</a></li>
                        <li class="nav-item"><a class="nav-link px-3 py-2" asp-controller="Payments" asp-action="Index">Payments</a></li>
                        <li class="nav-item"><a class="nav-link px-3 py-2" asp-controller="Home" asp-action="QuoteList">Quotes</a></li>
                        <li class="nav-item"><a class="nav-link px-3 py-2" asp-controller="Reports" asp-action="Index">Reports</a></li>
                        <li class="nav-item"><a class="nav-link px-3 py-2" asp-controller="Home" asp-action="Settings">Settings</a></li>
                    </ul>
                </div>

                <div class="sidebar-bottom-wrapper d-flex flex-column align-items-center gap-3 px-3">
                    <form asp-controller="Account" asp-action="Logout" method="post" class="w-100 m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sidebar-logout d-inline-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-box-arrow-right"></i>
                            <span>Logout</span>
                        </button>
                    </form>
                    <div class="brand-logo-container">
                        <img src="~/images/logo.png" alt="Exclusive Distributors Logo" />
                    </div>
                </div>
            </div>

            <div id="contentCol" class="col-12 col-md-9 col-lg-10 d-flex flex-column">

                <header>
                    <nav class="navbar navbar-expand navbar-light top-navbar d-flex justify-content-between align-items-center">

                        <div class="d-flex align-items-center gap-2">
                            <button id="toggleSidebarBtn" type="button" class="btn text-white p-1 border-0 me-2" title="Hide/Show Taskbar">
                                <i class="bi bi-list fs-3"></i>
                            </button>
                            <span class="navbar-brand">Exclusive Distributors</span>
                        </div>

                        <div class="d-flex align-items-center gap-3 gap-md-4 text-white">
                            <span class="text-white-50 small d-none d-lg-inline">
                                <i class="bi bi-envelope me-1 text-info"></i><strong class="text-white">@userEmail</strong>
                            </span>

                            <a asp-controller="Notifications" asp-action="Index" class="text-white text-decoration-none">
                                <i class="bi bi-bell fs-4" style="cursor: pointer;"></i>
                            </a>

                            <a asp-controller="Home" asp-action="UserProfile" class="text-white text-decoration-none" title="@userEmail">
                                <i class="bi bi-person-circle fs-3" style="cursor: pointer;"></i>
                            </a>

                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn p-0 border-0 text-white" title="Logout">
                                    <i class="bi bi-box-arrow-right fs-4"></i>
                                </button>
                            </form>

                        </div>

                    </nav>
                </header>

                <div class="container-fluid px-2 px-md-4">
                    <div id="autoDismissNotice" class="alert alert-info bg-dark text-info border-info border-opacity-25 d-flex align-items-center mb-4 shadow-sm" role="alert" style="transition: opacity 0.5s ease;">
                        <i class="bi bi-info-circle-fill flex-shrink-0 me-2 fs-5"></i>
                        <div>
                            <strong>System Notice:</strong> @autoMessage
                        </div>
                    </div>

                    <main role="main" class="pb-3">
                        @RenderBody()
                    </main>
                </div>

            </div>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.getElementById('toggleSidebarBtn').addEventListener('click', function () {
            var sidebar = document.getElementById('sidebarCol');
            var content = document.getElementById('contentCol');

            sidebar.classList.toggle('collapsed-sidebar');
            if (sidebar.classList.contains('collapsed-sidebar')) {
                content.classList.remove('col-md-9', 'col-lg-10');
                content.classList.add('col-12');
            } else {
                content.classList.remove('col-12');
                content.classList.add('col-md-9', 'col-lg-10');
            }
        });

        window.addEventListener('DOMContentLoaded', (event) => {
            setTimeout(function() {
                var noticeBanner = document.getElementById('autoDismissNotice');
                if (noticeBanner) {
                    noticeBanner.style.opacity = '0';
                    setTimeout(function() {
                        noticeBanner.style.display = 'none';
                    }, 500); 
                }
            }, 5000); 
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>