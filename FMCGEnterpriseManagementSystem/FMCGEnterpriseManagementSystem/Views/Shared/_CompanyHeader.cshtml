@*
    Purpose: Company name and location shown at the top of New Quote / New Invoice.
    Authors: ST10068525 (new file, not yet committed)
*@
@* Company name + location at the top of New Quote / New Invoice (from Settings > Company Profile) *@
@model FMCGEnterpriseManagementSystem.Models.SystemSetting

@{
    var location = !string.IsNullOrWhiteSpace(Model.City) ? Model.City : Model.PhysicalAddress;
}

@if (string.IsNullOrWhiteSpace(Model.CompanyName))
{
    <h5 class="fw-bold m-0 text-muted">Company details not added yet</h5>
    <small class="text-muted d-block">
        Add them under <a asp-controller="Settings" asp-action="Index">Settings</a>
    </small>
}
else
{
    <h5 class="fw-bold m-0" style="color: #1c323d;">@Model.CompanyName</h5>
    <small class="text-muted d-block">
        @location@(string.IsNullOrWhiteSpace(Model.CompanyVatNumber) ? "" : (string.IsNullOrWhiteSpace(location) ? "" : " · ") + "VAT No. " + Model.CompanyVatNumber)
    </small>
}
