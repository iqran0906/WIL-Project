@model FMCGEnterpriseManagementSystem.ViewModels.CreateUserAccountViewModel

@{
    ViewData["Title"] = "Create User Account";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2>Create User Account</h2>

        @if (ViewBag.EmployeeName != null)
        {
            <p class="text-muted">
                Creating system access for
                <strong>@ViewBag.EmployeeName</strong>
            </p>
        }
    </div>

    <div class="card">
        <div class="card-body">

            <form asp-controller="UserAccounts"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <input asp-for="EmployeeID" type="hidden" />

                <!-- Email -->
                <div class="mb-3">

                    <label asp-for="Email"
                           class="form-label">
                    </label>

                    <input asp-for="Email"
                           class="form-control"
                           autocomplete="email" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>

                <!-- Role -->
                <div class="mb-3">

                    <label asp-for="Role"
                           class="form-label">
                    </label>

                    <select asp-for="Role"
                            class="form-select">

                        <option value="">
                            -- Select Role --
                        </option>

                        <option value="Employee">
                            Employee
                        </option>

                        <option value="SalesRepresentative">
                            Sales Representative
                        </option>

                    </select>

                    <span asp-validation-for="Role"
                          class="text-danger">
                    </span>

                </div>

                <!-- Temporary Password -->
                <div class="mb-3">

                    <label asp-for="TemporaryPassword"
                           class="form-label">
                    </label>

                    <div class="input-group">

                        <input asp-for="TemporaryPassword"
                               id="temporaryPassword"
                               class="form-control"
                               autocomplete="new-password" />

                        <button type="button"
                                id="toggleTemporaryPassword"
                                class="btn btn-outline-secondary"
                                aria-label="Show temporary password">

                            <i id="temporaryPasswordIcon"
                               class="bi bi-eye"></i>

                        </button>

                    </div>

                    <span asp-validation-for="TemporaryPassword"
                          class="text-danger">
                    </span>

                    <!-- Password Strength -->
                    <div class="mt-3">

                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="fw-semibold">
                                Password Strength:
                            </span>

                            <span id="passwordStrength"
                                  class="badge bg-secondary">
                                Not entered
                            </span>
                        </div>

                        <div class="progress mb-3"
                             style="height: 7px;">

                            <div id="passwordStrengthBar"
                                 class="progress-bar"
                                 role="progressbar"
                                 style="width: 0%">
                            </div>

                        </div>

                        <div class="small">

                            <div id="lengthRequirement"
                                 class="text-muted mb-1">
                                <i class="bi bi-circle me-1"></i>
                                At least 8 characters
                            </div>

                            <div id="uppercaseRequirement"
                                 class="text-muted mb-1">
                                <i class="bi bi-circle me-1"></i>
                                At least one uppercase letter
                            </div>

                            <div id="lowercaseRequirement"
                                 class="text-muted mb-1">
                                <i class="bi bi-circle me-1"></i>
                                At least one lowercase letter
                            </div>

                            <div id="numberRequirement"
                                 class="text-muted mb-1">
                                <i class="bi bi-circle me-1"></i>
                                At least one number
                            </div>

                            <div id="specialRequirement"
                                 class="text-muted">
                                <i class="bi bi-circle me-1"></i>
                                At least one special character
                            </div>

                        </div>

                    </div>

                </div>

                <!-- Confirm Password -->
                <div class="mb-3">

                    <label asp-for="ConfirmPassword"
                           class="form-label">
                    </label>

                    <div class="input-group">

                        <input asp-for="ConfirmPassword"
                               id="confirmPassword"
                               class="form-control"
                               autocomplete="new-password" />

                        <button type="button"
                                id="toggleConfirmPassword"
                                class="btn btn-outline-secondary"
                                aria-label="Show confirm password">

                            <i id="confirmPasswordIcon"
                               class="bi bi-eye"></i>

                        </button>

                    </div>

                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger">
                    </span>

                    <div id="passwordMatchMessage"
                         class="small mt-1">
                    </div>

                </div>

                <!-- Buttons -->
                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Create Account
                    </button>

                    <a asp-controller="UserAccounts"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        const temporaryPassword =
            document.getElementById("temporaryPassword");

        const confirmPassword =
            document.getElementById("confirmPassword");

        const toggleTemporaryPassword =
            document.getElementById("toggleTemporaryPassword");

        const toggleConfirmPassword =
            document.getElementById("toggleConfirmPassword");

        const temporaryPasswordIcon =
            document.getElementById("temporaryPasswordIcon");

        const confirmPasswordIcon =
            document.getElementById("confirmPasswordIcon");

        const passwordStrength =
            document.getElementById("passwordStrength");

        const passwordStrengthBar =
            document.getElementById("passwordStrengthBar");

        const passwordMatchMessage =
            document.getElementById("passwordMatchMessage");


        // Show / hide temporary password
        toggleTemporaryPassword.addEventListener(
            "click",
            function () {

                togglePasswordVisibility(
                    temporaryPassword,
                    temporaryPasswordIcon,
                    toggleTemporaryPassword
                );
            }
        );


        // Show / hide confirm password
        toggleConfirmPassword.addEventListener(
            "click",
            function () {

                togglePasswordVisibility(
                    confirmPassword,
                    confirmPasswordIcon,
                    toggleConfirmPassword
                );
            }
        );


        function togglePasswordVisibility(
            input,
            icon,
            button) {

            const passwordIsHidden =
                input.type === "password";

            input.type =
                passwordIsHidden
                    ? "text"
                    : "password";

            icon.classList.toggle(
                "bi-eye",
                !passwordIsHidden);

            icon.classList.toggle(
                "bi-eye-slash",
                passwordIsHidden);

            button.setAttribute(
                "aria-label",
                passwordIsHidden
                    ? "Hide password"
                    : "Show password");
        }


        // Password strength
        temporaryPassword.addEventListener(
            "input",
            function () {

                checkPasswordStrength();
                checkPasswordsMatch();
            }
        );


        // Confirm password matching
        confirmPassword.addEventListener(
            "input",
            checkPasswordsMatch
        );


        function checkPasswordStrength() {

            const password =
                temporaryPassword.value;

            const requirements = {
                length: password.length >= 8,
                uppercase: /[A-Z]/.test(password),
                lowercase: /[a-z]/.test(password),
                number: /[0-9]/.test(password),
                special: /[^A-Za-z0-9]/.test(password)
            };

            updateRequirement(
                "lengthRequirement",
                requirements.length);

            updateRequirement(
                "uppercaseRequirement",
                requirements.uppercase);

            updateRequirement(
                "lowercaseRequirement",
                requirements.lowercase);

            updateRequirement(
                "numberRequirement",
                requirements.number);

            updateRequirement(
                "specialRequirement",
                requirements.special);


            const score =
                Object.values(requirements)
                      .filter(Boolean)
                      .length;


            if (password.length === 0) {

                passwordStrength.textContent =
                    "Not entered";

                passwordStrength.className =
                    "badge bg-secondary";

                passwordStrengthBar.style.width =
                    "0%";

                passwordStrengthBar.className =
                    "progress-bar";

                return;
            }


            if (score <= 2) {

                passwordStrength.textContent =
                    "Weak";

                passwordStrength.className =
                    "badge bg-danger";

                passwordStrengthBar.style.width =
                    "33%";

                passwordStrengthBar.className =
                    "progress-bar bg-danger";
            }
            else if (score <= 4) {

                passwordStrength.textContent =
                    "Medium";

                passwordStrength.className =
                    "badge bg-warning text-dark";

                passwordStrengthBar.style.width =
                    "66%";

                passwordStrengthBar.className =
                    "progress-bar bg-warning";
            }
            else {

                passwordStrength.textContent =
                    "Strong";

                passwordStrength.className =
                    "badge bg-success";

                passwordStrengthBar.style.width =
                    "100%";

                passwordStrengthBar.className =
                    "progress-bar bg-success";
            }
        }


        function updateRequirement(
            elementId,
            requirementMet) {

            const element =
                document.getElementById(elementId);

            const icon =
                element.querySelector("i");


            if (requirementMet) {

                element.classList.remove(
                    "text-muted");

                element.classList.add(
                    "text-success");

                icon.className =
                    "bi bi-check-circle-fill me-1";
            }
            else {

                element.classList.remove(
                    "text-success");

                element.classList.add(
                    "text-muted");

                icon.className =
                    "bi bi-circle me-1";
            }
        }


        function checkPasswordsMatch() {

            const password =
                temporaryPassword.value;

            const confirmation =
                confirmPassword.value;


            if (confirmation.length === 0) {

                passwordMatchMessage.textContent =
                    "";

                return;
            }


            if (password === confirmation) {

                passwordMatchMessage.textContent =
                    "Passwords match.";

                passwordMatchMessage.className =
                    "small mt-1 text-success";
            }
            else {

                passwordMatchMessage.textContent =
                    "Passwords do not match.";

                passwordMatchMessage.className =
                    "small mt-1 text-danger";
            }
        }

    </script>
}