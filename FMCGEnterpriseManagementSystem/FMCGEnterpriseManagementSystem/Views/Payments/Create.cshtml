@model FMCGEnterpriseManagementSystem.ViewModels.PaymentViewModel

@{
    ViewData["Title"] = "Record Payment";
}

<div class="content-card">

    <div class="row align-items-center mb-4 g-3">
        <div class="col-12 col-sm-6 text-center text-sm-start">
            <h5 class="fw-bold m-0" style="color: #1c323d;">
                Exclusive Distributors (pty) LTD
            </h5>
            <small class="text-muted d-block">
                Durban
            </small>
        </div>

        <div class="col-12 col-sm-6 text-center text-sm-end">
            <div class="d-inline-block text-start w-100" style="max-width: 280px;">
                <div class="d-flex align-items-center justify-content-between gap-2">
                    <label class="small text-secondary fw-bold text-nowrap m-0">
                        Payment Date:
                    </label>

                    <input asp-for="PaymentDate"
                           type="date"
                           class="form-control form-control-sm"
                           style="width:160px;" />
                </div>
            </div>
        </div>
    </div>

    <h2 class="fw-bold mb-4 text-center text-sm-start"
        style="color: #1c323d;">
        Record Payment
    </h2>

    <form asp-controller="Payments"
          asp-action="Create"
          method="post">

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <div class="row g-3 mb-4">

            <div class="col-md-6">

                <div class="row align-items-center mb-3 g-2">

                    <label class="col-12 col-sm-4 fw-bold text-secondary">
                        Invoice Number
                    </label>

                    <div class="col-12 col-sm-8">

                        <input asp-for="InvoiceNumber"
                               class="form-control"
                               readonly />

                        <input asp-for="InvoiceId"
                               type="hidden" />

                    </div>

                </div>

                <div class="row align-items-center mb-3 g-2">

                    <label class="col-12 col-sm-4 fw-bold text-secondary">
                        Customer
                    </label>

                    <div class="col-12 col-sm-8">

                        <input asp-for="CustomerName"
                               class="form-control"
                               readonly />

                    </div>

                </div>

                <div class="row align-items-center g-2">

                    <label class="col-12 col-sm-4 fw-bold text-secondary">
                        Invoice Total
                    </label>

                    <div class="col-12 col-sm-8">

                        <input asp-for="InvoiceTotal"
                               class="form-control text-end"
                               value="@Model.InvoiceTotal.ToString("F2")"
                               readonly />

                    </div>

                </div>

            </div>


            <div class="col-md-6">

                <div class="row align-items-center mb-3 g-2">

                    <label class="col-12 col-sm-4 fw-bold text-secondary">
                        Amount Already Paid
                    </label>

                    <div class="col-12 col-sm-8">

                        <input asp-for="AmountAlreadyPaid"
                               class="form-control text-end"
                               value="@Model.AmountAlreadyPaid.ToString("F2")"
                               readonly />

                    </div>

                </div>

                <div class="row align-items-center mb-3 g-2">

                    <label class="col-12 col-sm-4 fw-bold text-secondary">
                        Outstanding Balance
                    </label>

                    <div class="col-12 col-sm-8">

                        <input asp-for="OutstandingBalance"
                               class="form-control text-end fw-bold"
                               value="@Model.OutstandingBalance.ToString("F2")"
                               readonly />

                    </div>

                </div>

                <div class="row align-items-center g-2">

                    <label class="col-12 col-sm-4 fw-bold text-secondary">
                        Payment Method
                    </label>

                    <div class="col-12 col-sm-8">

                        <select asp-for="PaymentMethod"
                                class="form-select">

                            <option value="">Select Payment Method</option>
                            <option value="Cash">Cash</option>
                            <option value="Card">Card</option>
                            <option value="EFT">EFT</option>
                            <option value="Bank Transfer">Bank Transfer</option>

                        </select>

                    </div>

                </div>

            </div>

        </div>


        <div class="row g-3 mb-4">

            <div class="col-md-6">

                <div class="row align-items-center g-2">

                    <label class="col-12 col-sm-4 fw-bold text-secondary">
                        Amount Paid
                    </label>

                    <div class="col-12 col-sm-8">

                        <input asp-for="AmountPaid"
                               type="number"
                               step="0.01"
                               min="0.01"
                               class="form-control text-end"
                               placeholder="0.00" />

                        <span asp-validation-for="AmountPaid"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>

        </div>


        @if (Model.PaymentHistory != null && Model.PaymentHistory.Any())
        {
            <div class="border rounded bg-light p-3 mb-4">

                <h5 class="fw-bold mb-3"
                    style="color:#1c323d;">
                    Payment History
                </h5>

                <div class="table-responsive">

                    <table class="table table-sm align-middle bg-white">

                        <thead class="table-secondary">

                            <tr>
                                <th>Date</th>
                                <th>Payment Method</th>
                                <th class="text-end">Amount Paid</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var payment in Model.PaymentHistory)
                            {
                                <tr>

                                    <td>
                                        @payment.PaymentDate.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @payment.PaymentMethod
                                    </td>

                                    <td class="text-end">
                                        R @payment.AmountPaid.ToString("N2")
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        }


        <div class="d-flex justify-content-end gap-2 gap-sm-3">

            <a asp-controller="Payments"
               asp-action="Index"
               class="btn btn-link text-decoration-none text-secondary align-self-center">
                Cancel
            </a>

            <button type="submit"
                    class="btn btn-custom-save">
                Record Payment
            </button>

        </div>

    </form>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}