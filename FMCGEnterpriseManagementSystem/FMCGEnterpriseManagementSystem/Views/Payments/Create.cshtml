@*
    Purpose: Record a customer payment against an invoice.
    Original author: Naseeha27 (Git history).
    UI integration: Iqra Nazir (2026).


    References:
    Bootstrap (n.d.) Forms. https://getbootstrap.com/docs/5.3/forms/overview/
    Microsoft (n.d.) ASP.NET Core model validation.
    https://learn.microsoft.com/en-us/aspnet/core/mvc/models/validation
*@

@model FMCGEnterpriseManagementSystem.ViewModels.PaymentViewModel

@{
    ViewData["Title"] = "Record Payment";
}

<div class="content-card payments-page">

    <div class="payments-page-header">

        <div>
            <h2 class="payments-page-title">
                Record Payment
            </h2>

            <p class="payments-page-subtitle">
                Record a payment received against an existing customer invoice.
            </p>
        </div>

        <div class="text-md-end">

            <div class="payments-company-name">
                Exclusive Distributors (Pty) Ltd
            </div>

            <div class="payments-page-subtitle">
                Durban
            </div>

        </div>

    </div>

    <form asp-controller="Payments"
          asp-action="Create"
          method="post"
          id="paymentForm">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <!-- INVOICE DETAILS -->
        <div class="payments-card">

            <h5 class="payments-section-title">
                <i class="bi bi-receipt me-2"></i>
                Invoice Information
            </h5>

            <div class="row g-4">

                <div class="col-md-6">

                    <div class="mb-3">
                        <label asp-for="InvoiceNumber" class="form-label">
                            Invoice Number
                        </label>

                        <input asp-for="InvoiceNumber"
                               class="form-control"
                               readonly />

                        <input asp-for="InvoiceId" type="hidden" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="CustomerName" class="form-label">
                            Customer
                        </label>

                        <input asp-for="CustomerName"
                               class="form-control"
                               readonly />
                    </div>

                    <div>
                        <label asp-for="InvoiceTotal" class="form-label">
                            Invoice Total (R)
                        </label>

                        <input asp-for="InvoiceTotal"
                               class="form-control text-end"
                               value="@Model.InvoiceTotal.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                               readonly />
                    </div>

                </div>

                <div class="col-md-6">

                    <div class="mb-3">
                        <label asp-for="AmountAlreadyPaid" class="form-label">
                            Amount Already Paid (R)
                        </label>

                        <input asp-for="AmountAlreadyPaid"
                               class="form-control text-end"
                               value="@Model.AmountAlreadyPaid.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                               readonly />
                    </div>

                    <div>
                        <label asp-for="OutstandingBalance" class="form-label">
                            Outstanding Balance (R)
                        </label>

                        <input asp-for="OutstandingBalance"
                               class="form-control text-end fw-bold"
                               value="@Model.OutstandingBalance.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                               readonly />
                    </div>

                </div>

            </div>

        </div>

        <!-- PAYMENT DETAILS -->
        <div class="payments-card">

            <h5 class="payments-section-title">
                <i class="bi bi-credit-card me-2"></i>
                Payment Details
            </h5>

            <div class="row g-3">

                <div class="col-md-4">
                    <label asp-for="PaymentDate" class="form-label">
                        Payment Date
                    </label>

                    <input asp-for="PaymentDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="PaymentDate"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="PaymentMethod" class="form-label">
                        Payment Method
                    </label>

                    <select asp-for="PaymentMethod" class="form-select">
                        <option value="">Select Payment Method</option>
                        <option value="Cash">Cash</option>
                        <option value="Card">Card</option>
                        <option value="EFT">EFT</option>
                        <option value="Bank Transfer">Bank Transfer</option>
                    </select>

                    <span asp-validation-for="PaymentMethod"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="AmountPaid" class="form-label">
                        Amount Paid (R)
                    </label>

                    <input asp-for="AmountPaid"
                           type="number"
                           step="0.01"
                           min="0.01"
                           max="@Model.OutstandingBalance.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                           data-val-range="Payment cannot be more than the outstanding balance of R@Model.OutstandingBalance.ToString("N2")."
                           data-val-range-min="0.01"
                           data-val-range-max="@Model.OutstandingBalance.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                           class="form-control text-end"
                           placeholder="0.00" />

                    <span asp-validation-for="AmountPaid"
                          class="text-danger small"></span>
                </div>

            </div>

        </div>

        <!-- PAYMENT HISTORY -->
        @if (Model.PaymentHistory != null && Model.PaymentHistory.Any())
        {
            <div class="payments-card">

                <h5 class="payments-section-title">
                    <i class="bi bi-clock-history me-2"></i>
                    Payment History
                </h5>

                <div class="payments-table-container">

                    <table class="payments-table">

                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Payment Method</th>
                                <th class="text-end">Amount Paid</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var payment in Model.PaymentHistory)
                            {
                                <tr>
                                    <td>
                                        @payment.PaymentDate.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @payment.PaymentMethod
                                    </td>

                                    <td class="text-end fw-semibold">
                                        R @payment.AmountPaid.ToString("N2")
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        }

        <!-- ACTIONS -->
        <div class="d-flex justify-content-end flex-wrap gap-3">

            <a asp-controller="Payments"
               asp-action="Index"
               class="payments-btn-outline">
                Cancel
            </a>

            <button type="submit"
                    class="payments-btn-primary">

                <i class="bi bi-check-lg"></i>
                Record Payment
            </button>

        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}