@*
    Purpose: Select an approved invoice before recording a payment.
    Original functionality: Existing Payments module contributors (Git history).
    UI integration: Iqra Nazir (2026).


    References:
    Bootstrap (n.d.) Tables. https://getbootstrap.com/docs/5.3/content/tables/
    Microsoft (n.d.) ASP.NET Core Tag Helpers.
    https://learn.microsoft.com/en-us/aspnet/core/mvc/views/tag-helpers/intro
*@

@model List<FMCGEnterpriseManagementSystem.ViewModels.InvoiceViewModel>

@{
    ViewData["Title"] = "Select Invoice";
}

<div class="content-card payments-page">

    <div class="payments-page-header">

        <div>
            <h2 class="payments-page-title">
                Select Invoice
            </h2>

            <p class="payments-page-subtitle">
                Select an approved invoice to record a customer payment.
            </p>
        </div>

        <a asp-controller="Payments"
           asp-action="Index"
           class="payments-btn-outline">

            <i class="bi bi-arrow-left"></i>
            Back to Payments
        </a>

    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    <div class="payments-card">

        @if (Model != null && Model.Any())
        {
            <div class="payments-table-container">

                <table class="payments-table">

                    <thead>
                        <tr>
                            <th>Invoice Date</th>
                            <th>Invoice Number</th>
                            <th>Customer</th>
                            <th class="text-end">Total</th>
                            <th class="text-end">Amount Due</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var invoice in Model)
                        {
                            <tr>

                                <td>
                                    @invoice.InvoiceDate.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    <span class="payments-reference">
                                        @invoice.InvoiceNumber
                                    </span>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(invoice.CustomerName)
                                        ? "N/A"
                                        : invoice.CustomerName)
                                </td>

                                <td class="text-end">
                                    R @invoice.Total.ToString("N2")
                                </td>

                                <td class="text-end fw-semibold">
                                    R @invoice.AmountDue.ToString("N2")
                                </td>

                                <td>

                                    @if (invoice.Status == "Approved")
                                    {
                                        <span class="payments-status paid">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Approved
                                        </span>
                                    }

                                </td>

                                <td class="text-end">

                                    <a asp-controller="Payments"
                                       asp-action="Create"
                                       asp-route-invoiceId="@invoice.InvoiceId"
                                       class="payments-btn-primary">

                                        <i class="bi bi-credit-card"></i>
                                        Record Payment
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="payments-empty">

                <i class="bi bi-receipt"></i>

                <h3>No Invoices Found</h3>

                <p>
                    There are currently no invoices available for payment.
                </p>

                <a asp-controller="Invoices"
                   asp-action="Index"
                   class="payments-btn-primary">

                    <i class="bi bi-arrow-right-circle"></i>
                    View Invoices
                </a>

            </div>
        }

    </div>

</div>