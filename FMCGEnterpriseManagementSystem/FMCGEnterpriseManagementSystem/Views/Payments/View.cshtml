@*
    Purpose: Display, print and email a payment receipt.
    Original author: Naseeha27 (Git history).
    UI integration: Iqra Nazir (2026).
    UI adaptation assistance: OpenAI ChatGPT (2026).

    References:
    Bootstrap (n.d.) Modal. https://getbootstrap.com/docs/5.3/components/modal/
    Microsoft (n.d.) ASP.NET Core Razor syntax.
    https://learn.microsoft.com/en-us/aspnet/core/mvc/views/razor
    MDN Web Docs (n.d.) Window.print().
    https://developer.mozilla.org/en-US/docs/Web/API/Window/print
*@

@model FMCGEnterpriseManagementSystem.ViewModels.PaymentViewModel

@{
    ViewData["Title"] = "Payment Receipt";

    // Preserve the existing PDF-specific layout selection.
    Layout = Context.Request.Headers["User-Agent"].ToString()
        .Contains("wkhtmltopdf")
            ? "_PdfLayout"
            : "_Layout";
}

<div class="content-card payments-page">

    <div class="payments-page-header">

        <div>
            <div class="payments-company-name">
                Exclusive Distributors (Pty) Ltd
            </div>

            <div class="payments-page-subtitle">
                Durban
            </div>
        </div>

        <div class="text-md-end">
            <h2 class="payments-page-title mb-1">
                Payment Receipt
            </h2>

            <div class="payments-page-subtitle">
                @Model.PaymentDate.ToString("dd MMMM yyyy")
            </div>
        </div>

    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-6">
            <div class="payments-card h-100">

                <h5 class="payments-section-title">
                    <i class="bi bi-credit-card me-2"></i>
                    Payment Information
                </h5>

                <div class="mb-3">
                    <strong>Payment ID:</strong>
                    @Model.PaymentId
                </div>

                <div class="mb-3">
                    <strong>Payment Date:</strong>
                    @Model.PaymentDate.ToString("dd/MM/yyyy")
                </div>

                <div>
                    <strong>Payment Method:</strong>
                    @Model.PaymentMethod
                </div>

            </div>
        </div>

        <div class="col-md-6">
            <div class="payments-card h-100">

                <h5 class="payments-section-title">
                    <i class="bi bi-receipt me-2"></i>
                    Invoice Information
                </h5>

                <div class="mb-3">
                    <strong>Invoice Number:</strong>
                    @Model.InvoiceNumber
                </div>

                <div class="mb-3">
                    <strong>Customer:</strong>
                    @(string.IsNullOrWhiteSpace(Model.CustomerName)
                        ? "N/A"
                        : Model.CustomerName)
                </div>

                <div>
                    <strong>Invoice Total:</strong>
                    R @Model.InvoiceTotal.ToString("N2")
                </div>

            </div>
        </div>

    </div>

    <!-- PAYMENT SUMMARY -->
    <div class="payments-summary-card mb-4">

        <div class="row g-4 text-center">

            <div class="col-md-4">

                <div class="payments-summary-label">
                    Amount Paid
                </div>

                <div class="payments-summary-value">
                    R @Model.AmountPaid.ToString("N2")
                </div>

            </div>

            <div class="col-md-4">

                <div class="payments-summary-label">
                    Total Paid
                </div>

                <div class="payments-summary-value">
                    R @Model.AmountAlreadyPaid.ToString("N2")
                </div>

            </div>

            <div class="col-md-4">

                <div class="payments-summary-label">
                    Outstanding Balance
                </div>

                <div class="payments-summary-value">
                    R @Model.OutstandingBalance.ToString("N2")
                </div>

            </div>

        </div>

    </div>

    <div class="text-center mb-4">

        @if (Model.Status ==
            FMCGEnterpriseManagementSystem.Enums.PaymentStatus.Paid)
        {
            <span class="payments-status paid">
                <i class="bi bi-check-circle me-1"></i>
                Invoice Settled
            </span>
        }
        else if (Model.Status ==
            FMCGEnterpriseManagementSystem.Enums.PaymentStatus.PartiallyPaid)
        {
            <span class="payments-status partial">
                <i class="bi bi-clock-history me-1"></i>
                Partially Paid
            </span>
        }
        else
        {
            <span class="payments-status unpaid">
                Unpaid
            </span>
        }

    </div>

    <!-- RECEIPT ACTIONS -->
    <div class="payments-header-actions justify-content-end payments-no-print">

        <a asp-controller="Payments"
           asp-action="Index"
           class="payments-btn-outline">

            <i class="bi bi-arrow-left"></i>
            Back to Payments
        </a>

        <button type="button"
                class="payments-btn-outline"
                onclick="window.print()">

            <i class="bi bi-printer"></i>
            Print Receipt
        </button>

        <button type="button"
                class="payments-btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#emailPaymentModal">

            <i class="bi bi-envelope"></i>
            Email Receipt
        </button>

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success mt-3 payments-no-print">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger mt-3 payments-no-print">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- EMAIL RECEIPT MODAL -->
    <div class="modal fade payments-no-print"
         id="emailPaymentModal"
         tabindex="-1"
         aria-labelledby="emailPaymentModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <form asp-controller="Payments"
                      asp-action="EmailPayment"
                      method="post"
                      id="emailPaymentForm">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.PaymentId" />

                    <div class="modal-header">

                        <h5 class="modal-title"
                            id="emailPaymentModalLabel">
                            Email Payment Receipt
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close"></button>

                    </div>

                    <div class="modal-body">

                        <label for="recipientEmail"
                               class="form-label">
                            Recipient Email
                        </label>

                        <input type="email"
                               id="recipientEmail"
                               name="recipientEmail"
                               class="form-control"
                               required
                               placeholder="customer@example.com" />

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="payments-btn-outline"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit"
                                id="sendReceiptButton"
                                class="payments-btn-primary">

                            <i class="bi bi-send"></i>
                            Send Receipt
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

<script>
    // Prevent repeated submissions of the receipt email form.
    const emailPaymentForm = document.getElementById('emailPaymentForm');

    if (emailPaymentForm) {
        emailPaymentForm.addEventListener('submit', function () {
            const sendButton = document.getElementById('sendReceiptButton');

            sendButton.disabled = true;
            sendButton.textContent = 'Sending...';
        });
    }
</script>