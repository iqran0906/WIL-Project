@*
    File: Views/Profile/ChangePassword.cshtml

    Purpose:
    Allows authenticated users to change their account password.

    Original Author:
    ST10068525 

    UI Improvements:
    Iqra Nazir (2026).

    
    References :
    Microsoft (n.d.) Razor syntax reference for ASP.NET Core.
    Available at: https://learn.microsoft.com/en-us/aspnet/core/mvc/views/razor

   
    MDN Web Docs (n.d.) HTML input element.
    Available at: https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input
*@

@model FMCGEnterpriseManagementSystem.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
}

<style>
    /* ==========================================
       CHANGE PASSWORD PAGE
       ========================================== */

    .profile-password-page {
        background: #e6edf1;
        border: 1px solid rgba(53, 127, 145, 0.18);
        border-radius: 15px;
        padding: 30px;
        min-height: 75vh;
        color: #183244;
        font-size: 16px;
    }

    /* PAGE HEADER */

    .profile-password-header {
        display: flex;
        align-items: center;
        gap: 17px;
        margin-bottom: 28px;
    }

    .profile-password-header-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 58px;
        height: 58px;
        flex-shrink: 0;
        background: #dce9ee;
        border: 1px solid #c9d9df;
        border-radius: 12px;
        color: #357f91;
        font-size: 26px;
    }

    .profile-password-title {
        color: #183244;
        font-size: 30px;
        font-weight: 800;
        margin: 0 0 6px;
    }

    .profile-password-description {
        color: #667988;
        font-size: 16px;
        line-height: 1.5;
        margin: 0;
    }

    /* FORM CARD */

    .profile-password-card {
        max-width: 720px;
        margin: 0 auto;
        background: #f8fafb;
        border: 1px solid #c9d9df;
        border-top: 3px solid #357f91;
        border-radius: 12px;
        padding: 28px;
    }

    .profile-password-section-title {
        color: #183244;
        font-size: 20px;
        font-weight: 800;
        margin: 0 0 8px;
    }

    .profile-password-section-description {
        color: #667988;
        font-size: 15px;
        line-height: 1.5;
        margin-bottom: 24px;
    }

    /* FORM FIELDS */

    .profile-password-form-group {
        margin-bottom: 24px;
    }

    .profile-password-label {
        display: block;
        color: #183244;
        font-size: 15px;
        font-weight: 700;
        margin-bottom: 9px;
    }

    .profile-password-input {
        background: #fff;
        border: 1px solid #c9d9df;
        border-radius: 8px;
        color: #183244;
        font-size: 16px;
        padding: 11px 13px;
        min-height: 46px;
    }

    .profile-password-input:focus {
        border-color: #357f91;
        box-shadow: 0 0 0 3px rgba(53, 127, 145, 0.12);
    }

    .profile-password-validation {
        display: block;
        color: #a13e3e;
        font-size: 14px;
        margin-top: 6px;
    }

    /* PASSWORD GUIDANCE */

    .profile-password-guidance {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        background: #edf3f5;
        border: 1px solid #d9e4e9;
        border-radius: 9px;
        padding: 15px;
        margin-top: 14px;
    }

    .profile-password-guidance i {
        color: #357f91;
        font-size: 20px;
        flex-shrink: 0;
    }

    .profile-password-guidance p {
        color: #536b78;
        font-size: 15px;
        line-height: 1.6;
        margin: 0;
    }

    /* BUTTONS */

    .profile-password-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 12px;
        border-top: 1px solid #d9e4e9;
        padding-top: 24px;
        margin-top: 30px;
    }

    .profile-password-btn-primary,
    .profile-password-btn-outline {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border-radius: 8px;
        padding: 11px 19px;
        font-size: 15px;
        font-weight: 700;
        line-height: 1.4;
        text-decoration: none;
        cursor: pointer;
        transition: 0.2s ease;
    }

    .profile-password-btn-primary {
        background: #357f91;
        border: 1px solid #357f91;
        color: #fff;
    }

    .profile-password-btn-primary:hover {
        background: #286675;
        border-color: #286675;
        color: #fff;
    }

    .profile-password-btn-outline {
        background: #fff;
        border: 1px solid #a9c4cc;
        color: #357f91;
    }

    .profile-password-btn-outline:hover {
        background: #dce9ee;
        color: #286675;
    }

    /* RESPONSIVE */

    @@media (max-width: 768px) {
        .profile-password-page {
            padding: 18px;
        }

        .profile-password-title {
            font-size: 26px;
        }

        .profile-password-card {
            padding: 18px;
        }

        .profile-password-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .profile-password-btn-primary,
        .profile-password-btn-outline {
            width: 100%;
        }
    }
</style>

<div class="profile-password-page">

    @* PAGE HEADER *@
    <div class="profile-password-header">

        <div class="profile-password-header-icon">
            <i class="bi bi-shield-lock"></i>
        </div>

        <div>
            <h1 class="profile-password-title">
                Change Password
            </h1>

            <p class="profile-password-description">
                Update your password to keep your account secure.
            </p>
        </div>

    </div>

    @* PASSWORD FORM *@
    <div class="profile-password-card">

        <h2 class="profile-password-section-title">
            Password Information
        </h2>

        <p class="profile-password-section-description">
            Enter your current password and choose a new secure password.
        </p>

        <form asp-controller="Profile"
              asp-action="ChangePassword"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            @* CURRENT PASSWORD *@
            <div class="profile-password-form-group">

                <label asp-for="CurrentPassword"
                       class="profile-password-label">
                </label>

                <input asp-for="CurrentPassword"
                       class="form-control profile-password-input"
                       autocomplete="current-password" />

                <span asp-validation-for="CurrentPassword"
                      class="profile-password-validation">
                </span>

            </div>

            @* NEW PASSWORD *@
            <div class="profile-password-form-group">

                <label asp-for="NewPassword"
                       class="profile-password-label">
                </label>

                <input asp-for="NewPassword"
                       class="form-control profile-password-input"
                       autocomplete="new-password" />

                <span asp-validation-for="NewPassword"
                      class="profile-password-validation">
                </span>

                <div class="profile-password-guidance">

                    <i class="bi bi-info-circle"></i>

                    <p>
                        Your new password must contain at least
                        <strong>8 characters</strong>, including an
                        uppercase letter, a lowercase letter,
                        a number and a special character.
                    </p>

                </div>

            </div>

            @* CONFIRM PASSWORD *@
            <div class="profile-password-form-group">

                <label asp-for="ConfirmPassword"
                       class="profile-password-label">
                </label>

                <input asp-for="ConfirmPassword"
                       class="form-control profile-password-input"
                       autocomplete="new-password" />

                <span asp-validation-for="ConfirmPassword"
                      class="profile-password-validation">
                </span>

            </div>

            @* FORM ACTIONS *@
            <div class="profile-password-actions">

                <a asp-controller="Home"
                   asp-action="UserProfile"
                   class="profile-password-btn-outline">

                    <i class="bi bi-arrow-left"></i>
                    Cancel

                </a>

                <button type="submit"
                        class="profile-password-btn-primary">

                    <i class="bi bi-shield-check"></i>
                    Change Password

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}