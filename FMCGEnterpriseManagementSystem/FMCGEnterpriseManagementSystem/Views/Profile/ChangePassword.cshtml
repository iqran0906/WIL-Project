*@
@model FMCGEnterpriseManagementSystem.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
}

<div class="content-card" style="max-width: 640px;">
    <div class="d-flex align-items-center gap-3 mb-4 border-bottom pb-3">
        <i class="bi bi-shield-lock fs-2" style="color: #357383;"></i>
        <h2 class="fw-bold m-0" style="color: #1c323d;">Change Password</h2>
    </div>

    <form asp-controller="Profile" asp-action="ChangePassword" method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="CurrentPassword" class="form-label fw-bold"></label>
            <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label fw-bold"></label>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="text-danger small"></span>
            <div class="form-text">
                At least 8 characters, with an uppercase letter, a lowercase letter, a number and a symbol.
            </div>
        </div>

        <div class="mb-4">
            <label asp-for="ConfirmPassword" class="form-label fw-bold"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>

        <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 border-top pt-3">
            <a asp-controller="Home"
               asp-action="UserProfile"
               class="btn btn-link text-decoration-none text-secondary">
                Cancel
            </a>

            <button type="submit" class="btn btn-custom-save">
                Change Password
            </button>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
