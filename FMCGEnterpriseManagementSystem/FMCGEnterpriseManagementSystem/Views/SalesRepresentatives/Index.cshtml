@*
    Purpose: Active Sales Representatives list page.
    Authors: iqran0906 (from git history)
*@

@model IEnumerable<FMCGEnterpriseManagementSystem.ViewModels.SalesRepresentativeViewModel>

@{
    ViewData["Title"] = "Sales Representatives";
}

<div class="px-2 py-3">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle me-1"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="bi bi-exclamation-triangle me-1"></i>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }


    <!-- HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">

        <div>

            <h2 class="text-white fw-bold mb-1">
                Sales Representatives
            </h2>

            <p class="text-white-50 mb-0">
                Manage active sales representatives and their sales information.
            </p>

        </div>


        <div class="d-flex gap-2 flex-wrap">

            <a asp-controller="SalesRepresentatives"
               asp-action="Inactive"
               class="btn btn-outline-light text-decoration-none">

                <i class="bi bi-person-dash me-1"></i>
                Inactive Sales Representatives

            </a>


            <a asp-controller="SalesRepresentatives"
               asp-action="Create"
               class="btn btn-action-primary text-decoration-none">

                <i class="bi bi-person-plus me-1"></i>
                New Sales Representative

            </a>

        </div>

    </div>


    <!-- SEARCH -->
    <div class="d-flex align-items-center gap-2 mb-4">

        <span class="text-white fw-bold">
            Keyword:
        </span>

        <form asp-controller="SalesRepresentatives"
              asp-action="Index"
              method="get"
              class="d-flex gap-2">

            <input type="text"
                   name="keyword"
                   value="@ViewBag.Keyword"
                   class="form-control form-control-sm search-field"
                   placeholder="Rep code, employee, email or area" />


            <button type="submit"
                    class="btn btn-sm btn-light">
                Search
            </button>


            <a asp-controller="SalesRepresentatives"
               asp-action="Index"
               class="btn btn-sm btn-outline-light">
                Clear
            </a>

        </form>

    </div>


    <!-- TABLE -->
    <div class="table-responsive">

        <table class="custom-data-table">

            <thead>

                <tr>
                    <th>Rep Code</th>
                    <th>Employee Number</th>
                    <th>Employee</th>
                    <th>Email</th>
                    <th>Area</th>
                    <th>Salary</th>
                    <th>Commission</th>
                    <th>Sales Target</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>

            </thead>


            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var salesRep in Model)
                    {
                        <tr>

                            <td>
                                @salesRep.SalesRepCode
                            </td>

                            <td>
                                @salesRep.EmployeeNumber
                            </td>

                            <td>
                                @salesRep.EmployeeName
                            </td>

                            <td>
                                @salesRep.Email
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(salesRep.Area)
                                    ? "-"
                                    : salesRep.Area)
                            </td>

                            <td>
                                R @salesRep.Salary.ToString("N2")
                            </td>

                            <td>
                                @salesRep.CommissionRate.ToString("0.##")%
                            </td>

                            <td>
                                R @salesRep.SalesTarget.ToString("N2")
                            </td>

                            <td>

                                <span class="badge bg-success">
                                    Active
                                </span>

                            </td>

                            <td>

                                <div class="d-flex gap-2 flex-wrap">

                                    <a asp-controller="SalesRepresentatives"
                                       asp-action="Edit"
                                       asp-route-id="@salesRep.SalesRepresentativeId"
                                       class="btn btn-sm btn-warning">

                                        <i class="bi bi-pencil-square me-1"></i>
                                        Edit

                                    </a>


                                    <!-- Opens the in-system confirmation modal -->
                                    <button type="button"
                                            class="btn btn-sm btn-danger deactivate-salesrep-btn"
                                            data-id="@salesRep.SalesRepresentativeId"
                                            data-name="@salesRep.EmployeeName">

                                        <i class="bi bi-person-x me-1"></i>
                                        Deactivate

                                    </button>

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="10"
                            class="text-center py-5">

                            <div class="fw-semibold mb-1">
                                No active sales representatives found.
                            </div>

                            <div class="text-muted small">
                                Try changing your search criteria.
                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>


    <!-- DEACTIVATE SALES REPRESENTATIVE MODAL -->
    <div class="modal fade"
         id="deactivateSalesRepModal"
         tabindex="-1"
         aria-labelledby="deactivateSalesRepModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title"
                        id="deactivateSalesRepModalLabel">

                        Confirm Deactivation

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>


                <div class="modal-body">

                    <p class="mb-2">
                        Are you sure you want to deactivate
                        <strong id="salesRepName"></strong>?
                    </p>

                    <p class="text-muted small mb-0">
                        The sales representative will be moved to
                        Inactive Sales Representatives and can be
                        activated again later.
                    </p>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>


                    <form asp-controller="SalesRepresentatives"
                          asp-action="Deactivate"
                          method="post"
                          id="deactivateSalesRepForm">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               id="deactivateSalesRepId" />


                        <button type="submit"
                                class="btn btn-danger">

                            <i class="bi bi-person-x me-1"></i>
                            Deactivate

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const modalElement =
                document.getElementById("deactivateSalesRepModal");

            const salesRepId =
                document.getElementById("deactivateSalesRepId");

            const salesRepName =
                document.getElementById("salesRepName");

            const modal =
                new bootstrap.Modal(modalElement);


            document
                .querySelectorAll(".deactivate-salesrep-btn")
                .forEach(function (button) {

                    button.addEventListener("click", function () {

                        salesRepId.value =
                            this.dataset.id;

                        salesRepName.textContent =
                            this.dataset.name;

                        modal.show();

                    });

                });

        });

    </script>

}