@*
    Purpose: Display and manage active sales representatives.
    Original author: iqran0906 (from Git history).

    References:
    Bootstrap (n.d.) Tables, Cards and Modals.
    https://getbootstrap.com/docs/5.3/
*@

@model IEnumerable<FMCGEnterpriseManagementSystem.ViewModels.SalesRepresentativeViewModel>

@{
    ViewData["Title"] = "Sales Representatives";

    var representatives = Model?.ToList()
        ?? new List<FMCGEnterpriseManagementSystem.ViewModels.SalesRepresentativeViewModel>();

    var keyword = ViewBag.Keyword?.ToString() ?? "";
}

<link rel="stylesheet" href="~/css/sales-representatives.css" asp-append-version="true" />

<div class="sales-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- HEADER -->

    <div class="sales-page-header">

        <div>
            <h2 class="sales-page-title">Sales Representatives</h2>
            <p class="sales-page-subtitle">
                Manage active sales representatives and their sales information.
            </p>
        </div>

        <div class="sales-header-actions">

            <a asp-controller="SalesRepresentatives"
               asp-action="Inactive"
               class="sales-btn-outline">
                <i class="bi bi-person-dash me-2"></i>
                Inactive Sales Representatives
            </a>

            <a asp-controller="SalesRepresentatives"
               asp-action="Create"
               class="sales-btn-primary">
                <i class="bi bi-person-plus me-2"></i>
                New Sales Representative
            </a>

        </div>

    </div>

    <!-- SUMMARY -->

    <div class="row g-3">

        <div class="col-12 col-md-6">

            <div class="sales-stat-card">
                <div class="sales-stat-label">
                    Active Representatives Displayed
                </div>
                <div class="sales-stat-value">
                    @representatives.Count
                </div>
            </div>

        </div>

        <div class="col-12 col-md-6">

            <div class="sales-stat-card">
                <div class="sales-stat-label">
                    Employment Status
                </div>
                <span class="sales-status-active">
                    Active Representatives
                </span>
            </div>

        </div>

    </div>

    <!-- SEARCH -->

    <div class="sales-filter-panel">

        <form asp-controller="SalesRepresentatives"
              asp-action="Index"
              method="get">

            <div class="row g-3 align-items-end">

                <div class="col-12 col-lg-8">

                    <label for="salesRepKeyword" class="sales-filter-label">
                        Search Sales Representatives
                    </label>

                    <input type="search"
                           id="salesRepKeyword"
                           name="keyword"
                           value="@keyword"
                           class="form-control"
                           placeholder="Rep code, employee, email or area..." />

                </div>

                <div class="col-6 col-lg-2">

                    <button type="submit"
                            class="btn sales-btn-primary w-100">
                        <i class="bi bi-search me-1"></i>
                        Search
                    </button>

                </div>

                <div class="col-6 col-lg-2">

                    <a asp-controller="SalesRepresentatives"
                       asp-action="Index"
                       class="btn sales-btn-outline w-100">
                        Clear
                    </a>

                </div>

            </div>

        </form>

    </div>

    <!-- TABLE -->

    <div class="sales-table-container">

        <table class="sales-table">

            <thead>
                <tr>
                    <th>Rep Code</th>
                    <th>Employee Number</th>
                    <th>Employee</th>
                    <th>Email</th>
                    <th>Area</th>
                    <th>Salary</th>
                    <th>Commission</th>
                    <th>Sales Target</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var salesRep in representatives)
                {
                    <tr>

                        <td class="sales-rep-code">
                            @salesRep.SalesRepCode
                        </td>

                        <td>
                            @salesRep.EmployeeNumber
                        </td>

                        <td class="sales-rep-name">
                            @salesRep.EmployeeName
                        </td>

                        <td>
                            @salesRep.Email
                        </td>

                        <td>
                            @(string.IsNullOrWhiteSpace(salesRep.Area) ? "-" : salesRep.Area)
                        </td>

                        <td>
                            R @salesRep.Salary.ToString("N2")
                        </td>

                        <td>
                            @salesRep.CommissionRate.ToString("0.##")%
                        </td>

                        <td>
                            R @salesRep.SalesTarget.ToString("N2")
                        </td>

                        <td>
                            <span class="sales-status-active">
                                Active
                            </span>
                        </td>

                        <td>

                            <div class="sales-actions">

                                <a asp-controller="SalesRepresentatives"
                                   asp-action="Edit"
                                   asp-route-id="@salesRep.SalesRepresentativeId"
                                   class="sales-edit-btn">

                                    <i class="bi bi-pencil-square me-1"></i>
                                    Edit

                                </a>

                                <button type="button"
                                        class="sales-deactivate-btn"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deactivateSalesRepModal"
                                        data-id="@salesRep.SalesRepresentativeId"
                                        data-name="@salesRep.EmployeeName">

                                    <i class="bi bi-person-x me-1"></i>
                                    Deactivate

                                </button>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

    @if (!representatives.Any())
    {
        <div class="sales-empty-state">

            <i class="bi bi-people fs-1 d-block mb-3"></i>

            <h5 class="fw-bold">
                No active sales representatives found
            </h5>

            <p class="mb-0">
                Try changing your search criteria or add a new representative.
            </p>

        </div>
    }

</div>

<!-- DEACTIVATION MODAL -->

<div class="modal fade sales-modal"
     id="deactivateSalesRepModal"
     tabindex="-1"
     aria-labelledby="deactivateSalesRepModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title fw-bold" id="deactivateSalesRepModalLabel">
                    Confirm Deactivation
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body">

                <p>
                    Are you sure you want to deactivate
                    <strong id="salesRepName"></strong>?
                </p>

                <p class="text-muted small mb-0">
                    This representative will move to Inactive Sales Representatives.
                    They can be reactivated later.
                </p>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <form asp-controller="SalesRepresentatives"
                      asp-action="Deactivate"
                      method="post"
                      id="deactivateSalesRepForm">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           id="deactivateSalesRepId" />

                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-person-x me-1"></i>
                        Deactivate Representative
                    </button>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>
        // Populate the modal using the selected sales representative.

        document.addEventListener("DOMContentLoaded", function () {

            const modal = document.getElementById("deactivateSalesRepModal");

            modal.addEventListener("show.bs.modal", function (event) {

                const button = event.relatedTarget;

                if (!button) {
                    return;
                }

                document.getElementById("deactivateSalesRepId").value =
                    button.getAttribute("data-id");

                document.getElementById("salesRepName").textContent =
                    button.getAttribute("data-name") || "this representative";

            });

        });
    </script>
}