@model IEnumerable<FMCGEnterpriseManagementSystem.Models.SalesRepresentative>

@{
    ViewData["Title"] = "Sales Representatives";
}

<div class="px-2 py-3">
    <h2 class="text-white fw-bold mb-3">Sales Representatives</h2>

    <div class="mb-4">
        <a asp-controller="SalesRepresentatives" asp-action="Create" class="btn btn-action-primary text-decoration-none">
            New Sales Rep
        </a>
    </div>

    <div class="d-flex align-items-center gap-2 mb-4">
        <span class="text-white fw-bold">Keyword:</span>
        <div class="position-relative">
            <input type="text" class="form-control form-control-sm search-field" placeholder="Rep Code, Name, Area, etc">
            <i class="bi bi-search position-absolute end-0 top-50 translate-middle-y me-2 text-white-50 small"></i>
        </div>
    </div>

    <div class="table-responsive">
        <table class="custom-data-table w-100">
            <thead>
                <tr>
                    <th>Rep Code</th>
                    <th>Name</th>
                    <th>Area</th>
                    <th>Contact Number</th>
                    <th>Email</th>
                    <th>Commission Rate</th>
                    <th>Target</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.SalesRepCode</td>
                            <td>@item.FirstName @item.LastName</td>
                            <td>@item.Territory</td>
                            <td>@item.ContactNumber</td>
                            <td>@item.Email</td>
                            <td>@item.CommissionRate.ToString("P1")</td>
                            <td>R 0.00</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>