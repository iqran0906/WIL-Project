@*
    Purpose: Display inactive sales representatives and support reactivation.
    Original author: iqran0906 (from Git history).

    References:
    Bootstrap (n.d.) Tables and Modals.
    https://getbootstrap.com/docs/5.3/
*@

@model IEnumerable<FMCGEnterpriseManagementSystem.ViewModels.SalesRepresentativeViewModel>

@{
    ViewData["Title"] = "Inactive Sales Representatives";

    var representatives = Model?.ToList()
        ?? new List<FMCGEnterpriseManagementSystem.ViewModels.SalesRepresentativeViewModel>();

    var keyword = ViewBag.Keyword?.ToString() ?? "";
}

<link rel="stylesheet" href="~/css/sales-representatives.css" asp-append-version="true" />

<div class="sales-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- HEADER -->

    <div class="sales-page-header">

        <div>

            <h2 class="sales-page-title">
                Inactive Sales Representatives
            </h2>

            <p class="sales-page-subtitle">
                View and manage sales representatives who are no longer active.
            </p>

        </div>

        <a asp-controller="SalesRepresentatives"
           asp-action="Index"
           class="sales-btn-outline">

            <i class="bi bi-arrow-left me-2"></i>
            Back to Sales Representatives

        </a>

    </div>

    <!-- SUMMARY -->

    <div class="row g-3">

        <div class="col-12 col-md-6">

            <div class="sales-stat-card inactive">

                <div class="sales-stat-label">
                    Inactive Representatives Displayed
                </div>

                <div class="sales-stat-value">
                    @representatives.Count
                </div>

            </div>

        </div>

        <div class="col-12 col-md-6">

            <div class="sales-stat-card inactive">

                <div class="sales-stat-label">
                    Employment Status
                </div>

                <span class="sales-status-inactive">
                    Inactive Representatives
                </span>

            </div>

        </div>

    </div>

    <!-- SEARCH -->

    <div class="sales-filter-panel">

        <form asp-controller="SalesRepresentatives"
              asp-action="Inactive"
              method="get">

            <div class="row g-3 align-items-end">

                <div class="col-12 col-lg-8">

                    <label for="inactiveSalesKeyword"
                           class="sales-filter-label">
                        Search Inactive Representatives
                    </label>

                    <input type="search"
                           id="inactiveSalesKeyword"
                           name="keyword"
                           value="@keyword"
                           class="form-control"
                           placeholder="Rep code, employee, email or area..." />

                </div>

                <div class="col-6 col-lg-2">

                    <button type="submit"
                            class="btn sales-btn-primary w-100">

                        <i class="bi bi-search me-1"></i>
                        Search

                    </button>

                </div>

                <div class="col-6 col-lg-2">

                    <a asp-controller="SalesRepresentatives"
                       asp-action="Inactive"
                       class="btn sales-btn-outline w-100">
                        Clear
                    </a>

                </div>

            </div>

        </form>

    </div>

    <!-- TABLE -->

    <div class="sales-table-container">

        <table class="sales-table">

            <thead>
                <tr>
                    <th>Rep Code</th>
                    <th>Employee Number</th>
                    <th>Employee</th>
                    <th>Email</th>
                    <th>Area</th>
                    <th>Salary</th>
                    <th>Commission</th>
                    <th>Sales Target</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var salesRep in representatives)
                {
                    <tr>

                        <td class="sales-rep-code">
                            @salesRep.SalesRepCode
                        </td>

                        <td>
                            @salesRep.EmployeeNumber
                        </td>

                        <td class="sales-rep-name">
                            @salesRep.EmployeeName
                        </td>

                        <td>
                            @salesRep.Email
                        </td>

                        <td>
                            @(string.IsNullOrWhiteSpace(salesRep.Area) ? "-" : salesRep.Area)
                        </td>

                        <td>
                            R @salesRep.Salary.ToString("N2")
                        </td>

                        <td>
                            @salesRep.CommissionRate.ToString("0.##")%
                        </td>

                        <td>
                            R @salesRep.SalesTarget.ToString("N2")
                        </td>

                        <td>
                            <span class="sales-status-inactive">
                                Inactive
                            </span>
                        </td>

                        <td>

                            <button type="button"
                                    class="sales-reactivate-btn"
                                    data-bs-toggle="modal"
                                    data-bs-target="#reactivateSalesRepModal"
                                    data-id="@salesRep.SalesRepresentativeId"
                                    data-name="@salesRep.EmployeeName">

                                <i class="bi bi-person-check me-1"></i>
                                Reactivate

                            </button>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

    @if (!representatives.Any())
    {
        <div class="sales-empty-state">

            <i class="bi bi-person-dash fs-1 d-block mb-3"></i>

            <h5 class="fw-bold">
                No inactive sales representatives found
            </h5>

            <p class="mb-0">
                Deactivated representatives will appear here.
            </p>

        </div>
    }

</div>

<!-- REACTIVATION MODAL -->

<div class="modal fade sales-modal"
     id="reactivateSalesRepModal"
     tabindex="-1"
     aria-labelledby="reactivateSalesRepModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title fw-bold"
                    id="reactivateSalesRepModalLabel">

                    Confirm Reactivation

                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body">

                <p>
                    Are you sure you want to reactivate
                    <strong id="reactivateSalesRepName"></strong>?
                </p>

                <p class="text-muted small mb-0">
                    This representative will return to the active
                    Sales Representatives list.
                </p>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <form asp-controller="SalesRepresentatives"
                      asp-action="Reactivate"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           id="reactivateSalesRepId" />

                    <button type="submit" class="btn btn-success">

                        <i class="bi bi-person-check me-1"></i>
                        Reactivate Representative

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>
        // Populate the reactivation modal with the selected representative.

        document.addEventListener("DOMContentLoaded", function () {

            const modal = document.getElementById("reactivateSalesRepModal");

            modal.addEventListener("show.bs.modal", function (event) {

                const button = event.relatedTarget;

                if (!button) {
                    return;
                }

                document.getElementById("reactivateSalesRepId").value =
                    button.getAttribute("data-id");

                document.getElementById("reactivateSalesRepName").textContent =
                    button.getAttribute("data-name") || "this representative";

            });

        });
    </script>
}