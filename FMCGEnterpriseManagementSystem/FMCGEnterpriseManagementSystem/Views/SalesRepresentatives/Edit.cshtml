@*
    Purpose: Edit an existing sales representative.
    Original author: iqran0906 (from Git history).

    References:
    Bootstrap (n.d.) Forms and Grid.
    https://getbootstrap.com/docs/5.3/
*@

@model FMCGEnterpriseManagementSystem.ViewModels.SalesRepresentativeViewModel

@{
    ViewData["Title"] = "Edit Sales Representative";
}

<link rel="stylesheet" href="~/css/sales-representatives.css" asp-append-version="true" />

<div class="sales-page">

    <div class="sales-page-header">

        <div>
            <h2 class="sales-page-title">Edit Sales Representative</h2>

            <p class="sales-page-subtitle">
                Update representative information, compensation and sales targets.
            </p>
        </div>

    </div>

    <form asp-controller="SalesRepresentatives"
          asp-action="Edit"
          method="post">

        @Html.AntiForgeryToken()

        <input asp-for="SalesRepresentativeId" type="hidden" />
        <input asp-for="EmployeeID" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <div class="row g-4">

            <!-- REPRESENTATIVE INFORMATION -->

            <div class="col-12 col-xl-6">

                <div class="sales-form-section">

                    <h5 class="sales-section-title">
                        <i class="bi bi-person-badge me-2"></i>
                        Representative Information
                    </h5>

                    <p class="sales-section-subtitle">
                        Review the linked employee and update representative details.
                    </p>

                    <!-- EMPLOYEE -->

                    <div class="mb-3">

                        <label class="form-label">Employee</label>

                        <input type="text"
                               class="form-control"
                               value="@Model.EmployeeName"
                               readonly />

                    </div>

                    <!-- EMPLOYEE NUMBER -->

                    <div class="mb-3">

                        <label class="form-label">Employee Number</label>

                        <input type="text"
                               class="form-control"
                               value="@Model.EmployeeNumber"
                               readonly />

                    </div>

                    <!-- EMAIL -->

                    <div class="mb-3">

                        <label class="form-label">Email</label>

                        <input type="text"
                               class="form-control"
                               value="@Model.Email"
                               readonly />

                    </div>

                    <!-- SALES REP CODE -->

                    <div class="mb-3">

                        <label asp-for="SalesRepCode"
                               class="form-label"></label>

                        <input asp-for="SalesRepCode"
                               class="form-control" />

                        <span asp-validation-for="SalesRepCode"
                              class="text-danger small"></span>

                    </div>

                    <!-- AREA -->

                    <div class="mb-3">

                        <label asp-for="Area"
                               class="form-label"></label>

                        <input asp-for="Area"
                               class="form-control"
                               placeholder="Enter assigned area" />

                        <span asp-validation-for="Area"
                              class="text-danger small"></span>

                    </div>

                </div>

            </div>

            <!-- SALES INFORMATION -->

            <div class="col-12 col-xl-6">

                <div class="sales-form-section">

                    <h5 class="sales-section-title">
                        <i class="bi bi-graph-up-arrow me-2"></i>
                        Sales & Compensation
                    </h5>

                    <p class="sales-section-subtitle">
                        Update salary, commission and sales targets.
                    </p>

                    <!-- SALARY -->

                    <div class="mb-3">

                        <label asp-for="Salary" class="form-label"></label>

                        <div class="input-group">

                            <span class="input-group-text">R</span>

                            <input asp-for="Salary"
                                   class="form-control"
                                   type="number"
                                   min="0"
                                   step="0.01" />

                        </div>

                        <span asp-validation-for="Salary"
                              class="text-danger small"></span>

                    </div>

                    <!-- COMMISSION -->

                    <div class="mb-3">

                        <label asp-for="CommissionRate"
                               class="form-label"></label>

                        <div class="input-group">

                            <input asp-for="CommissionRate"
                                   class="form-control"
                                   type="number"
                                   min="0"
                                   max="100"
                                   step="0.01" />

                            <span class="input-group-text">%</span>

                        </div>

                        <span asp-validation-for="CommissionRate"
                              class="text-danger small"></span>

                    </div>

                    <!-- SALES TARGET -->

                    <div class="mb-3">

                        <label asp-for="SalesTarget"
                               class="form-label"></label>

                        <div class="input-group">

                            <span class="input-group-text">R</span>

                            <input asp-for="SalesTarget"
                                   class="form-control"
                                   type="number"
                                   min="0"
                                   step="0.01" />

                        </div>

                        <span asp-validation-for="SalesTarget"
                              class="text-danger small"></span>

                    </div>

                    <!-- STATUS -->

                    <div class="mb-3">

                        <label class="form-label">Status</label>

                        <div class="mt-2">

                            @if (Model.IsActive)
                            {
                                <span class="sales-status-active">Active</span>
                            }
                            else
                            {
                                <span class="sales-status-inactive">Inactive</span>
                            }

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- ACTIONS -->

        <div class="sales-form-actions">

            <a asp-controller="SalesRepresentatives"
               asp-action="Index"
               class="sales-btn-outline">

                <i class="bi bi-arrow-left me-1"></i>
                Cancel

            </a>

            <button type="submit" class="sales-btn-primary">

                <i class="bi bi-check-lg me-1"></i>
                Save Changes

            </button>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}