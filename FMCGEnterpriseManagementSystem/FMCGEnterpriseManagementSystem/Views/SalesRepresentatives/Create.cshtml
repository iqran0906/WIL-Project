@*
    Purpose: Create a sales representative linked to an eligible employee.
    Original author: iqran0906 (from Git history).

    References:
    Bootstrap (n.d.) Forms and Grid.
    https://getbootstrap.com/docs/5.3/
*@

@model FMCGEnterpriseManagementSystem.ViewModels.SalesRepresentativeViewModel

@{
    ViewData["Title"] = "New Sales Representative";
}

<link rel="stylesheet" href="~/css/sales-representatives.css" asp-append-version="true" />

<div class="sales-page">

    <div class="sales-page-header">

        <div>
            <h2 class="sales-page-title">New Sales Representative</h2>

            <p class="sales-page-subtitle">
                Assign an eligible employee as a sales representative
                and configure their sales information.
            </p>
        </div>

    </div>

    <form asp-controller="SalesRepresentatives"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <div class="row g-4">

            <!-- REPRESENTATIVE INFORMATION -->

            <div class="col-12 col-xl-6">

                <div class="sales-form-section">

                    <h5 class="sales-section-title">
                        <i class="bi bi-person-badge me-2"></i>
                        Representative Information
                    </h5>

                    <p class="sales-section-subtitle">
                        Select an employee and specify their assigned sales area.
                    </p>

                    <!-- EMPLOYEE -->

                    <div class="mb-3">

                        <label asp-for="EmployeeID" class="form-label"></label>

                        <select asp-for="EmployeeID"
                                asp-items="ViewBag.Employees"
                                class="form-select">

                            <option value="">-- Select Employee --</option>

                        </select>

                        <span asp-validation-for="EmployeeID"
                              class="text-danger small"></span>

                        <div class="sales-form-help">
                            Only active employees who are not already
                            sales representatives are available.
                        </div>

                    </div>

                    <!-- GENERATED CODE -->

                    <div class="mb-3">

                        <label class="form-label">
                            Sales Rep Code
                        </label>

                        <input type="text"
                               class="form-control"
                               value="Generated automatically when saved"
                               readonly />

                        <div class="sales-form-help">
                            The next available code will be assigned automatically,
                            for example SR-001, SR-002 or SR-003.
                        </div>

                    </div>

                    <!-- AREA -->

                    <div class="mb-3">

                        <label asp-for="Area" class="form-label"></label>

                        <input asp-for="Area"
                               class="form-control"
                               placeholder="e.g. Durban North" />

                        <span asp-validation-for="Area"
                              class="text-danger small"></span>

                    </div>

                </div>

            </div>

            <!-- SALES INFORMATION -->

            <div class="col-12 col-xl-6">

                <div class="sales-form-section">

                    <h5 class="sales-section-title">
                        <i class="bi bi-graph-up-arrow me-2"></i>
                        Sales & Compensation
                    </h5>

                    <p class="sales-section-subtitle">
                        Configure salary, commission and sales targets.
                    </p>

                    <!-- SALARY -->

                    <div class="mb-3">

                        <label asp-for="Salary" class="form-label"></label>

                        <div class="input-group">

                            <span class="input-group-text">R</span>

                            <input asp-for="Salary"
                                   class="form-control"
                                   type="number"
                                   min="0"
                                   step="0.01" />

                        </div>

                        <span asp-validation-for="Salary"
                              class="text-danger small"></span>

                    </div>

                    <!-- COMMISSION -->

                    <div class="mb-3">

                        <label asp-for="CommissionRate" class="form-label"></label>

                        <div class="input-group">

                            <input asp-for="CommissionRate"
                                   class="form-control"
                                   type="number"
                                   min="0"
                                   max="100"
                                   step="0.01" />

                            <span class="input-group-text">%</span>

                        </div>

                        <span asp-validation-for="CommissionRate"
                              class="text-danger small"></span>

                    </div>

                    <!-- SALES TARGET -->

                    <div class="mb-3">

                        <label asp-for="SalesTarget" class="form-label"></label>

                        <div class="input-group">

                            <span class="input-group-text">R</span>

                            <input asp-for="SalesTarget"
                                   class="form-control"
                                   type="number"
                                   min="0"
                                   step="0.01" />

                        </div>

                        <span asp-validation-for="SalesTarget"
                              class="text-danger small"></span>

                    </div>

                </div>

            </div>

        </div>

        <!-- ACTIONS -->

        <div class="sales-form-actions">

            <a asp-controller="SalesRepresentatives"
               asp-action="Index"
               class="sales-btn-outline">

                <i class="bi bi-arrow-left me-1"></i>
                Cancel

            </a>

            <button type="submit" class="sales-btn-primary">

                <i class="bi bi-check-lg me-1"></i>
                Save Sales Representative

            </button>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}