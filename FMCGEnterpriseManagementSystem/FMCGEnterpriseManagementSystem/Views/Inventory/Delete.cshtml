@model FMCGEnterpriseManagementSystem.ViewModels.InventoryViewModel

@{
    ViewData["Title"] = "Delete Inventory Item";
}

<div class="content-card p-4">
    <h2 class="fw-bold mb-3 text-danger">Delete Inventory Item</h2>
    <p class="text-muted mb-4">Are you sure you want to remove this item from inventory? This action cannot be undone.</p>

    <div class="card border-danger mb-4 bg-dark text-white">
        <div class="card-body">
            <h5 class="card-title fw-bold">@Model.ProductName</h5>
            <p class="card-text mb-1"><strong>Product Code:</strong> @Model.ProductCode</p>
            <p class="card-text mb-0"><strong>Selling Price:</strong> R @Model.SellingPrice</p>
        </div>
    </div>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ProductId" />

        <div class="d-flex justify-content-end gap-3">
            <button type="button" class="btn btn-link text-decoration-none text-secondary align-self-center" onclick="window.location.href='@Url.Action("Index", "Inventory")'">Cancel</button>
            <button type="submit" class="btn btn-danger px-4">Confirm Delete</button>
        </div>
    </form>
</div>