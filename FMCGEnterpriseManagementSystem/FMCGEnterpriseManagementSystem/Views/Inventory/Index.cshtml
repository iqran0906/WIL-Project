@model IEnumerable<FMCGEnterpriseManagementSystem.ViewModels.InventoryViewModel>

@using System.Globalization

@*
    Purpose:
    Inventory management dashboard with summary cards,
    search, category filtering, stock indicators,
    expiry monitoring and inventory actions.

    Updated:
    Uses the existing InventoryViewModel.StockStatus property
    and each inventory item's configured ReorderLevel.

    References:

    Microsoft (n.d.) Razor syntax reference for ASP.NET Core.
    Available at:
    https://learn.microsoft.com/en-us/aspnet/core/mvc/views/razor

    Bootstrap (n.d.) Cards.
    Available at:
    https://getbootstrap.com/docs/5.3/components/card/

    Bootstrap (n.d.) Tables.
    Available at:
    https://getbootstrap.com/docs/5.3/content/tables/

    Mozilla (n.d.) Array.prototype.filter().
    MDN Web Docs.
    Available at:
    https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Array/filter
*@

@{
    ViewData["Title"] = "Inventory";

    // Convert the supplied inventory records into a list.
    var inventory = Model?.ToList()
        ?? new List<FMCGEnterpriseManagementSystem.ViewModels.InventoryViewModel>();

    // Use the actual inventory records for the summary cards.
    var totalProducts = inventory.Count;

    var totalStockUnits = inventory.Sum(item => item.QuantityOnHand);

    // Uses each product's configured reorder level.
    // Out-of-stock products are also included because they require attention.
    var productsRequiringReorder = inventory.Count(item =>
        item.StockStatus == "Low Stock" ||
        item.StockStatus == "Out of Stock");

    // Calculate expiry dates using the current application date.
    var today = DateTime.Today;
    var expiryLimit = today.AddDays(30);

    // Count products expiring within the next 30 days.
    // Already-expired products are not included in this count.
    var expiringSoon = inventory.Count(item =>
        item.ExpiryDate.HasValue &&
        item.ExpiryDate.Value.Date >= today &&
        item.ExpiryDate.Value.Date <= expiryLimit);

    // Build category filter options from the actual inventory data.
    var categories = inventory
        .Where(item => !string.IsNullOrWhiteSpace(item.CategoryName))
        .Select(item => item.CategoryName!)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(category => category)
        .ToList();
}

<style>
    /* =========================================================
       INVENTORY MANAGEMENT
       Navy, teal and blue-grey design
       ========================================================= */

    .inventory-page {
        background: #e6edf1;
        border: 1px solid rgba(53, 127, 145, 0.18);
        border-radius: 15px;
        padding: 30px;
        margin-bottom: 30px;
        min-height: 80vh;
        color: #183244;
    }

    /* PAGE HEADER */

    .inventory-page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 18px;
        margin-bottom: 26px;
    }

    .inventory-page-title {
        font-size: 30px;
        font-weight: 800;
        color: #183244;
        margin-bottom: 5px;
    }

    .inventory-page-subtitle {
        color: #667988;
        font-size: 15px;
        margin-bottom: 0;
    }

    .inventory-header-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .inventory-btn-primary {
        background: #357f91;
        color: #ffffff;
        border: 1px solid #357f91;
        border-radius: 6px;
        padding: 10px 18px;
        font-weight: 600;
        text-decoration: none;
    }

    .inventory-btn-primary:hover {
        background: #286675;
        color: #ffffff;
    }

    .inventory-btn-outline {
        background: transparent;
        color: #536475;
        border: 1px solid #a8b1bb;
        border-radius: 6px;
        padding: 10px 18px;
        font-weight: 500;
    }

    .inventory-btn-outline:hover {
        background: #dce6eb;
        color: #183244;
    }

    /* =========================================================
       SUMMARY CARDS
       ========================================================= */

    .inventory-stat-card {
        background: #f8fafb;
        border: 1px solid #c9d9df;
        border-top: 3px solid #357f91;
        border-radius: 7px;
        padding: 20px;
        height: 100%;
        min-height: 112px;
        box-shadow: 0 3px 12px rgba(15, 40, 55, 0.05);
    }

    .inventory-stat-card.attention {
        border-top-color: #e0a32b;
    }

    .inventory-stat-card.expiry {
        border-top-color: #657c91;
    }

    .inventory-stat-label {
        color: #667988;
        font-size: 14px;
        margin-bottom: 10px;
    }

    .inventory-stat-value {
        color: #142d40;
        font-size: 28px;
        font-weight: 800;
        line-height: 1.2;
    }

    .inventory-stat-card.attention .inventory-stat-value {
        color: #9b6200;
    }

    /* =========================================================
       SEARCH AND FILTERS
       ========================================================= */

    .inventory-filter-panel {
        background: #edf3f5;
        border: 1px solid #c9d9df;
        border-radius: 7px;
        padding: 20px;
        margin: 25px 0;
    }

    .inventory-filter-label {
        font-size: 14px;
        font-weight: 600;
        color: #465768;
        margin-bottom: 7px;
    }

    .inventory-filter-panel .form-control,
    .inventory-filter-panel .form-select {
        background: #f7f8fa;
        border: 1px solid #d3dbe2;
        min-height: 43px;
        color: #263b4b;
    }

    /* =========================================================
       INVENTORY TABLE
       ========================================================= */

    .inventory-table-container {
        width: 100%;
        overflow-x: auto;
    }

    .inventory-modern-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 8px;
        font-size: 15px;
    }

    .inventory-modern-table thead th {
        background: #dce9ee;
        color: #17384a;
        padding: 18px 12px;
        border-top: 1px solid #c9d9df;
        border-bottom: 1px solid #c9d9df;
        font-weight: 700;
        white-space: nowrap;
        text-align: center;
    }

    .inventory-modern-table tbody td {
        background: #f8fafb;
        padding: 17px 12px;
        border-top: 1px solid #e0e5ea;
        border-bottom: 1px solid #e0e5ea;
        color: #344657;
        vertical-align: middle;
        text-align: center;
    }

    .inventory-modern-table tbody tr td:first-child {
        border-left: 1px solid #e0e5ea;
    }

    .inventory-modern-table tbody tr td:last-child {
        border-right: 1px solid #e0e5ea;
    }

    /* Highlight products requiring replenishment. */

    .inventory-modern-table tbody tr.inventory-low-stock td {
        background: #fff0d4;
    }

    .inventory-modern-table tbody tr.inventory-out-stock td {
        background: #ffe4e4;
    }

    .inventory-modern-table tbody tr:hover td {
        filter: brightness(0.97);
    }

    .inventory-product-name {
        color: #183244;
        font-weight: 700;
    }

    .inventory-product-description {
        color: #7b8793;
        font-size: 12px;
        margin-top: 5px;
    }

    .inventory-reorder-note {
        color: #966000;
        font-size: 12px;
        font-weight: 600;
        margin-top: 5px;
    }

    .inventory-out-stock .inventory-reorder-note {
        color: #ad2f37;
    }

    /* =========================================================
       STOCK STATUS BADGES
       ========================================================= */

    .inventory-status {
        display: inline-block;
        border-radius: 5px;
        padding: 6px 10px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .inventory-status-good {
        background: #dff5e8;
        color: #187544;
    }

    .inventory-status-low {
        background: #fff0c9;
        color: #946100;
    }

    .inventory-status-out {
        background: #fce0e0;
        color: #ad2f37;
    }

    /* EXPIRY INDICATORS */

    .inventory-expiry-warning {
        color: #a56c00;
        font-weight: 700;
    }

    .inventory-expired {
        color: #bd303b;
        font-weight: 700;
    }
/* ==========================================================
   INVENTORY ACTION BUTTONS
   Consistent styling with Employees and Sales Representatives.
   ========================================================== */

.inventory-action-buttons {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
}

.inventory-edit-btn,
.inventory-delete-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    min-height: 36px;
    padding: 8px 13px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s ease,
                border-color 0.2s ease;
}

/* EDIT */

.inventory-edit-btn {
    background: #e0f0f2;
    border: 1px solid #a6cdd3;
    color: #216b7b;
}

.inventory-edit-btn:hover {
    background: #cce5e9;
    border-color: #78b4be;
    color: #174e5a;
}

/* DELETE */

.inventory-delete-btn {
    background: #f9e5e5;
    border: 1px solid #e9b7b7;
    color: #a33a3a;
}

.inventory-delete-btn:hover {
    background: #f3d2d2;
    border-color: #d99a9a;
    color: #862b2b;
}

/* KEYBOARD ACCESSIBILITY */

.inventory-edit-btn:focus-visible,
.inventory-delete-btn:focus-visible {
    outline: 2px solid #357f91;
    outline-offset: 3px;
}

    /* EMPTY STATE */

    .inventory-empty-state {
        background: #f8fafb;
        padding: 45px 20px;
        text-align: center;
        color: #667988;
        border: 1px solid #c9d9df;
        border-radius: 8px;
    }

    /* RESPONSIVE LAYOUT */

    @@media (max-width: 768px) {

        .inventory-page {
            padding: 18px;
        }

        .inventory-page-title {
            font-size: 25px;
        }

        .inventory-header-actions {
            width: 100%;
        }

        .inventory-header-actions .btn,
        .inventory-header-actions a {
            flex: 1;
            text-align: center;
        }
    }

    /* PRINT STYLES */

    @@media print {

        .inventory-page {
            background: #ffffff;
            padding: 0;
        }

        .inventory-header-actions,
        .inventory-filter-panel,
        .inventory-action-buttons {
            display: none !important;
        }

        .inventory-modern-table tbody tr td {
            background: #ffffff !important;
        }
    }
</style>


<div class="inventory-page">

    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="inventory-page-header">

        <div>
            <h2 class="inventory-page-title">
                Inventory Management
            </h2>

            <p class="inventory-page-subtitle">
                Monitor stock availability, product quantities and expiry dates.
            </p>
        </div>

        <div class="inventory-header-actions">

            <button type="button"
                    class="btn inventory-btn-outline"
                    data-bs-toggle="modal"
                    data-bs-target="#manageCategoriesModal">

                <i class="bi bi-tags me-2"></i>
                Manage Categories

            </button>

            <a asp-controller="Inventory"
               asp-action="AddItem"
               class="btn inventory-btn-primary">

                <i class="bi bi-plus-lg me-2"></i>
                New Item

            </a>

        </div>

    </div>


    <!-- =====================================================
         SUMMARY CARDS
         ===================================================== -->

    <div class="row g-3">

        <!-- TOTAL PRODUCTS -->

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="inventory-stat-card">

                <div class="inventory-stat-label">
                    Total Inventory Products
                </div>

                <div class="inventory-stat-value">
                    @totalProducts
                </div>

            </div>

        </div>


        <!-- TOTAL STOCK UNITS -->

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="inventory-stat-card">

                <div class="inventory-stat-label">
                    Total Stock Units
                </div>

                <div class="inventory-stat-value">
                    @totalStockUnits.ToString("N0")
                </div>

            </div>

        </div>


        <!-- PRODUCTS REQUIRING REORDER -->

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="inventory-stat-card @(productsRequiringReorder > 0 ? "attention" : "")">

                <div class="inventory-stat-label">
                    Products Requiring Reorder
                </div>

                <div class="inventory-stat-value">
                    @productsRequiringReorder
                </div>

            </div>

        </div>


        <!-- EXPIRING PRODUCTS -->

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="inventory-stat-card expiry">

                <div class="inventory-stat-label">
                    Expiring Within 30 Days
                </div>

                <div class="inventory-stat-value">
                    @expiringSoon
                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         SEARCH AND FILTERS
         ===================================================== -->

    <div class="inventory-filter-panel">

        <div class="row g-3 align-items-end">

            <!-- SEARCH -->

            <div class="col-12 col-lg-5">

                <label for="searchKeyword"
                       class="inventory-filter-label">
                    Search Inventory
                </label>

                <input type="search"
                       id="searchKeyword"
                       class="form-control"
                       placeholder="Product code, name or description..." />

            </div>


            <!-- CATEGORY FILTER -->

            <div class="col-12 col-md-5 col-lg-3">

                <label for="categoryFilter"
                       class="inventory-filter-label">
                    Category
                </label>

                <select id="categoryFilter"
                        class="form-select">

                    <option value="">
                        All Categories
                    </option>

                    @foreach (var category in categories)
                    {
                        <option value="@category">
                            @category
                        </option>
                    }

                </select>

            </div>


            <!-- STOCK STATUS FILTER -->

            <div class="col-12 col-md-4 col-lg-2">

                <label for="stockFilter"
                       class="inventory-filter-label">
                    Stock Status
                </label>

                <select id="stockFilter"
                        class="form-select">

                    <option value="">
                        All Statuses
                    </option>

                    <option value="good">
                        In Stock
                    </option>

                    <option value="low">
                        Low Stock
                    </option>

                    <option value="out">
                        Out of Stock
                    </option>

                </select>

            </div>


            <!-- CLEAR FILTERS -->

            <div class="col-12 col-md-3 col-lg-2">

                <button type="button"
                        id="clearInventoryFilters"
                        class="btn inventory-btn-outline w-100">

                    Clear

                </button>

            </div>

        </div>

    </div>


    <!-- =====================================================
         INVENTORY TABLE
         ===================================================== -->

    <div class="inventory-table-container">

        <table class="inventory-modern-table">

            <thead>
                <tr>
                    <th>Product Code</th>
                    <th>Product</th>
                    <th>Category</th>
                    <th>Quantity</th>
                    <th>Unit Price Incl. VAT</th>
                    <th>Expiry Date</th>
                    <th>Stock Status</th>
                    <th>Notes</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody id="inventoryTableBody">

                @foreach (var item in inventory)
                {
                    // Use the existing business rule in InventoryViewModel.
                    var stockLabel = item.StockStatus;

                    // Map the business status to a UI filter value.
                    var stockStatus = stockLabel switch
                    {
                        "Out of Stock" => "out",
                        "Low Stock" => "low",
                        _ => "good"
                    };

                    // Choose the badge appearance.
                    var stockBadgeClass = stockStatus switch
                    {
                        "out" => "inventory-status-out",
                        "low" => "inventory-status-low",
                        _ => "inventory-status-good"
                    };

                    // Highlight products requiring replenishment.
                    var rowClass = stockStatus switch
                    {
                        "out" => "inventory-out-stock",
                        "low" => "inventory-low-stock",
                        _ => ""
                    };

                    // Determine whether the product has expired.
                    var isExpired =
                        item.ExpiryDate.HasValue &&
                        item.ExpiryDate.Value.Date < today;

                    // Determine whether the product expires within 30 days.
                    var isExpiringSoon =
                        item.ExpiryDate.HasValue &&
                        item.ExpiryDate.Value.Date >= today &&
                        item.ExpiryDate.Value.Date <= expiryLimit;

                    <tr class="inventory-row @rowClass"
                        data-category="@item.CategoryName"
                        data-stock="@stockStatus">

                        <!-- PRODUCT CODE -->

                        <td class="item-code fw-semibold">
                            @item.ProductCode
                        </td>


                        <!-- PRODUCT NAME AND DESCRIPTION -->

                        <td>

                            <div class="inventory-product-name item-name">
                                @item.ProductName
                            </div>

                            <div class="inventory-product-description item-description">
                                @item.Description
                            </div>

                        </td>


                        <!-- CATEGORY -->

                        <td class="item-category">
                            @item.CategoryName
                        </td>


                        <!-- QUANTITY -->

                        <td class="fw-bold">

                            @item.QuantityOnHand

                            @if (stockStatus == "low" || stockStatus == "out")
                            {
                                <div class="inventory-reorder-note">
                                    Reorder at @item.ReorderLevel
                                </div>
                            }

                        </td>


                        <!-- UNIT PRICE -->

                        <td>
                            @{
                                var price = decimal.TryParse(
                                    item.SellingPrice,
                                    NumberStyles.Any,
                                    CultureInfo.InvariantCulture,
                                    out var parsedPrice)
                                    ? parsedPrice
                                    : 0m;
                            }

                            R @price.ToString("N2")
                        </td>


                        <!-- EXPIRY DATE -->

                        <td>

                            @if (item.ExpiryDate.HasValue)
                            {
                                <span class="@(isExpired ? "inventory-expired" : isExpiringSoon ? "inventory-expiry-warning" : "")">

                                    @item.ExpiryDate.Value.ToString("dd MMM yyyy")

                                </span>

                                @if (isExpired)
                                {
                                    <div class="small inventory-expired">
                                        Expired
                                    </div>
                                }
                                else if (isExpiringSoon)
                                {
                                    <div class="small inventory-expiry-warning">
                                        Expiring Soon
                                    </div>
                                }
                            }
                            else
                            {
                                <span class="text-muted">
                                    N/A
                                </span>
                            }

                        </td>


                        <!-- STOCK STATUS -->

                        <td>

                            <span class="inventory-status @stockBadgeClass">
                                @stockLabel
                            </span>

                        </td>


                        <!-- NOTES -->

                        <td>

                            @(string.IsNullOrWhiteSpace(item.Notes)
                                ? "—"
                                : item.Notes)

                        </td>


                        <!-- ACTIONS -->

                        <td>

                            <div class="inventory-action-buttons">

                                <a asp-controller="Inventory"
                                   asp-action="Edit"
                                   asp-route-id="@item.InventoryId"
                                   class="inventory-edit-btn">

                                    <i class="bi bi-pencil-square me-1"></i>
                                    Edit

                                </a>

                                <a asp-controller="Inventory"
                                   asp-action="Delete"
                                   asp-route-id="@item.InventoryId"
                                   class="inventory-delete-btn">

                                    <i class="bi bi-trash me-1"></i>
                                    Delete

                                </a>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>


    <!-- =====================================================
         EMPTY STATE
         ===================================================== -->

    <div id="inventoryEmptyState"
         class="inventory-empty-state @(inventory.Any() ? "d-none" : "")">

        <i class="bi bi-box-seam fs-1 d-block mb-3"></i>

        <h5 class="fw-bold">
            No inventory items found
        </h5>

        <p class="mb-0">
            Try adjusting your search or filters,
            or add a new inventory item.
        </p>

    </div>

</div>


<!-- =========================================================
     CATEGORY MANAGEMENT MODAL
     ========================================================= -->

<div class="modal fade"
     id="manageCategoriesModal"
     tabindex="-1"
     aria-labelledby="manageCategoriesModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title fw-bold"
                    id="manageCategoriesModalLabel">
                    Manage Categories
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body">

                <div class="alert alert-info small">

                    <i class="bi bi-info-circle me-1"></i>

                    Categories shown below are currently used by
                    inventory products. Category editing and deletion
                    are not connected to the database from this modal.

                </div>

                <div class="list-group">

                    @foreach (var category in categories)
                    {
                        <div class="list-group-item">

                            <i class="bi bi-tag me-2 text-secondary"></i>

                            @category

                        </div>
                    }

                    @if (!categories.Any())
                    {
                        <div class="text-muted small">
                            No categories are currently available.
                        </div>
                    }

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Close

                </button>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>
        // ======================================================
        // INVENTORY SEARCH AND FILTERING
        //
        // Filters existing rows without changing database data.
        // ======================================================

        document.addEventListener("DOMContentLoaded", function () {

            const searchInput =
                document.getElementById("searchKeyword");

            const categoryFilter =
                document.getElementById("categoryFilter");

            const stockFilter =
                document.getElementById("stockFilter");

            const clearButton =
                document.getElementById("clearInventoryFilters");

            const rows =
                document.querySelectorAll(".inventory-row");

            const emptyState =
                document.getElementById("inventoryEmptyState");


            function applyFilters() {

                const search =
                    searchInput.value.toLowerCase().trim();

                const category =
                    categoryFilter.value.toLowerCase();

                const stock =
                    stockFilter.value;

                let visibleCount = 0;


                rows.forEach(function (row) {

                    const rowText =
                        row.textContent.toLowerCase();

                    const rowCategory =
                        (row.dataset.category || "").toLowerCase();

                    const rowStock =
                        row.dataset.stock || "";


                    const matchesSearch =
                        !search || rowText.includes(search);

                    const matchesCategory =
                        !category || rowCategory === category;

                    const matchesStock =
                        !stock || rowStock === stock;


                    const visible =
                        matchesSearch &&
                        matchesCategory &&
                        matchesStock;


                    row.style.display = visible ? "" : "none";

                    if (visible) {
                        visibleCount++;
                    }

                });


                emptyState.classList.toggle(
                    "d-none",
                    visibleCount > 0
                );
            }


            searchInput.addEventListener(
                "input",
                applyFilters
            );

            categoryFilter.addEventListener(
                "change",
                applyFilters
            );

            stockFilter.addEventListener(
                "change",
                applyFilters
            );


            clearButton.addEventListener("click", function () {

                searchInput.value = "";
                categoryFilter.value = "";
                stockFilter.value = "";

                applyFilters();

            });

        });
    </script>
}