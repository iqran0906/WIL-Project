@model FMCGEnterpriseManagementSystem.ViewModels.InventoryViewModel

@{
    ViewData["Title"] = "Edit Inventory Item";
}

<div class="content-card p-4">
    <h2 class="fw-bold mb-4" style="color: #61b5ff;">Edit Inventory Item</h2>

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        
        <!-- Crucial: Must include InventoryId so the update targets the right record -->
        <input type="hidden" asp-for="InventoryId" />
        <input type="hidden" asp-for="ProductId" />

        <div class="row g-4">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="ProductCode" class="form-label text-white">Item Code</label>
                    <input asp-for="ProductCode" class="form-control rounded-0">
                    <span asp-validation-for="ProductCode" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ProductName" class="form-label text-white">Product Name</label>
                    <input asp-for="ProductName" class="form-control rounded-0">
                    <span asp-validation-for="ProductName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryName" class="form-label text-white">Category</label>
                    <input asp-for="CategoryName" class="form-control rounded-0">
                    <span asp-validation-for="CategoryName" class="text-danger small"></span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="QuantityOnHand" class="form-label text-white">Quantity On Hand</label>
                    <input asp-for="QuantityOnHand" class="form-control rounded-0" type="number">
                    <span asp-validation-for="QuantityOnHand" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SellingPrice" class="form-label text-white">Selling Price</label>
                    <input asp-for="SellingPrice" class="form-control rounded-0" type="number" step="0.01">
                    <span asp-validation-for="SellingPrice" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CostExVat" class="form-label text-white">Cost (Excl. VAT)</label>
                    <input asp-for="CostExVat" class="form-control rounded-0" type="number" step="0.01">
                    <span asp-validation-for="CostExVat" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ReorderLevel" class="form-label text-white">Reorder Level (Low Stock Limit)</label>
                    <input asp-for="ReorderLevel" class="form-control rounded-0" type="number">
                    <span asp-validation-for="ReorderLevel" class="text-danger small"></span>
              </div>
        </div>

        <div class="d-flex justify-content-end gap-3 mt-4">
            <button type="button" class="btn btn-link text-decoration-none text-secondary align-self-center" onclick="window.location.href='@Url.Action("Index", "Inventory")'">Cancel</button>
            <button type="submit" class="btn text-white fw-bold px-4" style="background-color: #316573; border-radius: 4px;">Update Item</button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}