@model FMCGEnterpriseManagementSystem.ViewModels.InventoryViewModel

@{
    ViewData["Title"] = "Edit Inventory Item";
}

<div class="content-card p-4" style="background-color: #ffffff; border-radius: 12px; color: #1c323d;">
    <h2 class="fw-bold mb-4" style="color: #1c323d;">Edit Inventory Item</h2>

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="InventoryId" />
        <input type="hidden" asp-for="ProductId" />

        <div class="row g-4">
            <div class="col-md-8 offset-md-2">
                <!-- Item Code -->
                <div class="mb-3">
                    <label asp-for="ProductCode" class="form-label fw-bold" style="color: #1c323d;"></label>
                    <input asp-for="ProductCode" class="form-control" required />
                    <span asp-validation-for="ProductCode" class="text-danger"></span>
                </div>

                <!-- Description / Product Name -->
                <div class="mb-3">
                    <label asp-for="ProductName" class="form-label fw-bold" style="color: #1c323d;">Description</label>
                    <input asp-for="ProductName" class="form-control" required />
                    <span asp-validation-for="ProductName" class="text-danger"></span>
                </div>

                <!-- Category -->
                <div class="mb-3">
                    <label asp-for="CategoryName" class="form-label fw-bold" style="color: #1c323d;"></label>
                    <input asp-for="CategoryName" class="form-control" />
                    <span asp-validation-for="CategoryName" class="text-danger"></span>
                </div>

                <!-- Quantity On Hand -->
                <div class="mb-3">
                    <label asp-for="QuantityOnHand" class="form-label fw-bold" style="color: #1c323d;"></label>
                    <input asp-for="QuantityOnHand" class="form-control" min="0" required />
                    <span asp-validation-for="QuantityOnHand" class="text-danger"></span>
                </div>

                <!-- Selling Price -->
                <div class="mb-3">
                    <label asp-for="SellingPrice" class="form-label fw-bold" style="color: #1c323d;"></label>
                    <input asp-for="SellingPrice" class="form-control" required />
                    <span asp-validation-for="SellingPrice" class="text-danger"></span>
                </div>

                <!-- Reorder Level -->
                <div class="mb-3">
                    <label asp-for="ReorderLevel" class="form-label fw-bold" style="color: #1c323d;"></label>
                    <input asp-for="ReorderLevel" class="form-control" min="0" required />
                    <span asp-validation-for="ReorderLevel" class="text-danger"></span>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex justify-content-end gap-3 mt-4">
                    <a asp-controller="Inventory" asp-action="Index" class="btn btn-link text-decoration-none text-secondary align-self-center">Cancel</a>
                    <button type="submit" class="btn btn-custom-save px-4 py-2" style="background-color: #1c323d; color: #ffffff;">Update Item</button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}