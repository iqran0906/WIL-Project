@{
    ViewData["Title"] = "New Item";
}

<div class="content-card">
    <h2 class="fw-bold mb-4" style="color: #1c323d;">New Item</h2>

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <form method="post">
        @Html.AntiForgeryToken()

        <div class="row g-4">
            <!-- Product Code -->
            <div class="col-md-6">
                <label class="form-label">Product Code</label>
                <input type="text"
                       id="productCode"
                       class="form-control"
                       value=""
                       readonly>
            </div>
           
            <!-- Product -->
            <div class="col-md-6">
                <label class="form-label">Product</label>
                <select name="ProductId"
                        id="productSelect"
                        class="form-select"
                        required>

                    <option value="" selected disabled>Select Product</option>

                    @foreach (var product in ViewBag.Products)
                    {
                        <option value="@product.ProductId"
                                data-code="@product.ProductCode"
                                data-description="@product.Description"
                                data-price="@product.SellingPrice"
                                data-category="@product.Category">
                            @product.ProductCode - @product.ProductName
                        </option>
                    }

                </select>

            </div>

                    <!-- Description -->
                    <div class="col-md-6">
                        <label class="form-label">Description</label>
                        <input type="text"
                               name="Description"
                               id="descriptionInput"
                               class="form-control"
                               readonly>
                    </div>

            <!-- Quantity -->
            <div class="col-md-6">
                <label class="form-label">Quantity</label>
                <input type="number"
                       name="QuantityOnHand"
                       min="0"
                       class="form-control"
                       placeholder="Enter Quantity"
                       required>
            </div>

            <!-- Reorder Level -->
            <div class="col-md-6">
                <label class="form-label">Reorder Level (Low Stock Limit)</label>
                <input type="number"
                       name="ReorderLevel"
                       min="0"
                       class="form-control"
                       placeholder="E.g. 20"
                       required>
            </div>

                    <!-- Unit Value -->
                    <div class="col-md-6">
                        <label class="form-label">Unit Value</label>
                        <input type="number"
                               step="0.01"
                               id="sellingPriceInput"
                               name="SellingPrice"
                               class="form-control"
                               readonly>
                    </div>

            <!-- VAT -->
            <div class="col-md-6">
                <label class="form-label">VAT</label>
                <select name="VatRate" class="form-select">
                    <option selected disabled>Select VAT</option>
                    <option value="15">Standard (15%)</option>
                    <option value="0">Zero Rated (0%)</option>
                    <option value="-1">Exempt</option>
                </select>
            </div>

            <!-- Expiry Date -->
            <div class="col-md-6">
                <label class="form-label">Expiry Date</label>

                <select id="expiryOptionSelect" class="form-select mb-2">
                    <option value="none" selected>Optional / No Expiry Date</option>
                    <option value="custom">Set Expiry Date...</option>
                </select>

                <div id="expiryDatePickerContainer" style="display: none;">
                    <input type="date"
                           id="expiryDateInput"
                           name="ExpiryDate"
                           class="form-control">
                </div>
            </div>

                    <!-- Category -->
                    <div class="col-md-6">
                        <label class="form-label">Category</label>
                        <input type="text"
                               name="CategoryName"
                               id="categoryInput"
                               class="form-control"
                               readonly>
                    </div>

            <!-- Notes -->
            <div class="col-12">
                <label class="form-label">Notes</label>

                <textarea name="Notes"
                          class="form-control"
                          rows="4"
                          placeholder="Add any additional notes about this item..."></textarea>
            </div>

            <!-- Action Buttons -->
            <div class="col-12">
                <div class="d-flex justify-content-end gap-3 mt-2">
                    <a asp-controller="Inventory"
                       asp-action="Index"
                       class="btn btn-link text-decoration-none text-secondary">
                        Cancel
                    </a>

                    <button type="submit" class="btn btn-custom-save">
                        Save Item
                    </button>
                </div>
            </div>

        </div>
    </form>
</div>

        @section Scripts {
            <script>
                document.addEventListener("DOMContentLoaded", function () {

                    // ==========================
                    // PRODUCT SELECTION
                    // ==========================

                    const productSelect =
                        document.getElementById("productSelect");

                    const productCodeInput =
                        document.getElementById("productCode");

                    const descriptionInput =
                        document.getElementById("descriptionInput");

                    const sellingPriceInput =
                        document.getElementById("sellingPriceInput");

                    const categoryInput =
                        document.getElementById("categoryInput");

                    if (productSelect) {
                        productSelect.addEventListener("change", function () {

                            const selectedOption =
                                this.options[this.selectedIndex];

                            productCodeInput.value =
                                selectedOption.dataset.code || "";

                            descriptionInput.value =
                                selectedOption.dataset.description || "";

                            sellingPriceInput.value =
                                selectedOption.dataset.price || "";

                            categoryInput.value =
                                selectedOption.dataset.category || "";
                        });
                    }


                    // ==========================
                    // EXPIRY DATE
                    // ==========================

                    const expiryOptionSelect =
                        document.getElementById("expiryOptionSelect");

                    const expiryDatePickerContainer =
                        document.getElementById("expiryDatePickerContainer");

                    const expiryDateInput =
                        document.getElementById("expiryDateInput");

                    if (expiryOptionSelect) {
                        expiryOptionSelect.addEventListener("change", function () {

                            if (this.value === "custom") {
                                expiryDatePickerContainer.style.display = "block";
                            }
                            else {
                                expiryDatePickerContainer.style.display = "none";
                                expiryDateInput.value = "";
                            }
                        });
                    }

                });
            </script>
        }