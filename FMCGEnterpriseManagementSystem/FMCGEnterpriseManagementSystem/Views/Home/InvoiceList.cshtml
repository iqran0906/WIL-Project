@{
    ViewData["Title"] = "Invoice";
}

<div class="px-2 py-3">
    <div class="row align-items-start mb-3">
        <div class="col-md-4">
            <h2 class="text-white fw-bold mb-3">Invoice</h2>
            <a asp-controller="Home" asp-action="CreateInvoice" class="btn btn-action-primary text-decoration-none">
                New Invoice
            </a>
        </div>

        <div class="col-md-8">
            <div class="row g-2 justify-content-md-end text-white">
                <div class="col-6 col-sm-3">
                    <label class="small fw-bold">Period:</label>
                    <select class="form-select form-select-sm"><option>All</option></select>
                </div>
                <div class="col-6 col-sm-3">
                    <label class="small fw-bold">Customer:</label>
                    <select class="form-select form-select-sm"><option>All</option></select>
                </div>
                <div class="col-6 col-sm-3">
                    <label class="small fw-bold">Start:</label>
                    <input type="date" class="form-control form-control-sm">
                </div>
                <div class="col-6 col-sm-3">
                    <label class="small fw-bold">End:</label>
                    <input type="date" class="form-control form-control-sm">
                </div>
            </div>

            <div class="d-flex justify-content-md-end align-items-center gap-2 mt-3">
                <span class="text-white fw-bold small">Keyword:</span>
                <div class="position-relative">
                    <input type="text" class="form-control form-control-sm search-field" placeholder="Item Code, Category, etc">
                    <i class="bi bi-search position-absolute end-0 top-50 translate-middle-y me-2 text-white-50 small"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex align-items-center gap-2 mb-3 text-white">
        <span class="fw-bold">View:</span>
        <select class="form-select form-select-sm w-auto d-inline-block"><option>Invoices</option></select>
    </div>

    <div class="table-responsive">
        <table class="custom-data-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Invoice No.</th>
                    <th>Amount Due</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>&nbsp;</td>
                    <td>&nbsp;</td>
                    <td>&nbsp;</td>
                    <td>&nbsp;</td>
                    <td>&nbsp;</td>
                    <td>&nbsp;</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>