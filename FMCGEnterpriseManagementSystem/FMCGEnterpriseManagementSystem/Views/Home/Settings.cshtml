@model FMCGEnterpriseManagementSystem.Models.RegisterUserViewModel

@{
    ViewData["Title"] = "System Settings";
    var userList = ViewBag.UserList as List<FMCGEnterpriseManagementSystem.Models.User> ?? new List<FMCGEnterpriseManagementSystem.Models.User>();
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-white fw-bold mb-0"><i class="bi bi-gear-fill me-2"></i>System Settings</h2>
            <small class="text-white-50">Manage user registrations and system options</small>
        </div>
    </div>

    @if (TempData["SettingsSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SettingsSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 h-100" style="background-color: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);">
                <div class="card-header bg-transparent border-bottom border-secondary text-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-person-plus-fill me-2"></i>Register New User</h5>
                </div>
                <div class="card-body p-4 text-white">
                    <form asp-controller="Home" asp-action="Settings" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label text-white-50 small fw-bold"></label>
                            <input asp-for="Email" class="form-control bg-dark text-white border-secondary" placeholder="user@company.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label text-white-50 small fw-bold"></label>
                            <input asp-for="Password" class="form-control bg-dark text-white border-secondary" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label text-white-50 small fw-bold"></label>
                            <input asp-for="ConfirmPassword" class="form-control bg-dark text-white border-secondary" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Role" class="form-label text-white-50 small fw-bold"></label>
                            <select asp-for="Role" class="form-select bg-dark text-white border-secondary">
                                <option value="User">User</option>
                                <option value="Administrator">Administrator</option>
                                <option value="SalesRep">Sales Representative</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn text-white w-100 py-2" style="background-color: #357383;">
                            <i class="bi bi-person-check-fill me-2"></i>Create User Account
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card shadow-sm border-0 h-100" style="background-color: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);">
                <div class="card-header bg-transparent border-bottom border-secondary text-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-people-fill me-2"></i>Existing System Accounts</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-dark table-hover mb-0 align-middle">
                            <thead class="table-secondary">
                                <tr>
                                    <th>Email / Username</th>
                                    <th>Status</th>
                                    <th>Account ID</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (userList.Count == 0)
                                {
                                    <tr>
                                        <td colspan="3" class="text-center py-4 text-white-50">No registered users found.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var user in userList)
                                    {
                                        <tr>
                                            <td><i class="bi bi-envelope me-2 text-info"></i>@user.Email</td>
                                            <td>
                                                @if (user.IsActive)
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Inactive</span>
                                                }
                                            </td>
                                            <td class="text-white-50 font-monospace small">@user.Id</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>