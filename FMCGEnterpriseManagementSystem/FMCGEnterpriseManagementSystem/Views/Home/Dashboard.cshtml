@*
    Title: Exclusive Distributors Dashboard
    Purpose:
    Display business analytics, global search, quick actions,
    monthly invoiced income and product-category sales.

    Original dashboard:
    Maseeha17, ST10068525 (Git history).

    UI enhancements:
    WIL Exclusive Distributors project.

    References:

    Microsoft (n.d.) Razor syntax reference for ASP.NET Core.
    Microsoft Learn. Available at:
    https://learn.microsoft.com/en-us/aspnet/core/mvc/views/razor

    Microsoft (n.d.) Role-based authorization in ASP.NET Core.
    Microsoft Learn. Available at:
    https://learn.microsoft.com/en-us/aspnet/core/security/authorization/roles

    Bootstrap (n.d.) Grid system.
    Available at:
    https://getbootstrap.com/docs/5.3/layout/grid/

    Bootstrap (n.d.) Bootstrap Icons.
    Available at:
    https://icons.getbootstrap.com/

    Chart.js (n.d.) Chart.js documentation.
    Available at:
    https://www.chartjs.org/docs/latest/

    Mozilla (n.d.) CSS transitions.
    MDN Web Docs. Available at:
    https://developer.mozilla.org/en-US/docs/Web/CSS/CSS_transitions

*@

@model FMCGEnterpriseManagementSystem.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    // Format monetary values consistently throughout the dashboard.
    var moneyCulture = System.Globalization.CultureInfo.InvariantCulture;

    string Money(decimal value)
    {
        return "R " + value.ToString("N2", moneyCulture);
    }

    // Retrieve the authenticated username.
    var username = User.Identity?.Name ?? "User";

    
    var accountName = username.Split((char)64)[0];

    // Produce a readable account name without modifying Identity.
    var displayName = string.IsNullOrWhiteSpace(accountName)
        ? "User"
        : char.ToUpperInvariant(accountName[0]) + accountName.Substring(1);

    // Determine the greeting using the application server's local time.
    var greeting = DateTime.Now.Hour switch
    {
        < 12 => "Good morning",
        < 17 => "Good afternoon",
        _ => "Good evening"
    };

    // Use the established application roles to control shortcuts.
    var isAdministrator = User.IsInRole("Administrator");
    var isEmployee = User.IsInRole("Employee");

    var canManageCatalog = isAdministrator || isEmployee;
    var canViewReports = isAdministrator;
}

<style>
    /*
       References:
       Bootstrap (n.d.) Grid system.
       Mozilla (n.d.) CSS transitions.
    */

    .dashboard-page {
        --dash-primary: #20d5c4;
        --dash-primary-soft: rgba(32, 213, 196, 0.12);
        --dash-background: #102a3a;
        --dash-surface: #112c3e;
        --dash-surface-alt: #14364a;
        --dash-border: rgba(32, 213, 196, 0.17);
        --dash-text: #ffffff;
        --dash-muted: #b2c6d2;
        --dash-grid: rgba(255, 255, 255, 0.09);

        color: var(--dash-text);
        padding-bottom: 35px;
    }

    /* DASHBOARD INTRODUCTION */

    .dashboard-intro {
        position: relative;
        padding: 32px 36px;
        margin-bottom: 30px;
        border: 1px solid rgba(32, 213, 196, 0.20);
        border-radius: 22px;

        background:
            radial-gradient(
                circle at 90% 15%,
                rgba(32, 213, 196, 0.14),
                transparent 35%
            ),
            linear-gradient(
                120deg,
                #0b1d30,
                #14354a
            );

        overflow: hidden;
    }

    .dashboard-intro::after {
        content: "";
        position: absolute;
        width: 250px;
        height: 250px;
        right: -90px;
        top: -120px;
        border: 1px solid rgba(32, 213, 196, 0.20);
        border-radius: 50%;
        pointer-events: none;
    }

    .dashboard-eyebrow {
        color: var(--dash-primary);
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 12px;
    }

    .dashboard-title {
        color: white;
        font-size: clamp(27px, 3vw, 39px);
        font-weight: 800;
        letter-spacing: -0.8px;
        margin-bottom: 10px;
        line-height: 1.25;
        overflow-wrap: anywhere;
    }

    .dashboard-title span {
        color: var(--dash-primary);
    }

    .dashboard-description {
        color: var(--dash-muted);
        font-size: 14px;
        line-height: 1.7;
        margin: 0;
        max-width: 760px;
    }

    /* GLOBAL SEARCH */

    .dashboard-search {
        max-width: 560px;
        margin-bottom: 32px;
    }

    .dashboard-search .input-group {
        border: 1px solid var(--dash-border);
        border-radius: 13px;
        overflow: hidden;
        background: var(--dash-surface);
        transition: border-color 0.25s ease;
    }

    .dashboard-search .input-group:focus-within {
        border-color: var(--dash-primary);
    }

    .dashboard-search .input-group-text {
        background: var(--dash-surface);
        color: var(--dash-primary);
        border: none;
        padding: 0 17px;
    }

    .dashboard-search .form-control {
        background: var(--dash-surface);
        border: none;
        color: white;
        min-height: 52px;
        font-size: 13px;
    }

    .dashboard-search .form-control::placeholder {
        color: #9cb5c3;
    }

    .dashboard-search .form-control:focus {
        box-shadow: none;
        background: var(--dash-surface-alt);
        color: white;
    }

    /* SECTION HEADINGS */

    .dashboard-section-heading {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
    }

    .dashboard-section-heading::before {
        content: "";
        width: 4px;
        height: 25px;
        border-radius: 4px;
        background: var(--dash-primary);
    }

    .dashboard-section-heading h2 {
        color: white;
        font-size: 20px;
        font-weight: 800;
        margin: 0;
    }

    /* QUICK ACTIONS */

    .dashboard-action {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: space-between;
        gap: 18px;
        min-height: 142px;
        padding: 23px;
        border-radius: 17px;

        background:
            linear-gradient(
                145deg,
                #13364a,
                #10283b
            );

        border: 1px solid var(--dash-border);
        color: white;
        text-decoration: none;

        transition:
            transform 0.25s ease,
            border-color 0.25s ease,
            box-shadow 0.25s ease;
    }

    .dashboard-action:hover {
        color: white;
        transform: translateY(-5px);
        border-color: rgba(32, 213, 196, 0.60);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.18);
    }

    .dashboard-action:focus-visible {
        outline: 2px solid var(--dash-primary);
        outline-offset: 3px;
    }

    .dashboard-action i {
        font-size: 26px;
        color: var(--dash-primary);
    }

    .dashboard-action span {
        font-weight: 700;
        font-size: 14px;
    }

    /* ANALYTICS HEADER */

    .dashboard-analytics-header {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        margin-bottom: 22px;
    }

    .dashboard-analytics-header .dashboard-section-heading {
        margin-bottom: 0;
    }

    /* PERIOD FILTER */

    .dashboard-period-filter {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .dashboard-period-filter label {
        color: var(--dash-muted);
        font-size: 13px;
        font-weight: 700;
        margin: 0;
    }

    .dashboard-period-filter .form-select {
        background-color: var(--dash-surface);
        color: white;
        border: 1px solid var(--dash-border);
        border-radius: 10px;
        min-width: 165px;
        padding: 10px 38px 10px 14px;
        font-size: 13px;
        color-scheme: dark;
    }

    .dashboard-period-filter .form-select:focus {
        border-color: var(--dash-primary);
        box-shadow: 0 0 0 3px rgba(32, 213, 196, 0.12);
    }

    /* ANALYTICS CARDS */

    .dashboard-page .viz-root {
        --viz-surface: #112c3e;
        --viz-text-primary: #ffffff;
        --viz-text-secondary: #b2c6d2;
        --viz-grid: rgba(255, 255, 255, 0.09);
        --viz-axis: rgba(255, 255, 255, 0.22);

        
        --series-1: #20d5c4;
        --series-2: #3987e5;
        --series-3: #199e70;
        --series-4: #c98500;
        --series-5: #d55181;
        --series-other: #c3c2b7;
    }

    .dashboard-page .viz-card {
        position: relative;
        height: 100%;
        padding: 26px;
        border-radius: 20px;

        background:
            linear-gradient(
                150deg,
                #14364a,
                #10283a
            );

        border: 1px solid var(--dash-border);
        color: var(--viz-text-primary);

        font-family:
            system-ui,
            -apple-system,
            "Segoe UI",
            sans-serif;

        overflow: hidden;
    }

    .dashboard-page .viz-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 26px;
        right: 26px;
        height: 2px;
        background: linear-gradient(
            90deg,
            transparent,
            rgba(32, 213, 196, 0.65),
            transparent
        );
        pointer-events: none;
    }

    .dashboard-page .viz-card h3 {
        color: white;
        font-size: 18px;
        font-weight: 800;
        margin-bottom: 6px;
    }

    .dashboard-page .viz-subtitle {
        color: var(--viz-text-secondary);
        font-size: 12px;
        line-height: 1.6;
    }

    .dashboard-page .viz-hero {
        color: white;
        font-size: clamp(23px, 2vw, 29px);
        font-weight: 800;
        line-height: 1.2;
        font-variant-numeric: tabular-nums;
    }

    .dashboard-page .viz-empty {
        color: var(--viz-text-secondary);
        text-align: center;
        padding: 60px 10px;
    }

    .dashboard-page .viz-empty i {
        color: var(--dash-primary);
    }

    /* CATEGORY LEGEND */

    .dashboard-page .viz-legend {
        list-style: none;
        padding: 0;
        margin: 0;
        font-size: 13px;
    }

    .dashboard-page .viz-legend li {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 7px 0;
    }

    .dashboard-page .viz-legend .swatch {
        width: 12px;
        height: 12px;
        border-radius: 3px;
        flex-shrink: 0;
    }

    .dashboard-page .viz-legend .name {
        flex-grow: 1;
        color: var(--viz-text-primary);
    }

    .dashboard-page .viz-legend .value {
        color: var(--viz-text-secondary);
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    /* ACCESSIBLE CHART TABLES */

    .dashboard-page .viz-table-toggle {
        margin-top: 20px;
    }

    .dashboard-page .viz-table-toggle summary {
        color: var(--dash-primary);
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        padding: 8px 0;
    }

    .dashboard-page .viz-table {
        width: 100%;
        font-size: 12px;
        color: var(--viz-text-primary);
        margin-top: 10px;
        border-collapse: collapse;
    }

    .dashboard-page .viz-table th,
    .dashboard-page .viz-table td {
        padding: 10px 8px;
        border-bottom: 1px solid var(--viz-grid);
    }

    .dashboard-page .viz-table th {
        color: var(--dash-primary);
        font-weight: 700;
    }

    .dashboard-page .viz-table td.num,
    .dashboard-page .viz-table th.num {
        text-align: right;
        font-variant-numeric: tabular-nums;
    }

    /* DOUGHNUT CHART */

    .dashboard-page .doughnut-wrap {
        position: relative;
        max-width: 230px;
        margin: 0 auto;
    }

    .dashboard-page .doughnut-center {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        pointer-events: none;
        text-align: center;
    }

    .dashboard-page .doughnut-center .fw-bold {
        color: white;
        font-size: 17px;
        font-weight: 800;
    }

    /* RESPONSIVE LAYOUT */

    @@media (max-width: 768px) {

        .dashboard-intro {
            padding: 26px 24px;
        }

        .dashboard-page .viz-card {
            padding: 22px;
        }

        .dashboard-analytics-header {
            align-items: flex-start;
        }

        .dashboard-period-filter {
            width: 100%;
            justify-content: space-between;
        }
    }

    @@media (max-width: 576px) {

        .dashboard-intro {
            padding: 25px 22px;
        }

        .dashboard-action {
            min-height: 125px;
            padding: 19px;
        }

        .dashboard-title {
            font-size: 27px;
        }

        .dashboard-page .viz-card {
            padding: 19px;
        }

        .dashboard-page .viz-hero {
            font-size: 22px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {

        .dashboard-action,
        .dashboard-search .input-group {
            transition: none;
        }
    }
</style>

<div class="dashboard-page">

    <!-- DASHBOARD INTRODUCTION -->

    <section class="dashboard-intro">

        <div class="dashboard-eyebrow">
            EXCLUSIVE DISTRIBUTORS / BUSINESS OVERVIEW
        </div>

        <h1 class="dashboard-title">
            @greeting, <span>@displayName</span>
        </h1>

        <p class="dashboard-description">
            Here's what's happening across your business today.
            Access your daily operations and performance insights below.
        </p>

    </section>


    <!-- GLOBAL SEARCH -->

    <form asp-controller="Search"
          asp-action="Index"
          method="get"
          class="dashboard-search"
          role="search">

        <div class="input-group">

            <span class="input-group-text">
                <i class="bi bi-search" aria-hidden="true"></i>
            </span>

            <input type="search"
                   name="q"
                   class="form-control"
                   placeholder="Search customers, products, invoices..."
                   aria-label="Search"
                   required />

        </div>

    </form>


    <!-- ==========================================================
     QUICK ACTIONS
     Purpose:
     Connect Dashboard shortcuts to the functional business
     modules instead of older Home prototype pages.

     Updated by: Iqra Nazir (2026)

     Reference:
     Microsoft (n.d.) Anchor Tag Helper in ASP.NET Core.
     https://learn.microsoft.com/en-us/aspnet/core/mvc/views/tag-helpers/built-in/anchor-tag-helper
     ========================================================== -->

<section aria-labelledby="quickActionsHeading">

    <div class="dashboard-section-heading">
        <h2 id="quickActionsHeading">Quick Actions</h2>
    </div>

    <div class="row g-3 mb-5">

        <!-- CUSTOMER -->

        <div class="col-6 col-md-4 col-xl-2">

            <a asp-controller="Customers"
               asp-action="AddCustomer"
               class="dashboard-action">

                <i class="bi bi-person-plus" aria-hidden="true"></i>

                <span>New Customer</span>

            </a>

        </div>


        <!-- SUPPLIER: ADMINISTRATOR AND EMPLOYEE -->

        @if (canManageCatalog)
        {
            <div class="col-6 col-md-4 col-xl-2">

                <a asp-controller="Supplier"
                   asp-action="AddSupplier"
                   class="dashboard-action">

                    <i class="bi bi-truck" aria-hidden="true"></i>

                    <span>New Supplier</span>

                </a>

            </div>
        }


        <!-- PRODUCT: ADMINISTRATOR AND EMPLOYEE -->

        @if (canManageCatalog)
        {
            <div class="col-6 col-md-4 col-xl-2">

                <a asp-controller="Inventory"
                   asp-action="AddItem"
                   class="dashboard-action">

                    <i class="bi bi-box-seam" aria-hidden="true"></i>

                    <span>New Product</span>

                </a>

            </div>
        }


        <!-- INVOICE: FUNCTIONAL INVOICE MODULE -->

        <div class="col-6 col-md-4 col-xl-2">

            <a asp-controller="Invoices"
               asp-action="Create"
               class="dashboard-action">

                <i class="bi bi-receipt" aria-hidden="true"></i>

                <span>New Invoice</span>

            </a>

        </div>


        <!-- QUOTE: FUNCTIONAL QUOTATION MODULE -->

        <div class="col-6 col-md-4 col-xl-2">

            <a asp-controller="Quotes"
               asp-action="Create"
               class="dashboard-action">

                <i class="bi bi-file-earmark-text" aria-hidden="true"></i>

                <span>New Quote</span>

            </a>

        </div>


        <!-- REPORTS: ADMINISTRATOR ONLY -->

        @if (canViewReports)
        {
            <div class="col-6 col-md-4 col-xl-2">

                <a asp-controller="Reports"
                   asp-action="Index"
                   class="dashboard-action">

                    <i class="bi bi-bar-chart" aria-hidden="true"></i>

                    <span>View Reports</span>

                </a>

            </div>
        }

    </div>

</section>


    <!-- BUSINESS ANALYTICS -->

    <section class="viz-root"
             aria-labelledby="businessAnalyticsHeading">

        <div class="dashboard-analytics-header">

            <div class="dashboard-section-heading">

                <h2 id="businessAnalyticsHeading">
                    Business Analytics
                </h2>

            </div>


            <!-- PERIOD FILTER -->

            <form method="get"
                  asp-controller="Home"
                  asp-action="Dashboard"
                  class="dashboard-period-filter">

                <label for="dashboardMonths">
                    Period:
                </label>

                <select id="dashboardMonths"
                        name="months"
                        class="form-select"
                        onchange="this.form.submit()">

                    @foreach (var option in new[] { 6, 12, 24 })
                    {
                        <option value="@option"
                                selected="@(Model.Months == option)">
                            Last @option months
                        </option>
                    }

                </select>

                <noscript>
                    <button type="submit"
                            class="btn btn-sm btn-outline-info">
                        Apply
                    </button>
                </noscript>

            </form>

        </div>


        <div class="row g-4">

            <!-- INCOME BY MONTH -->

            <div class="col-12 col-lg-7">

                <div class="viz-card">

                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">

                        <div>

                            <h3>Income by Month</h3>

                            <div class="viz-subtitle">
                                Value invoiced per month (incl. VAT),
                                last @Model.Months months
                            </div>

                        </div>


                        <div class="text-lg-end">

                            <div class="viz-hero">
                                @Money(Model.ThisMonthIncome)
                            </div>

                            <div class="viz-subtitle">

                                This month

                                @if (Model.MonthOnMonthChange is decimal change)
                                {
                                    <span class="ms-1">

                                        <i class="bi @(change >= 0 ? "bi-arrow-up-right" : "bi-arrow-down-right")"
                                           aria-hidden="true"></i>

                                        @(change >= 0 ? "+" : "")@change.ToString("0.0")%
                                        vs last month

                                    </span>
                                }

                            </div>

                        </div>

                    </div>


                    @if (Model.TotalIncome == 0)
                    {
                        <div class="viz-empty">

                            <i class="bi bi-graph-up fs-2 d-block mb-2"
                               aria-hidden="true"></i>

                            No invoices in the last @Model.Months months yet.

                        </div>
                    }
                    else
                    {
                        <div style="position: relative; height: 260px;">

                            <canvas id="incomeChart"
                                    role="img"
                                    aria-label="Line chart of income per month for the last @Model.Months months. Total @Money(Model.TotalIncome).">
                            </canvas>

                        </div>


                        <!-- ACCESSIBLE INCOME TABLE -->

                        <details class="viz-table-toggle">

                            <summary>View as table</summary>

                            <div class="table-responsive">

                                <table class="viz-table">

                                    <thead>
                                        <tr>
                                            <th>Month</th>
                                            <th class="num">Income</th>
                                            <th class="num">Change</th>
                                        </tr>
                                    </thead>

                                    <tbody>

                                        @for (var i = 0; i < Model.IncomeByMonth.Count; i++)
                                        {
                                            var month = Model.IncomeByMonth[i];

                                            var previous = i > 0
                                                ? Model.IncomeByMonth[i - 1].Income
                                                : 0;

                                            <tr>

                                                <td>@month.Label</td>

                                                <td class="num">
                                                    @Money(month.Income)
                                                </td>

                                                <td class="num">

                                                    @(i == 0 || previous == 0
                                                        ? "—"
                                                        : ((month.Income - previous) / previous * 100m)
                                                            .ToString("+0.0;-0.0;0.0") + "%")

                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                    <tfoot>

                                        <tr class="fw-bold">

                                            <td>Total</td>

                                            <td class="num">
                                                @Money(Model.TotalIncome)
                                            </td>

                                            <td></td>

                                        </tr>

                                    </tfoot>

                                </table>

                            </div>

                        </details>
                    }

                </div>

            </div>


            <!-- SALES PER CATEGORY -->

            <div class="col-12 col-lg-5">

                <div class="viz-card">

                    <h3>Sales per Category</h3>

                    <div class="viz-subtitle mb-4">

                        Share of sales by product category,
                        last @Model.Months months

                    </div>


                    @if (!Model.SalesByCategory.Any())
                    {
                        <div class="viz-empty">

                            <i class="bi bi-pie-chart fs-2 d-block mb-2"
                               aria-hidden="true"></i>

                            No product sales in the last @Model.Months months yet.

                        </div>
                    }
                    else
                    {
                        <div class="row g-3 align-items-center">

                            <div class="col-12 col-sm-6 col-lg-12 col-xl-6">

                                <div class="doughnut-wrap">

                                    <canvas id="categoryChart"
                                            role="img"
                                            aria-label="Doughnut chart of sales per product category. Total @Money(Model.TotalCategorySales).">
                                    </canvas>


                                    <div class="doughnut-center">

                                        <div class="viz-subtitle">
                                            Total Sales
                                        </div>

                                        <div class="fw-bold">
                                            @Money(Model.TotalCategorySales)
                                        </div>

                                    </div>

                                </div>

                            </div>


                            <!-- CHART LEGEND -->

                            <div class="col-12 col-sm-6 col-lg-12 col-xl-6">

                                <ul id="categoryLegend"
                                    class="viz-legend"
                                    aria-label="Sales category legend">
                                </ul>

                            </div>

                        </div>


                        <!-- ACCESSIBLE CATEGORY TABLE -->

                        <details class="viz-table-toggle">

                            <summary>View as table</summary>

                            <div class="table-responsive">

                                <table class="viz-table">

                                    <thead>

                                        <tr>
                                            <th>Category</th>
                                            <th class="num">Sales</th>
                                            <th class="num">Share</th>
                                        </tr>

                                    </thead>

                                    <tbody>

                                        @foreach (var category in Model.SalesByCategory)
                                        {
                                            <tr>

                                                <td>@category.Category</td>

                                                <td class="num">
                                                    @Money(category.Sales)
                                                </td>

                                                <td class="num">

                                                    @(Model.TotalCategorySales == 0
                                                        ? "0.0"
                                                        : (category.Sales / Model.TotalCategorySales * 100m)
                                                            .ToString("0.0"))%

                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>

                        </details>
                    }

                </div>

            </div>

        </div>

    </section>

</div>


@section Scripts {

    @*
        Chart.js is used to render the dashboard visualisations.

        Reference:
        Chart.js (n.d.) Chart.js documentation.
        Available at: https://www.chartjs.org/docs/latest/

        The existing JavaScript file is retained to preserve
        chart rendering and category legend functionality.
    *@

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>


    <!-- INCOME DATA FROM DASHBOARD SERVICE -->

    <script type="application/json" id="incomeData">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.IncomeByMonth.Select(m => new
            {
                label = m.Label,
                value = m.Income
            })
        ))
    </script>


    <!-- CATEGORY DATA FROM DASHBOARD SERVICE -->

    <script type="application/json" id="categoryData">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.SalesByCategory.Select(c => new
            {
                label = c.Category,
                value = c.Sales
            })
        ))
    </script>


    <!-- EXISTING DASHBOARD CHART LOGIC -->

    <script src="~/js/dashboard-charts.js"
            asp-append-version="true"></script>
}