@{
    ViewData["Title"] = "Notifications";
}

<div class="content-card">
    <div class="d-flex align-items-center gap-3 mb-4 border-bottom pb-3">
        <i class="bi bi-bell-fill fs-2" style="color: #357383;"></i>
        <h2 class="fw-bold m-0" style="color: #1c323d;">Notifications</h2>
    </div>

    <div class="d-flex flex-column align-items-center justify-content-center text-center p-4 p-sm-5 rounded border bg-light shadow-sm" style="min-height: 250px;">
        <div class="rounded-circle bg-white p-3 mb-3 border shadow-sm">
            <i class="bi bi-chat-left-dots fs-3" style="color: #357383;"></i>
        </div>
        <h5 class="fw-bold text-dark mb-1">All Caught Up!</h5>
        <p class="text-muted small mb-0" style="max-width: 320px;">No recent notifications found. Complete data hooks to populate live event streams here later.</p>
    </div>

    <div class="d-flex justify-content-end gap-3 mt-4 border-top pt-3">
        <a asp-action="Dashboard" class="btn btn-outline-secondary px-4 w-100 w-sm-auto text-center">Back to Dashboard</a>
    </div>
</div>