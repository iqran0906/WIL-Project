@{
    ViewData["Title"] = "Welcome | Exclusive Distributors";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"]</title>

    <!--
        EXCLUSIVE DISTRIBUTORS — FUTURISTIC WELCOME PAGE

        Purpose:
        Public-facing landing page for the FMCG Enterprise
        Management System and WIL EXPO demonstration.

        Design inspiration:
        TDMC (n.d.) TDMC. Available at: https://tdmc.co.za/

        Technical references (Harvard Anglia):

        Bootstrap (n.d.) Introduction. Bootstrap Documentation.
        Available at: https://getbootstrap.com/docs/5.3/getting-started/introduction/

        Bootstrap (n.d.) Bootstrap Icons. Available at:
        https://icons.getbootstrap.com/

        Mozilla (n.d.) CSS animations. MDN Web Docs.
        Available at:
        https://developer.mozilla.org/en-US/docs/Web/CSS/CSS_animations

        Mozilla (n.d.) Intersection Observer API. MDN Web Docs.
        Available at:
        https://developer.mozilla.org/en-US/docs/Web/API/Intersection_Observer_API

        Mozilla (n.d.) prefers-reduced-motion. MDN Web Docs.
        Available at:
        https://developer.mozilla.org/en-US/docs/Web/CSS/@@media/prefers-reduced-motion

        Microsoft (n.d.) Tag Helpers in forms in ASP.NET Core.
        Microsoft Learn. Available at:
        https://learn.microsoft.com/en-us/aspnet/core/mvc/views/working-with-forms

        Implementation:
        Original implementation adapted for the Exclusive
        Distributors WIL project. The design uses general
        visual inspiration rather than copying TDMC assets.

        All dashboard figures displayed below are illustrative.
    -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
            :root {
                --navy: #081527;
                --navy-light: #10253d;
                --navy-mid: #122e46;
                --teal: #20d5c4;
                --teal-dark: #0eaaa2;
                --white: #ffffff;
                --muted: #a6bacb;
                --glass: rgba(17, 42, 63, .68);
            }

            * {
                box-sizing: border-box;
            }

            html {
                scroll-behavior: smooth;
            }

            body {
                margin: 0;
                font-family: 'Segoe UI', Arial, sans-serif;
                background: var(--navy);
                color: var(--white);
                overflow-x: hidden;
            }

            a {
                text-decoration: none;
            }

            /* =========================
                       NAVIGATION
                    ========================= */

            .welcome-navbar {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                z-index: 20;
                padding: 28px 6%;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .brand {
                color: white;
                font-size: 19px;
                font-weight: 800;
                letter-spacing: 1px;
                white-space: nowrap;
            }

                .brand span {
                    color: var(--teal);
                }

            .nav-login {
                color: white;
                border: 1px solid rgba(255,255,255,.25);
                padding: 12px 25px;
                border-radius: 40px;
                font-weight: 600;
                transition: .3s ease;
                background: rgba(255,255,255,.04);
                backdrop-filter: blur(12px);
            }

                .nav-login:hover {
                    color: var(--navy);
                    background: var(--teal);
                    border-color: var(--teal);
                    box-shadow: 0 0 25px rgba(32,213,196,.35);
                }

            /* =========================
                       FUTURISTIC HERO
                    ========================= */

            .hero {
                position: relative;
                min-height: 100vh;
                display: flex;
                align-items: center;
                overflow: hidden;
                padding: 155px 6% 110px;
                isolation: isolate;
                background: radial-gradient( circle at 75% 40%, rgba(15,157,162,.20), transparent 42% ), linear-gradient( 125deg, #081527 0%, #10243b 58%, #0a2034 100% );
            }

            /* Animated technology grid */

            .hero-grid {
                position: absolute;
                inset: 0;
                z-index: -2;
                opacity: .25;
                background-image: linear-gradient( rgba(32,213,196,.12) 1px, transparent 1px ), linear-gradient( 90deg, rgba(32,213,196,.12) 1px, transparent 1px );
                background-size: 65px 65px;
                mask-image: linear-gradient( to right, transparent, black 45%, black );
                animation: gridDrift 24s linear infinite;
            }

            .hero-glow {
                position: absolute;
                width: 550px;
                height: 550px;
                right: 2%;
                top: 17%;
                border-radius: 50%;
                background: rgba(22,196,190,.17);
                filter: blur(110px);
                z-index: -1;
                animation: glowPulse 7s ease-in-out infinite alternate;
            }

            .hero::after {
                content: "";
                position: absolute;
                width: 750px;
                height: 750px;
                right: -250px;
                top: 5%;
                border: 1px solid rgba(32,213,196,.12);
                border-radius: 50%;
                pointer-events: none;
            }

            .hero-layout {
                width: 100%;
                max-width: 1550px;
                margin: 0 auto;
                display: grid;
                grid-template-columns: 1.05fr .95fr;
                align-items: center;
                gap: 65px;
            }

            .hero-content {
                position: relative;
                z-index: 2;
                animation: fadeUp 1s ease both;
            }

            .eyebrow {
                display: inline-flex;
                align-items: center;
                gap: 12px;
                color: var(--teal);
                font-size: 12px;
                font-weight: 800;
                letter-spacing: 2.5px;
                text-transform: uppercase;
                margin-bottom: 28px;
            }

                .eyebrow::before {
                    content: "";
                    width: 28px;
                    height: 2px;
                    background: var(--teal);
                    box-shadow: 0 0 12px var(--teal);
                }

            .hero h1 {
                font-size: clamp(46px, 5vw, 79px);
                line-height: 1.08;
                letter-spacing: -2.8px;
                font-weight: 800;
                margin-bottom: 28px;
            }

                .hero h1 span {
                    color: var(--teal);
                    text-shadow: 0 0 50px rgba(32,213,196,.14);
                }

            .hero-description {
                color: var(--muted);
                font-size: 18px;
                line-height: 1.9;
                max-width: 620px;
                margin-bottom: 38px;
            }

            .hero-actions {
                display: flex;
                align-items: center;
                flex-wrap: wrap;
                gap: 20px;
            }

            .primary-button {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 15px;
                padding: 17px 30px;
                color: #071d2b;
                font-weight: 800;
                border-radius: 40px;
                background: linear-gradient( 110deg, #20d5c4, #46e4d1 );
                box-shadow: 0 0 30px rgba(32,213,196,.20);
                transition: transform .3s ease, box-shadow .3s ease;
            }

                .primary-button:hover {
                    color: #071d2b;
                    transform: translateY(-4px);
                    box-shadow: 0 0 40px rgba(32,213,196,.45);
                }

            .secondary-button {
                color: #d2e7ed;
                font-weight: 600;
                display: inline-flex;
                align-items: center;
                gap: 10px;
                transition: color .3s ease;
            }

                .secondary-button:hover {
                    color: var(--teal);
                }

            .hero-trust {
                display: flex;
                flex-wrap: wrap;
                gap: 22px;
                margin-top: 48px;
                color: #92adbf;
                font-size: 13px;
            }

                .hero-trust span {
                    display: flex;
                    align-items: center;
                    gap: 8px;
                }

                .hero-trust i {
                    color: var(--teal);
                }

            /* =========================
                       FLOATING DASHBOARD PREVIEW
                    ========================= */

            .dashboard-scene {
                position: relative;
                perspective: 1200px;
                min-width: 0;
            }

            .dashboard-preview {
                position: relative;
                border: 1px solid rgba(79,221,213,.27);
                border-radius: 24px;
                padding: 23px;
                background: rgba(10,28,45,.78);
                backdrop-filter: blur(20px);
                box-shadow: 0 35px 85px rgba(0,0,0,.40), 0 0 55px rgba(32,213,196,.08);
                transform: rotateY(-8deg) rotateX(4deg);
                animation: dashboardFloat 6s ease-in-out infinite;
            }

            .preview-topbar {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                padding-bottom: 18px;
                margin-bottom: 22px;
                border-bottom: 1px solid rgba(255,255,255,.08);
            }

            .preview-title {
                font-size: 15px;
                font-weight: 800;
                letter-spacing: .3px;
            }

            .preview-subtitle {
                color: #7f9aaa;
                font-size: 11px;
                margin-top: 4px;
            }

            .preview-status {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                color: #85e8d9;
                font-size: 10px;
                border: 1px solid rgba(32,213,196,.22);
                border-radius: 20px;
                padding: 7px 10px;
                white-space: nowrap;
            }

            .status-dot {
                width: 6px;
                height: 6px;
                background: var(--teal);
                border-radius: 50%;
                box-shadow: 0 0 10px var(--teal);
            }

            .preview-metrics {
                display: grid;
                grid-template-columns: repeat(3, minmax(0, 1fr));
                gap: 12px;
                margin-bottom: 18px;
            }

            .preview-metric {
                background: rgba(255,255,255,.045);
                border: 1px solid rgba(255,255,255,.07);
                border-radius: 13px;
                padding: 15px 12px;
                min-width: 0;
            }

            .metric-label {
                font-size: 10px;
                color: #91a9ba;
                margin-bottom: 9px;
            }

            .metric-value {
                font-size: clamp(15px, 1.6vw, 23px);
                font-weight: 800;
                color: white;
            }

            .metric-trend {
                font-size: 10px;
                color: var(--teal);
                margin-top: 6px;
            }

            .preview-chart {
                padding: 18px;
                border-radius: 15px;
                border: 1px solid rgba(255,255,255,.07);
                background: rgba(255,255,255,.035);
            }

            .chart-heading {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 10px;
                margin-bottom: 18px;
            }

                .chart-heading h3 {
                    font-size: 13px;
                    font-weight: 700;
                    margin: 0;
                }

                .chart-heading span {
                    color: #8ca7b7;
                    font-size: 10px;
                }

            .chart-bars {
                height: 135px;
                display: flex;
                align-items: flex-end;
                justify-content: space-between;
                gap: 9px;
                padding-bottom: 2px;
                border-bottom: 1px solid rgba(255,255,255,.10);
            }

            .chart-bar {
                flex: 1;
                max-width: 35px;
                border-radius: 5px 5px 0 0;
                background: linear-gradient( to top, rgba(17,154,154,.42), #27dacb );
                box-shadow: 0 0 12px rgba(32,213,196,.12);
                animation: barGrow 1.3s ease both;
                transform-origin: bottom;
            }

                .chart-bar:nth-child(2) {
                    animation-delay: .1s;
                }

                .chart-bar:nth-child(3) {
                    animation-delay: .2s;
                }

                .chart-bar:nth-child(4) {
                    animation-delay: .3s;
                }

                .chart-bar:nth-child(5) {
                    animation-delay: .4s;
                }

                .chart-bar:nth-child(6) {
                    animation-delay: .5s;
                }

                .chart-bar:nth-child(7) {
                    animation-delay: .6s;
                }

            .chart-labels {
                display: flex;
                justify-content: space-between;
                margin-top: 10px;
                color: #7e99ab;
                font-size: 9px;
            }

            .preview-bottom {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 12px;
                margin-top: 15px;
            }

            .preview-mini {
                border: 1px solid rgba(255,255,255,.07);
                background: rgba(255,255,255,.035);
                border-radius: 12px;
                padding: 14px;
            }

            .preview-mini-label {
                font-size: 10px;
                color: #9ab2c0;
                margin-bottom: 7px;
            }

            .preview-mini-value {
                font-size: 17px;
                font-weight: 800;
            }

                .preview-mini-value.teal {
                    color: var(--teal);
                }

            .preview-note {
                text-align: center;
                margin-top: 13px;
                color: #8ba5b5;
                font-size: 11px;
            }

            /* Floating decorative badges */

            .floating-badge {
                position: absolute;
                display: flex;
                align-items: center;
                gap: 9px;
                background: rgba(17,47,65,.95);
                border: 1px solid rgba(32,213,196,.35);
                color: #e2f7f5;
                border-radius: 12px;
                padding: 12px 16px;
                font-size: 12px;
                font-weight: 600;
                box-shadow: 0 15px 35px rgba(0,0,0,.25);
                z-index: 2;
                animation: badgeFloat 5s ease-in-out infinite;
            }

                .floating-badge i {
                    color: var(--teal);
                    font-size: 18px;
                }

            .badge-inventory {
                top: -22px;
                right: -20px;
            }

            .badge-analytics {
                bottom: 20px;
                left: -30px;
                animation-delay: 1.5s;
            }

            /* =========================
                       FEATURE SECTION
                    ========================= */

            .features-section {
                position: relative;
                background: radial-gradient( circle at 50% 0%, rgba(32,213,196,.06), transparent 40% ), #f4f8fb;
                color: #10223a;
                padding: 110px 6% 120px;
            }

            .features-container {
                max-width: 1450px;
                margin: 0 auto;
            }

            .section-eyebrow {
                color: #0a9994;
                font-size: 12px;
                letter-spacing: 2.5px;
                font-weight: 800;
                margin-bottom: 15px;
            }

            .section-heading {
                font-size: clamp(33px, 4vw, 52px);
                font-weight: 800;
                letter-spacing: -1.5px;
                margin-bottom: 18px;
            }

            .section-description {
                color: #65798e;
                max-width: 700px;
                line-height: 1.8;
                font-size: 17px;
                margin-bottom: 55px;
            }

            .feature-card {
                height: 100%;
                position: relative;
                overflow: hidden;
                background: rgba(255,255,255,.90);
                border: 1px solid #dce8ed;
                border-radius: 22px;
                padding: 40px 35px;
                transition: transform .35s ease, box-shadow .35s ease, border-color .35s ease;
            }

                .feature-card::before {
                    content: "";
                    position: absolute;
                    inset: 0;
                    border-radius: inherit;
                    background: linear-gradient( 135deg, rgba(32,213,196,.09), transparent 55% );
                    opacity: 0;
                    transition: opacity .35s ease;
                    pointer-events: none;
                }

                .feature-card:hover {
                    transform: translateY(-10px);
                    border-color: rgba(16,176,166,.50);
                    box-shadow: 0 25px 55px rgba(16,30,53,.11), 0 0 25px rgba(32,213,196,.10);
                }

                    .feature-card:hover::before {
                        opacity: 1;
                    }

            .feature-icon {
                position: relative;
                width: 68px;
                height: 68px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 18px;
                background: rgba(32,213,196,.12);
                color: #0b9e98;
                font-size: 29px;
                margin-bottom: 30px;
                transition: transform .3s ease;
            }

            .feature-card:hover .feature-icon {
                transform: scale(1.08) rotate(-4deg);
            }

            .feature-card h3 {
                position: relative;
                font-size: 22px;
                font-weight: 800;
                margin-bottom: 17px;
            }

            .feature-card p {
                position: relative;
                color: #667b8d;
                line-height: 1.85;
                margin: 0;
            }

            .feature-number {
                position: absolute;
                right: 30px;
                top: 32px;
                color: #dce9ed;
                font-size: 30px;
                font-weight: 800;
            }

            /* =========================
                       FINAL CALL TO ACTION
                    ========================= */

            .cta-section {
                position: relative;
                padding: 85px 6%;
                text-align: center;
                background: linear-gradient( 125deg, #0b1d31, #103b49 );
                border-top: 1px solid rgba(32,213,196,.14);
            }

                .cta-section h2 {
                    font-size: clamp(30px, 3.5vw, 44px);
                    font-weight: 800;
                    margin-bottom: 17px;
                }

                .cta-section p {
                    color: #a9c2cf;
                    font-size: 17px;
                    margin-bottom: 30px;
                }

            .welcome-footer {
                background: #071321;
                color: #8fa5b8;
                padding: 28px 6%;
                text-align: center;
                font-size: 13px;
            }

            /* =========================
                       SCROLL ANIMATIONS
                    ========================= */

            .reveal {
                opacity: 0;
                transform: translateY(30px);
                transition: opacity .7s ease, transform .7s ease;
            }

                .reveal.visible {
                    opacity: 1;
                    transform: translateY(0);
                }

            @@keyframes fadeUp {
                from {
                    opacity: 0;
                    transform: translateY(30px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@keyframes dashboardFloat {
                0%, 100% {
                    transform: translateY(0) rotateY(-8deg) rotateX(4deg);
                }

                50% {
                    transform: translateY(-13px) rotateY(-6deg) rotateX(3deg);
                }
            }

            @@keyframes badgeFloat {
                0%, 100% {
                    transform: translateY(0);
                }

                50% {
                    transform: translateY(-10px);
                }
            }

            @@keyframes glowPulse {
                from {
                    opacity: .55;
                    transform: scale(.95);
                }

                to {
                    opacity: 1;
                    transform: scale(1.08);
                }
            }

            @@keyframes gridDrift {
                from {
                    background-position: 0 0;
                }

                to {
                    background-position: 65px 65px;
                }
            }

            @@keyframes barGrow {
                from {
                    transform: scaleY(.1);
                    opacity: .2;
                }

                to {
                    transform: scaleY(1);
                    opacity: 1;
                }
            }

            /* =========================
                       RESPONSIVE DESIGN
                    ========================= */

            @@media (max-width: 1100px) {
                .hero-layout {
                    grid-template-columns: 1fr;
                    gap: 75px;
                }

                .hero-content {
                    max-width: 800px;
                }

                .dashboard-scene {
                    max-width: 720px;
                    margin: 0 auto;
                    width: 100%;
                }

                .hero {
                    padding-bottom: 130px;
                }
            }

            @@media (max-width: 768px) {
                .welcome-navbar {
                    padding: 24px 5%;
                }

                .brand {
                    font-size: 14px;
                    letter-spacing: .3px;
                }

                .nav-login {
                    padding: 10px 15px;
                    font-size: 12px;
                }

                .hero {
                    padding: 155px 6% 85px;
                }

                    .hero h1 {
                        font-size: clamp(42px, 10vw, 62px);
                        letter-spacing: -1.5px;
                    }

                .hero-description {
                    font-size: 16px;
                }

                .dashboard-preview {
                    transform: none;
                    animation: none;
                    padding: 15px;
                }

                .floating-badge {
                    display: none;
                }

                .features-section {
                    padding: 80px 6%;
                }

                .feature-card {
                    padding: 32px;
                }

                .hero-trust {
                    gap: 15px;
                }
            }

            @@media (max-width: 420px) {
                .brand {
                    font-size: 12px;
                }

                .nav-login {
                    padding: 9px 12px;
                }

                .hero h1 {
                    font-size: 39px;
                }

                .preview-metrics {
                    gap: 6px;
                }

                .preview-metric {
                    padding: 11px 8px;
                }

                .metric-value {
                    font-size: 15px;
                }
            }

            @@media (prefers-reduced-motion: reduce) {
                html {
                    scroll-behavior: auto;
                }

                *,
                *::before,
                *::after {
                    animation: none !important;
                    transition: none !important;
                }

                .reveal {
                    opacity: 1;
                    transform: none;
                }

                .dashboard-preview {
                    transform: none;
                }
            }
    </style>
</head>

<body>

    <!-- NAVIGATION -->
    <nav class="welcome-navbar" aria-label="Welcome navigation">

        <a class="brand"
           asp-controller="Home"
           asp-action="Welcome">
            EXCLUSIVE<span>DISTRIBUTORS</span>
        </a>

        <a class="nav-login"
           asp-controller="Account"
           asp-action="Login">
            Sign In <i class="bi bi-arrow-up-right"></i>
        </a>

    </nav>

    <main>

        <!-- HERO SECTION -->
        <section class="hero">

            <div class="hero-grid" aria-hidden="true"></div>
            <div class="hero-glow" aria-hidden="true"></div>

            <div class="hero-layout">

                <div class="hero-content">

                    <div class="eyebrow">
                        FMCG ENTERPRISE MANAGEMENT SYSTEM
                    </div>

                    <h1>
                        Smarter Distribution.<br />
                        <span>Seamless Management.</span>
                    </h1>

                    <p class="hero-description">
                        A connected enterprise platform bringing
                        inventory, customers, suppliers, quotations,
                        invoicing, payments and business intelligence
                        together in one streamlined experience.
                    </p>

                    <div class="hero-actions">

                        <a class="primary-button"
                           asp-controller="Account"
                           asp-action="Login">
                            Access Management System
                            <i class="bi bi-arrow-right"></i>
                        </a>

                        <a class="secondary-button" href="#features">
                            Explore Features
                            <i class="bi bi-arrow-down"></i>
                        </a>

                    </div>

                    <div class="hero-trust">
                        <span>
                            <i class="bi bi-shield-check"></i>
                            Role-Based Access
                        </span>

                        <span>
                            <i class="bi bi-boxes"></i>
                            Integrated Inventory
                        </span>

                        <span>
                            <i class="bi bi-graph-up-arrow"></i>
                            Business Insights
                        </span>
                    </div>

                </div>

                <!-- ILLUSTRATIVE DASHBOARD PREVIEW -->
                <div class="dashboard-scene"
                     aria-label="Illustrative preview of the management dashboard">

                    <div class="floating-badge badge-inventory"
                         aria-hidden="true">
                        <i class="bi bi-box-seam"></i>
                        Inventory Monitoring
                    </div>

                    <div class="dashboard-preview">

                        <div class="preview-topbar">

                            <div>
                                <div class="preview-title">
                                    Business Overview
                                </div>

                                <div class="preview-subtitle">
                                    Enterprise Dashboard Preview
                                </div>
                            </div>

                            <div class="preview-status">
                                <span class="status-dot"></span>
                                DEMO VIEW
                            </div>

                        </div>

                        <div class="preview-metrics">

                            <div class="preview-metric">
                                <div class="metric-label">
                                    Sales
                                </div>

                                <div class="metric-value">
                                    R 128K
                                </div>

                                <div class="metric-trend">
                                    <i class="bi bi-arrow-up-right"></i>
                                    Example
                                </div>
                            </div>

                            <div class="preview-metric">
                                <div class="metric-label">
                                    Active Products
