@{
    ViewData["Title"] = "Suppliers";
}

<div class="px-2 py-3">
    <h2 class="text-white fw-bold mb-3">Suppliers</h2>

    <div class="mb-4">
        <a asp-controller="Home" asp-action="AddSupplier" class="btn btn-action-primary text-decoration-none">
            New Supplier
        </a>
    </div>

    <form asp-controller="Suppliers" asp-action="Index" method="get" class="mb-4">
        <div class="d-flex align-items-center gap-2">
            <span class="text-white fw-bold">Keyword:</span>
            <div class="position-relative">
                <input type="text"
                       name="keyword"
                       value="@ViewBag.Keyword"
                       class="form-control form-control-sm search-field"
                       placeholder="Supplier Code, Name, Area, etc">
                <i class="bi bi-search position-absolute end-0 top-50 translate-middle-y me-2 text-white-50 small"></i>
            </div>
            <button type="submit" class="btn btn-sm btn-light">Search</button>
            <a asp-controller="Suppliers" asp-action="Index" class="btn btn-sm btn-outline-light">Clear</a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="custom-data-table">
            <thead>
                <tr>
                    <th>Supplier Code</th>
                    <th>Name</th>
                    <th>Contact Person</th>
                    <th>Contact Number</th>
                    <th>Email</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var supplier in Model)
                    {
                        <tr>
                            <td>@supplier.SupplierCode</td>
                            <td>@supplier.Name</td>
                            <td>@supplier.ContactPerson</td>
                            <td>@supplier.ContactNumber</td>
                            <td>@supplier.Email</td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-controller="Suppliers" asp-action="Details" asp-route-id="@supplier.SupplierId" class="btn btn-sm btn-outline-secondary">View</a>
                                    <form asp-controller="Suppliers" asp-action="Delete" asp-route-id="@supplier.SupplierId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this supplier?');">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-white-50">No suppliers found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>