@model FMCGEnterpriseManagementSystem.Models.UserProfileViewModel

@{
    ViewData["Title"] = "User Profile";
}

<div class="container py-4">
    <div class="card shadow-sm border-0 mx-auto" style="max-width: 650px; background-color: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);">
        <div class="card-header bg-transparent border-bottom border-secondary text-white py-3">
            <h4 class="mb-0 fw-bold"><i class="bi bi-person-circle me-2"></i>User Profile</h4>
            <small class="text-white-50">View and update your personal account details</small>
        </div>

        <div class="card-body p-4 text-white">
            @if (TempData["ProfileSuccess"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["ProfileSuccess"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-controller="Home" asp-action="UserProfile" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label text-white-50 small fw-bold"></label>
                    <input asp-for="FullName" class="form-control bg-dark text-white border-secondary" placeholder="Enter full name" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label text-white-50 small fw-bold"></label>
                    <input asp-for="Email" class="form-control bg-dark text-white border-secondary" placeholder="name@company.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PhoneNumber" class="form-label text-white-50 small fw-bold"></label>
                    <input asp-for="PhoneNumber" class="form-control bg-dark text-white border-secondary" placeholder="+27 82 123 4567" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Role" class="form-label text-white-50 small fw-bold"></label>
                    <input asp-for="Role" class="form-control bg-dark text-white-50 border-secondary" readonly disabled />
                    <small class="text-white-50">Role permissions are managed by the System Administrator.</small>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-2">
                    <a asp-action="Dashboard" class="btn btn-outline-light px-4">Cancel</a>
                    <button type="submit" class="btn text-white px-4" style="background-color: #357383;">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>