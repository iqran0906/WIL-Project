@model FMCGEnterpriseManagementSystem.Models.Customer

@{
    ViewData["Title"] = "New Customer";
}

<div class="content-card">
    <h2 class="fw-bold mb-4" style="color: #1c323d;">New Customer</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-controller="Home" asp-action="AddCustomer" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Name</label>
                    <input asp-for="Name" class="form-control" placeholder="Enter Customer Name" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Surname" class="form-label">Surname</label>
                    <input asp-for="Surname" class="form-control" placeholder="Enter Customer Surname" />
                    <span asp-validation-for="Surname" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="IdNumber" class="form-label">ID Number</label>
                    <input asp-for="IdNumber" class="form-control" placeholder="Enter ID Number" />
                    <span asp-validation-for="IdNumber" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ContactNumber" class="form-label">Contact Number</label>
                    <input asp-for="ContactNumber" class="form-control" placeholder="Enter Contact Number" required />
                    <span asp-validation-for="ContactNumber" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="Enter Email Address" required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="VATNumber" class="form-label">VAT Number</label>
                    <input asp-for="VATNumber" class="form-control" placeholder="Enter VAT Number (Optional)" />
                    <span asp-validation-for="VATNumber" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="PhysicalAddress" class="form-label">Physical Address</label>
                    <textarea asp-for="PhysicalAddress" class="form-control" rows="2" placeholder="Enter Physical Address"></textarea>
                    <span asp-validation-for="PhysicalAddress" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="DeliveryAddress" class="form-label">Delivery Address</label>
                    <textarea asp-for="DeliveryAddress" class="form-control" rows="2" placeholder="Enter Delivery Address"></textarea>
                    <span asp-validation-for="DeliveryAddress" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CustomerGroup" class="form-label">Group</label>
                    <select id="groupSelect" asp-for="CustomerGroup" class="form-select" onchange="toggleCustomGroup(this)">
                        <option selected disabled value="">Select Group</option>
                        <option value="Wholesale">Wholesale</option>
                        <option value="Retail">Retail</option>
                        <option value="Other">Other</option>
                    </select>
                    <span asp-validation-for="CustomerGroup" class="text-danger"></span>

                    <div id="customGroupContainer" class="mt-2 d-none">
                        <label class="form-label small text-muted">New Group Name</label>
                        <input type="text" id="customGroupName" name="CustomGroup" class="form-control" placeholder="Enter new group name" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="PaymentTerms" class="form-label">Payment Terms</label>
                    <select asp-for="PaymentTerms" class="form-select">
                        <option selected disabled value="">Select Payment Terms</option>
                        <option value="COD">COD</option>
                        <option value="7 Days">7 Days</option>
                        <option value="14 Days">14 Days</option>
                        <option value="21 Days">21 Days</option>
                        <option value="30 Days">30 Days</option>
                    </select>
                    <span asp-validation-for="PaymentTerms" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="SalesRep" class="form-label">Sales Rep</label>
                    <select asp-for="SalesRep" class="form-select">
                        <option selected disabled value="">Select Sales Rep</option>
                    </select>
                    <span asp-validation-for="SalesRep" class="text-danger"></span>
                </div>
            </div>

            <div class="col-12">
                <div class="mb-4">
                    <label asp-for="Notes" class="form-label">Notes</label>
                    <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Optional"></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-3 mt-2">
            <a asp-controller="Home" asp-action="CustomerList" class="btn btn-link text-decoration-none text-secondary align-self-center">Cancel</a>
            <button type="submit" class="btn btn-custom-save">Save Customer</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleCustomGroup(selectElement) {
            const container = document.getElementById('customGroupContainer');
            const input = document.getElementById('customGroupName');

            if (selectElement.value === 'Other') {
                container.classList.remove('d-none');
                input.focus();
            } else {
                container.classList.add('d-none');
                input.value = '';
            }
        }
    </script>
}