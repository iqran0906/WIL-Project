@model IEnumerable<FMCGEnterpriseManagementSystem.Models.Customer>

@{
    ViewData["Title"] = "Customers";
    bool isAdminRole = User.IsInRole("Admin");
    bool isTestAdmin = User.Identity?.Name?.Equals("admin.test@example.com", StringComparison.OrdinalIgnoreCase) == true;
    bool canDelete = isAdminRole || isTestAdmin;
}

<div class="px-2 py-3">
    <h2 class="text-white fw-bold mb-3">Customers</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="mb-4">
        <a asp-controller="Home" asp-action="AddCustomer" class="btn btn-action-primary text-decoration-none">
            New Customer
        </a>
    </div>

    <div class="d-flex align-items-center gap-2 mb-4">
        <span class="text-white fw-bold">Keyword:</span>
        <div class="position-relative">
            <input type="text" id="customerSearchInput" class="form-control form-control-sm search-field" placeholder="Customer, Email,etc">
            <i class="bi bi-search position-absolute end-0 top-50 translate-middle-y me-2 text-white-50 small"></i>
        </div>
    </div>

    <div class="table-responsive">
        <table class="custom-data-table" id="customerTable">
            <thead>
                <tr>
                    <th>Contact Person</th>
                    <th>Contact Number</th>
                    <th>Group</th>
                    <th>Terms</th>
                    <th>Due</th>
                    @if (canDelete)
                    {
                        <th>Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var customer in Model)
                    {
                        <tr>
                            <td>@(string.IsNullOrEmpty(customer.Surname) ? customer.Name : $"{customer.Name} {customer.Surname}")</td>
                            <td>@customer.ContactNumber</td>
                            <td>@(string.IsNullOrEmpty(customer.CustomerGroup) ? "-" : customer.CustomerGroup)</td>
                            <td>@(string.IsNullOrEmpty(customer.PaymentTerms) ? "-" : customer.PaymentTerms)</td>
                            <td>R0.00</td>
                            @if (canDelete)
                            {
                                <td>
                                    <form asp-action="DeleteCustomer" asp-route-id="@customer.CustomerId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this customer?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger py-0 px-2" style="font-size: 0.8rem;">Delete</button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr id="noCustomersRow">
                        <td>No customers found.</td>
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                        @if (canDelete)
                        {
                            <td>&nbsp;</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#customerSearchInput").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#customerTable tbody tr").filter(function () {
                    if ($(this).attr('id') === 'noCustomersRow') return;
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });
        });
    </script>
}