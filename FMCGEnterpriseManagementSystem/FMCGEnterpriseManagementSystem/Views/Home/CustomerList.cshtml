@*
    Purpose: Customers list with keyword search and amount due.
    Authors: ST10068525 (from git history)
*@
@model IEnumerable<FMCGEnterpriseManagementSystem.Models.Customer>

@{
    ViewData["Title"] = "Customers";

    var amountDue = ViewBag.AmountDue as Dictionary<int, decimal>
        ?? new Dictionary<int, decimal>();
}

<div class="px-2 py-3">
    <h2 class="text-white fw-bold mb-3">Customers</h2>

    <div class="mb-4">
        <a asp-controller="Home" asp-action="AddCustomer" class="btn btn-action-primary text-decoration-none">
            New Customer
        </a>
    </div>

    <form asp-controller="Home"
          asp-action="CustomerList"
          method="get"
          class="d-flex flex-wrap align-items-center gap-2 mb-4">
        <span class="text-white fw-bold">Keyword:</span>
        <div class="position-relative">
            <input type="text"
                   name="keyword"
                   value="@ViewBag.Keyword"
                   class="form-control form-control-sm search-field"
                   placeholder="Customer, Email,etc">
            <i class="bi bi-search position-absolute end-0 top-50 translate-middle-y me-2 text-white-50 small"></i>
        </div>
        <button type="submit" class="btn btn-sm btn-light">Search</button>
        <a asp-controller="Home" asp-action="CustomerList" class="btn btn-sm btn-outline-light">Clear</a>
    </form>

    <div class="table-responsive">
        <table class="custom-data-table">
            <thead>
                <tr>
                    <th>Customer No.</th>
                    <th>Contact Person</th>
                    <th>Contact Number</th>
                    <th>Group</th>
                    <th>Terms</th>
                    <th>Due</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var customer in Model)
                    {
                        <tr>
                            <td>@customer.CustomerId</td>
                            <td>
                                @customer.Name @customer.Surname
                                @if (!customer.IsActive)
                                {
                                    <span class="badge bg-secondary ms-1">Inactive</span>
                                }
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(customer.CellNumber) ? customer.TelephoneNumber : customer.CellNumber)</td>
                            <td>@customer.CustomerGroup</td>
                            <td>@customer.PaymentTerms</td>
                            <td>R@(amountDue.GetValueOrDefault(customer.CustomerId).ToString("N2"))</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">
                            @(string.IsNullOrWhiteSpace((string?)ViewBag.Keyword)
                                ? "No customers yet."
                                : "No customers match your search.")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
