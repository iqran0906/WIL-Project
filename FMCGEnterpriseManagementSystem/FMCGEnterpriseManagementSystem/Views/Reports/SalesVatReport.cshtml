@*
    Purpose: Sales Vat report page.
    Authors: iqran0906 (from git history)
*@
@model IEnumerable<FMCGEnterpriseManagementSystem.ViewModels.Reports.SalesVatReportViewModel>

@{
    ViewData["Title"] = "Sales VAT Report";
}

<div class="reports-page">
    <div class="reports-page-header">
        <div>
            <h2 class="reports-page-title">Sales VAT Report</h2>
            <p class="reports-page-description">Invoice sales values and recorded VAT amounts.</p>
        </div>
        <partial name="_ReportToolbar" model="@("SalesVatReport")" />
    </div>

    <form method="get" class="row g-3 reports-filter-panel no-print">
        <div class="col-md-4">
            <label class="reports-filter-label">Start Date</label>
            <input type="date" name="startDate"
                   value="@ViewBag.StartDate" class="form-control" />
        </div>

        <div class="col-md-4">
            <label class="reports-filter-label">End Date</label>
            <input type="date" name="endDate"
                   value="@ViewBag.EndDate" class="form-control" />
        </div>

        <div class="col-md-4 d-flex align-items-end gap-2">
            <button type="submit" class="reports-btn-primary">
                <i class="bi bi-funnel"></i>
                Apply Filter
            </button>
            <a asp-action="SalesVatReport" class="reports-btn-outline">Clear</a>
        </div>
    </form>

    @if (ViewBag.DateError != null)
    {
        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-1"></i>@ViewBag.DateError</div>
    }

    <div class="reports-content-card">
        <div>
            @if (!Model.Any())
            {
                <p class="text-muted mb-0">No VAT sales data found.</p>
            }
            else
            {
                <div class="reports-table-container">
                    <table class="reports-table">
                        <thead>
                            <tr>
                                <th>Invoice</th>
                                <th>Date</th>
                                <th>Customer</th>
                                <th>Subtotal</th>
                                <th>VAT</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.InvoiceNumber</td>
                                    <td>@item.InvoiceDate.ToString("dd MMM yyyy")</td>
                                    <td>@item.CustomerName</td>
                                    <td>R @item.Subtotal.ToString("N2")</td>
                                    <td>R @item.VatAmount.ToString("N2")</td>
                                    <td>R @item.Total.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold">
                                <td colspan="3">Totals</td>
                                <div class="container-fluid">
                                <td>R @Model.Sum(x => x.Subtotal).ToString("N2")</td>
                                <td>R @Model.Sum(x => x.VatAmount).ToString("N2")</td>
                                <td>R @Model.Sum(x => x.Total).ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>
</div>