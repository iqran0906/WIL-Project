@*
    Purpose: Customer Sales report page.
    Authors: iqran0906 (from git history)
*@
@model IEnumerable<FMCGEnterpriseManagementSystem.ViewModels.Reports.CustomerSalesReportViewModel>

@{
    ViewData["Title"] = "Customer Sales";
}

<div class="reports-page">
    <div class="reports-page-header">
        <div>
            <h2 class="reports-page-title">Customer Sales</h2>
            <p class"reports-page-description">Sales and outstanding balances by customer.</p>
        </div>

        <partial name="_ReportToolbar" model="@("CustomerSales")" />
    </div>

   <form method="get" class="row g-3 mb-4 no-print">
        <div class="col-md-4">
            <label class="reports-filter-label">Start Date</label>
            <input type="date" name="startDate"
                   value="@ViewBag.StartDate" class="form-control" />
        </div>

        <div class="col-md-4">
            <label class="reports-filter-label">End Date</label>
            <input type="date" name="endDate"
                   value="@ViewBag.EndDate" class="form-control" />
        </div>

        <div class="col-md-4 d-flex align-items-end gap-2">
            <button type="submit" class="reports-btn-primary">
    <i class="bi bi-funnel"></i>
    Apply Filter
</button>
            <a asp-action="CustomerSales" class="reports-btn-outline">Clear</a>
        </div>
    </form>

    @if (ViewBag.DateError != null)
    {
        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-1"></i>@ViewBag.DateError</div>
    }

    <div class="reports-content-card">
    <div>
            @if (!Model.Any())
            {
                <p class="text-muted mb-0">No customer sales found.</p>
            }
            else
            {
               <div class="reports-table-container">
                   <table class="reports-table">
                        <thead>
                            <tr>
                                <th>Customer</th>
                                <th>Invoices</th>
                                <th>Total Sales</th>
                                <th>Paid</th>
                                <th>Outstanding</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.CustomerName</td>
                                    <td>@item.InvoiceCount</td>
                                    <td>R @item.TotalSales.ToString("N2")</td>
                                    <td>R @item.TotalPaid.ToString("N2")</td>
                                    <td>R @item.OutstandingBalance.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>