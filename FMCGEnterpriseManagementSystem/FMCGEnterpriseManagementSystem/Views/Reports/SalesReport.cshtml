@*
    Purpose: Sales report page.
    Authors: iqran0906 (from git history)
*@
@model IEnumerable<FMCGEnterpriseManagementSystem.ViewModels.Reports.SalesReportViewModel>

@{
    ViewData["Title"] = "Sales Report";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-white fw-bold">Sales Report</h2>
            <p class="text-light opacity-75 mb-0">Daily sales, payments and outstanding balances.</p>
        </div>
        <partial name="_ReportToolbar" model="@("SalesReport")" />
    </div>

    <form method="get" class="row g-3 mb-4 no-print">
        <div class="col-md-4">
            <label class="form-label text-light fw-semibold">Start Date</label>
            <input type="date" name="startDate"
                   value="@ViewBag.StartDate" class="form-control" />
        </div>

        <div class="col-md-4">
            <label class="form-label text-light fw-semibold">End Date</label>
            <input type="date" name="endDate"
                   value="@ViewBag.EndDate" class="form-control" />
        </div>

        <div class="col-md-4 d-flex align-items-end gap-2">
            <button class="btn btn-primary">Filter</button>
            <a asp-action="SalesReport" class="btn btn-outline-light">Clear</a>
        </div>
    </form>

    @if (ViewBag.DateError != null)
    {
        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-1"></i>@ViewBag.DateError</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            @if (!Model.Any())
            {
                <p class="text-muted mb-0">No sales data found.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Invoices</th>
                                <th>Total Sales</th>
                                <th>Total Paid</th>
                                <th>Outstanding</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.SaleDate.ToString("dd MMM yyyy")</td>
                                    <td>@item.InvoiceCount</td>
                                    <td>R @item.TotalSales.ToString("N2")</td>
                                    <td>R @item.TotalPaid.ToString("N2")</td>
                                    <td>R @item.OutstandingBalance.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold">
                                <td>Totals</td>
                                <td>@Model.Sum(x => x.InvoiceCount)</td>
                                <td>R @Model.Sum(x => x.TotalSales).ToString("N2")</td>
                                <td>R @Model.Sum(x => x.TotalPaid).ToString("N2")</td>
                                <td>R @Model.Sum(x => x.OutstandingBalance).ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>
</div>