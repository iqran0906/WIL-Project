@*
    File: Views/Reports/InvoiceReport.cshtml

    Purpose:
    Displays invoice totals, payments and outstanding
    balances with date filtering and report exports.

    Original Author:
    iqran0906 (from Git history).

    UI Improvements:
    Iqra Nazir (2026).

    Development Assistance:
    OpenAI ChatGPT (2026).

    References (Harvard Anglia):
    Microsoft (n.d.) Razor syntax reference for ASP.NET Core.
    Available at: https://learn.microsoft.com/en-us/aspnet/core/mvc/views/razor

    Bootstrap (n.d.) Layout and forms.
    Available at: https://getbootstrap.com/docs/5.3/
*@

@model IEnumerable<FMCGEnterpriseManagementSystem.ViewModels.Reports.InvoiceReportViewModel>

@{
    ViewData["Title"] = "Invoice Report";
}

<div class="reports-page">

    @* Report heading and shared export toolbar *@
    <div class="reports-page-header">

        <div>
            <h2 class="reports-page-title">
                Invoice Report
            </h2>

            <p class="reports-page-description">
                Invoice totals, payments and outstanding balances.
            </p>
        </div>

        <partial name="_ReportToolbar" model="@("InvoiceReport")" />

    </div>

    @* Date range filters *@
    <form method="get"
          asp-action="InvoiceReport"
          class="row g-3 reports-filter-panel no-print">

        <div class="col-md-4">

            <label for="startDate" class="reports-filter-label">
                Start Date
            </label>

            <input type="date"
                   id="startDate"
                   name="startDate"
                   value="@ViewBag.StartDate"
                   class="form-control" />

        </div>

        <div class="col-md-4">

            <label for="endDate" class="reports-filter-label">
                End Date
            </label>

            <input type="date"
                   id="endDate"
                   name="endDate"
                   value="@ViewBag.EndDate"
                   class="form-control" />

        </div>

        <div class="col-md-4 d-flex align-items-end gap-2">

            <button type="submit" class="reports-btn-primary">
                <i class="bi bi-funnel"></i>
                Apply Filter
            </button>

            <a asp-action="InvoiceReport"
               class="reports-btn-outline">
                Clear
            </a>

        </div>

    </form>

    @* Display date validation errors returned by the controller *@
    @if (ViewBag.DateError != null)
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>
            @ViewBag.DateError
        </div>
    }

    @* Invoice report table *@
    <div class="reports-content-card">

        @if (!Model.Any())
        {
            <div class="reports-no-data">
                <i class="bi bi-info-circle me-2"></i>
                No invoice data found.
            </div>
        }
        else
        {
            <div class="reports-table-container">

                <table class="reports-table">

                    <thead>
                        <tr>
                            <th>Invoice</th>
                            <th>Date</th>
                            <th>Customer</th>
                            <th>Status</th>
                            <th>Subtotal</th>
                            <th>Total</th>
                            <th>Paid</th>
                            <th>Outstanding</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.InvoiceNumber</td>

                                <td>
                                    @item.InvoiceDate.ToString("dd MMM yyyy")
                                </td>

                                <td>@item.CustomerName</td>

                                <td>@item.Status</td>

                                <td>
                                    R @item.Subtotal.ToString("N2")
                                </td>

                                <td>
                                    R @item.Total.ToString("N2")
                                </td>

                                <td>
                                    R @item.AmountPaid.ToString("N2")
                                </td>

                                <td>
                                    R @item.OutstandingBalance.ToString("N2")
                                </td>
                            </tr>
                        }
                    </tbody>

                    <tfoot>
                        <tr>
                            <td colspan="5">
                                <strong>Totals</strong>
                            </td>

                            <td>
                                <strong>
                                    R @Model.Sum(x => x.Total).ToString("N2")
                                </strong>
                            </td>

                            <td>
                                <strong>
                                    R @Model.Sum(x => x.AmountPaid).ToString("N2")
                                </strong>
                            </td>

                            <td>
                                <strong>
                                    R @Model.Sum(x => x.OutstandingBalance).ToString("N2")
                                </strong>
                            </td>
                        </tr>
                    </tfoot>

                </table>

            </div>
        }

    </div>

</div>