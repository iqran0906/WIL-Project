@model IEnumerable<FMCGEnterpriseManagementSystem.ViewModels.Reports.ItemSalesReportViewModel>

@{
    ViewData["Title"] = "Item Sales Report";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Item Sales Report</h2>
            <p class="text-muted">Sales performance by product.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Reports</a>
    </div>

    <form method="get" class="row g-3 mb-4">
        <div class="col-md-4">
            <label class="form-label">Start Date</label>
            <input type="date" name="startDate"
                   value="@ViewBag.StartDate" class="form-control" />
        </div>

        <div class="col-md-4">
            <label class="form-label">End Date</label>
            <input type="date" name="endDate"
                   value="@ViewBag.EndDate" class="form-control" />
        </div>

        <div class="col-md-4 d-flex align-items-end gap-2">
            <button class="btn btn-primary">Filter</button>
            <a asp-action="ItemSalesReport" class="btn btn-outline-secondary">Clear</a>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (!Model.Any())
            {
                <p class="text-muted mb-0">No item sales found.</p>
            }
            else
            {
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Product Code</th>
                            <th>Product</th>
                            <th>Quantity Sold</th>
                            <th>Total Sales</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.ProductCode</td>
                                <td>@item.ProductName</td>
                                <td>@item.QuantitySold</td>
                                <td>R @item.TotalSales.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="fw-bold">
                            <td colspan="2">Totals</td>
                            <td>@Model.Sum(x => x.QuantitySold)</td>
                            <td>R @Model.Sum(x => x.TotalSales).ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            }
        </div>
    </div>
</div>