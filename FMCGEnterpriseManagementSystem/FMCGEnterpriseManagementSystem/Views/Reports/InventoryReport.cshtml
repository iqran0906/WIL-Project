@*
    Purpose: Inventory report page.
    Authors: iqran0906 (from git history)
*@
@model IEnumerable<FMCGEnterpriseManagementSystem.ViewModels.Reports.InventoryReportViewModel>

@{
    ViewData["Title"] = "Inventory Report";
}

<div class="reports-page">
    <div class="reports-page-header">
        <div>
            <h2 class="reports-page-title">Inventory Report</h2>
            <p class="reports-page-description">Current stock levels, values and expiry information.</p>
        </div>
        <partial name="_ReportToolbar" model="@("InventoryReport")" />
    </div>

    <div class="reports-content-card">
    <div>
            @if (!Model.Any())
            {
                <p class="text-muted mb-0">No inventory data found.</p>
            }
            else
            {
               <div class="reports-table-container">
                   <table class="reports-table">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Product</th>
                                <th>Category</th>
                                <th>On Hand</th>
                                <th>Reorder Level</th>
                                <th>Status</th>
                                <th>Selling Price</th>
                                <th>Stock Value</th>
                                <th>Earliest Expiry</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.ProductCode</td>
                                    <td>@item.ProductName</td>
                                    <td>@item.Category</td>
                                    <td>@item.QuantityOnHand</td>
                                    <td>@item.ReorderLevel</td>
                                    <td>
                                        @if (item.IsLowStock)
                                        {
                                            <span class="reports-status reports-status-danger">Low Stock</span>
                                        }
                                        else
                                        {
                                            <span class="reports-status reports-status-success">In Stock</span>
                                        }
                                    </td>
                                    <td>R @item.SellingPrice.ToString("N2")</td>
                                    <td>R @item.StockValue.ToString("N2")</td>
                                    <td>
                                        @(item.EarliestExpiryDate.HasValue
                                            ? item.EarliestExpiryDate.Value.ToString("dd MMM yyyy")
                                            : "N/A")
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold">
                                <td colspan="7">Total Inventory Value</td>
                                <td>R @Model.Sum(x => x.StockValue).ToString("N2")</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>
</div>