@*
    File: Views/Reports/ItemsPerCustomer.cshtml

    Purpose:
    Displays product quantities purchased by each customer.

    Original Author:
    iqran0906 (from Git history).

    UI Improvements:
    Iqra Nazir (2026).

    Development Assistance:
    OpenAI ChatGPT (2026).

    References:
    Microsoft (n.d.) ASP.NET Core Razor syntax.
    Bootstrap (n.d.) Layout and forms.
*@

@model IEnumerable<FMCGEnterpriseManagementSystem.ViewModels.Reports.ItemsPerCustomerReportViewModel>

@{
    ViewData["Title"] = "Items Per Customer";
}

<div class="reports-page">

    <div class="reports-page-header">
        <div>
            <h2 class="reports-page-title">Items Per Customer</h2>
            <p class="reports-page-description">
                Product quantities purchased by each customer.
            </p>
        </div>

        <partial name="_ReportToolbar" model="@("ItemsPerCustomer")" />
    </div>

    <form method="get"
          asp-action="ItemsPerCustomer"
          class="row g-3 reports-filter-panel no-print">

        <div class="col-md-4">
            <label for="startDate" class="reports-filter-label">
                Start Date
            </label>

            <input type="date"
                   id="startDate"
                   name="startDate"
                   value="@ViewBag.StartDate"
                   class="form-control" />
        </div>

        <div class="col-md-4">
            <label for="endDate" class="reports-filter-label">
                End Date
            </label>

            <input type="date"
                   id="endDate"
                   name="endDate"
                   value="@ViewBag.EndDate"
                   class="form-control" />
        </div>

        <div class="col-md-4 d-flex align-items-end gap-2">

            <button type="submit" class="reports-btn-primary">
                <i class="bi bi-funnel"></i>
                Apply Filter
            </button>

            <a asp-action="ItemsPerCustomer"
               class="reports-btn-outline">
                Clear
            </a>

        </div>

    </form>

    @if (ViewBag.DateError != null)
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>
            @ViewBag.DateError
        </div>
    }

    <div class="reports-content-card">

        @if (!Model.Any())
        {
            <div class="reports-no-data">
                <i class="bi bi-info-circle me-2"></i>
                No customer item sales found.
            </div>
        }
        else
        {
            <div class="reports-table-container">

                <table class="reports-table">

                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Total Items Purchased</th>
                            <th>Total Sales</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.CustomerName</td>

                                <td>@item.TotalItemsPurchased</td>

                                <td>
                                    R @item.TotalSales.ToString("N2")
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        }

    </div>

</div>