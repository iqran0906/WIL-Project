@*
    Purpose: Age Analysis report page.
    Authors: iqran0906 (from git history)
*@
@model IEnumerable<FMCGEnterpriseManagementSystem.ViewModels.Reports.AgeAnalysisReportViewModel>

@{
    ViewData["Title"] = "Age Analysis";
}

<div class="reports-page">
    <div class="reports-page-header">
        <div>
            <h2 class="reports-page-title">Age Analysis</h2>
            <p class="reports-page-description">Outstanding customer balances grouped by invoice age.</p>
        </div>

        <partial name="_ReportToolbar" model="@("AgeAnalysis")" />
    </div>

    <div class="reports-content-card">
    <div>
            @if (!Model.Any())
            {
                <p class="text-muted mb-0">There are no outstanding invoices.</p>
            }
            else
            {
               <div class="reports-table-container">
                   <table class="reports-table">
                        <thead>
                            <tr>
                                <th>Invoice</th>
                                <th>Customer</th>
                                <th>Date</th>
                                <th>Age</th>
                                <th>Bracket</th>
                                <th>Total</th>
                                <th>Paid</th>
                                <th>Outstanding</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.InvoiceNumber</td>
                                    <td>@item.CustomerName</td>
                                    <td>@item.InvoiceDate.ToString("dd MMM yyyy")</td>
                                    <td>@item.AgeInDays days</td>
                                    <td>@item.AgeBracket</td>
                                    <td>R @item.InvoiceTotal.ToString("N2")</td>
                                    <td>R @item.AmountPaid.ToString("N2")</td>
                                    <td>R @item.OutstandingBalance.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold">
                                <td colspan="7">Total Outstanding</td>
                                <td>R @Model.Sum(x => x.OutstandingBalance).ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>
</div>