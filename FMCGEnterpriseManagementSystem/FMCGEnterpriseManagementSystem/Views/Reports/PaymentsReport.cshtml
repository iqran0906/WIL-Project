@*
    Purpose: Payments report page.
    Authors: iqran0906 (from git history)
*@
@model IEnumerable<FMCGEnterpriseManagementSystem.ViewModels.Reports.PaymentReportViewModel>

@{
    ViewData["Title"] = "Payments Report";
}

<div class="reports-page">
   <div class="reports-page-header">
        <div>
            <h2 class="reports-page-title">Payments Report</h2>
            <p class="reports-page-description">Payments received against customer invoices.</p>
        </div>

        <partial name="_ReportToolbar" model="@("PaymentsReport")" />
    </div>

   <form method="get" class="row g-3 reports-filter-panel no-print">
        <div class="col-md-4">
            <label class="reports-filter-label">Start Date</label>
            <input type="date" name="startDate"
                   value="@ViewBag.StartDate" class="form-control" />
        </div>

        <div class="col-md-4">
            <label class="reports-filter-label">End Date</label>
            <input type="date" name="endDate"
                   value="@ViewBag.EndDate" class="form-control" />
        </div>

        <div class="col-md-4 d-flex align-items-end gap-2">
            <button type="submit" class="reports-btn-primary">
    <i class="bi bi-funnel"></i>
    Apply Filter
</button>
            <a asp-action="PaymentsReport" class="reports-btn-outline">Clear</a>
        </div>
    </form>

    @if (ViewBag.DateError != null)
    {
        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-1"></i>@ViewBag.DateError</div>
    }

    <div class="reports-content-card">
    <div>
            @if (!Model.Any())
            {
                <p class="text-muted mb-0">No payments found.</p>
            }
            else
            {
              <div class="reports-table-container">
                   <table class="reports-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Invoice</th>
                                <th>Customer</th>
                                <th>Method</th>
                                <th>Amount Paid</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.PaymentDate.ToString("dd MMM yyyy")</td>
                                    <td>@item.InvoiceNumber</td>
                                    <td>@item.CustomerName</td>
                                    <td>@item.PaymentMethod</td>
                                    <td>R @item.AmountPaid.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold">
                                <td colspan="4">Total Payments</td>
                                <td>R @Model.Sum(x => x.AmountPaid).ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>
</div>