@model IEnumerable<FMCGEnterpriseManagementSystem.ViewModels.Reports.QuoteReportViewModel>

@{
    ViewData["Title"] = "Quote Report";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Quote Report</h2>
            <p class="text-muted">Review customer quotations and their current status.</p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">Back to Reports</a>
    </div>

    <form method="get" class="row g-3 mb-4">
        <div class="col-md-4">
            <label class="form-label">Start Date</label>
            <input type="date" name="startDate"
                   value="@ViewBag.StartDate" class="form-control" />
        </div>

        <div class="col-md-4">
            <label class="form-label">End Date</label>
            <input type="date" name="endDate"
                   value="@ViewBag.EndDate" class="form-control" />
        </div>

        <div class="col-md-4 d-flex align-items-end gap-2">
            <button class="btn btn-primary">Filter</button>
            <a asp-action="QuoteReport" class="btn btn-outline-secondary">Clear</a>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (!Model.Any())
            {
                <p class="text-muted mb-0">No quote data found.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Quote</th>
                                <th>Date</th>
                                <th>Customer</th>
                                <th>Status</th>
                                <th>Subtotal</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.QuoteNumber</td>
                                    <td>@item.QuoteDate.ToString("dd MMM yyyy")</td>
                                    <td>@item.CustomerName</td>
                                    <td>@item.Status</td>
                                    <td>R @item.Subtotal.ToString("N2")</td>
                                    <td>R @item.Total.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold">
                                <td colspan="5">Total Quote Value</td>
                                <td>R @Model.Sum(x => x.Total).ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>
</div>