@*
    File: Views/Reports/Index.cshtml

    Purpose:
    Reports dashboard with searchable navigation to all twelve report categories.
    f
    Original Author:
    iqran0906 (2026), according to Git history.

    UI Improvements:
    Iqra Nazir (2026).

    Development Assistance:
    OpenAI ChatGPT (2026).

    References:
    Microsoft (n.d.) ASP.NET Core MVC Razor views.
    Bootstrap (n.d.) Grid system.
    MDN Web Docs (n.d.) JavaScript DOM manipulation.
*@

@{
    ViewData["Title"] = "Reports Dashboard";
}

<div class="reports-page">

    <div class="reports-page-header">

        <div>
            <h2 class="reports-page-title">
                Reports Dashboard
            </h2>

            <p class="reports-page-description">
                Access financial, sales, inventory and customer reports
                to monitor business performance.
            </p>
        </div>

    </div>


    @* ==========================================
       REPORT SEARCH
       ========================================== *@

    <div class="reports-search-panel">

        <label for="reportSearch"
               class="reports-search-label">

            Search Reports

        </label>

        <div style="max-width: 500px;">

            <input type="search"
                   id="reportSearch"
                   class="reports-search-input"
                   placeholder="Search by report name..."
                   autocomplete="off" />

        </div>

    </div>


    @* ==========================================
       REPORT NAVIGATION
       ========================================== *@

    <div class="row g-3" id="reportGrid">

        <div class="col-xl-4 col-md-6 report-card">

            <a asp-controller="Reports"
               asp-action="InvoiceReport"
               class="reports-navigation-card">

                <i class="bi bi-receipt reports-navigation-icon"></i>

                <div class="reports-navigation-title">
                    Invoice Report
                </div>

                <div class="reports-navigation-description">
                    Invoice totals, payments and outstanding balances.
                </div>

            </a>

        </div>


        <div class="col-xl-4 col-md-6 report-card">

            <a asp-controller="Reports"
               asp-action="QuoteReport"
               class="reports-navigation-card">

                <i class="bi bi-file-earmark-text reports-navigation-icon"></i>

                <div class="reports-navigation-title">
                    Quote Report
                </div>

                <div class="reports-navigation-description">
                    Customer quotations and their current statuses.
                </div>

            </a>

        </div>


        <div class="col-xl-4 col-md-6 report-card">

            <a asp-controller="Reports"
               asp-action="AgeAnalysis"
               class="reports-navigation-card">

                <i class="bi bi-calendar-check reports-navigation-icon"></i>

                <div class="reports-navigation-title">
                    Age Analysis
                </div>

                <div class="reports-navigation-description">
                    Outstanding customer balances grouped by invoice age.
                </div>

            </a>

        </div>


        <div class="col-xl-4 col-md-6 report-card">

            <a asp-controller="Reports"
               asp-action="CustomerReport"
               class="reports-navigation-card">

                <i class="bi bi-people reports-navigation-icon"></i>

                <div class="reports-navigation-title">
                    Customer Report
                </div>

                <div class="reports-navigation-description">
                    Customer account details and payment terms.
                </div>

            </a>

        </div>


        <div class="col-xl-4 col-md-6 report-card">

            <a asp-controller="Reports"
               asp-action="CustomerSales"
               class="reports-navigation-card">

                <i class="bi bi-graph-up-arrow reports-navigation-icon"></i>

                <div class="reports-navigation-title">
                    Customer Sales
                </div>

                <div class="reports-navigation-description">
                    Sales performance and balances by customer.
                </div>

            </a>

        </div>


        <div class="col-xl-4 col-md-6 report-card">

            <a asp-controller="Reports"
               asp-action="PaymentsReport"
               class="reports-navigation-card">

                <i class="bi bi-credit-card reports-navigation-icon"></i>

                <div class="reports-navigation-title">
                    Payments Report
                </div>

                <div class="reports-navigation-description">
                    Payments received against customer invoices.
                </div>

            </a>

        </div>


        <div class="col-xl-4 col-md-6 report-card">

            <a asp-controller="Reports"
               asp-action="InventoryReport"
               class="reports-navigation-card">

                <i class="bi bi-box-seam reports-navigation-icon"></i>

                <div class="reports-navigation-title">
                    Inventory Report
                </div>

                <div class="reports-navigation-description">
                    Current stock levels, inventory value and expiry dates.
                </div>

            </a>

        </div>


        <div class="col-xl-4 col-md-6 report-card">

            <a asp-controller="Reports"
               asp-action="SalesReport"
               class="reports-navigation-card">

                <i class="bi bi-bar-chart-line reports-navigation-icon"></i>

                <div class="reports-navigation-title">
                    Sales Report
                </div>

                <div class="reports-navigation-description">
                    Daily sales, payments and outstanding balances.
                </div>

            </a>

        </div>


        <div class="col-xl-4 col-md-6 report-card">

            <a asp-controller="Reports"
               asp-action="ItemsPerCustomer"
               class="reports-navigation-card">

                <i class="bi bi-basket reports-navigation-icon"></i>

                <div class="reports-navigation-title">
                    Items Per Customer
                </div>

                <div class="reports-navigation-description">
                    Product quantities purchased by each customer.
                </div>

            </a>

        </div>


        <div class="col-xl-4 col-md-6 report-card">

            <a asp-controller="Reports"
               asp-action="ItemSalesReport"
               class="reports-navigation-card">

                <i class="bi bi-boxes reports-navigation-icon"></i>

                <div class="reports-navigation-title">
                    Item Sales Report
                </div>

                <div class="reports-navigation-description">
                    Sales performance and quantities by product.
                </div>

            </a>

        </div>


        <div class="col-xl-4 col-md-6 report-card">

            <a asp-controller="Reports"
               asp-action="SalesRepReport"
               class="reports-navigation-card">

                <i class="bi bi-person-badge reports-navigation-icon"></i>

                <div class="reports-navigation-title">
                    Sales Rep Report
                </div>

                <div class="reports-navigation-description">
                    Sales targets, performance and estimated commissions.
                </div>

            </a>

        </div>


        <div class="col-xl-4 col-md-6 report-card">

            <a asp-controller="Reports"
               asp-action="SalesVatReport"
               class="reports-navigation-card">

                <i class="bi bi-calculator reports-navigation-icon"></i>

                <div class="reports-navigation-title">
                    Sales VAT Report
                </div>

                <div class="reports-navigation-description">
                    Invoice sales values and recorded VAT amounts.
                </div>

            </a>

        </div>

    </div>


    <div id="noReportsMessage"
         class="reports-empty-message mt-4"
         style="display:none;">

        <i class="bi bi-search me-2"></i>

        No reports match your search.

    </div>

</div>


@section Scripts {

    <script>
        /*
         * Client-side report search.
         * Reference:
         * MDN Web Docs (n.d.) Document.querySelectorAll().
         */

        document.getElementById("reportSearch")
            .addEventListener("input", function () {

                const searchValue =
                    this.value.toLowerCase().trim();

                let visibleCount = 0;

                document.querySelectorAll(".report-card")
                    .forEach(function (card) {

                        const reportName =
                            card.innerText.toLowerCase();

                        const isMatch =
                            reportName.includes(searchValue);

                        card.style.display =
                            isMatch ? "" : "none";

                        if (isMatch) {
                            visibleCount++;
                        }
                    });

                document.getElementById("noReportsMessage")
                    .style.display =
                        visibleCount === 0 ? "" : "none";
            });
    </script>

}