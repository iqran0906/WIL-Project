@*
    Purpose: Customer report page.
    Authors: iqran0906 (from git history)
*@
@model IEnumerable<FMCGEnterpriseManagementSystem.ViewModels.Reports.CustomerReportViewModel>

@{
    ViewData["Title"] = "Customer Report";
}

<div class="reports-page">
    <div class="reports-page-header">
        <div>
            <h2 class="reports-page-title">Customer Report</h2>
            <p class="reports-page-description">Customer account and payment information.</p>
        </div>

        <partial name="_ReportToolbar" model="@("CustomerReport")" />
    </div>

    <div class="reports-content-card">
    <div>
            @if (!Model.Any())
            {
                <p class="text-muted mb-0">No customers found.</p>
            }
            else
            {
                <div class="reports-table-container">
                   <table class="reports-table">
                        <thead>
                            <tr>
                                <th>Customer</th>
                                <th>Email</th>
                                <th>Telephone</th>
                                <th>Group</th>
                                <th>Payment Terms</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.CustomerName</td>
                                    <td>@item.Email</td>
                                    <td>@item.TelephoneNumber</td>
                                    <td>@item.CustomerGroup</td>
                                    <td>@item.PaymentTerms</td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="reports-status reports-status-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="reports-status reports-status-neutral">Inactive</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>