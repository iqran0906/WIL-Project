@model IEnumerable<FMCGEnterpriseManagementSystem.ViewModels.Reports.CustomerReportViewModel>

@{
    ViewData["Title"] = "Customer Report";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Customer Report</h2>
            <p class="text-muted">Customer account and payment information.</p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">Back to Reports</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (!Model.Any())
            {
                <p class="text-muted mb-0">No customers found.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Customer</th>
                                <th>Email</th>
                                <th>Telephone</th>
                                <th>Group</th>
                                <th>Payment Terms</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.CustomerName</td>
                                    <td>@item.Email</td>
                                    <td>@item.TelephoneNumber</td>
                                    <td>@item.CustomerGroup</td>
                                    <td>@item.PaymentTerms</td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>