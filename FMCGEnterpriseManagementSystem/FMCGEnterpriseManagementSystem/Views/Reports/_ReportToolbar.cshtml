@*
    
    Purpose:
    Shared PDF, Excel, Print and Back buttons used across all reports.

    Original Author:
    ST10068525 

    UI Improvements:
    Iqra Nazir (2026).

    Development Assistance:
    OpenAI ChatGPT (2026).

    References:
    Microsoft (n.d.) Partial views in ASP.NET Core.
    Bootstrap (n.d.) Buttons and layout.
*@

@model string

@{
    var startDate = ViewBag.StartDate as string;
    var endDate = ViewBag.EndDate as string;
}

<div class="reports-toolbar no-print">

    <a asp-controller="Reports"
       asp-action="Export"
       asp-route-report="@Model"
       asp-route-format="pdf"
       asp-route-startDate="@startDate"
       asp-route-endDate="@endDate"
       class="reports-btn-outline reports-btn-pdf"
       title="Download report as PDF">

        <i class="bi bi-file-earmark-pdf"></i>
        PDF

    </a>

    <a asp-controller="Reports"
       asp-action="Export"
       asp-route-report="@Model"
       asp-route-format="excel"
       asp-route-startDate="@startDate"
       asp-route-endDate="@endDate"
       class="reports-btn-outline reports-btn-excel"
       title="Download report as Excel">

        <i class="bi bi-file-earmark-excel"></i>
        Excel

    </a>

    <button type="button"
            class="reports-btn-outline"
            onclick="window.print()"
            title="Print this report">

        <i class="bi bi-printer"></i>
        Print

    </button>

    <a asp-controller="Reports"
       asp-action="Index"
       class="reports-btn-outline">

        <i class="bi bi-arrow-left"></i>
        Back to Reports

    </a>

</div>