@*
    Purpose:
    Create a new employee with employment details and one next-of-kin record.

    References:
    Bootstrap (n.d.) Forms.
    Available at: https://getbootstrap.com/docs/5.3/forms/overview/

    Microsoft (n.d.) Tag Helpers in forms in ASP.NET Core.
    Available at: https://learn.microsoft.com/en-us/aspnet/core/mvc/views/working-with-forms
*@

@model FMCGEnterpriseManagementSystem.ViewModels.EmployeeViewModel

@{
    ViewData["Title"] = "New Employee";
}

<style>
    .employee-form-page {
        background: #e6edf1;
        border: 1px solid rgba(53, 127, 145, 0.18);
        border-radius: 15px;
        padding: 30px;
        margin-bottom: 30px;
        color: #183244;
    }

    .employee-form-header {
        margin-bottom: 26px;
    }

    .employee-form-title {
        color: #183244;
        font-size: 30px;
        font-weight: 800;
        margin-bottom: 5px;
    }

    .employee-form-subtitle {
        color: #667988;
        font-size: 15px;
        margin-bottom: 0;
    }

    .employee-form-section {
        background: #f8fafb;
        border: 1px solid #c9d9df;
        border-top: 3px solid #357f91;
        border-radius: 8px;
        padding: 25px;
        height: 100%;
        box-shadow: 0 3px 12px rgba(15, 40, 55, 0.05);
    }

    .employee-form-section-title {
        font-size: 19px;
        font-weight: 800;
        color: #183244;
        margin-bottom: 6px;
    }

    .employee-form-section-subtitle {
        color: #788592;
        font-size: 13px;
        margin-bottom: 22px;
    }

    .employee-form-page .form-label {
        font-size: 14px;
        font-weight: 600;
        color: #465768;
        margin-bottom: 7px;
    }

    .employee-form-page .form-control {
        background: #f7f9fa;
        border: 1px solid #d3dbe2;
        border-radius: 6px;
        min-height: 44px;
        color: #263b4b;
    }

        .employee-form-page .form-control:focus {
            border-color: #357f91;
            box-shadow: 0 0 0 3px rgba(53, 127, 145, 0.12);
        }

        .employee-form-page .form-control[readonly] {
            background: #e9eff2;
            color: #657988;
        }

    .employee-form-page textarea.form-control {
        min-height: 90px;
    }

    .employee-form-help {
        color: #788592;
        font-size: 12px;
        margin-top: 6px;
    }

    .employee-form-actions {
        display: flex;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 25px;
    }

    .employee-form-save {
        background: #357f91;
        border: 1px solid #357f91;
        color: white;
        border-radius: 6px;
        padding: 11px 22px;
        font-weight: 600;
    }

        .employee-form-save:hover {
            background: #286675;
            color: white;
        }

    .employee-form-cancel {
        background: transparent;
        border: 1px solid #a8b1bb;
        color: #536475;
        border-radius: 6px;
        padding: 11px 22px;
        font-weight: 600;
        text-decoration: none;
    }

        .employee-form-cancel:hover {
            background: #dce6eb;
            color: #183244;
        }

    @@media (max-width: 768px) {
        .employee-form-page {
            padding: 18px;
        }

        .employee-form-title {
            font-size: 25px;
        }

        .employee-form-section {
            padding: 18px;
        }

        .employee-form-actions a,
        .employee-form-actions button {
            flex: 1;
            text-align: center;
        }
    }
</style>

<div class="employee-form-page">

    <!-- PAGE HEADER -->

    <div class="employee-form-header">

        <h2 class="employee-form-title">
            New Employee
        </h2>

        <p class="employee-form-subtitle">
            Register a new employee and capture their next-of-kin information.
        </p>

    </div>

    <form asp-controller="Employees"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"
             role="alert">
        </div>

        <div class="row g-4">

            <!-- EMPLOYEE DETAILS -->

            <div class="col-12 col-xl-6">

                <div class="employee-form-section">

                    <h5 class="employee-form-section-title">
                        <i class="bi bi-person-badge me-2"></i>
                        Employee Information
                    </h5>

                    <p class="employee-form-section-subtitle">
                        Enter the employee's personal and employment details.
                    </p>

                    <!-- EMPLOYEE NUMBER -->

                    <div class="mb-3">

                        <label class="form-label">
                            Employee Number
                        </label>

                        <input type="text"
                               class="form-control"
                               value="Generated automatically when saved"
                               readonly />

                        <div class="employee-form-help">
                            A unique employee number will be assigned automatically.
                        </div>

                    </div>

                    <!-- FIRST NAME -->

                    <div class="mb-3">

                        <label asp-for="FirstName"
                               class="form-label">
                        </label>

                        <input asp-for="FirstName"
                               class="form-control"
                               placeholder="Enter first name" />

                        <span asp-validation-for="FirstName"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- LAST NAME -->

                    <div class="mb-3">

                        <label asp-for="LastName"
                               class="form-label">
                        </label>

                        <input asp-for="LastName"
                               class="form-control"
                               placeholder="Enter last name" />

                        <span asp-validation-for="LastName"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- CONTACT NUMBER -->

                    <div class="mb-3">

                        <label asp-for="ContactNumber"
                               class="form-label">
                        </label>

                        <input asp-for="ContactNumber"
                               class="form-control"
                               placeholder="Enter contact number" />

                        <span asp-validation-for="ContactNumber"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- EMAIL -->

                    <div class="mb-3">

                        <label asp-for="Email"
                               class="form-label">
                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               placeholder="Enter email address" />

                        <span asp-validation-for="Email"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- JOB TITLE -->

                    <div class="mb-3">

                        <label asp-for="JobTitle"
                               class="form-label">
                        </label>

                        <input asp-for="JobTitle"
                               class="form-control"
                               placeholder="Enter job title" />

                        <span asp-validation-for="JobTitle"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- DATE OF EMPLOYMENT -->

                    <div class="mb-3">

                        <label asp-for="DateOfEmployment"
                               class="form-label">
                        </label>

                        <input asp-for="DateOfEmployment"
                               class="form-control" />

                        <span asp-validation-for="DateOfEmployment"
                              class="text-danger small">
                        </span>

                    </div>

                </div>

            </div>

            <!-- NEXT OF KIN -->

            <div class="col-12 col-xl-6">

                <div class="employee-form-section">

                    <h5 class="employee-form-section-title">
                        <i class="bi bi-people me-2"></i>
                        Next of Kin
                    </h5>

                    <p class="employee-form-section-subtitle">
                        Enter the contact information for the employee's next of kin.
                    </p>

                    <!-- FULL NAME -->

                    <div class="mb-3">

                        <label asp-for="NextOfKinFullName"
                               class="form-label">
                        </label>

                        <input asp-for="NextOfKinFullName"
                               class="form-control"
                               placeholder="Enter full name" />

                        <span asp-validation-for="NextOfKinFullName"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- RELATIONSHIP -->

                    <div class="mb-3">

                        <label asp-for="NextOfKinRelationship"
                               class="form-label">
                        </label>

                        <input asp-for="NextOfKinRelationship"
                               class="form-control"
                               placeholder="Enter relationship" />

                        <span asp-validation-for="NextOfKinRelationship"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- CONTACT NUMBER -->

                    <div class="mb-3">

                        <label asp-for="NextOfKinContactNumber"
                               class="form-label">
                        </label>

                        <input asp-for="NextOfKinContactNumber"
                               class="form-control"
                               placeholder="Enter contact number" />

                        <span asp-validation-for="NextOfKinContactNumber"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- EMAIL -->

                    <div class="mb-3">

                        <label asp-for="NextOfKinEmail"
                               class="form-label">
                        </label>

                        <input asp-for="NextOfKinEmail"
                               class="form-control"
                               placeholder="Enter email address" />

                        <span asp-validation-for="NextOfKinEmail"
                              class="text-danger small">
                        </span>

                    </div>

                </div>

            </div>

        </div>

        <!-- ACTION BUTTONS -->

        <div class="employee-form-actions">

            <a asp-controller="Employees"
               asp-action="Index"
               class="employee-form-cancel">

                <i class="bi bi-arrow-left me-1"></i>
                Cancel

            </a>

            <button type="submit"
                    class="employee-form-save">

                <i class="bi bi-check-lg me-1"></i>
                Save Employee

            </button>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}