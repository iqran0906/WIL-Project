@model FMCGEnterpriseManagementSystem.ViewModels.EmployeeViewModel

@{
    ViewData["Title"] = "New Employee";
}

<div class="content-card">
    <h2 class="fw-bold mb-4" style="color: #1c323d;">New Employee</h2>

    <form asp-controller="Employees" asp-action="Create" method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-4">

            <div class="col-md-6 border-end pe-md-4">

                <div class="mb-3">
                    <label asp-for="FirstName" class="form-label">Name</label>
                    <input asp-for="FirstName"
                           class="form-control"
                           placeholder="Enter Name" />
                    <span asp-validation-for="FirstName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="LastName" class="form-label">Surname</label>
                    <input asp-for="LastName"
                           class="form-control"
                           placeholder="Enter Surname" />
                    <span asp-validation-for="LastName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">ID Number</label>
                    <input type="text"
                           class="form-control"
                           placeholder="Enter ID Number" />
                </div>

                <div class="mb-3">
                    <label asp-for="ContactNumber" class="form-label">
                        Cell Number
                    </label>
                    <input asp-for="ContactNumber"
                           class="form-control"
                           placeholder="Enter Cell Number" />
                    <span asp-validation-for="ContactNumber"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email"
                           class="form-control"
                           placeholder="Enter Email Address" />
                    <span asp-validation-for="Email"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Nationality</label>
                    <input type="text"
                           class="form-control"
                           placeholder="Enter Nationality" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Address</label>
                    <textarea class="form-control"
                              rows="2"
                              placeholder="Enter Address"></textarea>
                </div>

            </div>

            <div class="col-md-6 ps-md-4">

                <h5 class="fw-bold text-muted mb-3 text-end">
                    Next Of Kin
                </h5>

                <div class="mb-3">
                    <label asp-for="NextOfKinFullName" class="form-label">
                        Name
                    </label>
                    <input asp-for="NextOfKinFullName"
                           class="form-control"
                           placeholder="Enter Name" />
                    <span asp-validation-for="NextOfKinFullName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Surname</label>
                    <input type="text"
                           class="form-control"
                           placeholder="Enter Surname" />
                </div>

                <div class="mb-3">
                    <label asp-for="NextOfKinRelationship"
                           class="form-label">
                        Relationship
                    </label>
                    <input asp-for="NextOfKinRelationship"
                           class="form-control"
                           placeholder="Enter Relationship, e.g., Mother, Father, etc" />
                    <span asp-validation-for="NextOfKinRelationship"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NextOfKinContactNumber"
                           class="form-label">
                        Contact Number
                    </label>
                    <input asp-for="NextOfKinContactNumber"
                           class="form-control"
                           placeholder="Enter Contact Number" />
                    <span asp-validation-for="NextOfKinContactNumber"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Address</label>
                    <textarea class="form-control"
                              rows="2"
                              placeholder="Enter Address"></textarea>
                </div>

            </div>

            <div class="col-12 border-top pt-3">
                <div class="mb-4">
                    <label class="form-label">Notes</label>
                    <textarea class="form-control"
                              rows="3"
                              placeholder="Optional"></textarea>
                </div>
            </div>

        </div>

        <div class="d-flex justify-content-end gap-3 mt-2">

            <a asp-controller="Employees"
               asp-action="Index"
               class="btn btn-link text-decoration-none text-secondary align-self-center">
                Cancel
            </a>

            <button type="submit"
                    class="btn btn-custom-save">
                Save Employee
            </button>

        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}