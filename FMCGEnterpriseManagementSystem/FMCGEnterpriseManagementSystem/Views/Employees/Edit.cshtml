@model FMCGEnterpriseManagementSystem.ViewModels.EmployeeViewModel

@{
    ViewData["Title"] = "Edit Employee";
}

<div class="content-card">
    <h2 class="fw-bold mb-4" style="color: #1c323d;">Edit Employee</h2>

    <form asp-controller="Employees" asp-action="Edit" method="post">

        @Html.AntiForgeryToken()

        <input asp-for="EmployeeID" type="hidden" />
        <input asp-for="NextOfKinID" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-4">

            <div class="col-md-6 border-end pe-md-4">

                <div class="mb-3">
                    <label asp-for="EmployeeNumber" class="form-label"></label>
                    <input asp-for="EmployeeNumber"
                           class="form-control"
                           placeholder="Enter Employee Number" />
                    <span asp-validation-for="EmployeeNumber"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName"
                           class="form-control"
                           placeholder="Enter First Name" />
                    <span asp-validation-for="FirstName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName"
                           class="form-control"
                           placeholder="Enter Last Name" />
                    <span asp-validation-for="LastName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ContactNumber" class="form-label"></label>
                    <input asp-for="ContactNumber"
                           class="form-control"
                           placeholder="Enter Contact Number" />
                    <span asp-validation-for="ContactNumber"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email"
                           class="form-control"
                           placeholder="Enter Email Address" />
                    <span asp-validation-for="Email"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="JobTitle" class="form-label"></label>
                    <input asp-for="JobTitle"
                           class="form-control"
                           placeholder="Enter Job Title" />
                    <span asp-validation-for="JobTitle"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DateOfEmployment" class="form-label"></label>
                    <input asp-for="DateOfEmployment"
                           class="form-control" />
                    <span asp-validation-for="DateOfEmployment"
                          class="text-danger"></span>
                </div>

            </div>

            <div class="col-md-6 ps-md-4">

                <h5 class="fw-bold text-muted mb-3 text-end">
                    Next Of Kin
                </h5>

                <div class="mb-3">
                    <label asp-for="NextOfKinFullName"
                           class="form-label"></label>
                    <input asp-for="NextOfKinFullName"
                           class="form-control"
                           placeholder="Enter Full Name" />
                    <span asp-validation-for="NextOfKinFullName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NextOfKinRelationship"
                           class="form-label"></label>
                    <input asp-for="NextOfKinRelationship"
                           class="form-control"
                           placeholder="Enter Relationship" />
                    <span asp-validation-for="NextOfKinRelationship"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NextOfKinContactNumber"
                           class="form-label"></label>
                    <input asp-for="NextOfKinContactNumber"
                           class="form-control"
                           placeholder="Enter Contact Number" />
                    <span asp-validation-for="NextOfKinContactNumber"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NextOfKinEmail"
                           class="form-label"></label>
                    <input asp-for="NextOfKinEmail"
                           class="form-control"
                           placeholder="Enter Email Address" />
                    <span asp-validation-for="NextOfKinEmail"
                          class="text-danger"></span>
                </div>

            </div>

        </div>

        <div class="d-flex justify-content-end gap-3 mt-2">

            <a asp-controller="Employees"
               asp-action="Index"
               class="btn btn-link text-decoration-none text-secondary align-self-center">
                Cancel
            </a>

            <button type="submit"
                    class="btn btn-custom-save">
                Save Changes
            </button>

        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}