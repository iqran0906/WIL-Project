@*
Purpose: ERP Login page.
Authors: iqran0906 (from git history)
Uses: jQuery Validation + Unobtrusive (MIT) https://jqueryvalidation.org
*@

@model FMCGEnterpriseManagementSystem.ViewModels.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Exclusive Distributors
    </title>


    <!-- Bootstrap -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <style>
    /*
       Purpose:
       Provide a consistent visual experience between the
       Welcome page and the secure login portal.

       References 
       Mozilla (n.d.) CSS: Cascading Style Sheets.
       MDN Web Docs. Available at:
       https://developer.mozilla.org/en-US/docs/Web/CSS

       Bootstrap (n.d.) Forms.
       Available at:
       https://getbootstrap.com/docs/5.3/forms/overview/

    */

    :root {
        --navy: #091827;
        --dark-navy: #06111f;
        --navy-light: #122b3c;
        --teal: #20d5c4;
        --teal-dark: #0da99f;
        --white: #ffffff;
        --text: #eaf5f6;
        --muted: #9db4c1;
        --border: rgba(32, 213, 196, 0.18);
    }

    * {
        box-sizing: border-box;
    }

    html,
    body {
        width: 100%;
        min-height: 100%;
    }

    body {
        margin: 0;
        font-family: "Segoe UI", Tahoma, sans-serif;
        background: var(--dark-navy);
        color: var(--text);
        overflow-x: hidden;
    }

    /* HEADER */

    .erp-header {
        height: 80px;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 7%;
        background: rgba(6, 17, 31, 0.92);
        border-bottom: 1px solid rgba(32, 213, 196, 0.12);
        position: relative;
        z-index: 10;
    }

    .erp-brand {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .erp-logo {
        width: 46px;
        height: 46px;
        padding: 5px;
        background: white;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 20px rgba(32, 213, 196, 0.15);
    }

    .erp-logo img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .erp-brand-name {
        font-size: 17px;
        font-weight: 800;
        color: white;
    }

    .erp-brand-subtitle {
        display: block;
        color: var(--teal);
        font-size: 10px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-top: 4px;
    }

    .secure-access {
        display: flex;
        align-items: center;
        gap: 9px;
        color: var(--muted);
        font-size: 12px;
    }

    .secure-access i {
        color: var(--teal);
    }

    /* PAGE BACKGROUND */

    .erp-page {
        min-height: calc(100vh - 80px);
        display: flex;
        position: relative;
        overflow: hidden;

        background:
            radial-gradient(
                circle at 15% 30%,
                rgba(32, 213, 196, 0.12),
                transparent 35%
            ),
            radial-gradient(
                circle at 85% 70%,
                rgba(32, 213, 196, 0.08),
                transparent 35%
            ),
            linear-gradient(
                135deg,
                #091827,
                #10263a,
                #071522
            );
    }

    .erp-background {
        position: absolute;
        inset: 0;
        pointer-events: none;

        background-image:
            linear-gradient(
                rgba(32, 213, 196, 0.035) 1px,
                transparent 1px
            ),
            linear-gradient(
                90deg,
                rgba(32, 213, 196, 0.035) 1px,
                transparent 1px
            );

        background-size: 55px 55px;
    }

    .background-circle {
        position: absolute;
        border-radius: 50%;
        border: 1px solid rgba(32, 213, 196, 0.12);
        pointer-events: none;
        animation: floatCircle 10s ease-in-out infinite alternate;
    }

    .circle-one {
        width: 600px;
        height: 600px;
        right: -250px;
        top: -180px;
    }

    .circle-two {
        width: 420px;
        height: 420px;
        left: -220px;
        bottom: -180px;
        animation-delay: 2s;
    }

    /* CONTENT */

    .erp-content {
        width: 100%;
        max-width: 1250px;
        margin: auto;
        padding: 65px 35px 85px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        z-index: 2;
    }

    /* LOGIN CONTAINER */

    .login-container {
        width: 100%;
        max-width: 1050px;
        min-height: 560px;
        display: grid;
        grid-template-columns: 1fr 1fr;

        background: rgba(13, 34, 50, 0.9);
        border: 1px solid var(--border);
        border-radius: 24px;
        overflow: hidden;

        box-shadow:
            0 30px 80px rgba(0, 0, 0, 0.35),
            0 0 45px rgba(32, 213, 196, 0.05);

        backdrop-filter: blur(20px);
        animation: fadeUp 0.8s ease;
    }

    /* LEFT PANEL */

    .login-info {
        position: relative;
        padding: 65px 55px;

        background:
            radial-gradient(
                circle at 10% 90%,
                rgba(32, 213, 196, 0.15),
                transparent 45%
            ),
            linear-gradient(
                150deg,
                #0c2635,
                #123647,
                #0a202f
            );

        color: white;
        overflow: hidden;
    }

    .login-info::after {
        content: "";
        position: absolute;
        width: 350px;
        height: 350px;
        right: -180px;
        bottom: -180px;
        border: 1px solid rgba(32, 213, 196, 0.18);
        border-radius: 50%;
    }

    .info-content {
        position: relative;
        z-index: 2;
    }

    .module-label {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 9px 14px;
        border-radius: 30px;

        background: rgba(32, 213, 196, 0.08);
        border: 1px solid rgba(32, 213, 196, 0.2);

        color: var(--teal);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        margin-bottom: 35px;
    }

    .module-label i {
        color: var(--teal);
    }

    .login-info h1 {
        font-size: clamp(30px, 3vw, 43px);
        line-height: 1.15;
        font-weight: 800;
        letter-spacing: -1px;
        margin-bottom: 22px;
    }

    .login-info h1 span {
        color: var(--teal);
    }

    .login-info-description {
        color: var(--muted);
        font-size: 15px;
        line-height: 1.85;
        max-width: 410px;
        margin-bottom: 40px;
    }

    /* MODULES */

    .module-list {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        max-width: 420px;
    }

    .module-item {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 14px;
        border-radius: 12px;

        background: rgba(255, 255, 255, 0.035);
        border: 1px solid rgba(32, 213, 196, 0.1);

        color: #d7e8ec;
        font-size: 12px;

        transition: all 0.3s ease;
    }

    .module-item:hover {
        background: rgba(32, 213, 196, 0.1);
        border-color: rgba(32, 213, 196, 0.3);
        transform: translateY(-3px);
    }

    .module-item i {
        color: var(--teal);
        font-size: 17px;
    }

    /* RIGHT PANEL */

    .login-panel {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 65px 60px;

        background: rgba(7, 22, 35, 0.85);
        border-left: 1px solid rgba(32, 213, 196, 0.1);
    }

    .login-form {
        width: 100%;
        max-width: 365px;
    }

    .login-heading {
        margin-bottom: 35px;
    }

    .login-heading h2 {
        font-size: 31px;
        font-weight: 800;
        color: white;
        margin-bottom: 10px;
    }

    .login-heading p {
        color: var(--muted);
        font-size: 13px;
        line-height: 1.7;
        margin: 0;
    }

    /* FORM */

    .form-label {
        color: #c7dce3;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 9px;
    }

    .input-group {
        height: 50px;
    }

    .input-group-text {
        width: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #112b3c;
        border-color: rgba(32, 213, 196, 0.18);
        color: var(--teal);
        font-size: 16px;
    }

    .form-control {
        height: 50px;
        border-color: rgba(32, 213, 196, 0.18);
        color: white;
        font-size: 13px;
        background: #112b3c;
    }

    .form-control::placeholder {
        color: #819aa7;
    }

    .form-control:focus {
        background: #143348;
        color: white;
        border-color: var(--teal);
        box-shadow: 0 0 0 3px rgba(32, 213, 196, 0.12);
        z-index: 3;
    }

    .password-toggle {
        border-color: rgba(32, 213, 196, 0.18);
        background: #112b3c;
        color: #a6c0ca;
        width: 48px;
    }

    .password-toggle:hover {
        background: #17394c;
        color: var(--teal);
    }

    .field-validation-error {
        display: block;
        margin-top: 6px;
    }

    /* LOGIN OPTIONS */

    .login-options {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 18px;
        margin-bottom: 30px;
    }

    .form-check-label {
        color: var(--muted);
        font-size: 12px;
        cursor: pointer;
    }

    .form-check-input {
        background-color: #112b3c;
        border-color: #54717e;
    }

    .form-check-input:checked {
        background-color: var(--teal);
        border-color: var(--teal);
    }

    .forgot-password {
        color: var(--teal);
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
    }

    .forgot-password:hover {
        color: white;
        text-decoration: underline;
    }

    /* BUTTON */

    .btn-login {
        width: 100%;
        height: 52px;
        border: none;
        border-radius: 10px;

        background: linear-gradient(
            135deg,
            #20d5c4,
            #12b8b0
        );

        color: #061827;
        font-size: 14px;
        font-weight: 800;

        transition: all 0.3s ease;
        box-shadow: 0 10px 25px rgba(32, 213, 196, 0.12);
    }

    .btn-login:hover {
        background: white;
        color: #061827;
        transform: translateY(-3px);
        box-shadow: 0 15px 35px rgba(32, 213, 196, 0.2);
    }

    .btn-login:active {
        transform: translateY(0);
    }

    /* SECURITY MESSAGE */

    .security-message {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-top: 30px;
        padding: 14px;

        background: rgba(32, 213, 196, 0.045);
        border: 1px solid rgba(32, 213, 196, 0.12);
        border-radius: 10px;

        color: var(--muted);
        font-size: 11px;
        line-height: 1.65;
    }

    .security-message i {
        color: var(--teal);
        font-size: 16px;
    }

    /* FOOTER */

    .erp-footer {
        position: absolute;
        bottom: 20px;
        left: 0;
        right: 0;
        text-align: center;
        color: #7794a2;
        font-size: 11px;
        z-index: 3;
    }

    /* VALIDATION */

    .validation-summary-errors {
        margin-bottom: 20px;
        padding: 12px;
        border-radius: 9px;
        background: rgba(194, 57, 57, 0.1);
        border: 1px solid rgba(235, 98, 98, 0.3);
        color: #ffb0aa;
        font-size: 12px;
    }

    .validation-summary-valid {
        display: none;
    }

    .text-danger {
        color: #ffaaa4 !important;
        font-size: 11px;
    }

    /* ANIMATIONS */

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(25px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes floatCircle {
        from {
            transform: translateY(0);
        }

        to {
            transform: translateY(25px);
        }
    }

    /* RESPONSIVE */

    @@media (max-width: 850px) {
        .erp-header {
            padding: 0 22px;
        }

        .secure-access {
            display: none;
        }

        .login-container {
            grid-template-columns: 1fr;
            max-width: 520px;
        }

        .login-info {
            padding: 40px;
        }

        .login-info h1 {
            font-size: 30px;
        }

        .login-info-description {
            margin-bottom: 25px;
        }

        .module-list {
            display: none;
        }

        .login-panel {
            padding: 45px 40px;
            border-left: none;
            border-top: 1px solid var(--border);
        }
    }

    @@media (max-width: 576px) {
        .erp-header {
            height: 70px;
            padding: 0 18px;
        }

        .erp-page {
            min-height: calc(100vh - 70px);
        }

        .erp-brand-subtitle {
            display: none;
        }

        .erp-content {
            padding: 25px 15px 65px;
        }

        .login-container {
            border-radius: 16px;
        }

        .login-info {
            padding: 30px 25px;
        }

        .login-info h1 {
            font-size: 26px;
        }

        .login-panel {
            padding: 40px 25px;
        }

        .login-options {
            gap: 10px;
        }

        .erp-footer {
            bottom: 10px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .login-container,
        .background-circle {
            animation: none;
        }

        .module-item,
        .btn-login {
            transition: none;
        }
    }
</style>

</head>


<body>


    <!-- =========================================================
         ERP HEADER
         ========================================================= -->

    <header class="erp-header">


        <div class="erp-brand">


            <div class="erp-logo">

                <img src="~/images/logo.png"
                     alt="Exclusive Distributors Logo" />

            </div>


            <div>

                <div class="erp-brand-name">

                    Exclusive Distributors

                </div>


                <span class="erp-brand-subtitle">

                    Enterprise Management System

                </span>

            </div>


        </div>


        <div class="secure-access">

            <i class="bi bi-shield-lock-fill"></i>

            Secure System Access

        </div>


    </header>



    <!-- =========================================================
         ERP PAGE
         ========================================================= -->

    <main class="erp-page">


        <div class="erp-background"></div>


        <div class="background-circle circle-one"></div>

        <div class="background-circle circle-two"></div>



        <div class="erp-content">


            <div class="login-container">


                <!-- =================================================
                     LEFT INFORMATION PANEL
                     ================================================= -->

                <section class="login-info">


                    <div class="info-content">


                        <div class="module-label">

                            <i class="bi bi-grid-1x2-fill"></i>

                            Exclusive Distributors Portal

                        </div>


                        <h1>

                            Manage your business

                            <span>efficiently.</span>

                        </h1>


                        <p class="login-info-description">

                            Access the Exclusive Distributors Enterprise
                            Management System to manage your day-to-day
                            business operations from one central platform.

                        </p>



                        <!-- ERP MODULES -->

                        <div class="module-list">


                            <div class="module-item">

                                <i class="bi bi-people"></i>

                                Customers

                            </div>


                            <div class="module-item">

                                <i class="bi bi-truck"></i>

                                Suppliers

                            </div>


                            <div class="module-item">

                                <i class="bi bi-box-seam"></i>

                                Inventory

                            </div>


                            <div class="module-item">

                                <i class="bi bi-receipt"></i>

                                Invoices

                            </div>


                            <div class="module-item">

                                <i class="bi bi-file-earmark-text"></i>

                                Quotes

                            </div>


                            <div class="module-item">

                                <i class="bi bi-bar-chart"></i>

                                Reports

                            </div>


                        </div>


                    </div>


                </section>



                <!-- =================================================
                     RIGHT LOGIN PANEL
                     ================================================= -->

                <section class="login-panel">


                    <div class="login-form">


                        <div class="login-heading">

                            <h2>
                                Sign in
                            </h2>


                            <p>
                                Enter your credentials to access the system.
                            </p>

                        </div>



                        <form asp-controller="Account"
                              asp-action="Login"
                              method="post">


                            @Html.AntiForgeryToken()



                            <!-- VALIDATION -->

                            <div asp-validation-summary="ModelOnly"
                                 class="validation-summary-errors"
                                 role="alert">
                            </div>



                            <!-- EMAIL -->

                            <div class="mb-3">


                                <label asp-for="Email"
                                       class="form-label">

                                    Email Address

                                </label>


                                <div class="input-group">


                                    <span class="input-group-text">

                                        <i class="bi bi-envelope"></i>

                                    </span>


                                    <input asp-for="Email"
                                           class="form-control"
                                           placeholder="Enter email address"
                                           autocomplete="email" />


                                </div>


                                <span asp-validation-for="Email"
                                      class="text-danger">
                                </span>


                            </div>



                            <!-- PASSWORD -->

                            <div class="mb-1">


                                <label asp-for="Password"
                                       class="form-label">

                                    Password

                                </label>


                                <div class="input-group">


                                    <span class="input-group-text">

                                        <i class="bi bi-lock"></i>

                                    </span>


                                    <input asp-for="Password"
                                           id="passwordInput"
                                           class="form-control"
                                           placeholder="Enter password"
                                           autocomplete="current-password" />


                                    <button type="button"
                                            id="togglePassword"
                                            class="btn password-toggle"
                                            aria-label="Show password">

                                        <i id="passwordIcon"
                                           class="bi bi-eye">
                                        </i>

                                    </button>


                                </div>


                                <span asp-validation-for="Password"
                                      class="text-danger">
                                </span>


                            </div>



                            <!-- LOGIN OPTIONS -->

                            <div class="login-options">


                                <div class="form-check">


                                    <input asp-for="RememberMe"
                                           class="form-check-input" />


                                    <label asp-for="RememberMe"
                                           class="form-check-label">
                                    </label>


                                </div>


                                <a asp-controller="Account"
                                   asp-action="ForgotPassword"
                                   class="forgot-password">

                                    Forgot Password?

                                </a>


                            </div>



                            <!-- LOGIN BUTTON -->

                            <button type="submit"
                                    class="btn-login">

                                <i class="bi bi-box-arrow-in-right me-2"></i>

                                Sign In to System

                            </button>



                            <!-- SECURITY MESSAGE -->

                            <div class="security-message">


                                <i class="bi bi-shield-lock-fill"></i>


                                <span>

                                    Your account is protected by secure
                                    authentication. Please do not share
                                    your login credentials with others.

                                </span>


                            </div>


                        </form>


                    </div>


                </section>


            </div>


        </div>



        <!-- FOOTER -->

        <div class="erp-footer">

            © @DateTime.Now.Year Exclusive Distributors
            &nbsp; | &nbsp;
            Enterprise Management System

        </div>


    </main>



    <!-- =========================================================
         JAVASCRIPT
         ========================================================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>

    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>


    <script>

        /* =====================================================
           PASSWORD VISIBILITY
           ===================================================== */

        const passwordInput =
            document.getElementById("passwordInput");

        const togglePassword =
            document.getElementById("togglePassword");

        const passwordIcon =
            document.getElementById("passwordIcon");


        if (togglePassword && passwordInput && passwordIcon) {

            togglePassword.addEventListener(
                "click",
                function () {


                    const isPassword =
                        passwordInput.type === "password";


                    passwordInput.type =
                        isPassword
                            ? "text"
                            : "password";


                    passwordIcon.classList.toggle(
                        "bi-eye",
                        !isPassword
                    );


                    passwordIcon.classList.toggle(
                        "bi-eye-slash",
                        isPassword
                    );


                    togglePassword.setAttribute(
                        "aria-label",
                        isPassword
                            ? "Hide password"
                            : "Show password"
                    );

                }
            );

        }

    </script>


</body>

</html>