@{
    ViewData["Title"] = "Password Reset";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-6 col-lg-5">

            <div class="content-card text-center">

                <i class="bi bi-envelope-check fs-1 text-secondary"></i>

                <h2 class="fw-bold mt-3"
                    style="color: #1c323d;">
                    Check Your Email
                </h2>

                <p class="text-muted mt-3">
                    If an active account exists for that email address,
                    password reset instructions will be sent to it.
                </p>

                <a asp-controller="Account"
                   asp-action="Login"
                   class="btn btn-action-primary mt-2">

                    Return to Login

                </a>

            </div>

        </div>

    </div>

</div>