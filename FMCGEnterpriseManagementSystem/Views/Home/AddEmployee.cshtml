@{
    ViewData["Title"] = "New Employee";
}

<div class="content-card">
    <h2 class="fw-bold mb-4" style="color: #1c323d;">New Employee</h2>

    <form method="post">
        <div class="row g-4">
            <!-- Left Side: Employee Personal Details Profile -->
            <div class="col-md-6 border-end pe-md-4">
                <div class="mb-3">
                    <label class="form-label">Name</label>
                    <input type="text" class="form-control" placeholder="Enter Name">
                </div>
                <div class="mb-3">
                    <label class="form-label">Surname</label>
                    <input type="text" class="form-control" placeholder="Enter Surname">
                </div>
                <div class="mb-3">
                    <label class="form-label">ID Number</label>
                    <input type="text" class="form-control" placeholder="Enter ID Number">
                </div>
                <div class="mb-3">
                    <label class="form-label">Cell Number</label>
                    <input type="text" class="form-control" placeholder="Enter Cell Number">
                </div>
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input type="email" class="form-control" placeholder="Enter Email Address">
                </div>
                <div class="mb-3">
                    <label class="form-label">Nationality</label>
                    <input type="text" class="form-control" placeholder="Enter Nationality">
                </div>
                <div class="mb-3">
                    <label class="form-label">Address</label>
                    <textarea class="form-control" rows="2" placeholder="Enter Address"></textarea>
                </div>
            </div>

            <!-- Right Side: Next Of Kin Relations Context -->
            <div class="col-md-6 ps-md-4">
                <h5 class="fw-bold text-muted mb-3 text-end">Next Of Kin</h5>

                <div class="mb-3">
                    <label class="form-label">Name</label>
                    <input type="text" class="form-control" placeholder="Enter Name">
                </div>
                <div class="mb-3">
                    <label class="form-label">Surname</label>
                    <input type="text" class="form-control" placeholder="Enter Surname">
                </div>
                <div class="mb-3">
                    <label class="form-label">Relationship</label>
                    <input type="text" class="form-control" placeholder="Enter Relationship, e.g., Mother, Father, etc">
                </div>
                <div class="mb-3">
                    <label class="form-label">Contact Number</label>
                    <input type="text" class="form-control" placeholder="Enter Contact Number">
                </div>
                <div class="mb-3">
                    <label class="form-label">Address</label>
                    <textarea class="form-control" rows="2" placeholder="Enter Address"></textarea>
                </div>
            </div>
            <div class="col-12 border-top pt-3">
                <div class="mb-4">
                    <label class="form-label">Notes</label>
                    <textarea class="form-control" rows="3" placeholder="Optional"></textarea>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-3 mt-2">
            <a asp-action="Dashboard" class="btn btn-link text-decoration-none text-secondary align-self-center">Cancel</a>
            <button type="submit" class="btn btn-custom-save">Save Employee</button>
        </div>
    </form>
</div>