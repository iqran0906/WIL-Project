@{
    ViewData["Title"] = "Customers";
}

<div class="content-card">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
        <h2 class="fw-bold m-0" style="color: #1c323d;">Customers</h2>
        <a asp-action="AddCustomer" class="btn w-100 w-sm-auto" style="background-color: #357383; color: white; font-weight: 500;">New Customer</a>
    </div>

    <div class="mb-4 d-flex flex-column flex-sm-row align-items-start align-items-sm-center gap-2">
        <span class="fw-bold text-secondary">Keyword:</span>
        <div class="input-group w-100" style="max-width: 300px;">
            <input type="text" class="form-control" placeholder="Customer, Email, etc">
            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle border" style="min-width: 600px;">
            <thead class="table-dark">
                <tr>
                    <th scope="col">Contact Person</th>
                    <th scope="col">Contact Number</th>
                    <th scope="col">Group</th>
                    <th scope="col">Terms</th>
                    <th scope="col">Due</th>
                </tr>
            </thead>
            <tbody>
                <tr class="text-muted text-center">
                    <td colspan="5">No active customer records loaded. Complete data hooks to populate live rows.</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>